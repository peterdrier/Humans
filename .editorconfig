[*]
charset = utf-8

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0053.severity = warning
resharper_lambda_expression_can_be_made_static_highlighting = none

[*.csproj]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf

# EF Core migrations are scaffolded code — skip formatting. `**.cs` rather than `*.cs` so the
# Shell's nested Migrations/System/ is covered like every section's flat Data/Migrations/.
[**/Migrations/**.cs]
generated_code = true
