{
  "classifications": {
    "dto": {
      "namePatterns": [
        "*Dto",
        "*Info",
        "*Row",
        "*Rows",
        "*Result",
        "*Results",
        "*Snapshot",
        "*View",
        "*ViewModel"
      ],
      "paths": [
        "src/Humans.Web/Models/**"
      ]
    },
    "readServiceInterface": {
      "namePatterns": [
        "I*ServiceRead",
        "I*ReadService"
      ]
    },
    "fullServiceInterface": {
      "namePatterns": [
        "I*Service"
      ]
    },
    "repositoryInterface": {
      "namePatterns": [
        "I*Repository"
      ],
      "inherits": [
        "IRepository"
      ]
    }
  }
}
