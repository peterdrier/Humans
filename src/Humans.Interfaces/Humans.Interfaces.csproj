<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lowest-level project: system marker interfaces, architecture attributes, and
    shape interfaces shared by Domain entities and their Application DTOs. Those
    shape interfaces may carry default-implemented members when a rule must have a
    single home across both implementers (IBurnSettingsInfo's early-entry clock) —
    so a little behaviour lives here, deliberately, not just declarations.
    Never a ProjectReference on another Humans.* project — this project stays the
    bottom of the graph so Humans.Domain can reference it. External packages only:
    NodaTime is allowed because IBurnSettingsInfo's calendar members are LocalDate
    and Instant, and NodaTime is an external, base-class-like dependency already
    used by every layer above. Namespaces intentionally remain Humans.Application.*
    (namespace ≠ assembly) so call sites and the Humans.Analyzers full-name
    constants are unaffected by the move.
  -->

  <ItemGroup>
    <PackageReference Include="NodaTime" />
    <!--
      ISection names IServiceCollection and IConfiguration. Both live in the
      shared framework, so this keeps the no-NuGet-packages promise intact.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
