  <ItemGroup>
    <ProjectReference Include="..\Humans.Domain\Humans.Domain.csproj" />
    <ProjectReference Include="..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\Sections\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <!--
      SystemSettings' contracts leaf. EmailOutboxService and DriveActivityMonitorService
      call ISystemSettingsService; the leaf references Humans.Interfaces only, so Base
      depending on it does not cycle (memory/architecture/section-project-cycle-fix.md).
    -->
    <ProjectReference Include="..\Sections\Humans.SystemSettings.Contracts\Humans.SystemSettings.Contracts.csproj" />
    <!-- Events' contracts leaf: SearchService calls IEventServiceRead. -->
    <ProjectReference Include="..\Sections\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Events.Contracts\Humans.Events.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Finance.Contracts\Humans.Finance.Contracts.csproj" />
    <!-- City Planning's contracts leaf: CampService clears a deleted camp's polygons. -->
    <ProjectReference Include="..\Sections\Humans.CityPlanning.Contracts\Humans.CityPlanning.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Budget.Contracts\Humans.Budget.Contracts.csproj" />
    <!--
      Campaigns' contracts leaf: TicketSyncService marks redeemed discount codes and
      TicketQueryService builds the code-tracking dashboard.
    -->
    <ProjectReference Include="..\Sections\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Campaigns.Contracts\Humans.Campaigns.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Consent.Contracts\Humans.Consent.Contracts.csproj" />
    <!--
      Notifications' contracts leaf: eleven services here emit through INotificationEmitter,
      AccountMergeService takes INotificationService, and ConsentService /
      HumanLifecycleService auto-resolve through INotificationAutoResolve.
    -->
    <ProjectReference Include="..\Sections\Humans.Governance.Contracts\Humans.Governance.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Notifications.Contracts\Humans.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Holded.Contracts\Humans.Holded.Contracts.csproj" />
    <!--
      Gdpr's contracts leaf, and the one reference here that exists because Base
      *implements* a section's contract rather than calling it: eight services in this
      project (UserService, TeamService, AccountMergeService, RoleAssignmentService,
      CampService, ShiftSignupService, TicketQueryService, AuditLogService) implement
      IUserDataContributor for the Article 15 export fan-out.
    -->
    <ProjectReference Include="..\Sections\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Onboarding.Contracts\Humans.Onboarding.Contracts.csproj" />
    <!--
      Tickets' contracts leaf: DashboardService and AccountDeletionService read a human's
      holdings, UserEmailService and ShiftManagementService read the order projection, all
      through ITicketServiceRead.
    -->
    <ProjectReference Include="..\Sections\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
    <!--
      Teams' contracts leaf: DashboardService, AuditViewerService, ContactFieldService, the
      three Shifts services and GoogleIntegration's TeamResourceService / GoogleAdminService /
      GoogleGroupSyncService / GoogleWorkspaceSyncService read teams through ITeamServiceRead
      or ITeamService, and AccountDeletionService / DuplicateAccountService write through it.
    -->
    <ProjectReference Include="..\Sections\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <!--
      Shifts' leaf. DashboardService and AdminDashboardService build the home and
      admin dashboards off IShiftView + IShiftManagementServiceRead,
      AccountDeletionService cancels signups and drops volunteer profiles, and
      UserParticipationBackfillService reads the active burn through
      IBurnSettingsService. The section's implementations are still in
      Humans.Application/Services/Shifts and move at the section's own G5 lane.
    -->
    <ProjectReference Include="..\Sections\Humans.Shifts.Contracts\Humans.Shifts.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.GoogleIntegration.Contracts\Humans.GoogleIntegration.Contracts.csproj" />
    <!--
      Users + Profiles' contracts leaf, carved ahead of the section move
      (nobodies-collective/Humans#866, lane 2 PR A). Base is the heaviest consumer there is:
      UserInfo is the canonical person read model, and the cross-section orchestrators left
      here — AccountDeletionService, ExternalLoginService, UserParticipationBackfillService,
      DashboardService, HumanLifecycleService — plus every Infrastructure job read through it.
      Every other project reaches these types transitively through this reference.
    -->
    <ProjectReference Include="..\Sections\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
  </ItemGroup>

