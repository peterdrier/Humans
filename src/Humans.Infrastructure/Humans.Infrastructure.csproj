<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Application.Tests" />
    <!--
      Teams' section test project: TeamServiceTests and TeamRoleServiceTests build the real
      TeamService over real Auth and Shifts repositories, and those contexts are internal
      here. Granted rather than rewriting ~3,000 lines of real-object tests into substitutes
      inside a move commit (design §15 step 8). GoogleIntegration was the third and left at
      its own G5 — Humans.GoogleIntegration.csproj now carries the mirror of this entry.
    -->
    <InternalsVisibleTo Include="Humans.Teams.Tests" />
    <InternalsVisibleTo Include="Humans.Shifts.Tests" />
    <!--
      Camps' service tests build the real CampService over an in-memory UsersDbContext to seed
      camp owners. Temporary: the entry comes out at Users' own G5 (Teams finding 36's mirror).
    -->
    <InternalsVisibleTo Include="Humans.Camps.Tests" />
    <InternalsVisibleTo Include="Humans.Web.Tests" />
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
    <!--
      Humans.Web is granted internals access because its section-DI extensions
      register the concrete repository implementations (which take
      IDbContextFactory<UsersDbContext> in their constructors). UsersDbContext
      itself is no longer referenced in live Web code — see issue #750. A
      follow-up can relocate the repository DI registrations into Infrastructure
      and drop this entry.
    -->
    <InternalsVisibleTo Include="Humans.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sections\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Application\Humans.Application.csproj" />
    <ProjectReference Include="..\Sections\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <!--
      Consent's and Governance's leaves survive for HumansMetricsService alone, which reads
      ILegalDocumentSyncServiceRead and IMembershipCalculatorRead for the metrics snapshot.
      SendReConsentReminderJob was the other consumer of both and left for Humans.Consent at
      G5 lane 5b-5 (nobodies-collective/Humans#866); SyncLegalDocumentsJob,
      SuspendNonCompliantMembersJob and TermRenewalReminderJob had already gone at lane 5b-4.
    -->
    <ProjectReference Include="..\Sections\Humans.Consent.Contracts\Humans.Consent.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Governance.Contracts\Humans.Governance.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Issues.Contracts\Humans.Issues.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Onboarding.Contracts\Humans.Onboarding.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <!--
      GoogleIntegration's contracts leaf survives the G5 jobs move for HumansMetricsService
      alone; the three Google jobs that also used it went to their sections
      (nobodies-collective/Humans#866). Humans.Monitor.Contracts came out in the same move —
      DriveActivityMonitorJob was its only consumer here.
    -->
    <ProjectReference Include="..\Sections\Humans.GoogleIntegration.Contracts\Humans.GoogleIntegration.Contracts.csproj" />
    <!--
      Tickets' contracts leaf: AdminDatabaseDiagnosticsService reads the order projection.
      That is the last consumer here — TicketSyncJob and GateVendorCheckInJob left for
      Humans.Tickets and Humans.Gate at G5 lane 5b-3 (nobodies-collective/Humans#866), and
      Humans.Budget.Contracts / Humans.Gate.Contracts came out entirely in the same move.
    -->
    <ProjectReference Include="..\Sections\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
  </ItemGroup>

