@model string
@{
    var reason = Model switch
    {
        "expired" => "Expired",
        "used" => "Used",
        "account-not-found" => "AccountNotFound",
        "signup-failed" => "SignupFailed",
        _ => "Unreadable",
    };
    var title = Localizer[$"SignInLinkError_{reason}_Title"].Value;
    ViewData["Title"] = title;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-5">
            <div class="card-body text-center">
                <i class="fa-solid fa-clock-rotate-left fa-3x text-warning mb-3"></i>
                <h2 class="card-title mb-3">@title</h2>
                <p class="text-muted">@Localizer[$"SignInLinkError_{reason}_Message"]</p>
                <a asp-action="Login" class="btn btn-primary mt-3">
                    @Localizer["SignInLinkError_RequestNew"]
                </a>
            </div>
        </div>
    </div>
</div>
