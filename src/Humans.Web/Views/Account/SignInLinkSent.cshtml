@{
    ViewData["Title"] = Localizer["SignInLinkSent_Title"].Value;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-5">
            <div class="card-body text-center">
                <i class="fa-solid fa-envelope-open-text fa-3x text-primary mb-3"></i>
                <h2 class="card-title mb-3">@Localizer["SignInLinkSent_Title"]</h2>
                <p class="text-muted">@Localizer["SignInLinkSent_Message"]</p>
                @if (ViewData["ExpiryTime"] is string expiryTime)
                {
                    <p class="text-muted small">@Localizer["SignInLinkSent_Expiry", expiryTime]</p>
                }
                <a asp-action="Login" class="btn btn-outline-secondary mt-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> @Localizer["SignInLinkSent_BackToLogin"]
                </a>
            </div>
        </div>
    </div>
</div>
