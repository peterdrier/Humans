@model Humans.Web.Models.Events.EventsCardViewModel
@* FavouriteButtonModel moved to Humans.Events at G5 lane 4b-i (nobodies-collective/Humans#866). *@
@using Humans.Events.Contracts
@* Events strings live in the section's resource set since #866 G5; Shell references the section project, so it localizes them directly. *@
@inject IStringLocalizer<Humans.Events.EventsResource> EventsLocalizer

@functions {
    static string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var mins = minutes % 60;
        if (hours == 0) return $"{mins}m";
        return mins == 0 ? $"{hours}h" : $"{hours}h {mins}m";
    }
}

<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-calendar-days me-1"></i> Events
    </div>
    <div class="list-group list-group-flush">
        @foreach (var row in Model.Rows)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@row.Title</strong>
                        <span class="badge bg-secondary ms-1">@row.CategoryName</span>
                        @if (row.IsRecurring)
                        {
                            <span class="badge bg-light text-dark ms-1" title="Recurring event">
                                <i class="fa-solid fa-repeat"></i>
                            </span>
                        }
                    </div>
                    <span class="ms-2">
                        @await Html.PartialAsync("_FavouriteButton", new FavouriteButtonModel
                        {
                            EventId = row.EventId,
                            IsFavourited = row.IsFavourited,
                            AddTitle = EventsLocalizer["Events_AddToFavourites"].Value,
                            RemoveTitle = EventsLocalizer["Events_RemoveFromFavourites"].Value,
                            RemoveRowTitle = EventsLocalizer["Events_RemoveFromSchedule"].Value,
                            ErrorMessage = Localizer["Common_Error"].Value
                        })
                    </span>
                </div>
                <div class="mt-1 small text-muted">
                    <i class="fa-solid fa-clock me-1"></i>@row.StartAt.ToWeekdayDayMonth() &middot;
                    @row.StartAt.ToTime() — @row.StartAt.AddMinutes(row.DurationMinutes).ToTime()
                    (@FormatDuration(row.DurationMinutes))
                    @if (row.VenueName != null)
                    {
                        <text> &middot; <i class="fa-solid fa-location-dot me-1"></i>@row.VenueName</text>
                    }
                    @if (!string.IsNullOrEmpty(row.LocationNote))
                    {
                        <text> &middot; @row.LocationNote</text>
                    }
                    @if (!string.IsNullOrEmpty(row.Host))
                    {
                        <text> &middot; <i class="fa-solid fa-user me-1"></i>@row.Host</text>
                    }
                </div>
                @if (!string.IsNullOrEmpty(row.Description))
                {
                    <p class="mt-2 mb-0 small">@row.Description</p>
                }
            </div>
        }
    </div>
</div>
