@model Humans.Web.ViewComponents.AdminSidebarViewModel

@* One row per group, alphabetical; the group's items are the tab strip on its pages.
   Desktop: a vertical list. Below 768px: a horizontally scrolling strip. *@
<div class="sidebar-rows-wrap">
    <nav class="sidebar-rows" aria-label="Admin sections">
        <a class="@(string.Equals(ViewContext.RouteData.Values["controller"] as string, Humans.Web.ViewComponents.AdminNavComposition.DashboardController, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
           asp-controller="@Humans.Web.ViewComponents.AdminNavComposition.DashboardController" asp-action="Index">
            <i class="fa-solid fa-house" aria-hidden="true"></i>
            <span>Dashboard</span>
        </a>
        @foreach (var group in Model.Groups)
        {
            var first = group.First;
            if (first.RawHref is not null)
            {
                <a class="@(group.IsActive ? "active" : null)" data-group="@group.Label" href="@first.RawHref">
                    <i class="@first.IconCssClass" aria-hidden="true"></i>
                    <span>@group.Label</span>
                    @if (group.PillSum.HasValue)
                    {
                        <span class="pill">@group.PillSum.Value</span>
                    }
                </a>
            }
            else
            {
                <a class="@(group.IsActive ? "active" : null)" data-group="@group.Label" asp-controller="@first.Controller" asp-action="@first.Action">
                    <i class="@first.IconCssClass" aria-hidden="true"></i>
                    <span>@group.Label</span>
                    @if (group.PillSum.HasValue)
                    {
                        <span class="pill">@group.PillSum.Value</span>
                    }
                </a>
            }
        }
    </nav>
</div>
