@using Humans.Base.Models
@model Humans.Web.ViewComponents.AdminSummaryViewModel

<page-header title="Welcome back, @Model.GreetingFirstName." subtitle="@string.Join(" · ", Model.Strapline)" variant="compact" />

<div class="stats">
    @foreach (var tile in Model.Tiles)
    {
        <partial name="_StatTile" model="new StatTileViewModel(tile.Label, tile.Value.Display, tile.Value.Secondary, tile.Value.Detail, tile.Value.Severity)" />
    }
</div>
