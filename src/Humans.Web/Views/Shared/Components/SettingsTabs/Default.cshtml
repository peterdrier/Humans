@using Humans.Base.Interfaces
@model IReadOnlyList<SettingsTab>

@* Empty-state plumbing text, no resx key: this renders only while nothing has
   contributed a tab yet. *@
@if (Model.Count == 0)
{
    <p class="text-muted">No settings are available yet.</p>
}
else
{
    <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
        @for (var i = 0; i < Model.Count; i++)
        {
            var tab = Model[i];
            var isActive = i == 0;
            <li class="nav-item" role="presentation">
                <button class="nav-link @(isActive ? "active" : "")" id="settingsTabs-tab-@tab.Key"
                        data-bs-toggle="tab" data-bs-target="#settingsTabs-panel-@tab.Key" type="button"
                        role="tab" aria-controls="settingsTabs-panel-@tab.Key"
                        aria-selected="@(isActive ? "true" : "false")">
                    @tab.Label
                </button>
            </li>
        }
    </ul>

    <div class="tab-content p-3" id="settingsTabsContent">
        @for (var i = 0; i < Model.Count; i++)
        {
            var tab = Model[i];
            var isActive = i == 0;
            <div class="tab-pane fade @(isActive ? "show active" : "")" id="settingsTabs-panel-@tab.Key"
                 role="tabpanel" aria-labelledby="settingsTabs-tab-@tab.Key">
                @await Component.InvokeAsync(tab.ComponentName)
            </div>
        }
    </div>
}
