@using Humans.Base.ViewComponents
@using Microsoft.AspNetCore.Authorization
@inject IEnumerable<Humans.Base.Interfaces.ISectionAdminNav> AdminNav
@inject IAuthorizationService Authorization
@{
    // docs/sections/admin-shell.md
    Layout = await AdminNavComposition.IsShellPageAsync(AdminNav, Context.GetEndpoint(), ViewContext.RouteData.Values, Authorization, User)
        ? "_AdminLayout" : "_Layout";
}
