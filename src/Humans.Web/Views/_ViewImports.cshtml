@using Humans.Web
@using Humans.Application.Extensions
@using Humans.Users.Contracts
@using Humans.Web.Extensions
@using Humans.Web.Extensions.Sections
@using Humans.Web.Helpers
@using Humans.Web.Models
@using Humans.Web.Models.Events
@using Humans.Web.ViewComponents
@using Humans.UI.ViewComponents
@using Humans.Domain.Entities
@using Humans.Domain.Enums
@using Humans.Shifts.Contracts
@using Humans.Tickets.Contracts
@using Humans.UI
@using Humans.UI.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Web
@addTagHelper *, Humans.UI
@* <vc:ticket-stub> is the Tickets section's own component, public under
   Humans.Tickets/Contracts/ so MVC's default provider discovers it and the tag helper is
   generated. Shell renders it from Shared/Components/MyTicketStubs, Shared/Components/
   TicketHoldings and WidgetGallery; the @using above imports TicketStubInfo but NOT the tag
   helper, and without this line the element ships as inert literal markup (step 6). *@
@addTagHelper *, Humans.Camps
@addTagHelper *, Humans.Tickets
@* <vc:shift-signups> is the Shifts section's own component, public under
   Humans.Shifts/Contracts/ so MVC's default provider discovers it and the tag helper is
   generated. Shell renders it from Home/Dashboard, Profile/Index, UsersAdmin/AdminDetail
   and WidgetGallery; without this line the element ships as inert literal markup
   (design §15 step 6). *@
@addTagHelper *, Humans.Shifts
@* <vc:user-calendar> is the Calendar section's own component, public under
   Humans.Calendar/Contracts/ so MVC's default provider discovers it and the tag helper is
   generated. Shell renders it from WidgetGallery; Users' UsersAdmin/AdminDetail invokes it
   by name instead. Without this line the element ships as inert literal markup
   (design §15 step 6). *@
@addTagHelper *, Humans.Calendar
@* <vc:audit-log> is the AuditLog section's own component since G5 lane 4b-2h
   (nobodies-collective/Humans#866); it used to be Humans.UI's. Shell renders it from
   WidgetGallery. Without this line the element ships as inert literal markup
   (design §15 step 6). *@
@addTagHelper *, Humans.AuditLog
