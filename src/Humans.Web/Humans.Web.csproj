<Project Sdk="Microsoft.NET.Sdk.Web"><PropertyGroup>  <UserSecretsId>f902cc11-ec92-4e4e-bb21-1be0f5af92a3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
    <InternalsVisibleTo Include="Humans.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Base is named directly since G5 lane 5b-6 deleted Humans.Infrastructure
      (nobodies-collective/Humans#866) — it used to arrive transitively through it. The
      Humans.Application reference went away at G5 lane 5c, which emptied that project; the
      contracts leaves Shell had been reaching through it are declared below.
    -->
    <ProjectReference Include="..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Sections\Humans.Auth\Humans.Auth.csproj" />
    <ProjectReference Include="..\Sections\Humans.Tickets\Humans.Tickets.csproj" />
    <ProjectReference Include="..\Sections\Humans.Consent\Humans.Consent.csproj" />
    <ProjectReference Include="..\Sections\Humans.Shifts.Contracts\Humans.Shifts.Contracts.csproj" />
    <ProjectReference Include="..\Sections\Humans.Issues\Humans.Issues.csproj" />
    <ProjectReference Include="..\Sections\Humans.GoogleIntegration\Humans.GoogleIntegration.csproj" />
    <ProjectReference Include="..\Sections\Humans.Backdoor\Humans.Backdoor.csproj" />
    <ProjectReference Include="..\Sections\Humans.Users\Humans.Users.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Arrived with the Humans.Infrastructure residue at G5 lane 5b-6
      (nobodies-collective/Humans#866); each is forced by exactly one moved file.
        DataProtection.EntityFrameworkCore — SystemDbContext's IDataProtectionKeyContext and
          PersistKeysToSystemDbContext. (.Extensions came across with it but is in the
          ASP.NET Core shared framework; NU1510 rejects naming it.)
        EntityFrameworkCore + the two Npgsql packages — SystemDbContext, its design-time
          factory and Migrations/System.
        NodaTime — AdminDatabaseDiagnosticsService, HumansMetricsService, UserActivityTracker.
        MyCSharp.HttpUserAgentParser — UserAgentClassifier.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="MyCSharp.HttpUserAgentParser" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <!-- Program.cs's UsePostgreSqlStorage; came via Humans.Infrastructure until lane 5b-6. -->
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Hangfire" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
  </ItemGroup>

  <!--
    Section modules. Shell compiles against only the sections above. Every other section, with the packages it
    needs, is copied flat into the output beside Shell and loaded at startup by SectionModuleLoader: not in
    Shell's deps.json, but where dotnet ef with startup project Humans.Web still finds it. The MSBuild call
    inherits this build's global properties, so inside a solution build it reuses the sections already built.
  -->
  <ItemGroup>
    <SectionModuleProject Include="..\Sections\*\*.csproj" />
  </ItemGroup>

  <Target Name="CopySectionModules" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_SectionModuleManifest>$(IntermediateOutputPath)section-modules.txt</_SectionModuleManifest>
    </PropertyGroup>
    <MSBuild Projects="@(SectionModuleProject)" Targets="Build" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_SectionModuleAssembly" />
    </MSBuild>
    <ReadLinesFromFile File="$(_SectionModuleManifest)" Condition="Exists('$(_SectionModuleManifest)')">
      <Output TaskParameter="Lines" ItemName="_PreviousSectionModuleFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_SectionModuleDir Include="@(_SectionModuleAssembly->'%(RootDir)%(Directory)')" />
      <_SectionModuleFile Include="%(_SectionModuleDir.Identity)*.dll;%(_SectionModuleDir.Identity)Humans.*.pdb;%(_SectionModuleDir.Identity)**\*.resources.dll" />
      <_SectionModuleFile>
        <Relative>%(RecursiveDir)%(Filename)%(Extension)</Relative>
      </_SectionModuleFile>
      <_PreviousSectionModuleFile Relative="%(Identity)" />
      <!-- What Shell ships itself stays Shell's; a file this target copied on an earlier build is still a module's. -->
      <_ShellOwnedFile Include="@(_SectionModuleFile)" Condition="Exists('$(OutDir)%(Relative)')" />
      <_ShellOwnedFile Remove="@(_PreviousSectionModuleFile)" MatchOnMetadata="Relative" />
      <_SectionModuleFile Remove="@(_ShellOwnedFile)" MatchOnMetadata="Relative" />
      <!-- A copy-local section bin also holds shared-framework assemblies; the runtime always takes the framework's. -->
      <_SharedFrameworkFile Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\$(BundledNETCoreAppPackageVersion)\ref\**\*.dll;$(NetCoreTargetingPackRoot)\Microsoft.AspNetCore.App.Ref\$(BundledNETCoreAppPackageVersion)\ref\**\*.dll" />
      <_SharedFrameworkFile Relative="%(Filename)%(Extension)" />
      <_SectionModuleFile Remove="@(_SharedFrameworkFile)" MatchOnMetadata="Relative" />
      <_ShellOwnedSection Include="@(_ShellOwnedFile->'%(Filename)')" Condition="'%(Extension)' == '.dll'" Section="%(Filename)" />
      <_SectionModuleWebRoot Include="$([System.IO.Path]::GetDirectoryName('%(SectionModuleProject.FullPath)'))\wwwroot\**\*">
        <Section>%(SectionModuleProject.Filename)</Section>
      </_SectionModuleWebRoot>
      <_SectionModuleWebRoot Remove="@(_ShellOwnedSection)" MatchOnMetadata="Section" />
    </ItemGroup>
    <Copy SourceFiles="@(_SectionModuleFile)"
          DestinationFiles="@(_SectionModuleFile->'$(OutDir)%(Relative)')"
          SkipUnchangedFiles="true">
      <!-- FileWrites: clean and incremental clean remove a module that stops being built, so it is not discovered. -->
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="@(_SectionModuleWebRoot)"
          DestinationFiles="@(_SectionModuleWebRoot->'$(OutDir)_content\%(Section)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true">
      <!-- FileWrites: clean and incremental clean remove a module that stops being built, so it is not discovered. -->
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <WriteLinesToFile File="$(_SectionModuleManifest)" Lines="@(_SectionModuleFile->'%(Relative)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_SectionModuleManifest)" />
    </ItemGroup>
  </Target>

  <!-- In publish, a module's wwwroot lands where a referenced section's would: wwwroot/_content/<Section>. -->
  <Target Name="PublishSectionModules" AfterTargets="Publish" DependsOnTargets="CopySectionModules">
    <Copy SourceFiles="@(_SectionModuleFile)"
          DestinationFiles="@(_SectionModuleFile->'$(PublishDir)%(Relative)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SectionModuleWebRoot)"
          DestinationFiles="@(_SectionModuleWebRoot->'$(PublishDir)wwwroot\_content\%(Section)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
