@using Humans.Base.Interfaces
@using Microsoft.Extensions.Localization
@model IReadOnlyList<MemberNavItem>
@inject IStringLocalizer<Humans.Base.SharedResource> NavLocalizer
@{
    // Shallow match — controller only, no action — the same rule _Layout.cshtml
    // uses for the two top-nav links it renders itself (Legal, Admin).
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    bool IsActive(MemberNavItem navItem) =>
        navItem.Controller is not null && string.Equals(navItem.Controller, currentController, StringComparison.OrdinalIgnoreCase);
    // Dropdown children share a controller (Events: Browse / MySubmissions / Schedule),
    // so a child also matches on action; the parent keeps the shallow match.
    var currentAction = ViewContext.RouteData.Values["action"] as string;
    bool IsActiveChild(MemberNavItem child) =>
        IsActive(child) && string.Equals(child.Action, currentAction, StringComparison.OrdinalIgnoreCase);
}
@foreach (var item in Model)
{
    @if (item.Children is { Count: > 0 })
    {
        var parentActive = item.Children.Any(IsActive);
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle@(parentActive ? " active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-current="@(parentActive ? "page" : null)">@NavLocalizer[item.Label]</a>
            <ul class="dropdown-menu">
                @foreach (var child in item.Children)
                {
                    @if (child.Divider)
                    {
                        <li><hr class="dropdown-divider" /></li>
                    }
                    else
                    {
                        var childActive = IsActiveChild(child);
                        <li>
                            @if (child.RawHref is not null)
                            {
                                <a class="dropdown-item@(childActive ? " active" : "")" href="@child.RawHref" aria-current="@(childActive ? "page" : null)">@NavLocalizer[child.Label]</a>
                            }
                            else
                            {
                                <a class="dropdown-item@(childActive ? " active" : "")" asp-area="" asp-controller="@child.Controller" asp-action="@child.Action" aria-current="@(childActive ? "page" : null)">@NavLocalizer[child.Label]</a>
                            }
                        </li>
                    }
                }
            </ul>
        </li>
    }
    else
    {
        var active = IsActive(item);
        var cssClass = (item.CssClass + (active ? " active" : "")).Trim();
        <li class="nav-item">
            @if (item.IconCssClass is not null)
            {
                @if (item.RawHref is not null)
                {
                    <a class="nav-link @cssClass" href="@item.RawHref" aria-label="@NavLocalizer[item.Label]" title="@NavLocalizer[item.Label]" aria-current="@(active ? "page" : null)"><i class="@item.IconCssClass"></i></a>
                }
                else
                {
                    <a class="nav-link @cssClass" asp-area="" asp-controller="@item.Controller" asp-action="@item.Action" aria-label="@NavLocalizer[item.Label]" title="@NavLocalizer[item.Label]" aria-current="@(active ? "page" : null)"><i class="@item.IconCssClass"></i></a>
                }
            }
            else if (item.RawHref is not null)
            {
                <a class="nav-link @cssClass" href="@item.RawHref" aria-current="@(active ? "page" : null)">@NavLocalizer[item.Label]</a>
            }
            else
            {
                <a class="nav-link @cssClass" asp-area="" asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(active ? "page" : null)">@NavLocalizer[item.Label]</a>
            }
        </li>
    }
}
