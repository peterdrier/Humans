@model Humans.Base.ViewComponents.BreadcrumbViewModel
@if (Model.Items.Count > 0)
{
    <nav aria-label="@Localizer["Common_Breadcrumb"]">
        <ol class="breadcrumb">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                if (i == Model.Items.Count - 1)
                {
                    <li class="breadcrumb-item active" aria-current="page">@Model.Items[i]</li>
                }
                else
                {
                    <li class="breadcrumb-item">@Model.Items[i]</li>
                }
            }
        </ol>
    </nav>
}
