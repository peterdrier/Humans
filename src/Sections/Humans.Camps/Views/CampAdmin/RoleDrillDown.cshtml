@using Humans.Base.Models.Tables
@using Microsoft.AspNetCore.Html
@model CampRoleDrillDownViewModel
@{
    ViewData["Title"] = $"{Model.RoleName} — {Model.Event.EventName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Camp" asp-action="Index">@SharedLocalizer["Camp_Plural"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Camps_AdminTitle"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Roles">Roles</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.RoleName</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">@Model.RoleName <small class="text-muted">— @Model.Event.EventName</small></h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0">@Html.SanitizedMarkdown(Model.Description)</p>
        }
    </div>
    <form asp-controller="CampAdmin" asp-action="RolesDrillDown" asp-route-slug="@Model.RouteKey" method="get" class="d-flex gap-2 align-items-center">
        <label for="eventSettingsId" class="form-label mb-0 text-nowrap">Event</label>
        <select id="eventSettingsId" name="eventSettingsId" class="form-select form-select-sm js-autosubmit" style="max-width: 220px;">
            @foreach (var option in Model.EventOptions)
            {
                if (option.EventSettingsId == Model.Event.EventSettingsId)
                {
                    <option value="@option.EventSettingsId" selected>@option.EventName</option>
                }
                else
                {
                    <option value="@option.EventSettingsId">@option.EventName</option>
                }
            }
        </select>
        <noscript><button type="submit" class="btn btn-outline-primary btn-sm">Show</button></noscript>
    </form>
</div>


<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row align-items-center">
            <div class="col-md-3 small text-muted">Slot count</div>
            <div class="col-md-3"><strong>@Model.SlotCount</strong> per camp</div>
            <div class="col-md-3 small text-muted">Minimum required</div>
            <div class="col-md-3"><strong>@Model.MinimumRequired</strong></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.GroupEmail))
        {
            <hr class="my-2" />
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-muted me-2">Group email:</span>
                    <code>@Model.GroupEmail</code>
                </div>
                <a href="@("mailto:" + Model.GroupEmail)" class="btn btn-outline-primary btn-sm">
                    <i class="fa-regular fa-envelope me-1"></i>Email group
                </a>
            </div>
        }
    </div>
</div>

<script nonce="@Context.Items["CspNonce"]">
    // CSP-compliant replacement for inline onchange.
    document.querySelectorAll('select.js-autosubmit').forEach(function(el) {
        el.addEventListener('change', function() { el.form.submit(); });
    });
</script>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-table-list me-2"></i>Roster (@Model.Camps.Count camp(s) for @Model.Event.EventName)
    </div>
    @if (Model.Camps.Count == 0)
    {
        <div class="card-body">
            <p class="text-muted mb-0">No camps participate in @Model.Event.EventName.</p>
        </div>
    }
    else
    {
        Func<CampRoleDrillDownCampRowViewModel, IHtmlContent> barrioCell =
            @<text><a asp-controller="Camp" asp-action="Details" asp-route-slug="@item.CampSlug">@item.CampName</a></text>;
        Func<CampRoleDrillDownCampRowViewModel, IHtmlContent> assigneesCell = @<text>
            @if (item.Assignees.Count == 0)
            {
                <span class="text-muted small">— none —</span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    @foreach (var a in item.Assignees)
                    {
                        <vc:human user-id="@a.UserId" layout="AvatarName" size="40" />
                    }
                </div>
            }
        </text>;
        var rosterTable = TableModel.For(Model.Camps)
            .Template("Barrio", barrioCell)
            .Template("Assignees", assigneesCell)
            .Build();
        <partial name="_Table" model="rosterTable" />
    }
</div>
