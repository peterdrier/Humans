@model Humans.Camps.Models.CampIndexViewModel
@{
    ViewData["Title"] = $"{SharedLocalizer["Camp_Plural"]} {Model.Year}";
    var pendingCount = (int?)ViewBag.PendingCount ?? 0;
}

<page-header title="@($"{SharedLocalizer["Camp_Plural"].Value} {Model.Year}")">
    <vc:access-matrix section="Camps" />
    <a asp-controller="CampAdmin" asp-action="Index" class="btn btn-outline-secondary" authorize-policy="@CampsPolicies.Read">
        <i class="fa-solid fa-shield-halved me-1"></i> @Localizer["Camps_AdminTitle"]
        @if (pendingCount > 0)
        {
            <span class="badge bg-danger ms-1">@pendingCount</span>
        }
        <i class="fa-solid fa-lock auth-lock-icon"></i>
    </a>
    <a href="https://drive.google.com/file/d/1orfoEDH6uFz3Hn6ioaqVo-EG_Iuv1Dji/view"
       class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer">
        <i class="fa-solid fa-book me-1"></i> @Localizer["Camps_Index_BarrioGuide"]
        <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
    </a>
    <a asp-action="Register" class="btn btn-primary" authorize-policy="AppAccess">
        <i class="fa-solid fa-plus me-1"></i> @Localizer["Camps_Register_Submit", Localizer["Camps_Singular"]]
    </a>
</page-header>


<form method="get" asp-action="Index" class="card mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label asp-for="Filters.Search" class="form-label small mb-1">@Localizer["Camps_Index_SearchLabel"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="search" asp-for="Filters.Search" id="camp-name-search" class="form-control"
                           placeholder="@Localizer["Camps_Index_SearchPlaceholder", Localizer["Camps_Singular"].Value.ToLower(System.Globalization.CultureInfo.CurrentUICulture)]"
                           autocomplete="off" />
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <label asp-for="Filters.Vibe" class="form-label small mb-1">@Localizer["Camps_Index_VibeLabel"]</label>
                <select asp-for="Filters.Vibe" class="form-select js-auto-submit"
                        asp-items="@Localizer.EnumSelectItems<CampVibe>()">
                    <option value="">@Localizer["Camps_Index_AllOption"]</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label asp-for="Filters.SoundZone" class="form-label small mb-1">@Localizer["Camps_Index_SoundZoneLabel"]</label>
                <select asp-for="Filters.SoundZone" class="form-select js-auto-submit"
                        asp-items="@SharedLocalizer.EnumSelectItems<SoundZone>()">
                    <option value="">@Localizer["Camps_Index_AllOption"]</option>
                </select>
            </div>
            <div class="col-lg-4 d-flex flex-wrap column-gap-3 pb-2">
                <div class="form-check">
                    <input asp-for="Filters.KidsFriendly" class="form-check-input js-auto-submit" type="checkbox" />
                    <label asp-for="Filters.KidsFriendly" class="form-check-label">@Localizer["Camps_Index_KidsWelcomeFilter"]</label>
                </div>
                <div class="form-check">
                    <input asp-for="Filters.AcceptingMembers" class="form-check-input js-auto-submit" type="checkbox" />
                    <label asp-for="Filters.AcceptingMembers" class="form-check-label">@Localizer["Camps_Index_AcceptingMembersFilter"]</label>
                </div>
                <div class="form-check">
                    <input asp-for="Filters.ShowLeadPositions" class="form-check-input js-auto-submit" type="checkbox" />
                    <label asp-for="Filters.ShowLeadPositions" class="form-check-label">@Localizer["Camps_Index_ShowLeadPositions"]</label>
                </div>
            </div>
        </div>
    </div>
</form>

<div id="camp-search-empty" class="alert alert-info" style="display: none;">
    @Localizer["Camps_Index_NoSearchResults", SharedLocalizer["Camp_Plural"]]
</div>

@if (Model.MyCamps.Any())
{
    <h4 class="mb-3">@Localizer["Camps_MyCamps_Title"] <small class="text-muted">(@Localizer["Camps_Index_PendingApproval"])</small></h4>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        @foreach (var camp in Model.MyCamps)
        {
            @await Html.PartialAsync("_CampCard", camp)
        }
    </div>
}

@if (Model.Camps.Any())
{
    <div id="camp-directory" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var camp in Model.Camps)
        {
            @await Html.PartialAsync("_CampCard", camp)
        }
    </div>
}
else
{
    <div class="alert alert-info">
        @Localizer["Camps_Index_NoFilterResults", SharedLocalizer["Camp_Plural"]]
    </div>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('camp-name-search');
            var emptyMsg = document.getElementById('camp-search-empty');
            var directory = document.getElementById('camp-directory');
            if (!input || !directory) return;

            // Scope to directory cards only — the "My Camps (pending approval)"
            // section also renders _CampCard, and the search filter must not
            // hide the user's own pending entries.
            var cards = Array.prototype.slice.call(directory.querySelectorAll('.camp-card'));
            var debounceTimer = null;

            function applyFilter() {
                var q = input.value.trim().toLowerCase();
                var anyVisible = false;
                cards.forEach(function (card) {
                    var name = (card.getAttribute('data-camp-name') || '').toLowerCase();
                    var match = q.length === 0 || name.indexOf(q) !== -1;
                    card.style.display = match ? '' : 'none';
                    if (match) anyVisible = true;
                });
                if (emptyMsg) {
                    emptyMsg.style.display = (q.length > 0 && !anyVisible) ? '' : 'none';
                }
            }

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(applyFilter, 80);
            });
        })();
    </script>
}
