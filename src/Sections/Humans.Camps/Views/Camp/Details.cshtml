@using Humans.CityPlanning
@model Humans.Camps.Models.CampDetailViewModel
@* The placement strip's copy is City Planning's resource set, not SharedResource — a
   Shell view cannot see a section's keys through the ambient Localizer, so the marker
   is injected directly. *@
@inject IStringLocalizer<CityPlanningResource> CityPlanningLocalizer
@{
    ViewData["Title"] = Model.Name;
    var isCityPlanningMember = ViewBag.IsCityPlanningTeamMember as bool? ?? false;
    var membershipYear = Model.Membership.OpenSeasonYear?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? string.Empty;
}

<nav aria-label="@Localizer["Camps_Details_Breadcrumb"]">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@SharedLocalizer["Camp_Plural"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>


<div class="row">
    <div class="col-md-8">
        @if (Model.ImageUrls.Count > 0)
        {
            if (Model.ImageUrls.Count == 1)
            {
                <img src="@Model.ImageUrls[0]" class="w-100 rounded mb-4 camp-carousel-img" alt="@Model.Name" />
            }
            else
            {
                <div id="campCarousel" class="carousel slide mb-4">
                    <div class="carousel-indicators">
                        @for (var i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <button type="button" data-bs-target="#campCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-label="@Localizer["Camps_Details_Slide", i + 1]"></button>
                        }
                    </div>
                    <div class="carousel-inner">
                        @for (var i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.ImageUrls[i]" class="d-block w-100 rounded camp-carousel-img" alt="@Model.Name" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#campCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Camps_Details_Previous"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#campCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Camps_Details_Next"]</span>
                    </button>
                </div>
            }
        }

        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 class="mb-1">@Model.Name</h1>
                @if (Model.CurrentSeason?.EventSettingsId is { } seasonEventId)
                {
                    <p class="mb-1">
                        <a asp-action="SeasonDetails" asp-route-slug="@Model.Slug" asp-route-eventSettingsId="@seasonEventId" class="link-secondary">
                            @Localizer["Camps_Details_SeasonLink", Model.CurrentSeason.Year]
                        </a>
                    </p>
                }
                @if (Model.HistoricalNames.Count > 0 && !Model.HideHistoricalNames)
                {
                    <p class="text-muted mb-0">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i>
                        @Localizer["Camps_Details_AlsoKnownAs"] @string.Join(", ", Model.HistoricalNames)
                    </p>
                }
            </div>
            <div class="d-flex gap-1">
                @if (Model.IsSwissCamp)
                {
                    <span class="badge bg-danger fs-6">
                        <i class="fa-solid fa-flag me-1"></i>@Localizer["Camps_Details_SwissCampBadge"]
                    </span>
                }
                @if (Model.CurrentSeason?.Status == CampSeasonStatus.Full)
                {
                    <span class="badge bg-warning text-dark fs-6">@Localizer["Camps_Card_Full"]</span>
                }
            </div>
        </div>

        @if (Model.CurrentSeason != null)
        {
            var season = Model.CurrentSeason;

            <partial name="_CampRosterCard" model="Model" />

            @* Invoked by Type, not by name. A fanout: not every contributor must bind CampId. *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <vc:camp-parts camp-id="@Model.Id" />
            }

            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-pen-fancy me-1"></i> @SharedLocalizer["Nav_About"]
                </div>
                <div class="card-body">
                    @Html.SanitizedMarkdown(season.BlurbLong)
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-users me-1"></i> @Localizer["Camps_CommunityHeading"]
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>@Localizer["Camps_LanguagesLabel"]</dt>
                                <dd>@season.Languages</dd>
                                <dt>@Localizer["Camps_AcceptingMembersLabel"]</dt>
                                <dd>@SharedLocalizer.EnumDisplay(season.AcceptingMembers)</dd>
                                <dt>@Localizer["Camps_KidsWelcomeLabel"]</dt>
                                <dd>@SharedLocalizer.EnumDisplay(season.KidsWelcome)</dd>
                                @if (season.KidsWelcome != YesNoMaybe.No)
                                {
                                    <dt>@Localizer["Camps_KidsVisitingLabel"]</dt>
                                    <dd>@SharedLocalizer.EnumDisplay(season.KidsVisiting)</dd>
                                    @if (!string.IsNullOrEmpty(season.KidsAreaDescription))
                                    {
                                        <dt>@Localizer["Camps_KidsAreaDescriptionLabel"]</dt>
                                        <dd>@Html.SanitizedMarkdown(season.KidsAreaDescription)</dd>
                                    }
                                }
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>@Localizer["Camps_AdultPlayspaceLabel"]</dt>
                                <dd>@SharedLocalizer.EnumDisplay(season.AdultPlayspace)</dd>
                                <dt>@Localizer["Camps_MemberCountLabel"]</dt>
                                <dd>@season.MemberCount</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            @if (season.Vibes.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fa-solid fa-heart-pulse me-1"></i> @Localizer["Camps_VibesLabel"]
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var vibe in season.Vibes)
                            {
                                <span class="badge bg-secondary fs-6">@Localizer.EnumDisplay(vibe)</span>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (season.HasPerformanceSpace != PerformanceSpaceStatus.No || !string.IsNullOrEmpty(season.PerformanceTypes))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fa-solid fa-masks-theater me-1"></i> @Localizer["Camps_CultureHeading"]
                    </div>
                    <div class="card-body">
                        <dl>
                            <dt>@Localizer["Camps_PerformanceSpaceLabel"]</dt>
                            <dd>@SharedLocalizer.EnumDisplay(season.HasPerformanceSpace)</dd>
                            @if (!string.IsNullOrEmpty(season.PerformanceTypes))
                            {
                                <dt>@Localizer["Camps_PerformanceTypesLabel"]</dt>
                                <dd>@season.PerformanceTypes</dd>
                            }
                        </dl>
                    </div>
                </div>
            }

            @if (Model.IsCurrentUserLead || Model.IsCurrentUserCampAdmin || isCityPlanningMember)
            {
                var placementState = ViewBag.PlacementState as Humans.CityPlanning.Contracts.BarrioPlacementState?
                    ?? Humans.CityPlanning.Contracts.BarrioPlacementState.Closed;
                (NodaTime.LocalDate? OpensOn, NodaTime.LocalDate? ClosesOn, NodaTime.LocalDate? ChangeableUntilOn) placementSchedule =
                    ViewBag.PlacementSchedule ?? ((NodaTime.LocalDate?)null, (NodaTime.LocalDate?)null, (NodaTime.LocalDate?)null);
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-map-location-dot me-1"></i> @Localizer["Camps_PlacementHeading"]</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small">@CityPlanningLocalizer["CityPlanning_PlacementPhase"]:</span>
                            @if (placementState != Humans.CityPlanning.Contracts.BarrioPlacementState.Closed)
                            {
                                @if (placementState == Humans.CityPlanning.Contracts.BarrioPlacementState.Open)
                                {
                                    <span class="badge bg-success">@CityPlanningLocalizer["CityPlanning_StatusOpen"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@CityPlanningLocalizer["CityPlanning_StatusChangeable"]</span>
                                }
                                <a asp-controller="CityPlanning" asp-action="BarrioMap" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-map me-1"></i> @CityPlanningLocalizer["CityPlanning_GoToPlacementMap"]
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@CityPlanningLocalizer["CityPlanning_StatusClosed"]</span>
                            }
                            <button type="button" class="btn btn-link btn-sm p-0"
                                    data-bs-toggle="modal" data-bs-target="#placement-help-modal"
                                    title="@CityPlanningLocalizer["CityPlanning_PlacementPhaseInfo"]">
                                <i class="fa-solid fa-circle-info text-muted"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <dl>
                                    @if (season.SoundZone.HasValue)
                                    {
                                        <dt>@Localizer["Camps_Index_SoundZoneLabel"]</dt>
                                        <dd><span class="badge bg-info">@SharedLocalizer.EnumDisplay(season.SoundZone.Value)</span></dd>
                                    }
                                    @if (season.SpaceRequirement.HasValue)
                                    {
                                        <dt>@Localizer["Camps_SpaceRequirementLabel"]</dt>
                                        <dd>@SharedLocalizer.EnumDisplay(season.SpaceRequirement.Value)</dd>
                                    }
                                    @if (Model.IsCurrentUserLead || Model.IsCurrentUserCampAdmin)
                                    {
                                        <dt>@Localizer["Camps_Details_Containers"]</dt>
                                        <dd><a asp-controller="Container" asp-action="Index"
                                               asp-route-slug="@Model.Slug" asp-route-year="@season.Year">@Localizer["Camps_Edit_ManageContainers"]</a></dd>
                                    }
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <dl>
                                    @if (season.ElectricalGrid.HasValue)
                                    {
                                        <dt>@Localizer["Camps_ElectricalGridLabel"]</dt>
                                        <dd>@SharedLocalizer.EnumDisplay(season.ElectricalGrid.Value)</dd>
                                    }
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
                @* By name, not by path: the partial moved into the City Planning RCL's Views/Shared,
                   and a name lookup searches every application part. *@
                @await Html.PartialAsync("_PlacementHelpModal", placementSchedule)
            }
        }
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-link me-1"></i> @Localizer["Camps_Links_Header"]
            </div>
            <div class="card-body">
                @if (Model.Links.Count > 0)
                {
                    <div class="mb-3">
                        @foreach (var link in Model.Links)
                        {
                            var platform = PlatformDetector.Detect(link.Url);
                            <div class="mb-2">
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer">
                                    <i class="@platform.IconClass me-1"></i> @platform.Name
                                </a>
                            </div>
                        }
                    </div>
                }
                <hr />
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="Contact" asp-route-slug="@Model.Slug" class="btn btn-primary w-100">
                        <i class="fa-solid fa-envelope me-1"></i> @Localizer["Camps_ContactButton"]
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                       class="btn btn-outline-primary w-100">
                        <i class="fa-solid fa-envelope me-1"></i> @Localizer["Camps_ContactLoginHint"]
                    </a>
                    @* Gate on the camp, not the viewer: Model.Membership is always NoOpenSeason on this anonymous
                       branch. An Active or Full season *for the active event* is what renders the membership card
                       and what RequestCampMembership accepts; dropping the event would promise a join the mutation
                       rejects. The events half is hedged rather than gated, to avoid a cross-section read. *@
                    var loginShowsMore =
                        Model.CurrentSeason is { Status: CampSeasonStatus.Active or CampSeasonStatus.Full }
                        && Model.IsActiveEventSeason;
                    <p class="small text-muted text-center mt-2 mb-0">
                        @(loginShowsMore
                            ? Localizer["Camps_ContactLoginDetailOpenSeason"]
                            : Localizer["Camps_ContactLoginDetail"])
                    </p>
                }
            </div>
        </div>

        @if (Model.TimesAtNowhere > 0)
        {
            <div class="card mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-fire fa-2x text-warning mb-2"></i>
                    <h5>@Localizer["Camps_TimesParticipatingLabel"]: @Model.TimesAtNowhere</h5>
                </div>
            </div>
        }

        <partial name="_CampRolesCard" model="Model" />

        @* My membership (authenticated only — never shown to anonymous visitors) *@
        @if (User.Identity?.IsAuthenticated == true && Model.Membership.Status != CampMemberStatusSummaryView.NoOpenSeason)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-campground me-1"></i> @Localizer["Camps_Details_MyMembership"]
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">
                        @Localizer["Camps_Details_MembershipHelp"]
                    </p>
                    @switch (Model.Membership.Status)
                    {
                        case CampMemberStatusSummaryView.None:
                            @if (Model.IsCurrentUserLead)
                            {
                                @* Leads are part of the camp by definition — don't prompt them to "request to join". *@
                                <div class="alert alert-info py-2 mb-0">
                                    <i class="fa-solid fa-user-shield me-1"></i>
                                    @Localizer["Camps_Details_LeadForSeason", membershipYear]
                                </div>
                            }
                            else
                            {
                                @* Full is informational only — it tells visitors the camp looks full, it
                                   does not block a request. Humans doesn't yet know everyone actually in
                                   the camp, so people still need to be able to request/join. *@
                                @if (Model.CurrentSeason is { Status: CampSeasonStatus.Full } && Model.IsActiveEventSeason)
                                {
                                    <div class="alert alert-secondary py-2 mb-2">
                                        <i class="fa-solid fa-circle-info me-1"></i>
                                        @Localizer["Camps_Details_FullSeason", membershipYear]
                                    </div>
                                }
                                <form asp-controller="Camp" asp-action="RequestMembership" asp-route-slug="@Model.Slug" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i class="fa-solid fa-hand me-1"></i> @Localizer["Camps_Details_RequestJoin", membershipYear]
                                    </button>
                                </form>
                            }
                            break;
                        case CampMemberStatusSummaryView.Pending:
                            <div class="d-grid gap-2">
                                <div class="alert alert-warning py-2 mb-0">
                                    <i class="fa-solid fa-hourglass-half me-1"></i> @Localizer["Camps_Details_PendingApproval", membershipYear]
                                </div>
                                <form asp-controller="Camp" asp-action="WithdrawMembershipRequest" asp-route-slug="@Model.Slug" asp-route-campMemberId="@Model.Membership.CampMemberId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary w-100" data-confirm="@Localizer["Camps_Details_WithdrawConfirm"]">
                                        <i class="fa-solid fa-xmark me-1"></i> @Localizer["Camps_Details_WithdrawRequest"]
                                    </button>
                                </form>
                            </div>
                            break;
                        case CampMemberStatusSummaryView.Active:
                            <div class="d-grid gap-2">
                                <div class="alert alert-success py-2 mb-0">
                                    <i class="fa-solid fa-check me-1"></i> @Localizer["Camps_Details_ActiveMembership", membershipYear]
                                </div>
                                <form asp-controller="Camp" asp-action="LeaveMembership" asp-route-slug="@Model.Slug" asp-route-campMemberId="@Model.Membership.CampMemberId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning w-100" data-confirm="@Localizer["Camps_Details_LeaveConfirm"]">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i> @Localizer["Camps_Details_LeaveCamp"]
                                    </button>
                                </form>
                            </div>
                            break;
                    }
                </div>
            </div>
        }

        @if (Model.IsCurrentUserLead || Model.IsCurrentUserCampAdmin)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-gear me-1"></i> @SharedLocalizer["TeamDetail_Actions"]
                </div>
                <div class="card-body d-grid gap-2">
                    <a asp-action="Edit" asp-route-slug="@Model.Slug" class="btn btn-outline-primary">
                        <i class="fa-solid fa-pen-to-square me-1"></i>
                        @if (Model.IsCurrentUserLead)
                        {
                            <text>@Localizer["Camps_Details_EditAndAssignRoles", Localizer["Camps_Singular"].Value]</text>
                        }
                        else
                        {
                            <text>Edit @Localizer["Camps_Singular"]</text>
                        }
                    </a>
                    <a asp-controller="Events" asp-action="MySubmissions" class="btn btn-outline-primary">
                        <i class="fa-solid fa-calendar-days me-1"></i> @Localizer["Camps_Details_ManageEvents"]
                    </a>
                    @if (Model.CurrentSeason != null)
                    {
                        var s = Model.CurrentSeason;
                        @if (Model.IsCurrentUserLead && (s.Status == CampSeasonStatus.Pending || s.Status == CampSeasonStatus.Active))
                        {
                            <form asp-controller="Camp" asp-action="Withdraw" asp-route-slug="@Model.Slug" asp-route-seasonId="@s.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning w-100" data-confirm="@Localizer["Camps_Details_WithdrawSeasonConfirm"]">
                                    <i class="fa-solid fa-right-from-bracket me-1"></i> @Localizer["Camps_Details_WithdrawSeason"]
                                </button>
                            </form>
                        }
                        @if ((Model.IsCurrentUserLead || Model.IsCurrentUserCampAdmin) && s.Status == CampSeasonStatus.Active)
                        {
                            <form asp-controller="Camp" asp-action="MarkFull" asp-route-slug="@Model.Slug" asp-route-seasonId="@s.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning w-100" data-confirm="@Localizer["Camps_Details_MarkFullConfirm"]">
                                    <i class="fa-solid fa-ban me-1"></i> @Localizer["Camps_Details_MarkFull"]
                                </button>
                            </form>
                        }
                        @if (Model.IsCurrentUserCampAdmin && (s.Status == CampSeasonStatus.Withdrawn || s.Status == CampSeasonStatus.Full))
                        {
                            <form asp-controller="CampAdmin" asp-action="Reactivate" asp-route-seasonId="@s.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnSlug" value="@Model.Slug" />
                                <button type="submit" class="btn btn-outline-success w-100">
                                    <i class="fa-solid fa-rotate-left me-1"></i> Reactivate Season
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>
