@model Humans.Camps.Models.CampEditViewModel
@{
    ViewData["Title"] = $"{Localizer["Camp_Edit_MembersRolesHeading"]} — {Model.Name}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@SharedLocalizer["Camp_Plural"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-slug="@Model.Slug">@Model.Name</a></li>
        <li class="breadcrumb-item"><a asp-action="Edit" asp-route-slug="@Model.Slug">@SharedLocalizer["Common_Edit"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Camps_Members_Members"]</li>
    </ol>
</nav>

<h1 class="mb-4">@Localizer["Camp_Edit_MembersRolesHeading"] — @Model.Name <small class="text-muted">(@Model.Year)</small></h1>


<div class="row">
    <div class="col-md-8">
        @if (Model.RolesPanel is not null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-list-check me-1"></i> @Localizer["Camps_Members_Roles"] (@Model.Year)
                </div>
                <div class="card-body">
                    @if (Model.RolesPanel.Rows.Count == 0)
                    {
                        <p class="text-muted small mb-0">
                            @Localizer["Camp_Members_NoRolesDefined"]
                            @if (Model.RolesPanel.CanManage)
                            {
                                <text>@Localizer["Camp_Members_NoRolesAdminHint"] <a asp-controller="CampAdmin" asp-action="Roles">@Localizer["Camp_Members_NoRolesAdminHintLink"]</a>.</text>
                            }
                        </p>
                    }
                    else
                    {
                        @foreach (var role in Model.RolesPanel.Rows)
                        {
                            <div class="mb-3">
                                @{
                                    var descId = $"role-desc-{role.DefinitionId:N}";
                                    var addId = $"role-add-{role.DefinitionId:N}";
                                }
                                <h6 class="mb-1">
                                    @role.Name
                                    @if (role.MinimumRequired > 0)
                                    {
                                        <span class="badge bg-secondary">@Localizer["Camp_Members_RoleRequiredBadge"]</span>
                                    }
                                    <small class="text-muted">@Localizer["Camp_Members_RoleSlotsFilled", role.CurrentCount, role.SlotCount]</small>
                                    @if (role.OverCapacity)
                                    {
                                        <span class="badge bg-warning text-dark" title="@Localizer["Camp_Members_RoleOverCapacityTitle"]">@Localizer["Camp_Members_RoleOverCapacityBadge"]</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(role.Description))
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline text-muted"
                                                data-bs-toggle="collapse" data-bs-target="#@descId"
                                                aria-expanded="false" aria-controls="@descId" title="@Localizer["Camps_Members_ShowDescription"]">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </button>
                                    }
                                    @if (Model.RolesPanel.CanManage && role.EmptySlotCount > 0)
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline text-success"
                                                data-bs-toggle="collapse" data-bs-target="#@addId"
                                                aria-expanded="false" aria-controls="@addId" title="@Localizer["Camps_Members_AddToRole"]">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    }
                                </h6>
                                @if (!string.IsNullOrWhiteSpace(role.Description))
                                {
                                    <div class="collapse" id="@descId">
                                        <div class="text-muted small mb-2">@Html.SanitizedMarkdown(role.Description)</div>
                                    </div>
                                }

                                @if (role.FilledSlots.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        @foreach (var slot in role.FilledSlots)
                                        {
                                            <div class="d-inline-flex align-items-center gap-2 border rounded-pill px-3 py-2">
                                                <vc:human user-id="@slot.UserId" layout="AvatarName" size="56" />
                                                @if (Model.RolesPanel.CanManage)
                                                {
                                                    <form asp-action="UnassignRole" asp-route-slug="@Model.Slug" asp-route-assignmentId="@slot.AssignmentId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-0 lh-1" title="@Localizer["Camps_Members_RemoveAssignment"]" data-confirm="@Localizer["Camps_Members_RemoveAssignmentConfirm"]">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (Model.RolesPanel.CanManage && role.EmptySlotCount > 0)
                                {
                                    var alreadyInRole = role.FilledSlots.Select(s => s.UserId).ToList();
                                    <div class="collapse mt-2" id="@addId">
                                        <form asp-action="AssignRoleByUser" asp-route-slug="@Model.Slug" method="post" class="d-flex gap-2" style="max-width: 22rem;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="roleDefinitionId" value="@role.DefinitionId" />
                                            <vc:human-search field-name="userId"
                                                             instance-key="@($"role-{role.DefinitionId:N}")"
                                                             placeholder="@SharedLocalizer["Search_Title"].Value"
                                                             exclude-user-ids="@alreadyInRole"
                                                             scope="Name" />
                                            <button class="btn btn-sm btn-outline-primary" type="submit" title="@Localizer["Camps_Members_AssignHelp"]">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }

    </div>

    <div class="col-md-4">
        @if (Model.RolesPanel is not null && Model.RolesPanel.CanManage)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-user-plus me-1"></i> @Localizer["Camps_Members_AddActiveMember"]
                </div>
                <div class="card-body">
                    <form asp-action="AddMember" asp-route-slug="@Model.Slug" method="post" class="input-group">
                        @Html.AntiForgeryToken()
                        <vc:human-search field-name="userId" scope="Name" placeholder="@SharedLocalizer["Search_Title"].Value" />
                        <button type="submit" class="btn btn-outline-success" title="@Localizer["Camps_Members_AddActiveMember"]">
                            <i class="fa-solid fa-user-plus"></i>
                        </button>
                    </form>
                    <div class="form-text">@Localizer["Camp_Members_AddMemberSearchHelp"]</div>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-users-gear me-1"></i> @Localizer["Camps_Members_SeasonHumans"] (@Model.Year)
            </div>
            <div class="card-body p-0">
                <div class="px-3 py-2">
                    <strong class="text-muted small">@Localizer["Camps_Members_PendingRequests"] (@Model.PendingMembers.Count)</strong>
                </div>
                @if (Model.PendingMembers.Count == 0)
                {
                    <div class="px-3 pb-2 text-muted small fst-italic">@Localizer["Camp_Members_NoPendingRequests"]</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var pending in Model.PendingMembers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <vc:human user-id="@pending.UserId" />
                                <div class="d-flex gap-2">
                                    @* Defense-in-depth: only render approve/reject for Pending; service-side guard still applies. *@
                                    @if (pending.Status == CampMemberStatus.Pending)
                                    {
                                        <form asp-action="ApproveMembership" asp-route-slug="@Model.Slug" asp-route-campMemberId="@pending.CampMemberId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="@Localizer["Camps_Members_Approve"]">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        </form>
                                        <form asp-action="RejectMembership" asp-route-slug="@Model.Slug" asp-route-campMemberId="@pending.CampMemberId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Camps_Members_Reject"]" data-confirm="@Localizer["Camps_Members_RejectConfirm"]">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                <div class="px-3 pt-3 pb-2 d-flex justify-content-between align-items-center gap-2">
                    <strong class="text-muted small">@Localizer["Camps_Members_ActiveHumans"] (@Model.ActiveMembers.Count)</strong>
                    <span class="badge bg-light text-dark border" title="@Localizer["Camps_Members_EeSlotsHelp", Model.Year]">
                        EE: @Model.EeGrantedCount/@Model.EeSlotCount
                    </span>
                </div>
                @if (Model.ActiveMembers.Count == 0)
                {
                    <div class="px-3 pb-2 text-muted small fst-italic">@Localizer["Camp_Details_RosterEmpty"]</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var active in Model.ActiveMembers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <vc:human user-id="@active.UserId" />
                                    <span class="badge rounded-pill @active.EventShiftSignupBadgeClass"
                                          title="@Localizer["Camp_ShiftSignupBadgeTitle"]"
                                          aria-label="@Localizer["Camp_ShiftSignupBadgeAriaLabel", active.EventShiftSignupCount]">
                                        @active.EventShiftSignupDisplay
                                    </span>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    @{
                                        var canGrant = Model.EeGrantedCount < Model.EeSlotCount;
                                        var eeDisabled = !active.HasEarlyEntry && !canGrant;
                                    }
                                    <form method="post" asp-action="SetMemberEarlyEntry"
                                          asp-route-slug="@Model.Slug" asp-route-campMemberId="@active.CampMemberId"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="granted" value="@((!active.HasEarlyEntry).ToString().ToLowerInvariant())" />
                                        <button type="submit"
                                                class="btn btn-sm @(active.HasEarlyEntry ? "btn-success" : "btn-outline-secondary")"
                                                title="@(active.HasEarlyEntry ? Localizer["Camps_Members_RevokeEarlyEntry"] : Localizer["Camps_Members_GrantEarlyEntry"])"
                                                @(eeDisabled ? "disabled" : "")>
                                            @(active.HasEarlyEntry ? "✓ EE" : Localizer["Camps_Members_GrantEe"].Value)
                                        </button>
                                    </form>
                                    <form asp-action="RemoveMembership" asp-route-slug="@Model.Slug" asp-route-campMemberId="@active.CampMemberId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="@SharedLocalizer["Common_Remove"]" data-confirm="@Localizer["Camps_Members_RemoveHumanConfirm"]">
                                            <i class="fa-solid fa-user-minus"></i>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
                <div class="card-body border-top">
                    <small class="text-muted">
                        @Localizer["Camps_Members_RecordHelp"]
                    </small>
                </div>
            </div>
        </div>

    </div>
</div>
