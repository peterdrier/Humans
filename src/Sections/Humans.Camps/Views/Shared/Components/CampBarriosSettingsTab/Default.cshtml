@model CampBarriosSettingsViewModel

@* Explicit asp-controller/asp-action: inside /Settings, ambient route data would resolve "OpenSeason"/"CloseSeason"
   against the wrong controller. *@
<h6>Camp registration by event</h6>
@if (Model.Events.Count == 0)
{
    <empty-state>No events yet. Create one on the Events tab.</empty-state>
}
else
{
    <table class="table table-sm align-middle">
        <tbody>
            @foreach (var ev in Model.Events)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>
                        @if (ev.RegistrationOpen)
                        {
                            <span class="badge bg-success">Open</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-controller="CampAdmin" asp-action="@(ev.RegistrationOpen ? "CloseSeason" : "OpenSeason")"
                              asp-route-eventSettingsId="@ev.EventSettingsId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (ev.RegistrationOpen)
                            {
                                <button type="submit" class="btn btn-outline-warning btn-sm">
                                    <i class="fa-solid fa-door-closed me-1"></i>Close
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    <i class="fa-solid fa-door-open me-1"></i>Open
                                </button>
                            }
                        </form>
                    </td>
                </tr>
                <tr>
                    <td colspan="3" class="border-top-0 pt-0">
                        <form asp-controller="CampAdmin" asp-action="RegistrationInfo"
                              asp-route-eventSettingsId="@ev.EventSettingsId" method="post">
                            @Html.AntiForgeryToken()
                            <label class="form-label small text-muted" for="registration-info-@ev.EventSettingsId">
                                Registration info: Markdown shown at the top of the Register page while this event takes registrations. Leave empty to hide.
                            </label>
                            <textarea id="registration-info-@ev.EventSettingsId" name="registrationInfo"
                                      class="form-control form-control-sm mb-2" rows="3">@ev.RegistrationInfo</textarea>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-save me-1"></i>Save
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
