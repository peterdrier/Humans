@model CampComplianceViewModel
@{
    ViewData["Title"] = $"Barrio role compliance — {Model.Event.EventName}";

    Func<CampComplianceRow, IHtmlContent> barrioCell = @<text>
        <a asp-controller="Camp" asp-action="Details" asp-route-slug="@item.CampSlug">@item.CampName</a>
        @if (item.IsBelowMinimum)
        {
            <i class="fa-solid fa-triangle-exclamation text-warning ms-1" title="Missing one or more required roles"></i>
        }
    </text>;
    Func<CampComplianceRow, IHtmlContent> sizeCell =
        @<text>@item.JoinedMemberCount<span class="text-muted">/@item.TargetMemberCount</span></text>;
    var builder = TableModel.For(Model.Rows)
        .Template("Barrio", barrioCell, o => o.Css("text-nowrap"), sortBy: r => r.CampName)
        .Template("Size", sizeCell, o => o.Css("text-center text-nowrap").HeaderCss("text-center text-nowrap"), sortBy: r => r.JoinedMemberCount);
    for (var roleIndex = 0; roleIndex < Model.Roles.Count; roleIndex++)
    {
        var index = roleIndex;
        var role = Model.Roles[index];
        Func<CampComplianceRow, IHtmlContent> roleCell = @<text>
            <div class="d-flex flex-wrap gap-1 justify-content-center">
                @foreach (var userId in item.Cells[index].AssigneeUserIds)
                {
                    <vc:human user-id="@userId" layout="Card" size="64" link="Public" />
                }
                @for (var i = 0; i < item.Cells[index].Shortfall; i++)
                {
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-warning"
                          style="width: 64px; height: 64px; border: 2px dashed var(--bs-warning);"
                          title="Required role unfilled">
                        <i class="fa-solid fa-user-plus fa-lg"></i>
                    </span>
                }
                @if (item.Cells[index].AssigneeUserIds.Count == 0 && item.Cells[index].MinimumRequired == 0)
                {
                    <span class="text-muted">&mdash;</span>
                }
            </div>
        </text>;
        builder.Template(role.MinimumRequired > 0 ? $"{role.Name} (min {role.MinimumRequired})" : role.Name,
            roleCell, o => o.Css("text-center").HeaderCss("text-center"),
            sortBy: r => r.Cells[index].AssigneeUserIds.Count);
    }
    var table = builder.Css("align-middle").Build();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Camp" asp-action="Index">@SharedLocalizer["Camp_Plural"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="CampAdmin" asp-action="Index">Admin</a></li>
        <li class="breadcrumb-item active" aria-current="page">Compliance</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Barrio role compliance &mdash; @Model.Event.EventName</h1>
    <form asp-controller="CampCompliance" asp-action="Compliance" method="get" class="d-flex gap-2 align-items-center">
        <label for="eventSettingsId" class="form-label mb-0 text-nowrap">Event</label>
        <select id="eventSettingsId" name="eventSettingsId" class="form-select form-select-sm" style="max-width: 220px;">
            @foreach (var option in Model.EventOptions)
            {
                if (option.EventSettingsId == Model.Event.EventSettingsId)
                {
                    <option value="@option.EventSettingsId" selected>@option.EventName</option>
                }
                else
                {
                    <option value="@option.EventSettingsId">@option.EventName</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-arrows-rotate me-1"></i>Show
        </button>
    </form>
</div>


@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info me-1"></i>
        No active barrios for @Model.Event.EventName.
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="fa-solid fa-people-group"></i>
            <span>@Model.BarrioCount active barrio(s)</span>
            @if (Model.NonCompliantCount > 0)
            {
                <span class="badge bg-warning text-dark ms-auto">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.NonCompliantCount missing required roles
                </span>
            }
            else
            {
                <span class="badge bg-success ms-auto">
                    <i class="fa-solid fa-circle-check me-1"></i>All required roles filled
                </span>
            }
        </div>
        <partial name="_Table" model="table" />
    </div>
}
