<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Events.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\..\Humans.Application\Humans.Application.csproj" />
    <!--
      EventsController derives from Humans.Camps' HumansCampControllerBase so Workshop Leads
      can submit camp events. The base could not stay in Humans.UI once ICampServiceRead moved
      onto a section leaf (Humans.UI may not reference a section at any price), and it derives
      from HumansControllerBase, which lives in Humans.UI — a project no .Contracts leaf may
      reference. So it lives under the section's Contracts/ folder and consumers take the section
      project (Teams' HumansTeamControllerBase shape). Acyclic: Humans.Camps names nothing of
      Events. (This comment previously said "IActionResult, which the framework-free leaf cannot
      name". G5 lane 3c measured that false — Humans.Camps.Contracts references Humans.Interfaces,
      which carries FrameworkReference Microsoft.AspNetCore.App, and that flows transitively. The
      base class's home in Humans.UI is the real constraint; the placement is unchanged.)
    -->
    <ProjectReference Include="..\Humans.Camps\Humans.Camps.csproj" />
    <!--
      Calendar owns the personal iCal feed; EventService implements its
      ICalendarFeedContributor. Calendar's Contracts/ is a folder, not a leaf, so the
      reference is to the section project — acyclic because the contributor fan-out
      inverts the arrow: Calendar names no section but Users.Contracts
      (nobodies-collective/Humans#866, G5 lane 4b-2c).
    -->
    <ProjectReference Include="..\Humans.Calendar\Humans.Calendar.csproj" />
    <ProjectReference Include="..\Humans.Events.Contracts\Humans.Events.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
