@model Humans.Events.ViewComponents.EventsGalleryViewModel

@* The wg-* classes are the gallery page's (Debug's /Debug/WidgetGallery); this renders inside its
   ChromeSlots.WidgetGallery slot, so the section owns its own cards and Debug names nothing here. *@

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent ParamsBlock(params (string Name, string Description)[] entries)
    {
        var html = new System.Text.StringBuilder();
        html.Append("<dl class=\"wg-params\">");
        if (entries.Length == 0)
        {
            html.Append("<dd class=\"wg-params-none\">(no parameters — uses ambient request context)</dd>");
        }
        else
        {
            foreach (var (name, desc) in entries)
            {
                html.Append($"<dt>{System.Net.WebUtility.HtmlEncode(name)}</dt><dd>{desc}</dd>");
            }
        }
        html.Append("</dl>");
        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }

    private static Microsoft.AspNetCore.Html.IHtmlContent AuthLine(string text)
    {
        return new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"wg-auth-line\">{text}</div>");
    }
}

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">EventsSearchResultViewComponent.cs</span>
            <span class="wg-card-kind kind-vc">ViewComponent</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Events/ViewComponents/EventsSearchResultViewComponent.cs</span>
    </div>
    <div class="wg-card-note">One event-search result row (<code>&lt;vc:events-search-result&gt;</code>), keyed by event id. Events builds the <code>/Events/Browse?q=</code> link itself, since there is no single-event page. The component has no feature check of its own — callers gate on <code>Features:Events</code>, as this card and <code>/Search</code> both do. Renders nothing when the id is not an approved event.</div>
    @ParamsBlock(
        ("event-id", "<code>Guid</code> — the matched approved event")
    )
    <div class="wg-card-example">
        @if (Model.EventId is { } eventId)
        {
            <div class="list-group">
                <vc:events-search-result event-id="@eventId" />
            </div>
        }
        else
        {
            <div class="text-muted small">No approved event to key the row from, or <code>Features:Events</code> is off.</div>
        }
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">&lt;vc:events-card&gt;</span>
            <span class="wg-card-kind kind-vc">ViewComponent</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Events/ViewComponents/EventsCardViewComponent.cs</span>
    </div>
    <div class="wg-card-note">
        Not rendered here: it needs a live camp id (or user id) whose approved events exist in the current edition,
        self-gates to authenticated viewers, and hides entirely when the <code>Features:Events</code> flag is off.
        See a barrio detail page under <a href="/Barrios">/Barrios</a> or a <a href="/Profile/Me">profile</a>.
    </div>
    @ParamsBlock(
        ("camp-id", "<code>Guid?</code> — the camp whose approved events to list"),
        ("user-id", "<code>Guid?</code> — or the person whose events to list")
    )
</div>
