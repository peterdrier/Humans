@* Links to Browse filtered to the title: there is no single-event detail page. *@
@model Humans.Events.ViewComponents.EventsSearchResultViewModel

<a href="/Events/Browse?q=@Uri.EscapeDataString(Model.Title)" class="list-group-item list-group-item-action">
    <div class="d-flex align-items-start gap-3">
        <div class="d-flex align-items-center justify-content-center rounded bg-light"
             style="width: 40px; height: 40px; flex-shrink: 0;">
            <i class="fa-solid fa-calendar-day text-muted"></i>
        </div>
        <div class="flex-grow-1">
            <strong>@Model.Title</strong>
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <div class="small text-muted">@Model.CategoryName</div>
            }
        </div>
    </div>
</a>
