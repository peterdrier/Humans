@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error. *@
@using Humans.Events
@using Humans.Events.Contracts
@using Humans.Events.Domain
@using Humans.Events.Helpers
@using Humans.Events.Models
@using Humans.Events.Services
@using Humans.Events.Services.Dtos
@using Humans.Base.Extensions
@using Humans.Base
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EventsResource> Localizer
@* Shared strings (Common_*, Camp_Plural) come from SharedLocalizer explicitly, so the set a key comes from is
   visible at the call site. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@addTagHelper *, Humans.Events
