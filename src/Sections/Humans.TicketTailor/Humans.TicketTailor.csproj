<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.TicketTailor.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Adapter section: one implementation of Humans.Tickets' ITicketVendorService port. No
      tables, no controllers, no views, so plain Microsoft.NET.Sdk. The direct reference to
      Humans.Tickets (the owner, not a leaf) is sanctioned and acyclic: Tickets names nothing
      here, and only Section.Register binds the adapter (nobodies-collective/Humans#866).
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Tickets\Humans.Tickets.csproj" />
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore PackageReference: those ship with no PackageVersion and fail NU1010 under
      Central Package Management. IHttpClientFactory arrives via the FrameworkReference.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation; keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
