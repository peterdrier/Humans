@model GuestDashboardViewModel
@{
    ViewData["Title"] = SharedLocalizer["Dashboard_Title"].Value;
}

<div class="row justify-content-center mb-4">
    <div class="col-lg-8 text-center">
        <h1 class="mb-1">@Html.Raw(string.Format(Localizer["Onboarding_GuestGreeting"].Value, Html.Encode(Model.DisplayName)))</h1>
        <p class="text-muted">@Localizer["Onboarding_GuestSubtitle"]</p>
    </div>
</div>


<div class="row justify-content-center mb-5">
    <div class="col-lg-8">
        <div class="card border-0 shadow dashboard-callout">
            <div class="card-body text-center py-5 px-4">
                <h2 class="display-5 fw-bold mb-3 dashboard-callout-title">@Localizer["Onboarding_GuestGetInvolvedTitle"]</h2>
                <p class="mb-2 dashboard-callout-copy">
                    @Localizer["Onboarding_GuestGetInvolvedDescription"]
                </p>
                <ul class="list-unstyled mb-2 dashboard-callout-copy">
                    <li>@Localizer["Onboarding_GuestGetInvolvedBullet1"]</li>
                    <li>@Localizer["Onboarding_GuestGetInvolvedBullet2"]</li>
                    <li>@Localizer["Onboarding_GuestGetInvolvedBullet3"]</li>
                </ul>
                <p class="mb-3 dashboard-callout-muted">
                    <small>@Localizer["Onboarding_GuestGetInvolvedHint"]</small>
                </p>
                <a asp-controller="Profile" asp-action="Edit" class="btn btn-lg px-5 dashboard-callout-primary">
                    <i class="fa-solid fa-arrow-right me-2"></i>@Localizer["Onboarding_GuestCreateProfile"]
                </a>
            </div>
        </div>
    </div>
</div>

@* Tickets contributes the order summary here; renders nothing without an order.
   ChromeSlotViewComponent is Shell-resident (Humans.Web) — a section RCL cannot
   @addTagHelper it, so invoke by name (design §15 step 6). *@
@await Component.InvokeAsync("ChromeSlot", new { name = "guest-page" })

<div class="row justify-content-center mb-5">
    <div class="col-lg-8">
        <h5 class="text-muted mb-1">@Localizer["Onboarding_GuestExplore"]</h5>
        <p class="text-muted small mb-3 guest-section-sub">@Localizer["Onboarding_GuestExploreSubtitle"]</p>
        <div class="row g-3">
            @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
            {
                Controller = "Camp",
                Action = "Index",
                Title = SharedLocalizer["Camp_Plural"].Value,
                Description = Localizer["Onboarding_GuestBarriosDescription"].Value,
                IconCssClass = "fa-solid fa-campground fa-lg",
                ColumnClass = "col-sm-4"
            })
            @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
            {
                Controller = "Team",
                Action = "Index",
                Title = SharedLocalizer["Nav_Teams"].Value,
                Description = Localizer["Onboarding_GuestTeamsDescription"].Value,
                IconCssClass = "fa-solid fa-people-group fa-lg",
                ColumnClass = "col-sm-4"
            })
            @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
            {
                Controller = "Legal",
                Action = "Index",
                Title = Localizer["Onboarding_GuestLegal"].Value,
                Description = Localizer["Onboarding_GuestLegalDescription"].Value,
                IconCssClass = "fa-solid fa-scale-balanced fa-lg",
                ColumnClass = "col-sm-4"
            })
        </div>
    </div>
</div>

<div class="row justify-content-center mb-4">
    <div class="col-lg-8">
        <h5 class="text-muted mb-1">@Localizer["Onboarding_GuestAccountTitle"]</h5>
        <p class="text-muted small mb-3 guest-section-sub">@Localizer["Onboarding_GuestAccountSubtitle"]</p>
        <div class="row g-3">
            @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
            {
                Controller = "GuestAccount",
                Action = "CommunicationPreferences",
                Title = Localizer["Onboarding_GuestCommsTitle"].Value,
                Description = Localizer["Onboarding_GuestCommsDescription"].Value,
                IconCssClass = "fa-solid fa-bell",
                IconVariant = "info",
                Compact = true
            })
            @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
            {
                Controller = "GuestData",
                Action = "DownloadData",
                Title = Localizer["Onboarding_GuestDataTitle"].Value,
                Description = Localizer["Onboarding_GuestDataDescription"].Value,
                IconCssClass = "fa-solid fa-download",
                IconVariant = "info",
                Compact = true
            })
            @if (!Model.IsDeletionPending)
            {
                @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
                {
                    Controller = "GuestAccount",
                    Action = "RequestDeletion",
                    Title = Localizer["Onboarding_GuestDeleteTitle"].Value,
                    Description = Localizer["Onboarding_GuestDeleteDescription"].Value,
                    IconCssClass = "fa-solid fa-trash-can",
                    IconVariant = "danger",
                    Compact = true,
                    IsPost = true,
                    ConfirmMessage = Localizer["Onboarding_GuestDeleteAccountConfirm"].Value
                })
            }
        </div>
    </div>
</div>

@if (Model.IsDeletionPending)
{
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="card border-warning shadow-sm">
                <div class="card-body d-flex align-items-start py-3">
                    <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-warning me-3 mt-1">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-1">@Localizer["Onboarding_GuestDeletionPendingTitle"]</h6>
                        <p class="mb-1 small text-muted">
                            @Html.Raw(string.Format(Localizer["Onboarding_GuestDeletionRequestedOn"].Value, "<strong>" + Html.Encode(Model.DeletionRequestedAt?.ToDate()) + "</strong>"))
                        </p>
                        @if (Model.DeletionEligibleAfter.HasValue && Model.DeletionEligibleAfter > Model.DeletionScheduledFor)
                        {
                            <p class="mb-2 small text-muted">
                                @Html.Raw(string.Format(Localizer["Onboarding_GuestDeletionHeldUntil"].Value, "<strong>" + Html.Encode(Model.DeletionEligibleAfter?.ToDate()) + "</strong>"))
                            </p>
                        }
                        else
                        {
                            <p class="mb-2 small text-muted">
                                @Html.Raw(string.Format(Localizer["Onboarding_GuestDeletionScheduledFor"].Value, "<strong>" + Html.Encode(Model.DeletionScheduledFor?.ToDate()) + "</strong>"))
                            </p>
                        }
                        <form asp-controller="GuestAccount" asp-action="CancelDeletion" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="fa-solid fa-rotate-left me-1"></i>@Localizer["Onboarding_GuestDeletionCancelButton"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

