@using Microsoft.AspNetCore.Mvc.Localization
@* The banner's two keys live in OnboardingResource, not SharedResource — binding the shared
   set renders them as their own names on every authenticated page. *@
@inject IHtmlLocalizer<OnboardingResource> BannerLocalizer
@model Humans.Onboarding.ViewComponents.OnboardingProgressBannerViewModel
@if (Model.Show)
{
    <div class="alert alert-info mb-0 rounded-0 text-center">
        @BannerLocalizer["Onboarding_BannerText"]
        <a href="@Url.Action("Index", "OnboardingWidget")" class="alert-link ms-2">
            @BannerLocalizer["Onboarding_BannerCta"]
        </a>
    </div>
}
