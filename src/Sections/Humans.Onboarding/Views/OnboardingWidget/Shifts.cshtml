@model ShiftsStepViewModel
@{
    ViewData["Title"] = Localizer["Onboarding_ShiftsTitle"].Value;
    var hasShifts = Model.EventSettings is not null && Model.Shifts.Count > 0;
    var selected = Model.SelectedPriority;
    string PillCss(string key) =>
        selected == key ? "btn btn-sm btn-danger" : "btn btn-sm btn-outline-secondary";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="mb-2">@Localizer["Onboarding_ShiftsTitle"]</h1>

            @if (Model.HasAnyCritical)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>@Localizer["Onboarding_ShiftsCriticalHeading"]</strong> @Localizer["Onboarding_ShiftsCriticalBody", Model.CriticalFilledPercent ?? 0]
                    @if (Model.HasAnyImportant)
                    {
                        <div class="mt-2 mb-0">@Localizer["Onboarding_ShiftsImportantAlsoOpen", Model.ImportantOpenCount]</div>
                    }
                    <div class="mt-2 mb-0">@(Model.EarlyEntrySignupsClosed
                        ? Localizer["Onboarding_ShiftsCriticalCtaSetupClosed"]
                        : Localizer["Onboarding_ShiftsCriticalCta"])</div>
                </div>
            }
            else if (Model.HasAnyImportant)
            {
                <div class="alert alert-warning" role="alert">
                    @(Model.EarlyEntrySignupsClosed
                        ? Localizer["Onboarding_ShiftsImportantBodySetupClosed", Model.ImportantOpenCount]
                        : Localizer["Onboarding_ShiftsImportantBody", Model.ImportantOpenCount])
                </div>
            }

            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <div class="btn-group" role="group" aria-label="Shift priority filter">
                    <a asp-action="Shifts" asp-route-priority="critical" class="@PillCss("critical")">@Localizer["Onboarding_PriorityCritical"]</a>
                    <a asp-action="Shifts" asp-route-priority="important" class="@PillCss("important")">@Localizer["Onboarding_PriorityImportant"]</a>
                    <a asp-action="Shifts" asp-route-priority="all" class="@PillCss("all")">@SharedLocalizer["Shifts_All"]</a>
                </div>
                <form asp-action="Skip" method="post" class="d-inline ms-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        @Localizer["Onboarding_ShiftsNotNow"]
                    </button>
                </form>
            </div>


            @if (!hasShifts)
            {
                @* Empty-state — mirrors Shifts/BrowsingClosed. *@
                <div class="alert alert-info text-center my-4">
                    @if (Model.EventSettings is null)
                    {
                        <p class="mb-0">@Localizer["Onboarding_ShiftsNoActiveEvent"]</p>
                    }
                    else if (selected == "critical")
                    {
                        <p class="mb-0">@Localizer["Onboarding_ShiftsNoCritical"]</p>
                    }
                    else if (selected == "important")
                    {
                        <p class="mb-0">@Localizer["Onboarding_ShiftsNoImportant"]</p>
                    }
                    else
                    {
                        <p class="mb-0">@SharedLocalizer["Shifts_NoShiftsAvailable"]</p>
                    }
                </div>
            }
            else
            {
                @* Shifts' rota tables are Shell's presentation and Shifts has not moved, so the
                   component stays there and resolves by name across application parts — the
                   arguments are all Humans.Domain / Humans.Application types (design §15 step 6). *@
                @await Component.InvokeAsync("OnboardingShiftsList", new
                {
                    eventSettings = Model.EventSettings!,
                    shifts = Model.Shifts,
                    userSignupShiftIds = Model.UserSignupShiftIds,
                    userSignupStatuses = Model.UserSignupStatuses,
                    earlyEntrySignupsClosed = Model.EarlyEntrySignupsClosed,
                })
            }
        </div>
    </div>
</div>
