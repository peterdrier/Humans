@using Humans.Consent.ViewComponents
@model ConsentsStepViewModel
@{ ViewData["Title"] = Model.Document.DocumentName; }

<div class="row justify-content-center">
    <div class="col-lg-10">
        @await Component.InvokeAsync(typeof(ConsentSigningStepViewComponent), new
        {
            document = Model.Document,
            currentIndex = Model.CurrentIndex,
            totalRequired = Model.TotalRequired,
            returnUrl = Url.Action(nameof(OnboardingWidgetController.Index), "OnboardingWidget"),
        })
    </div>
</div>
