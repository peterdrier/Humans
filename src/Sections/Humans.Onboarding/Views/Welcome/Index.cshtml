@{
    ViewData["Title"] = Localizer["Onboarding_WelcomeTitle"].Value;
    var widgetUrl = Url.Action("Index", "OnboardingWidget");
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = widgetUrl });
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <section class="welcome-hero text-center">
            <div class="welcome-checkmark">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h1 class="welcome-heading">@Localizer["Onboarding_WelcomeHeading"]</h1>
            <p class="welcome-subtitle">@Localizer["Onboarding_WelcomeSubtitle"]</p>
        </section>

        <div class="welcome-shifts-card">
            <h2 class="welcome-shifts-title">@Localizer["Onboarding_WelcomeShiftsTitle"]</h2>
            <p class="welcome-shifts-body">@Localizer["Onboarding_WelcomeShiftsBody"]</p>
            <p class="welcome-shifts-body">@Localizer["Onboarding_WelcomeShiftsBody2"]</p>
        </div>

        <div class="text-center mb-3">
            <a href="@loginUrl" class="btn btn-primary btn-lg welcome-cta">
                <i class="fa-solid fa-right-to-bracket me-2"></i>@Localizer["Onboarding_WelcomeCTA"]
            </a>
        </div>

        @* Deliberately unlocalized (spec 2026-08-12): points external visitors at the
           English-only Tour page. *@
        <p class="text-center mb-3">
            <a href="/Tour">New here? See what Humans does &rarr;</a>
        </p>

        <p class="welcome-footer text-center">@Localizer["Onboarding_WelcomeFooter"]</p>

        <div class="welcome-contact text-center">
            <p>@Localizer["Onboarding_WelcomeContact"]
                <a href="mailto:hola@nobodies.team">hola@nobodies.team</a>
            </p>
        </div>

    </div>
</div>
