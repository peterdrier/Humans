@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error.

   Three localizers: the section's own keys, SharedResource (shared vocabulary and the Onboarding_*Label keys
   DataAnnotations resolves), and Consent's. A key looked up against the wrong one renders as its own name with
   a green build, so OnboardingLocalizerBindingTests checks every one. *@
@using Humans.Base.Extensions
@using Humans.Consent
@using Humans.Consent.Contracts
@using Humans.Base.Enums
@using Humans.Users.Contracts
@using Humans.Governance.Contracts
@using Humans.Onboarding
@using Humans.Onboarding.Controllers
@using Humans.Onboarding.Models
@using Humans.Base
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Humans.Base.ViewComponents
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OnboardingResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
