@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = $"{SharedLocalizer["SectionHelp_Guide"]} — {SharedLocalizer["Error_Title"]}";
}

<div class="row">
    <section class="col-md-9 offset-md-3">
        <h1>@SharedLocalizer["Error_SomethingWentWrong"]</h1>
        <p>@SharedLocalizer["Error_TryAgainLater"]</p>
        @* Not the Guide home: that re-enters the same content load and lands back here. *@
        <p><a asp-controller="Home" asp-action="Index">@SharedLocalizer["Common_ReturnHome"]</a></p>
    </section>
</div>
