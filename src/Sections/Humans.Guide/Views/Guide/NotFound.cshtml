@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = $"{SharedLocalizer["SectionHelp_Guide"]} — {SharedLocalizer["Error404_Title"]}";
}

<div class="row">
    <section class="col-md-9 offset-md-3">
        <h1>@SharedLocalizer["Error404_Title"]</h1>
        <p>@SharedLocalizer["Error404_Description"]</p>
        <p><a asp-controller="Guide" asp-action="Index">@SharedLocalizer["SectionHelp_Guide"]</a></p>
    </section>
</div>
