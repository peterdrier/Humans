<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Guide.Tests" />
    <!-- The one assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Guide owns no tables, so there is no DbContext, no repository and no AddSectionDbContext
      call. GuideSettings stays in Humans.Base/Configuration beside GitHubGuideContentSource,
      the shared GitHub-markdown connector Agent and Base read too.
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Auth\Humans.Auth.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Markdig renders the guide markdown and gives GuideSegmenter its block parse; AngleSharp
      parses the rendered HTML for GuideHtmlPostprocessor. No AspNetCore package: those ship with
      no PackageVersion on purpose and would fail the build with NU1010 under Central Package
      Management — IMemoryCache and IOptions arrive through the framework reference Sdk.Razor
      already adds. Octokit is for GitHubHealthCheck (nobodies-collective/Humans#1075).
    -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Octokit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation; keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
