<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Guide.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Guide owns no tables, so there is no DbContext, no repository and no AddSectionDbContext
      call (G5-SECTION-TEMPLATE.md step 1 / the Data-and-DbContext steps are skipped wholesale).
      Unlike Scanner — the other table-less section — Humans.Infrastructure is still referenced:
      GuideSettings binds Guide:* and is read by GitHubGuideContentSource, which stays in Base
      as a shared GitHub-markdown connector (three of its four consumers are not Guide's), so
      the settings type stays in Humans.Infrastructure/Configuration with it.
    -->
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\..\Humans.Application\Humans.Application.csproj" />
    <ProjectReference Include="..\..\Humans.Infrastructure\Humans.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Markdig renders the guide markdown; it moved out of Humans.Infrastructure with
      GuideRenderer, which was its only consumer there. No AspNetCore package: those ship with
      no PackageVersion on purpose and would fail the build with NU1010 under Central Package
      Management — IMemoryCache and IOptions arrive through the framework reference Sdk.Razor
      already adds. No EF Core either — the section owns no tables.
    -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
