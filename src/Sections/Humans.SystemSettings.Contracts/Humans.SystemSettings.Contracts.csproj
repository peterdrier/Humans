    memory/architecture/section-project-cycle-fix.md). References Humans.Interfaces
    only — the bottom of the graph — so Humans.Application can reference it freely.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
  </ItemGroup>

</Project>
