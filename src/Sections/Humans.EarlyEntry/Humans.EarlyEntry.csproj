<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.EarlyEntry.Tests" />
    <!-- The one assembly allowed to see many sections at once. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sdk.Web puts these in ImplicitUsings; Sdk.Razor does not. -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore PackageReference: NU1010 under Central Package Management. It arrives
      via the framework reference Sdk.Razor adds.
    -->
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the section's docs visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
