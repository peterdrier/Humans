<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Finance's cross-section surface, carved into its own leaf project because two of its
    consumers are still in Base: ExpenseReportService (Humans.Application) and
    HoldedSyncJob (Humans.Infrastructure/Jobs), so a Contracts/ *folder* inside
    Humans.Finance would make Base reference a section and cycle (design §15.5b,
    memory/architecture/section-project-cycle-fix.md). References Humans.Interfaces only —
    the bottom of the graph — so Humans.Application can reference it freely.

    That constraint is also why CreditorLedgerLine lives here rather than the Holded
    connector's HoldedLedgerLineDto: the connector stays in Base, this project cannot
    reference Base, and promoting the connector's DTO downward is the forbidden fix.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
