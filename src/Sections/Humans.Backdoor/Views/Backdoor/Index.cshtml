@model BackdoorKeysViewModel
@using NodaTime
@inject Humans.Base.Interfaces.IOrgTimeZone OrgTimeZone
@{
    ViewData["Title"] = Localizer["Backdoor_Title"];
    var orgZone = OrgTimeZone.Zone;

    string Stamp(Instant? at) => at is null
        ? Localizer["Backdoor_Never"]
        : at.Value.ToDateTime(orgZone);

    Func<BackdoorKeyListItem, IHtmlContent> keyCell = @<text><code>@item.DisplayPrefix…</code></text>;
    Func<BackdoorKeyListItem, IHtmlContent> createdCell = @<text>@Stamp(item.CreatedAt)</text>;
    Func<BackdoorKeyListItem, IHtmlContent> lastUsedCell = @<text>@Stamp(item.LastUsedAt)</text>;
    Func<BackdoorKeyListItem, IHtmlContent> expiresCell = @<text>@Stamp(item.ExpiresAt)</text>;
    Func<BackdoorKeyListItem, IHtmlContent> statusCell = @<text>
        @if (item.IsRevoked)
        {
            <span class="badge bg-secondary">@Localizer["Backdoor_Status_Revoked", Stamp(item.RevokedAt)]</span>
        }
        else if (!item.OwnerEligible)
        {
            <span class="badge bg-warning text-dark" title="@Localizer["Backdoor_Status_DisabledHint"]">@Localizer["Backdoor_Status_Disabled"]</span>
        }
        else if (item.IsExpired)
        {
            <span class="badge bg-warning text-dark">@Localizer["Backdoor_Status_Expired"]</span>
        }
        else
        {
            <span class="badge bg-success">@Localizer["Backdoor_Status_Active"]</span>
        }
    </text>;
    Func<BackdoorKeyListItem, IHtmlContent> actionsCell = @<text>
        @if (item.IsRotatable)
        {
            <form asp-action="Rotate" asp-route-id="@item.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Backdoor_Rotate"]</button>
            </form>
        }
        @if (item.ViewerMayManage && !item.IsRevoked)
        {
            <form asp-action="Revoke" asp-route-id="@item.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Backdoor_Revoke"]</button>
            </form>
        }
    </text>;
    var keysBuilder = TableModel.For(Model.Keys);
    if (Model.ShowsOwners)
        keysBuilder = keysBuilder.Human("Owner", k => k.UserId);
    var keysTable = keysBuilder
        .Column(Localizer["Backdoor_Label"], k => k.Label)
        .Template(Localizer["Backdoor_Key"], keyCell)
        .Template(Localizer["Backdoor_Created"], createdCell, c => c.Css("text-nowrap"), sortBy: k => k.CreatedAt)
        .Template(Localizer["Backdoor_LastUsed"], lastUsedCell, c => c.Css("text-nowrap"), sortBy: k => k.LastUsedAt)
        .Template(Localizer["Backdoor_Expires"], expiresCell, c => c.Css("text-nowrap"), sortBy: k => k.ExpiresAt)
        .Template(Localizer["Backdoor_Status"], statusCell)
        .Template(Localizer["Backdoor_Actions"], actionsCell, o => o.NoSort().Css("text-end").HeaderCss("text-end"))
        .RowCss(k => k.IsUsable ? null : "text-muted")
        .Css("align-middle")
        .Build();
}

<page-header title="@Localizer["Backdoor_Title"]" subtitle="@Localizer["Backdoor_Subtitle"]" />

@if (Model.NewPlaintextKey is not null)
{
    <div class="alert alert-success" role="alert">
        <h2 class="h6"><i class="fa-solid fa-key me-1"></i>@Localizer["Backdoor_CopyNow"]</h2>
        <p class="mb-2">@Localizer["Backdoor_CopyNowBody"]</p>
        <code class="user-select-all d-block p-2 bg-body-secondary rounded">@Model.NewPlaintextKey</code>
    </div>
}

<div class="card mb-4">
    <div class="card-header">@Localizer["Backdoor_NewKey"]</div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2 align-items-end">
            @if (Model.EligibleUsers.Count > 0)
            {
                <div class="col-md-4">
                    <label class="form-label" for="ownerUserId">Owner</label>
                    <select class="form-select" id="ownerUserId" name="ownerUserId">
                        <option value="">Me</option>
                        @foreach (var candidate in Model.EligibleUsers)
                        {
                            <option value="@candidate.UserId">@candidate.DisplayName</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-5">
                <label class="form-label" for="label">@Localizer["Backdoor_Label"]</label>
                <input class="form-control" id="label" name="label" maxlength="100" required
                       placeholder="@Localizer["Backdoor_LabelPlaceholder"]" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-plus me-1"></i>@Localizer["Backdoor_Create"]
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Keys.Count == 0)
{
    <empty-state>@Localizer["Backdoor_Empty"]</empty-state>
}
else
{
    <partial name="_Table" model="keysTable" />
}

<p class="mt-3 text-muted small">
    <i class="fa-solid fa-circle-info me-1"></i>@Localizer["Backdoor_About"]
    @Localizer["Backdoor_ShortLived", Model.ShortKeyLifetimeDays]
</p>
