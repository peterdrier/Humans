@model BackdoorKeysViewModel
@using NodaTime
@{
    ViewData["Title"] = "API keys";
    var madrid = DateTimeZoneProviders.Tzdb["Europe/Madrid"];

    string Stamp(Instant? at) => at is null
        ? "never"
        : at.Value.ToDateTime(madrid);

    Func<BackdoorKeyListItem, IHtmlContent> ownerCell = @<text><vc:human user-id="@item.UserId" link="None" /></text>;
    Func<BackdoorKeyListItem, IHtmlContent> keyCell = @<text><code>@item.DisplayPrefix…</code></text>;
    Func<BackdoorKeyListItem, IHtmlContent> createdCell = @<text>@Stamp(item.CreatedAt)</text>;
    Func<BackdoorKeyListItem, IHtmlContent> lastUsedCell = @<text>@Stamp(item.LastUsedAt)</text>;
    Func<BackdoorKeyListItem, IHtmlContent> statusCell = @<text>
        @if (item.IsRevoked)
        {
            <span class="badge bg-secondary">Revoked @Stamp(item.RevokedAt)</span>
        }
        else if (!item.OwnerEligible)
        {
            <span class="badge bg-warning text-dark" title="Its owner is not an active Admin or Board member, so every request with it is refused.">Disabled</span>
        }
        else
        {
            <span class="badge bg-success">Active</span>
        }
    </text>;
    Func<BackdoorKeyListItem, IHtmlContent> actionsCell = @<text>
        @if (item.IsUsable)
        {
            <form asp-action="Rotate" asp-route-id="@item.Id" method="post" class="d-inline" authorize-policy="AdminOnly">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Rotate</button>
            </form>
        }
        @if (!item.IsRevoked)
        {
            <form asp-action="Revoke" asp-route-id="@item.Id" method="post" class="d-inline" authorize-policy="AdminOnly">
                <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
            </form>
        }
    </text>;
    var keysTable = TableModel.For(Model.Keys)
        .Template("Owner", ownerCell)
        .Column("Label", k => k.Label)
        .Template("Key", keyCell)
        .Template("Created", createdCell, sortBy: k => k.CreatedAt)
        .Template("Last used", lastUsedCell, sortBy: k => k.LastUsedAt)
        .Template("Status", statusCell)
        .Template("Actions", actionsCell, o => o.NoSort().Css("text-end").HeaderCss("text-end"))
        .RowCss(k => k.IsUsable ? null : "text-muted")
        .Css("align-middle")
        .Build();
}

<page-header title="API keys" subtitle="Personal keys for /api/backdoor/*" />

@if (Model.NewPlaintextKey is not null)
{
    <div class="alert alert-success" role="alert">
        <h2 class="h6"><i class="fa-solid fa-key me-1"></i>Copy this key now</h2>
        <p class="mb-2">It is stored only as a hash — this is the one and only time it is shown.</p>
        <code class="user-select-all d-block p-2 bg-body-secondary rounded">@Model.NewPlaintextKey</code>
    </div>
}

<div class="mb-3 text-muted small">
    <i class="fa-solid fa-circle-info me-1"></i>
    A key is a person, not a service: every <code>/api/backdoor/*</code> request is attributed to
    its owner, and every write records them as the actor. Keys go only to full Admins and Board
    members. Send it in the <code>X-Api-Key</code> header.
</div>

<div class="card mb-4" authorize-policy="AdminOnly">
    <div class="card-header">Allocate a key</div>
    <div class="card-body">
        <form asp-action="Issue" method="post" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="ownerUserId">Owner</label>
                <select class="form-select" id="ownerUserId" name="ownerUserId" required>
                    @foreach (var candidate in Model.EligibleUsers)
                    {
                        <option value="@candidate.UserId">@candidate.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label" for="label">Label</label>
                <input class="form-control" id="label" name="label" maxlength="100" required
                       placeholder="e.g. laptop triage agent" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-plus me-1"></i>Allocate
                </button>
            </div>
        </form>
        @if (Model.EligibleUsers.Count == 0)
        {
            <p class="text-muted small mt-2 mb-0">No active account holds Admin or Board, so no key can be issued.</p>
        }
    </div>
</div>

@if (Model.Keys.Count == 0)
{
    <empty-state>No keys have been issued.</empty-state>
}
else
{
    <partial name="_Table" model="keysTable" />
}
