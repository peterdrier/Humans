<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Backdoor.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Auth\Humans.Auth.csproj" />
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <ProjectReference Include="..\Humans.Gdpr\Humans.Gdpr.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <!--
      The sections whose machine surface Backdoor serves. Each is reached only through
      the public interface in its Contracts/ folder (Agent, Feedback, Notifications, Store,
      Surveys, Expenses) or its contracts leaf (Issues, Finance) — HUM0034 keeps everything
      else in those assemblies internal, so the reference cannot widen past the published
      surface. Acyclic by construction:
      nothing references Backdoor. Debug is absent — /api/backdoor/logs reads
      InMemoryLogSink, which is Base's; so is Humans.Issues itself, since every Issues type
      named here resolves from the contracts leaf.
    -->
    <ProjectReference Include="..\Humans.Agent\Humans.Agent.csproj" />
    <ProjectReference Include="..\Humans.Feedback\Humans.Feedback.csproj" />
    <ProjectReference Include="..\Humans.Issues\Humans.Issues.csproj" />
    <ProjectReference Include="..\Humans.Notifications\Humans.Notifications.csproj" />
    <ProjectReference Include="..\Humans.Store\Humans.Store.csproj" />
    <ProjectReference Include="..\Humans.Surveys\Humans.Surveys.csproj" />
    <!--
      Expense reports (peterdrier/Humans#1838, #1839): IExpenseReportServiceRead. Report/attachment
      routes authorize via PolicyNames.ExpenseReportView — a named policy Expenses' own
      SectionPolicies registers — so the ExpenseReportOperation/ExpenseReportOperationRequirement
      pair and its handler stay internal there rather than becoming published surface here.
    -->
    <ProjectReference Include="..\Humans.Expenses\Humans.Expenses.csproj" />
    <!-- Creditor bindings, the category map and SEPA transfers — contracts leaf only, never
         Humans.Finance itself (memory/architecture/section-project-cycle-fix.md). -->
    <ProjectReference Include="..\Humans.Finance.Contracts\Humans.Finance.Contracts.csproj" />
    <!-- The budget year label (e.g. "2026") a report is booked to, for the year filter/field. -->
    <ProjectReference Include="..\Humans.Budget\Humans.Budget.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
