<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Tickets.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Shifts.Contracts\Humans.Shifts.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <!-- TicketTransferAdmin/Detail.cshtml renders <vc:audit-log>, which moved out of Humans.UI
         into the AuditLog section in G5 lane 4b-2h (nobodies-collective/Humans#866). -->
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <!--
      Outbound section references, all through leaves and all acyclic — none of these
      leaves names a Tickets type.
        Budget    — TicketQueryService reports ticketing actuals into the budget grid.
        Campaigns — TicketSyncService marks grants redeemed; TicketQueryService builds
                    the code-tracking dashboard; CampaignService now asks *this* section
                    for codes through Humans.Tickets.Contracts.ITicketDiscountCodes.
        Email     — the transfer wizard's three notification templates (primitives only).
        Gdpr      — TicketQueryService is an Article 15 contributor.
    -->
    <ProjectReference Include="..\Humans.Budget.Contracts\Humans.Budget.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Campaigns.Contracts\Humans.Campaigns.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
    <ProjectReference Include="..\Humans.EarlyEntry\Humans.EarlyEntry.csproj" />
    <!--
      Stripe fee enrichment on TicketOrder, through Humans.Stripe.Contracts. Direct
      section reference, acyclic — Humans.Stripe references no section.
    -->
    <ProjectReference Include="..\Humans.Stripe\Humans.Stripe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
