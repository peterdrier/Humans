@using Humans.Tickets.ViewComponents
@model MemberTicketStatusViewModel

<div class="row justify-content-center mb-5">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @if (!Model.TicketsConfigured && !Model.SellsInHumans && !Model.HasTicket)
                {
                    <div class="d-flex align-items-center">
                        <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-warning me-3">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <div>
                            <strong>@SharedLocalizer["Dashboard_TicketNotConfigured"]</strong>
                        </div>
                    </div>
                }
                else if (Model.HoldingsUnavailable)
                {
                    <div class="d-flex align-items-center">
                        <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-warning me-3">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <div>
                            <strong>@Localizer["Tickets_MemberTicketStatus_Unavailable"]</strong>
                        </div>
                    </div>
                }
                else if (Model.HasTicket)
                {
                    <div class="d-flex align-items-center">
                        <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-success me-3">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@SharedLocalizer["Dashboard_TicketConfirmed"]</h5>
                            @if (Model.UserTicketCount + Model.HumansTicketCount > 1)
                            {
                                <small class="text-muted">@string.Format(SharedLocalizer["Dashboard_TicketCount"].Value, Model.UserTicketCount + Model.HumansTicketCount)</small>
                            }
                        </div>
                    </div>
                    @if (Model.UserTicketCount > 0)
                    {
                        <vc:my-ticket-stubs user-id="@Model.UserId" />
                    }
                    <div class="mt-3 d-flex flex-wrap gap-2">
                        @if (Model.HumansTicketCount > 0)
                        {
                            <a class="btn btn-sm btn-primary" asp-controller="TicketBuy" asp-action="Mine">
                                <i class="fa-solid fa-qrcode me-1"></i>@Localizer["Tickets_Mine_Show"]
                            </a>
                        }
                        @if (Model.SellsInHumans)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="TicketBuy" asp-action="Index">@Localizer["Tickets_Buy_Title"]</a>
                        }
                        @if (Model.UserTicketCount > 0)
                        {
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-controller="TicketTransfer" asp-action="Index">@Localizer["Tickets_MemberTicketStatus_Transfers"]</a>
                        }
                    </div>
                }
                else if (Model.ParticipationStatus == ParticipationStatus.NotAttending)
                {
                    <div class="d-flex align-items-center mb-3">
                        <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-neutral me-3">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@SharedLocalizer["Dashboard_NotAttending"]</h5>
                            <small class="text-muted">@SharedLocalizer["Dashboard_NotAttendingHint"]</small>
                        </div>
                    </div>
                    <form asp-controller="TicketParticipation" asp-action="UndoNotAttending" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-rotate-left me-1"></i> @SharedLocalizer["Dashboard_UndoNotAttending"]
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-flex align-items-center mb-3">
                        <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-info me-3">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@SharedLocalizer["Dashboard_TicketMissing"]</h5>
                            <small class="text-muted">@SharedLocalizer["Dashboard_TicketMissingHint"]</small>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @if (Model.SellsInHumans)
                        {
                            <a asp-controller="TicketBuy" asp-action="Index" class="btn btn-primary">
                                <i class="fa-solid fa-ticket me-1"></i> @Localizer["Tickets_Buy_Title"]
                            </a>
                        }
                        else
                        {
                            <a href="@MemberTicketStatusViewModel.TicketPurchaseUrl" target="_blank" rel="noopener" class="btn btn-primary">
                                <i class="fa-solid fa-external-link-alt me-1"></i> @SharedLocalizer["Dashboard_BuyTicket"]
                            </a>
                        }
                        @if (Model.TicketsConfigured)
                        {
                            <a asp-controller="ProfileEmails" asp-action="Emails" class="btn btn-outline-secondary btn-sm">@SharedLocalizer["Dashboard_DifferentEmail"]</a>
                        }
                    </div>
                    @if (Model.EventYear.HasValue)
                    {
                        <hr />
                        <form asp-controller="TicketParticipation" asp-action="DeclareNotAttending" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <i class="fa-solid fa-xmark me-1"></i> @SharedLocalizer["Dashboard_DeclareNotAttending"]
                            </button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>
