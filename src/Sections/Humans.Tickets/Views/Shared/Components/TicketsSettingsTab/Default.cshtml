@model bool

@* Explicit asp-controller/asp-action: this renders on /Settings but posts to TicketController. *@
<form class="mw-540" method="post" asp-controller="Ticket" asp-action="ScheduledSync">
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="scheduledSyncEnabled" name="enabled" value="true" checked="@Model" />
        <label class="form-check-label" for="scheduledSyncEnabled">Sync orders from the ticket vendor on a schedule</label>
    </div>
    <button type="submit" class="btn btn-primary">Save settings</button>
    <div class="form-text mt-2">Turn off once sales have ended. "Sync now" on /Tickets works either way.</div>
</form>
