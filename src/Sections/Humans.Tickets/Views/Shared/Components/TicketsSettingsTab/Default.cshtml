@model Humans.Tickets.ViewComponents.TicketsSettingsTabModel

@* Explicit asp-controller/asp-action: this renders on /Settings but posts to TicketController. *@
<form class="mw-540" method="post" asp-controller="Ticket" asp-action="ScheduledSync">
    <div class="form-check form-switch mb-2">
        @if (Model.IsScheduledSyncEnabled)
        {
            <input class="form-check-input" type="checkbox" role="switch" id="scheduledSyncEnabled" name="enabled" value="true" checked />
        }
        else
        {
            <input class="form-check-input" type="checkbox" role="switch" id="scheduledSyncEnabled" name="enabled" value="true" />
        }
        <label class="form-check-label" for="scheduledSyncEnabled">Sync orders from the ticket vendor on a schedule</label>
    </div>
    <button type="submit" class="btn btn-primary">Save settings</button>
    <div class="form-text mt-2">Turn off once sales have ended. "Sync now" on /Tickets works either way.</div>
</form>

<form class="mw-540 mt-4" method="post" asp-controller="Ticket" asp-action="PostEventHold">
    <label class="form-label" for="postEventHoldDays">Post-event hold (days)</label>
    <div class="d-flex gap-2 mb-2">
        <input class="form-control w-auto" type="number" min="0" max="3650" id="postEventHoldDays" name="days" value="@Model.PostEventHoldDays" required />
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
    <div class="form-text">Days after an event's strike that a ticket holder's account deletion waits. Once they pass, each ticketing platform erases the event's personal data.</div>
</form>
