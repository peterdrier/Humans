@model Humans.Tickets.ViewComponents.TicketHoldingsViewModel

@if (Model.ChipOnly)
{
    <vc:onsite-chip user-id="@Model.UserId" view-mode="@Model.ViewMode" in-holdings="true" />
    return;
}

<div class="card mb-3">
    <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <h3 class="h6 mb-0">@Localizer["Tickets_TicketHoldings_Title"]</h3>
        <small class="text-muted">@Model.OrderCount @(Model.OrderCount == 1 ? Localizer["Tickets_TicketHoldings_OrderSingular"] : Localizer["Tickets_TicketHoldings_OrderPlural"])</small>
    </div>
    <div class="card-body py-3 d-flex flex-column gap-2">
        <vc:onsite-chip user-id="@Model.UserId" view-mode="@Model.ViewMode" in-holdings="true" />
        @if (Model.Tickets.Count == 0)
        {
            <empty-state class="small mb-0">@Localizer["Tickets_TicketHoldings_Empty"]</empty-state>
        }
        else
        {
            @foreach (var t in Model.Tickets.Where(t => t.Status != TicketAttendeeStatus.Void)
                .OrderBy(t => t.AttendeeName, StringComparer.OrdinalIgnoreCase))
            {
                <vc:ticket-stub stub="@t" />
            }
            @foreach (var t in Model.Tickets.Where(t => t.Status == TicketAttendeeStatus.Void)
                .OrderBy(t => t.AttendeeName, StringComparer.OrdinalIgnoreCase))
            {
                <div class="small text-muted text-break">
                    <span class="badge bg-secondary me-1">@Localizer["Tickets_TicketStub_Void"]</span>
                    <s>@t.AttendeeName</s>
                    @if (!string.IsNullOrEmpty(t.AttendeeEmail))
                    {
                        <span>· @t.AttendeeEmail</span>
                    }
                </div>
            }
        }
    </div>
</div>
