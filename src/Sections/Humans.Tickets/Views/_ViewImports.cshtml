@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by TicketsPageRenderTests (step 12).

   Two localizers by design (design §15 step 3b, Governance's variant): the section owns
   its TicketTransfer_* set, and the transfer wizard also renders Common_Back /
   Common_Cancel, which are genuinely shared vocabulary and stay in SharedResource. *@
@using Humans.Application.Extensions
@using Humans.Domain.Enums
@using Humans.Tickets
@using Humans.Tickets.Contracts
@using Humans.Tickets.Controllers
@using Humans.Tickets.Domain
@using Humans.Tickets.Models
@using Humans.Tickets.Services.Dtos
@using Humans.UI
@using Humans.UI.Extensions
@using Humans.UI.Models
@using Humans.UI.Models.Tables
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TicketsResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* <vc:ticket-stub> is this section's own component, public under Contracts/ so MVC's
   default provider discovers it and the tag helper is generated (step 6). Everything else
   the views open — <vc:human>, <vc:human-search>, <vc:audit-log>, <vc:access-matrix> —
   is Humans.UI's. <vc:human-summary> is still Shell's and is invoked by name. *@
@addTagHelper *, Humans.UI
@addTagHelper *, Humans.Tickets
