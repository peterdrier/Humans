@using Humans.Tickets.Domain.Checkout
@model IReadOnlyList<Humans.Tickets.Services.Checkout.HeldTicket>
@{
    ViewData["Title"] = Localizer["Tickets_Mine_Title"].Value;
    var earlyEntryDate = ViewData["EarlyEntryDate"] as NodaTime.LocalDate?;
}

@section Crumbs {
    <a asp-action="Index">@Localizer["Tickets_Buy_Title"]</a>
    <span>@Localizer["Tickets_Mine_Title"]</span>
}

<page-header title="@(Localizer["Tickets_Mine_Title"].Value)">
    <a class="btn btn-outline-secondary" asp-action="Index">@SharedLocalizer["Common_Back"]</a>
</page-header>

@if (Model.Count == 0)
{
    <empty-state>@Localizer["Tickets_Mine_None"]</empty-state>
    return;
}

<p class="text-muted">@Localizer["Tickets_Mine_AtTheGate"]</p>

<div class="row g-4">
@foreach (var held in Model)
{
    var t = held.Ticket;
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h2 class="h4 mb-1">@held.EventName</h2>
                    <status-badge value="@t.State" text="@(Localizer[$"Tickets_Ticket_State_{t.State}"].Value)" />
                </div>
                <div class="fw-semibold">@t.HolderName</div>
                @if (t.Kind == TicketHolderKind.Child)
                {
                    <div class="small text-muted">@Localizer["Tickets_Buy_Line_Child"]</div>
                }
                <div class="small text-muted">@Localizer["Tickets_Buy_Barcode"]: <code>@t.Barcode</code></div>
                @if (earlyEntryDate is { } ee && t.State is TicketCheckoutTicketState.Valid or TicketCheckoutTicketState.Offered)
                {
                    <div class="small mt-2">
                        <i class="fa-solid fa-door-open me-1" aria-hidden="true"></i>@Localizer["Tickets_TicketStub_EarlyEntry", ee.ToWeekdayDayMonth()]
                    </div>
                }

                @if (t.State is TicketCheckoutTicketState.Valid or TicketCheckoutTicketState.Offered)
                {
                    <img src="@Humans.Tickets.Services.Delivery.TicketCodeImages.PngDataUri(t.Barcode)" alt="@t.Barcode"
                         class="img-fluid d-block mx-auto my-3 ticket-code" />
                }

                @if (held.Offer is { } offer)
                {
                    <p class="mt-2 mb-2">@Localizer["Tickets_Resale_InQueue", held.QueuePosition?.ToString() ?? string.Empty, (offer.RefundOwedMinor / 100m).ToEuro()]</p>
                    <p class="small text-muted">@Localizer["Tickets_Resale_QueueNote"]</p>
                    <div class="d-flex flex-wrap gap-2">
                        <form asp-action="Withdraw" asp-route-ticketId="@t.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Tickets_Resale_Withdraw"]</button>
                        </form>
                        @if (held.DirectedActive)
                        {
                            <span class="small">@Localizer["Tickets_Resale_InvitedTo", string.Join(", ", offer.Invites.Select(i => i.Email))]</span>
                            <form asp-action="CancelInvite" asp-route-ticketId="@t.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Tickets_Resale_CancelInvite"]</button>
                            </form>
                        }
                        @if (held.CanInvite)
                        {
                            <form asp-action="Invite" asp-route-ticketId="@t.Id" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input class="form-control form-control-sm" name="inviteeEmail" type="email" multiple maxlength="2000" required
                                       aria-label="@Localizer["Tickets_Resale_InviteEmail"]" placeholder="@Localizer["Tickets_Resale_InviteEmail"]" />
                                <button type="submit" class="btn btn-outline-primary btn-sm">@Localizer["Tickets_Resale_Invite"]</button>
                            </form>
                        }
                    </div>
                    @if (held.CanInvite)
                    {
                        <p class="small text-muted mt-2 mb-0">@Localizer["Tickets_Resale_InviteHelp"]</p>
                    }
                }
                else if (held.CanOffer)
                {
                    <details class="mt-2">
                        <summary class="small">@Localizer["Tickets_Resale_Offer"]</summary>
                        <p class="small text-muted mt-2">
                            @Localizer["Tickets_Resale_OfferHelp"]
                            @if (held.HasDependents)
                            {
                                @(" " + Localizer["Tickets_Resale_OfferWithChildren"].Value)
                            }
                        </p>
                        <form asp-action="Offer" asp-route-ticketId="@t.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Tickets_Resale_Offer"]</button>
                        </form>
                    </details>
                }

                @if (held.CompanionRequest is { State: TicketCompanionRequestState.Pending })
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <span class="small">@Localizer["Tickets_Companion_Pending"]</span>
                        <form asp-action="WithdrawCompanion" asp-route-ticketId="@t.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Tickets_Companion_Withdraw"]</button>
                        </form>
                    </div>
                }
                else if (held.CanAskCompanion)
                {
                    @if (held.CompanionRequest is { State: TicketCompanionRequestState.Declined } declined)
                    {
                        <p class="small mt-3 mb-0">@Localizer["Tickets_Companion_Declined", declined.DecisionNote ?? string.Empty]</p>
                    }
                    <details class="mt-2">
                        <summary class="small">@Localizer["Tickets_Companion_Ask"]</summary>
                        <p class="small text-muted mt-2">@Localizer["Tickets_Companion_AskHelp"]</p>
                        <form asp-action="AskCompanion" asp-route-ticketId="@t.Id" method="post">
                            @Html.AntiForgeryToken()
                            <label class="form-label small" for="companion-email-@t.Id">@Localizer["Tickets_Companion_Email"]</label>
                            <input class="form-control form-control-sm mb-2" id="companion-email-@t.Id" name="companionEmail" type="email"
                                   maxlength="320" required autocomplete="off" />
                            <label class="form-label small" for="companion-note-@t.Id">@Localizer["Tickets_Companion_Note"]</label>
                            <textarea class="form-control form-control-sm" id="companion-note-@t.Id" name="note" rows="2" maxlength="500"
                                      required aria-describedby="companion-note-help-@t.Id"></textarea>
                            <div class="form-text mb-2" id="companion-note-help-@t.Id">@Localizer["Tickets_Companion_NoteHelp"]</div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">@Localizer["Tickets_Companion_Send"]</button>
                        </form>
                    </details>
                }
            </div>
        </div>
    </div>
}
</div>
