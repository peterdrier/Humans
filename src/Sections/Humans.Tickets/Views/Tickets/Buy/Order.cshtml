@using Humans.Tickets.Domain.Checkout
@model Humans.Tickets.Controllers.TicketBuyOrderViewModel
@{
    ViewData["Title"] = Localizer["Tickets_Buy_OrderTitle"].Value;
    var order = Model.Order;
    var open = order.IsOpen;
    var processing = order.State == TicketCheckoutOrderState.Processing;
    var canPay = open && Model.IsBuyer && order.PaymentUrl is not null && order.State == TicketCheckoutOrderState.Pending;
}

@section Crumbs {
    <a asp-action="Index">@Localizer["Tickets_Buy_Title"]</a>
    <span>@Localizer["Tickets_Buy_OrderTitle"]</span>
}

<page-header title="@(Localizer["Tickets_Buy_OrderTitle"].Value)">
    <page-header-badge><status-badge value="@order.State" text="@(Localizer[$"Tickets_Buy_State_{order.State}"].Value)" /></page-header-badge>
    <page-header-subtitle>@Localizer["Tickets_Buy_Reference"]: <code>@order.Reference</code></page-header-subtitle>
    <a class="btn btn-outline-secondary" asp-action="Index">@SharedLocalizer["Common_Back"]</a>
</page-header>

<div class="row g-4">
    <div class="col-lg-7">
        @if (order.State == TicketCheckoutOrderState.Paid)
        {
            <p>@Localizer["Tickets_Buy_PaidHelp"]</p>
        }
        else if (processing)
        {
            <p class="text-muted">@Localizer["Tickets_Buy_ProcessingHelp"]</p>
        }
        else if (open)
        {
            <p class="text-muted">@Localizer["Tickets_Buy_PendingHelp"]</p>
        }

        <div class="stat mb-4">
            @if (Model.IsBuyer)
            {
                <div class="label">@Localizer["Tickets_Buy_Total"]</div>
                <div class="value buy-total">@((order.TotalMinor / 100m).ToEuro())</div>
            }
            <dl class="buy-lines">
                @foreach (var line in Model.VisibleLines)
                {
                    <dt>
                        @if (line.Kind == CheckoutLineKind.Ticket)
                        {
                            @(line.HolderKind == TicketHolderKind.Child ? Localizer["Tickets_Buy_Line_Child"] : Localizer["Tickets_Buy_Line_Ticket"])
                            var priceName = line.ClassLabel ?? line.WaveName;
                            @if (priceName is not null)
                            {
                                <span class="text-muted">(@priceName)</span>
                            }
                        }
                        else
                        {
                            @string.Format(Localizer["Tickets_Buy_Line_Donation"].Value, line.DonationPurpose ?? Localizer["Tickets_Buy_Purpose_General"].Value)
                            <span class="d-block small text-muted">@Localizer["Tickets_Buy_DonationLineNote"]</span>
                        }
                        @if (line.AttendeeName is not null)
                        {
                            <span class="d-block small">@line.AttendeeName</span>
                        }
                    </dt>
                    <dd>@(Model.IsBuyer ? (line.AmountMinor / 100m).ToEuro() : "")</dd>
                }
                @if (Model.IsBuyer)
                {
                    var donations = order.TotalMinor - order.TicketTotalMinor;
                    @if (donations > 0)
                    {
                        <dt class="buy-lines-sub">@Localizer["Tickets_Buy_TicketsSubtotal"]</dt>
                        <dd class="buy-lines-sub">@((order.TicketTotalMinor / 100m).ToEuro())</dd>
                        <dt>@Localizer["Tickets_Buy_DonationSubtotal"]</dt>
                        <dd>@((donations / 100m).ToEuro())</dd>
                    }
                }
            </dl>
            @if (Model.IsBuyer && order.RefundedMinor > 0)
            {
                <p class="small text-muted text-end mt-2 mb-0">@string.Format(Localizer["Tickets_Buy_Refunded"].Value, (order.RefundedMinor / 100m).ToEuro())</p>
            }

            @if (open && Model.IsBuyer)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
                    @if (canPay)
                    {
                        <a class="btn btn-primary btn-lg buy-pay" href="@order.PaymentUrl">@Localizer["Tickets_Buy_PayNow"]</a>
                    }
                    <a class="btn btn-outline-secondary" asp-action="Order" asp-route-id="@order.Id">@Localizer["Tickets_Buy_Refresh"]</a>
                    @if (!processing)
                    {
                        <form asp-action="Cancel" asp-route-id="@order.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Tickets_Buy_Cancel"]</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.VisibleTickets.Any())
    {
        <div class="col-lg-5">
            <h2 class="h4">@Localizer["Tickets_Buy_YourTickets"]</h2>
            <div class="list-group mb-3">
                @foreach (var ticket in Model.VisibleTickets)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start gap-2">
                        <span>
                            @ticket.HolderName
                            <span class="d-block small text-muted">@Localizer["Tickets_Buy_Barcode"]: <code>@ticket.Barcode</code></span>
                        </span>
                        <status-badge value="@ticket.State" text="@(Localizer[$"Tickets_Ticket_State_{ticket.State}"].Value)" />
                    </div>
                }
            </div>
            <a class="btn btn-primary" asp-action="Mine">@Localizer["Tickets_Mine_Title"]</a>
        </div>
    }
</div>
