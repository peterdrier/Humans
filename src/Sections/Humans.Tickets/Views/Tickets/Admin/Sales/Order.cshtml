@using Humans.Tickets.Domain.Checkout
@model Humans.Tickets.Services.Checkout.CheckoutOrderDetail
@{
    ViewData["Title"] = $"Order {Model.Order.Reference}";
    var o = Model.Order;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var canResend = o.State == TicketCheckoutOrderState.Paid;
    var canRefund = o.State == TicketCheckoutOrderState.Paid && Model.RefundableMinor > 0;

    Func<TicketCheckoutOrderLine, IHtmlContent> holderCell = @<text>@item.AttendeeName <span class="small d-block">@item.AttendeeEmail</span></text>;
    var lines = TableModel.For(o.Lines)
        .Column("Line", l => l.Description)
        .Template("Holder", holderCell, c => c.NoSort())
        .Column("From resale queue", l => l.ResaleOfferId is not null, c => c.BoolIcon().NoSort())
        .Column("VAT", l => (l.VatRate * 100).ToString("0.##", invariant) + " %", c => c.End())
        .Column("Amount (€)", l => l.AmountMinor / 100m, c => c.Currency().End())
        .Footer(new TableFooterCell("Total"), new TableFooterCell(""), new TableFooterCell(""), new TableFooterCell(""),
            new TableFooterCell((o.TotalMinor / 100m).ToEuro(), "text-end text-nowrap"))
        .Empty("This order has no lines.")
        .Build();

    Func<TicketCheckoutTicket, IHtmlContent> ticketHolderCell = @<text>@item.HolderName <span class="small d-block">@item.HolderEmail</span></text>;
    Func<TicketCheckoutTicket, IHtmlContent> codeCell = @<text><a asp-controller="TicketsSupportAdmin" asp-action="Ticket" asp-route-orderId="@o.Id" asp-route-ticketId="@item.Id"><code>@item.Barcode</code></a></text>;
    Func<TicketCheckoutTicket, IHtmlContent> ticketStateCell = @<text><status-badge value="@item.State" /> <span class="small">@item.VoidReason</span></text>;
    var tickets = TableModel.For(Model.Tickets)
        .Template("Holder", ticketHolderCell, c => c.NoSort())
        .Column("Kind", t => SharedLocalizer.EnumDisplay(t.Kind))
        .Template("Code", codeCell, sortBy: t => t.Barcode)
        .Template("State", ticketStateCell, sortBy: t => t.State.ToString())
        .Column("Paid (€)", t => t.PricePaidMinor / 100m, c => c.Currency().End())
        .Empty("No tickets issued.")
        .Build();

    Func<TicketCheckoutRefund, IHtmlContent> refundStateCell = @<text>
        <status-badge value="@item.State" />
        <span class="small">@item.FailureReason</span>
        @if (item.ManualRefundUrl is not null)
        {
            <a class="small" href="@item.ManualRefundUrl" target="_blank" rel="noopener">refund there</a>
        }
    </text>;
    var refunds = TableModel.For(Model.Refunds)
        .Column("When", r => r.CreatedAt, c => c.DateTime())
        .Column("Amount (€)", r => r.AmountMinor / 100m, c => c.Currency().End())
        .Template("State", refundStateCell, sortBy: r => r.State.ToString())
        .Column("Reason", r => r.Reason)
        .Column("Backend id", r => r.BackendRefundId, c => c.Code())
        .Empty("No refunds asked.")
        .Build();

    Func<TicketCheckoutOrderEvent, IHtmlContent> whoCell = @<text>
        @if (item.ActorUserId is { } actor)
        {
            <vc:human user-id="@actor" link="Admin" />
        }
        else
        {
            <span class="text-muted">automation</span>
        }
    </text>;
    var timeline = TableModel.For(Model.Timeline)
        .Column("When", e => e.At, c => c.DateTime())
        .Column("What", e => SharedLocalizer.EnumDisplay(e.Kind))
        .Column("Detail", e => e.Detail)
        .Template("Who", whoCell, c => c.NoSort().Css("text-nowrap"))
        .Empty("Nothing recorded yet.")
        .Build();
}

@section Crumbs {
    <a asp-action="Orders" asp-route-id="@o.SalesEventId">Orders</a>
    <span>@o.Reference</span>
}

<page-header title="Order @o.Reference" subtitle="@o.BuyerName">
    <page-header-badge><status-badge value="@o.State" /></page-header-badge>
    @if (o.AdminUrl is not null)
    {
        <a class="btn btn-outline-secondary btn-sm" href="@o.AdminUrl" target="_blank" rel="noopener">
            Open in @o.BackendKey <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i>
        </a>
    }
</page-header>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">Lines</div>
            <partial name="_Table" model="lines" />
        </div>
        <div class="card mb-4">
            <div class="card-header">Tickets</div>
            <partial name="_Table" model="tickets" />
        </div>
        <div class="card mb-4">
            <div class="card-header">Refunds</div>
            <partial name="_Table" model="refunds" />
        </div>
        <div class="card mb-4">
            <div class="card-header">Timeline</div>
            <partial name="_Table" model="timeline" />
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-baseline">
                <span>Summary</span>
                <span class="fs-5 fw-bold">@((o.TotalMinor / 100m).ToEuro())</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Buyer</dt>
                    <dd class="col-7"><vc:human user-id="@o.BuyerUserId" link="Admin" /><span class="small d-block text-break">@o.BuyerEmail</span></dd>
                    <dt class="col-5">Created</dt>
                    <dd class="col-7">@o.CreatedAt.ToDateTime()</dd>
                    <dt class="col-5">Paid</dt>
                    <dd class="col-7">@(o.PaidAt?.ToDateTime() ?? "—") <span class="small d-block">@o.PaymentMethod</span></dd>
                    <dt class="col-5">Backend</dt>
                    <dd class="col-7"><code>@o.BackendKey</code> <code class="small d-block text-break">@o.BackendOrderId</code></dd>
                </dl>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-7 fw-normal">Total</dt>
                    <dd class="col-5 text-end">@((o.TotalMinor / 100m).ToEuro())</dd>
                    <dt class="col-7 fw-normal">Fee</dt>
                    <dd class="col-5 text-end">@(o.FeeMinor is { } fee ? (fee / 100m).ToEuro() : "—")</dd>
                    <dt class="col-7 fw-normal">Refunded</dt>
                    <dd class="col-5 text-end">@((o.RefundedMinor / 100m).ToEuro())</dd>
                    @if (o.DisputedMinor > 0)
                    {
                        <dt class="col-7 fw-normal text-danger">Charged back</dt>
                        <dd class="col-5 text-end text-danger">@((o.DisputedMinor / 100m).ToEuro())</dd>
                    }
                </dl>
            </div>
        </div>

        @if (canResend || canRefund)
        {
            <div class="card mb-4" authorize-policy="@TicketsPolicies.Manage">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    @if (canResend)
                    {
                        <form asp-action="Resend" asp-route-id="@o.Id" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Resend ticket emails and receipt</button>
                            <div class="form-text">To each holder and the payer, as when the order was paid.</div>
                        </form>
                    }
                    @if (canRefund)
                    {
                        <form asp-action="Refund" asp-route-id="@o.Id" method="post"
                              data-confirm="Refund this order through @o.BackendKey? The money goes back to the buyer.">
                            @Html.AntiForgeryToken()
                            <h3 class="h6">Refund</h3>
                            <div class="mb-2">
                                <label class="form-label" for="amount">Amount (€)</label>
                                <input class="form-control w-50" id="amount" name="amount" type="number" step="0.01" min="0.01"
                                       max="@((Model.RefundableMinor / 100m).ToString("0.00", invariant))"
                                       value="@((Model.RefundableMinor / 100m).ToString("0.00", invariant))" required />
                                <div class="form-text">At most @((Model.RefundableMinor / 100m).ToEuro()): the tickets, never donations.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="reason">Reason</label>
                                <input class="form-control" id="reason" name="reason" maxlength="500" required />
                            </div>
                            <button type="submit" class="btn btn-outline-danger btn-sm">Refund through @o.BackendKey</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
