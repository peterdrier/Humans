@model (Humans.Tickets.Controllers.PlatformsViewModel Page, Humans.Tickets.Services.Checkout.PlatformInfo Platform)
@{
    var p = Model.Platform;
    var site = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var s = p.Setup;
    var events = Model.Page.AllSettings.Where(e => e.PlatformKey == p.Key).ToList();
    var check = Model.Page.Check?.Key == p.Key ? Model.Page.Check : null;

    Func<PlatformSetting, IHtmlContent> valueCell = @<text>
        @if (!item.IsSet)
        {
            <span class="badge bg-warning text-dark">Missing</span>
        }
        else if (item.IsSecret)
        {
            <span class="badge bg-success">Set</span>
        }
        else
        {
            <code class="text-break">@item.Value</code>
        }
    </text>;
    var settings = TableModel.For(s.Settings)
        .Column("Setting", x => x.Name, c => c.Code())
        .Column("Purpose", x => x.Purpose)
        .Template("Value", valueCell, sortBy: x => x.IsSet)
        .Empty("This platform reads no settings.")
        .Build();
}

<section class="card mb-4" id="platform-@p.Key">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">@s.DisplayName <code class="small ms-1">@p.Key</code></h2>
        <span class="badge @(p.IsConfigured ? "bg-success" : "bg-secondary")">@(p.IsConfigured ? "Configured" : "Not configured")</span>
    </div>
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-3">Hosting</dt>
            <dd class="col-sm-9">@s.Hosting</dd>
            @if (s.AdminUrl is not null)
            {
                <dt class="col-sm-3">Platform admin</dt>
                <dd class="col-sm-9"><a href="@s.AdminUrl" target="_blank" rel="noopener">@s.AdminUrl</a></dd>
            }
            @if (s.WebhookPath is not null)
            {
                <dt class="col-sm-3">Webhook URL</dt>
                <dd class="col-sm-9"><code class="text-break">@site@s.WebhookPath</code></dd>
            }
            <dt class="col-sm-3">Events</dt>
            <dd class="col-sm-9">
                @if (events.Count == 0)
                {
                    <span class="text-muted">None sell through it.</span>
                }
                @foreach (var e in events)
                {
                    <div>
                        @Model.Page.EventName(e.EventSettingsId) <status-badge value="@e.Mode" />
                        @if (e.PlatformEventRef is not null)
                        {
                            <span class="small">platform event <code>@e.PlatformEventRef</code></span>
                        }
                    </div>
                }
            </dd>
        </dl>

        <div class="mb-3">
            <partial name="_Table" model="settings" />
        </div>

        @if (s.Notes.Count > 0)
        {
            <details class="small mb-3">
                <summary>Setup notes</summary>
                <ul class="mt-2 mb-0">
                    @foreach (var note in s.Notes)
                    {
                        <li>@note</li>
                    }
                </ul>
            </details>
        }

        <div authorize-policy="@TicketsPolicies.Manage">
            <form method="post" asp-controller="TicketsPlatformAdmin" asp-action="Check" asp-route-key="@p.Key" class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    <label class="form-label small" for="ref-@p.Key">Event id in the platform (optional)</label>
                    <input class="form-control form-control-sm" id="ref-@p.Key" name="platformEventRef" value="@(check?.PlatformEventRef ?? events.FirstOrDefault()?.PlatformEventRef)" />
                </div>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Test connection</button>
            </form>
        </div>

        @if (check is not null)
        {
            <ul class="list-unstyled mt-3 mb-0">
                @foreach (var f in check.Findings)
                {
                    <li class="@(f.Ok ? "text-success" : "text-danger")">
                        <i class="fa-solid @(f.Ok ? "fa-check" : "fa-xmark") me-1" aria-hidden="true"></i>@f.Text
                    </li>
                }
            </ul>
        }
    </div>
</section>
