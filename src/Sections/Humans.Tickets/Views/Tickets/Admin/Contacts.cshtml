@model Humans.Tickets.Models.ContactImportPreviewViewModel
@{
    ViewData["Title"] = "Import Attendee Contacts";
    var c = Model.Plan.Counts;
}

<page-header title="Import Attendee Contacts" />

<p class="text-muted">
    Found @Model.Plan.TotalUnmatched unmatched attendee@(Model.Plan.TotalUnmatched == 1 ? "" : "s")
    for the active event. Each one below has no <code>MatchedUserId</code> yet.
    Select rows and click Apply.
</p>

<div class="mb-3">
    <span class="badge text-bg-success me-1">Attach existing: @c.AttachVerified</span>
    <span class="badge text-bg-primary me-1">Create new user: @c.CreateNewUser</span>
    <span class="badge text-bg-warning me-1">Delete unverified + create: @c.DeleteUnverifiedThenCreate</span>
    @if (c.AmbiguousEmailMatches > 0)
    {
        <span class="badge text-bg-danger me-1">Ambiguous (skipped): @c.AmbiguousEmailMatches</span>
    }
    @if (c.SkipNoEmail > 0)
    {
        <span class="badge text-bg-secondary me-1">No email (skipped): @c.SkipNoEmail</span>
    }
</div>

<form asp-controller="TicketsContactsAdmin" asp-action="Apply" method="post" id="contacts-apply">
    @Html.AntiForgeryToken()

    <div class="mb-2" authorize-policy="@Humans.Tickets.Contracts.TicketsPolicies.Manage">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="select-all">Select all</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="select-first">Select first 1</button>
        <button type="submit" class="btn btn-primary btn-sm" id="apply-btn">
            Apply selected (<span id="selected-count">0</span>)
        </button>
    </div>

    @{
        Func<AttendeeImportDecisionRow, IHtmlContent> contactActionsCell = @<text>
            @if (item.Outcome is AttendeeImportOutcome.AmbiguousEmailMatches
                              or AttendeeImportOutcome.SkipNoEmail
                              or AttendeeImportOutcome.SkipVoided)
            {
                @* Non-actionable rows: no checkbox *@
            }
            else
            {
                <input type="checkbox" name="selected" value="@item.AttendeeId"
                       class="form-check-input row-check" />
            }

        </text>;
        Func<AttendeeImportDecisionRow, IHtmlContent> emailCell = @<text>
            @(item.Email ?? "—")
            @if (item.GroupSize > 1)
            {
                <span class="badge text-bg-info ms-1" title="@item.GroupSize tickets share this email">×@item.GroupSize</span>
            }

        </text>;
        Func<AttendeeImportDecisionRow, IHtmlContent> nameCell = @<text>
            @if (item.ObservedNames is { Count: > 1 } names)
            {
                <details>
                    <summary>
                        @(item.AttendeeName ?? "—")
                        <span class="badge text-bg-warning ms-1" title="Multiple distinct names observed">@names.Count names</span>
                    </summary>
                    <ul class="mb-0 small text-muted">
                        @foreach (var n in names)
                        {
                            <li>@n</li>
                        }
                    </ul>
                </details>
            }
            else
            {
                @(item.AttendeeName ?? "—")
            }

        </text>;
        Func<AttendeeImportDecisionRow, IHtmlContent> decisionCell = @<text>
            @switch (item.Outcome)
            {
                case AttendeeImportOutcome.AttachVerified:
                    <span class="badge text-bg-success">Attach existing</span>
                    break;
                case AttendeeImportOutcome.CreateNewUser:
                    <span class="badge text-bg-primary">Create new user</span>
                    break;
                case AttendeeImportOutcome.DeleteUnverifiedThenCreate:
                    <span class="badge text-bg-warning">Delete unverified + create</span>
                    break;
                case AttendeeImportOutcome.AmbiguousEmailMatches:
                    <span class="badge text-bg-danger">Ambiguous</span>
                    break;
                case AttendeeImportOutcome.SkipNoEmail:
                    <span class="badge text-bg-secondary">No email</span>
                    break;
                case AttendeeImportOutcome.SkipVoided:
                    <span class="badge text-bg-secondary">Voided</span>
                    break;
            }

        </text>;
        Func<AttendeeImportDecisionRow, IHtmlContent> targetNotesCell = @<text>
            @if (item.Outcome == AttendeeImportOutcome.AttachVerified && item.TargetUserId is Guid uid)
            {
                <a asp-controller="UsersAdmin" asp-action="AdminDetail" asp-route-id="@uid">
                    View user</a>
            }
            else if (item.Outcome == AttendeeImportOutcome.DeleteUnverifiedThenCreate
                     && item.UnverifiedRowUserId is Guid squatterId)
            {
                <text>Will delete unverified email row owned by </text>
                <a asp-controller="UsersAdmin" asp-action="AdminDetail" asp-route-id="@squatterId">user</a>
            }
            else if (item.Outcome == AttendeeImportOutcome.AmbiguousEmailMatches
                     && item.AmbiguousUserIds is { Count: > 0 } ids)
            {
                <text>Ambiguous matching email rows owned by: @string.Join(", ", ids)</text>
            }

        </text>;
        var contactsTable = TableModel.For(Model.Rows)
            .Template("", contactActionsCell, o => o.NoSort())
            .Template("Email", emailCell, sortBy: r => r.Email)
            .Template("Name", nameCell, sortBy: r => r.AttendeeName)
            .Template("Decision", decisionCell, sortBy: r => r.Outcome)
            .Template("Target / Notes", targetNotesCell)
            .Column("Vendor Ticket Id", r => r.VendorTicketId, o => o.Code())
            .Css("align-middle")
            .Build();
    }
    <partial name="_Table" model="contactsTable" />
</form>

<script nonce="@Context.Items["CspNonce"]">
(function () {
    const checks = document.querySelectorAll('.row-check');
    const count = document.getElementById('selected-count');
    function refresh() {
        const n = Array.from(checks).filter(c => c.checked).length;
        count.textContent = n;
        document.getElementById('apply-btn').disabled = n === 0;
    }
    checks.forEach(c => c.addEventListener('change', refresh));
    document.getElementById('select-all').addEventListener('click', () => {
        checks.forEach(c => c.checked = true);
        refresh();
    });
    document.getElementById('select-first').addEventListener('click', () => {
        checks.forEach((c, i) => c.checked = (i === 0));
        refresh();
    });
    refresh();
})();
</script>
