@model RoleFormViewModel

@{
    var form = Model.Form;
    var id = Model.Id;
    IReadOnlyList<SlotPriority> priorities = form.Priorities.Count > 0 ? form.Priorities : [SlotPriority.None];
    var isCoordinator = form.IsCoordinator;
}

<form action="@Model.Action" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="name-@id">@Localizer["Roles_Form_Name"]</label>
            <input type="text" class="form-control" id="name-@id" name="Name" value="@form.Name" maxlength="100" required />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="slug-@id">@Localizer["Roles_Form_CustomSlug"]</label>
            <input type="text" class="form-control" id="slug-@id" name="CustomSlug" value="@form.CustomSlug" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="slots-@id">@Localizer["Roles_Form_Slots"]</label>
            <input type="number" class="form-control" id="slots-@id" name="SlotCount" value="@form.SlotCount" min="1" required />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="period-@id">@Localizer["Roles_Col_Period"]</label>
            <select class="form-select" id="period-@id" name="Period">
                @foreach (var period in Enum.GetValues<RolePeriod>())
                {
                    <option value="@period" selected="@(form.Period == period)">@SharedLocalizer[$"Enum_RolePeriod_{period}"]</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="hours-@id">@Localizer["Roles_Form_Hours"]</label>
            <input type="number" class="form-control" id="hours-@id" name="EstimatedHours" value="@form.EstimatedHours" min="0" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="sort-@id">@Localizer["Roles_Form_Sort"]</label>
            <input type="number" class="form-control" id="sort-@id" name="SortOrder" value="@form.SortOrder" required />
        </div>
        <div class="col-12">
            <span class="form-label d-block">@Localizer["Roles_Form_Priorities"]</span>
            <div class="d-flex flex-wrap gap-2">
                @for (var i = 0; i < priorities.Count; i++)
                {
                    <select class="form-select form-select-sm w-auto" name="Priorities" aria-label="@Localizer["Roles_Form_SlotN", i + 1]">
                        @foreach (var priority in Enum.GetValues<SlotPriority>())
                        {
                            <option value="@priority" selected="@(priorities[i] == priority)">@(i + 1): @SharedLocalizer[$"Enum_SlotPriority_{priority}"]</option>
                        }
                    </select>
                }
            </div>
            <div class="form-text">@Localizer["Roles_Form_PrioritiesHelp"]</div>
        </div>
        <div class="col-12">
            <label class="form-label" for="description-@id">@Localizer["Roles_Form_Description"]</label>
            <markdown-editor name="Description" id="description-@id" value="@form.Description" rows="3" maxlength="2000" />
        </div>
        <div class="col-12">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="public-@id" name="IsPublic" value="true" checked="@form.IsPublic" />
                <input type="hidden" name="IsPublic" value="false" />
                <label class="form-check-label" for="public-@id">@Localizer["Roles_Form_Public"]</label>
            </div>
            @if (Model.CanSetCoordinator)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="coordinator-@id" name="IsCoordinator" value="true" checked="@isCoordinator" />
                    <input type="hidden" name="IsCoordinator" value="false" />
                    <label class="form-check-label" for="coordinator-@id">@Localizer["Roles_Form_Coordinator"]</label>
                    <div class="form-text">@Localizer["Roles_Form_CoordinatorHelp"]</div>
                </div>
            }
            else
            {
                <input type="hidden" name="IsCoordinator" value="@(isCoordinator ? "true" : "false")" />
            }
        </div>
        @if (!isCoordinator && Model.Permissions.Count > 0)
        {
            <fieldset class="col-12">
                <legend class="form-label fs-6">@Localizer["Roles_Form_Permissions"]</legend>
                @foreach (var permission in Model.Permissions)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="perm-@id-@permission.Key" name="PermissionKeys" value="@permission.Key"
                               checked="@form.PermissionKeys.Contains(permission.Key)" />
                        <label class="form-check-label" for="perm-@id-@permission.Key">@permission.Title</label>
                        <div class="form-text">@permission.Blurb</div>
                    </div>
                }
            </fieldset>
        }
        <div class="col-12">
            <button type="submit" class="btn btn-primary">@(Model.IsNew ? Localizer["Roles_Form_Add"] : Localizer["Roles_Form_Save"])</button>
        </div>
    </div>
</form>
