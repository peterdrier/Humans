  </data>
  <data name="CityPlanning_Help_ColorsTitle" xml:space="preserve">
    <value>Couleurs &amp; zones sonores</value>
  </data>
  <data name="CityPlanning_Help_ColorsBody" xml:space="preserve">
    <value>Chaque barrio est coloré selon sa zone sonore préférée (modifiable depuis la page de ton barrio).</value>
