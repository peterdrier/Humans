  <data name="CityPlanning_Help_PlacingBody" xml:space="preserve">
    <value>Clique sur {0} pour commencer à dessiner. Clique ensuite sur la carte pour poser des points définissant ton espace — chaque clic ajoute un coin. Ferme la forme en cliquant sur le premier point.</value>
  </data>
  <data name="CityPlanning_Help_AdjustingTitle" xml:space="preserve">
