  <data name="CityPlanning_Help_PlacingTitle" xml:space="preserve">
    <value>Col·locar el teu barrio</value>
  </data>
  <data name="CityPlanning_Help_PlacingBody" xml:space="preserve">
    <value>Fes clic a {0} per començar a dibuixar. Després fes clic al mapa per col·locar punts que defineixin el teu espai — cada clic afegeix un racó. Tanca la forma fent clic al primer punt.</value>
  </data>
  <data name="CityPlanning_Help_AdjustingTitle" xml:space="preserve">
