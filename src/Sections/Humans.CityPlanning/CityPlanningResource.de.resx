  </data>
  <data name="CityPlanning_Help_ColorsTitle" xml:space="preserve">
    <value>Farben &amp; Klangzonen</value>
  </data>
  <data name="CityPlanning_Help_ColorsBody" xml:space="preserve">
    <value>Jedes Barrio ist entsprechend seiner bevorzugten Klangzone eingefärbt (auf der Barrio-Seite bearbeitbar).</value>
  </data>
