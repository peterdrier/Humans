<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.CityPlanning.Tests" />
    <!-- The one assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.CityPlanning.Contracts\Humans.CityPlanning.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <!--
      The barrio container pages are City Planning's URLs over Containers' data: the admin
      list and the container map inject IContainerService and render Containers' own card
      partials and resource keys. Containers keeps Contracts as a folder (its other consumers
      are all in Shell), so the reference is to the section project — the assembly boundary
      already limits what is visible to those public Contracts/ types. Acyclic: Containers
      references Humans.CityPlanning.Contracts, never this project.
    -->
    <ProjectReference Include="..\Humans.Containers\Humans.Containers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package here: those ship with no PackageVersion on purpose and would fail
      the build with NU1010 under Central Package Management. IFormFile (the GeoJSON zone
      uploads) arrives through the framework reference Sdk.Razor already adds.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation; keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
