@* The schedule's calendar days (event time zone), each null when unset. A tuple so Camps' Details page,
   which sees only CityPlanning's contracts, can render this partial too. *@
@model (NodaTime.LocalDate? OpensOn, NodaTime.LocalDate? ClosesOn, NodaTime.LocalDate? ChangeableUntilOn)
<div class="modal fade" id="placement-help-modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["CityPlanning_PlacementPhase"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>@Localizer["CityPlanning_Help_WhenIsIt"]</h6>
                @{
                    const string dateFmt = "d MMMM";
                }
                @if (Model.OpensOn.HasValue || Model.ClosesOn.HasValue || Model.ChangeableUntilOn.HasValue)
                {
                    <ul class="text-muted small ps-3">
                        @if (Model.OpensOn is { } opensOn)
                        {
                            <li>@Localizer["CityPlanning_Help_Opens"] <strong>@opensOn.ToString(dateFmt, null)</strong></li>
                        }
                        @if (Model.ClosesOn is { } closesOn)
                        {
                            <li>@Localizer["CityPlanning_Help_LastDayToPlace"] <strong>@closesOn.ToString(dateFmt, null)</strong></li>
                        }
                        @if (Model.ChangeableUntilOn is { } changeableUntilOn)
                        {
                            <li>@Localizer["CityPlanning_Help_ChangeableUntil"] <strong>@changeableUntilOn.ToString(dateFmt, null)</strong></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small">@Localizer["CityPlanning_Help_WhenPlaceholder"]</p>
                }

                <div class="row g-4">

                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <img src="~/_content/Humans.CityPlanning/img/city-planning/barrio-draw.png" class="card-img-top city-map-help-image" alt="@Localizer["CityPlanning_Help_PlacingImageAlt"]" />
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@Localizer["CityPlanning_Help_PlacingTitle"]</h6>
                                <p class="card-text text-muted small mb-0">@Html.Raw(string.Format(Localizer["CityPlanning_Help_PlacingBody"].Value, $"<strong>{Localizer["CityPlanning_AddMyBarrioButton"]}</strong>"))</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <img src="~/_content/Humans.CityPlanning/img/city-planning/barrio-edit.png" class="card-img-top city-map-help-image" alt="@Localizer["CityPlanning_Help_AdjustingImageAlt"]" />
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@Localizer["CityPlanning_Help_AdjustingTitle"]</h6>
                                <ul class="card-text text-muted small ps-3 mb-0">
                                    <li>@Localizer["CityPlanning_Help_Adjusting_VertexMove"]</li>
                                    <li>@Localizer["CityPlanning_Help_Adjusting_Reposition"]</li>
                                    <li>@Localizer["CityPlanning_Help_Adjusting_AddVertex"]</li>
                                    <li>@Localizer["CityPlanning_Help_Adjusting_DeleteVertex"]</li>
                                    <li>@Localizer["CityPlanning_Help_Adjusting_MultiSelect"]</li>
                                    <li>@Localizer["CityPlanning_Help_Adjusting_Area"]</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <img src="~/_content/Humans.CityPlanning/img/city-planning/barrio-history.png" class="card-img-top city-map-help-image" alt="@Localizer["CityPlanning_Help_SavingImageAlt"]" />
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@Localizer["CityPlanning_Help_SavingTitle"]</h6>
                                <p class="card-text text-muted small mb-0">@Localizer["CityPlanning_Help_SavingBody"]</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <img src="~/_content/Humans.CityPlanning/img/city-planning/barrio-outside-limits.png" class="card-img-top city-map-help-image" alt="@Localizer["CityPlanning_Help_ZonesImageAlt"]" />
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@Localizer["CityPlanning_Help_ZonesTitle"]</h6>
                                <p class="card-text text-muted small mb-0">@Localizer["CityPlanning_Help_ZonesBody"]</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <img src="~/_content/Humans.CityPlanning/img/city-planning/barrio-overlap.png" class="card-img-top city-map-help-image" alt="@Localizer["CityPlanning_Help_OverlapsImageAlt"]" />
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@Localizer["CityPlanning_Help_OverlapsTitle"]</h6>
                                <p class="card-text text-muted small mb-0">@Html.Raw(string.Format(Localizer["CityPlanning_Help_OverlapsBody"].Value, $"<a href=\"https://discord.com/channels/1462886445583962245/1467793922074873896\" target=\"_blank\" class=\"text-decoration-none\">{Localizer["CityPlanning_Help_OverlapsDiscordChannel"]}</a>"))</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <img src="~/_content/Humans.CityPlanning/img/city-planning/barrio-colors.png" class="card-img-top city-map-help-image" alt="@Localizer["CityPlanning_Help_ColorsImageAlt"]" />
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@Localizer["CityPlanning_Help_ColorsTitle"]</h6>
                                <p class="card-text text-muted small mb-0">@Localizer["CityPlanning_Help_ColorsBody"]</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
