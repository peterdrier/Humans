@using Humans.CityPlanning.ViewComponents
@model CampPlacementPhaseViewModel
<div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="fa-solid fa-map-location-dot me-1"></i> @Localizer["CityPlanning_PlacementPhase"]</span>
        <div class="d-flex align-items-center gap-2">
            @if (Model.State == BarrioPlacementState.Open)
            {
                <span class="badge bg-success">@Localizer["CityPlanning_StatusOpen"]</span>
            }
            else if (Model.State == BarrioPlacementState.Changeable)
            {
                <span class="badge bg-info text-dark">@Localizer["CityPlanning_StatusChangeable"]</span>
            }
            else
            {
                <span class="badge bg-secondary">@Localizer["CityPlanning_StatusClosed"]</span>
            }
            @if (Model.State != BarrioPlacementState.Closed)
            {
                <a asp-controller="CityPlanning" asp-action="BarrioMap" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-map me-1"></i> @Localizer["CityPlanning_GoToPlacementMap"]
                </a>
            }
            <button type="button" class="btn btn-link btn-sm p-0"
                    data-bs-toggle="modal" data-bs-target="#placement-help-modal"
                    title="@Localizer["CityPlanning_PlacementPhaseInfo"]">
                <i class="fa-solid fa-circle-info text-muted"></i>
            </button>
        </div>
    </div>
</div>
<partial name="_PlacementHelpModal" model="Model.Schedule" />
