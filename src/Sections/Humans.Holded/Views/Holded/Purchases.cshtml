@model HoldedPurchaseDocMirror
@{
    ViewData["Title"] = "Holded purchase documents";
}

<h1 class="mb-3">Holded purchase documents</h1>

<p class="text-muted">
    Every purchase document Holded lists, as of the last sync
    (@(Model.LastSyncAt is { } at ? at.ToDateTime() : "never")). Notes are read one document at a time, up to
    50 a sync, newest first; "—" means not read yet. Which budget category a document counts toward is
    Finance's call, shown on the budget year and the
    <a asp-controller="Finance" asp-action="HoldedUnmatched">unmatched documents</a> page.
</p>

@if (Model.Docs.Count == 0)
{
    <div class="card"><div class="card-body text-muted">No documents mirrored yet — run a sync from the summary.</div></div>
}
else
{
    <div class="card">
        @{
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell0 = @<text>@item.Date.ToDate()</text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell1 = @<text>
                <a href="@item.HoldedUrl" target="_blank" rel="noopener noreferrer" title="Open in Holded">
                    @(string.IsNullOrWhiteSpace(item.DocNumber) ? item.Id : item.DocNumber)<i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i>
                </a>

            </text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell2 = @<text>
                @item.ContactName
                @if (item.Description is not null)
                {
                    <div class="small text-muted">@item.Description</div>
                }

            </text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell3 = @<text>@item.Total.ToEuro()</text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell4 = @<text>
                @if (item.IsApproved)
                {
                    <i class="fa-solid fa-check text-success" title="Approved in Holded"></i>
                }
                else
                {
                    <span class="text-muted" title="Still a draft in Holded">—</span>
                }

            </text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell5 = @<text><code>@(item.BookedAccountId ?? "—")</code></text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell6 = @<text>@string.Join(", ", item.Tags)</text>;
            Func<HoldedPurchaseDocInfo, IHtmlContent> docCell7 = @<text>@(item.Notes ?? "—")</text>;
            var docsTable = TableModel.For(Model.Docs)
                .Template("Date", docCell0, o => o.Css("text-nowrap"), sortBy: d => d.Date)
                .Template("Doc #", docCell1, o => o.Css("text-nowrap"), sortBy: d => d.DocNumber)
                .Template("Contact", docCell2, sortBy: d => d.ContactName)
                .Template("Total", docCell3, o => o.End(), sortBy: d => d.Total)
                .Template("Approved", docCell4, sortBy: d => d.IsApproved ? 1 : 0)
                .Template("Booked account", docCell5, o => o.Css("small"))
                .Template("Tags", docCell6, o => o.Css("small"))
                .Template("Notes", docCell7, o => o.Css("small text-muted"))
                .Css("align-middle")
                .Build();
        }
        <partial name="_Table" model="docsTable" />
    </div>
}
