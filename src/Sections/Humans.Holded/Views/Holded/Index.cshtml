@model HoldedSummary
@using System.Globalization
@using NodaTime
@{
    ViewData["Title"] = "Holded";
    var o = Model;
    var madrid = DateTimeZoneProviders.Tzdb["Europe/Madrid"];

    string Stamp(Instant? at) => at is null
        ? "never"
        : at.Value.ToDateTime(madrid);

    string StatusBadge(string status) => status switch
    {
        "Running" => "bg-info",
        "Error" => "bg-danger",
        _ => "bg-success"
    };

    string N(int n) => n.ToString("N0", CultureInfo.InvariantCulture);
    var used = o.Usage?.Usage ?? 0;
}

<h1 class="mb-3">Holded</h1>
<partial name="_HoldedNav" />

<p class="text-muted">
    The local mirror of Holded's ledger and chart of accounts. Pages read the mirror and make no
    Holded calls; this one makes a single usage lookup.
</p>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Connection</dt>
            <dd class="col-sm-9">
                @if (!o.IsConfigured)
                {
                    <span class="badge bg-secondary">Not configured</span>
                    <span class="text-muted small">No <code>HOLDED_API_KEY_V2</code>: the mirror is shown as last synced, and syncing is off.</span>
                }
                else if (!o.ApiReachable)
                {
                    <span class="badge bg-warning text-dark">Unreachable</span>
                    <span class="text-muted small">Configured, but Holded did not answer the usage lookup.</span>
                }
                else
                {
                    <span class="badge bg-success">Connected</span>
                }
            </dd>

            <dt class="col-sm-3">API usage</dt>
            <dd class="col-sm-9">
                @if (o.Usage is { } u)
                {
                    <text>@used.ToString("N0", CultureInfo.InvariantCulture) of @N(o.MonthlyCallBudget) calls in @u.Period</text>
                    <span class="text-muted small">(budget from <code>Holded:MonthlyCallBudget</code>)</span>
                }
                else
                {
                    <span class="text-muted">unknown</span>
                }
                <a asp-action="Calls" class="small ms-2">by month and endpoint</a>
            </dd>

            <dt class="col-sm-3">Mirror</dt>
            <dd class="col-sm-9">@N(o.LedgerLineCount) lines, @N(o.EntryCount) entries, @N(o.AccountCount) accounts</dd>

            <dt class="col-sm-3">Mirror vs Holded</dt>
            <dd class="col-sm-9">
                @if (o.MismatchCount == 0)
                {
                    <span class="text-success"><i class="fa-solid fa-check me-1"></i>every account agrees</span>
                }
                else
                {
                    <a asp-action="Accounts" asp-route-mismatched="true" class="text-danger">
                        <i class="fa-solid fa-xmark me-1"></i>@N(o.MismatchCount) account@(o.MismatchCount == 1 ? "" : "s") disagree
                    </a>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-rotate me-1"></i>Sync</span>
        <div class="d-flex gap-2">
            <form authorize-policy="@FinancePolicies.Manage" asp-action="SyncNow" method="post" class="d-inline js-sync-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-arrows-rotate me-1"></i>Sync now
                </button>
            </form>
            <form authorize-policy="@FinancePolicies.Manage" asp-action="FullSync" method="post" class="d-inline js-sync-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Full resync
                </button>
            </form>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Kind</th><th>Status</th><th>Last run</th><th class="text-end">Count</th><th>Last error</th>
                </tr>
            </thead>
            <tbody>
                @if (o.SyncStates.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">Never synced.</td></tr>
                }
                @foreach (var s in o.SyncStates)
                {
                    <tr>
                        <td>@s.Kind</td>
                        <td><span class="badge @StatusBadge(s.Status)">@s.Status</span></td>
                        <td class="text-nowrap">@Stamp(s.LastSyncAt)</td>
                        <td class="text-end">@N(s.LastCount)</td>
                        <td class="small text-muted">@s.LastError</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">
        <strong>Sync now</strong> sweeps the last 45 days (one or two calls), refreshes the chart and
        re-pulls up to 10 drifted accounts. <strong>Full resync</strong> rebuilds the mirror from
        inception: about @N(o.FullSyncCalls) calls today, one per 200 lines plus the chart.
    </div>
</div>

<script>
    // A sweep can take a while and a second submit only earns a "skipped" toast; disable on click.
    document.querySelectorAll('.js-sync-form').forEach(function (form) {
        form.addEventListener('submit', function () {
            var clicked = form.querySelector('button[type="submit"]');
            document.querySelectorAll('.js-sync-form button[type="submit"]').forEach(function (b) {
                b.disabled = true;
            });
            if (clicked) {
                clicked.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Working…';
            }
        });
    });
</script>
