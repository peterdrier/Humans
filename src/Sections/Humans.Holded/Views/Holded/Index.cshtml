@model HoldedOverviewVm
@using System.Globalization
@using NodaTime
@{
    ViewData["Title"] = "Holded";
    var o = Model.Overview;
    var madrid = DateTimeZoneProviders.Tzdb["Europe/Madrid"];

    string Stamp(Instant? at) => at is null
        ? "never"
        : at.Value.InZone(madrid).ToDateTimeUnspecified().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture);

    string StatusBadge(string status) => status switch
    {
        "Running" => "bg-info",
        "Error" => "bg-danger",
        _ => "bg-success"
    };

    var used = o.Usage?.Usage ?? 0;
    var pct = o.MonthlyCallBudget > 0
        ? (int)Math.Min(100m, Math.Round(100m * used / o.MonthlyCallBudget))
        : 0;
    var barClass = pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-success";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Holded</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Finance" asp-action="Creditors" class="btn btn-outline-secondary">
            <i class="fa-solid fa-users me-1"></i>Creditors
        </a>
        <a asp-controller="Finance" asp-action="HoldedUnmatched" class="btn btn-outline-secondary">
            <i class="fa-solid fa-question me-1"></i>Unmatched docs
        </a>
    </div>
</div>

<p class="text-muted">
    Every figure below is read from the local mirror of Holded's daybook — the pages that use it
    make no Holded calls at all. The only live call this page makes is the usage lookup.
</p>

<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-plug me-1"></i>Connection
    </div>
    <div class="card-body">
        @if (!o.ApiReachable)
        {
            <div class="alert alert-warning mb-0">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                Holded did not answer the usage lookup — no API key configured, or the API is down.
                The mirror below still renders; syncing will fail until the connection is back.
            </div>
        }
        else
        {
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <div class="text-muted small">Billing period</div>
                    <div class="fs-5">@o.Usage!.Period</div>
                </div>
                <div class="col-md-9">
                    <div class="d-flex justify-content-between small">
                        <span>@used.ToString("N0", CultureInfo.InvariantCulture) of @o.MonthlyCallBudget.ToString("N0", CultureInfo.InvariantCulture) calls used</span>
                        <span class="text-muted">@pct%</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Monthly call budget"
                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @barClass" style="width: @pct%"></div>
                    </div>
                    <div class="text-muted small mt-1">
                        Budget is the plan-tier allowance, set in configuration (<code>Holded:MonthlyCallBudget</code>).
                        Holded's own <code>limit</code> for this period is
                        @o.Usage.Limit.ToString("N0", CultureInfo.InvariantCulture) — that is the
                        billable-overage ceiling, not the free allowance.
                    </div>
                    @if (o.Usage.SecondaryUsages.Count > 0)
                    {
                        <div class="text-muted small">
                            Secondary:
                            @string.Join(", ", o.Usage.SecondaryUsages.Select(kv => $"{kv.Key} {kv.Value}"))
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-rotate me-1"></i>Sync state</span>
        <div class="d-flex gap-2">
            <form asp-action="SyncNow" method="post" class="d-inline js-sync-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-arrows-rotate me-1"></i>Sync now
                </button>
            </form>
            <form asp-action="FullSync" method="post" class="d-inline js-sync-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm"
                        title="Rebuilds the whole mirror from 2020 — more API calls than the nightly sweep.">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Full resync
                </button>
            </form>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Sync</th><th>Status</th><th>Last run</th><th class="text-end">Count</th><th>Last error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in o.SyncStates)
                {
                    <tr>
                        <td>@s.Kind</td>
                        <td><span class="badge @StatusBadge(s.Status)">@s.Status</span></td>
                        <td class="text-nowrap">@Stamp(s.LastSyncAt)</td>
                        <td class="text-end">@s.LastCount</td>
                        <td class="small text-muted">@s.LastError</td>
                    </tr>
                }
                <tr>
                    <td>Purchase docs <span class="text-muted small">(Finance)</span></td>
                    <td><span class="badge @StatusBadge(Model.DocSync.Status)">@Model.DocSync.Status</span></td>
                    <td class="text-nowrap">@Stamp(Model.DocSync.LastSyncAt)</td>
                    <td class="text-end">@Model.DocSync.LastSyncedDocCount</td>
                    <td class="small text-muted">@Model.DocSync.LastError</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">
        <strong>Sync now</strong> pulls purchase docs and sweeps the trailing ledger window;
        <strong>Full resync</strong> replaces the mirror from inception. Cached ledger lines:
        @o.LedgerLineCount.ToString("N0", CultureInfo.InvariantCulture).
        @if (Model.CreditorBindings is int bindings)
        {
            <text>Creditor bindings: @bindings.</text>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-gauge me-1"></i>API calls by month
    </div>
    @if (o.CallsByMonth.Count == 0)
    {
        <div class="card-body"><p class="mb-0 text-muted">No calls metered yet.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Month</th><th class="text-end">Calls</th><th>By endpoint</th></tr></thead>
                <tbody>
                    @foreach (var m in o.CallsByMonth)
                    {
                        <tr>
                            <td class="text-nowrap">@(new DateTime(m.Year, m.Month, 1).ToString("MMM yyyy", CultureInfo.InvariantCulture))</td>
                            <td class="text-end">@m.Total</td>
                            <td class="small text-muted">
                                @string.Join(", ", m.ByEndpoint.OrderByDescending(e => e.Value).Select(e => $"{e.Key} {e.Value}"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-chart-simple me-1"></i>Department actuals</span>
        <span class="badge bg-secondary">629xxxxx</span>
    </div>
    @if (o.DepartmentActuals.Count == 0)
    {
        <div class="card-body"><p class="mb-0 text-muted">No department accounts cached — run a sync.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr><th>Account</th><th>Name</th><th class="text-end">Spent</th><th class="text-end">Lines</th><th class="text-center">OK</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in o.DepartmentActuals)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Account" asp-route-number="@a.Number"><code>@a.Number</code></a></td>
                            <td>@a.Name</td>
                            <td class="text-end">@a.HoldedBalance.ToEuro()</td>
                            <td class="text-end">@a.LocalLineCount</td>
                            <td class="text-center">
                                @if (a.Reconciled)
                                {
                                    <i class="fa-solid fa-check text-success" title="Local ledger sum matches Holded"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-xmark text-danger" title="Local @a.LocalBalance.ToEuro() vs Holded @a.HoldedBalance.ToEuro()"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-list me-1"></i>Chart of accounts</span>
        <span class="badge bg-secondary">@o.Accounts.Count accounts</span>
    </div>
    @if (o.Accounts.Count == 0)
    {
        <div class="card-body"><p class="mb-0 text-muted">No accounts cached — run a sync.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Account</th><th>Name</th><th>Group</th>
                        <th class="text-end">Holded</th><th class="text-end">Local</th>
                        <th class="text-end">Lines</th><th class="text-center">OK</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in o.Accounts)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Account" asp-route-number="@a.Number"><code>@a.Number</code></a></td>
                            <td>@a.Name</td>
                            <td class="small text-muted">@a.Group</td>
                            <td class="text-end">@a.HoldedBalance.ToEuro()</td>
                            <td class="text-end">@(a.LocalBalance is null ? "—" : a.LocalBalance.ToEuro())</td>
                            <td class="text-end">@a.LocalLineCount</td>
                            <td class="text-center">
                                @if (a.Reconciled)
                                {
                                    <i class="fa-solid fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-xmark text-danger"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            Archived accounts are hidden. <strong>Local</strong> is Σdebit − Σcredit over the cached
            lines; a ✗ means the nightly reconciliation still sees drift after its targeted re-pull.
            Total cached lines: @o.LedgerLineCount.ToString("N0", CultureInfo.InvariantCulture).
        </div>
    }
</div>

<script>
    // A sweep can take a while and a second submit only earns a "skipped" toast; disable on click.
    document.querySelectorAll('.js-sync-form').forEach(function (form) {
        form.addEventListener('submit', function () {
            var clicked = form.querySelector('button[type="submit"]');
            document.querySelectorAll('.js-sync-form button[type="submit"]').forEach(function (b) {
                b.disabled = true;
            });
            if (clicked) {
                clicked.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Working…';
            }
        });
    });
</script>
