@model HoldedAccountStatement
@using System.Globalization
@using NodaTime
@{
    var a = Model.Account;
    ViewData[Humans.Base.ViewComponents.AdminNavComposition.ParentKey] = "Accounts";
    ViewData["Title"] = $"{a.Number}{(string.IsNullOrWhiteSpace(a.Name) ? "" : $" · {a.Name}")}";
    var madrid = DateTimeZoneProviders.Tzdb["Europe/Madrid"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><code>@a.Number</code> @(string.IsNullOrWhiteSpace(a.Name) ? "" : a.Name)</h1>
    <div class="d-flex gap-2">
        <a href="https://app.holded.com/accounting/ledger/@a.Number" target="_blank" rel="noopener noreferrer"
           class="btn btn-outline-primary" title="This account's ledger in Holded itself.">
            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>See in Holded
        </a>
    </div>
</div>

<p class="text-muted">
    Every figure below reads in the association's own point of view: + means its money went up,
    − means it went down. Read straight from the mirror — this page makes no Holded calls.
    @if (!string.IsNullOrWhiteSpace(a.EnglishName))
    {
        <text>In English: <strong>@a.EnglishName</strong>.</text>
    }
    @if (!string.IsNullOrWhiteSpace(a.Group))
    {
        <text>Group: <strong>@a.Group</strong>.</text>
    }
    @if (a.Archived)
    {
        <span class="badge bg-secondary">archived in Holded</span>
    }
</p>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center h-100"><div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">Holded balance</h6>
            <span class="fs-4">@a.HoldedBalance.ToSignedEuro()</span>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100"><div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">Mirror balance</h6>
            <span class="fs-4">@(a.LocalBalance is null ? "—" : a.LocalBalance.Value.ToSignedEuro())</span>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100"><div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">Cached lines</h6>
            <span class="fs-4">@a.LocalLineCount.ToString("N0", CultureInfo.InvariantCulture)</span>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100"><div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">Reconciled</h6>
            @if (a.Reconciled)
            {
                <span class="fs-4 text-success"><i class="fa-solid fa-check"></i></span>
            }
            else
            {
                <span class="fs-4 text-danger"><i class="fa-solid fa-xmark"></i></span>
            }
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="fa-solid fa-list me-1"></i>Journal lines</div>
    @if (Model.Lines.Count == 0)
    {
        <div class="card-body text-muted text-center py-4">No cached lines for this account.</div>
    }
    else
    {
            Func<HoldedStatementLine, IHtmlContent> lineCell0 = @<text>@item.Date.ToDate(madrid)</text>;
            Func<HoldedStatementLine, IHtmlContent> lineCell1 = @<text>
                <a asp-action="Entry" asp-route-number="@item.EntryNumber">@item.EntryNumber/@item.Line</a>
                @if (!string.IsNullOrEmpty(item.EntryId))
                {
                    <div class="font-monospace" style="font-size: .7em;" title="Holded's entry id">@item.EntryId</div>
                }

            </text>;
            Func<HoldedStatementLine, IHtmlContent> lineCell2 = @<text>
                @if (item.Counterparty is { } cp)
                {
                    if (cp.TotalOpposingLines <= 1)
                    {
                        <a asp-action="Account" asp-route-number="@cp.AccountNum"><code>@cp.AccountNum</code> @cp.AccountName</a>
                    }
                    else
                    {
                        <a asp-action="Entry" asp-route-number="@item.EntryNumber">
                            <code>@cp.AccountNum</code> @cp.AccountName <span class="text-muted">+@(cp.TotalOpposingLines - 1) more</span>
                        </a>
                    }
                }
                else
                {
                    <span class="text-muted">—</span>
                }

            </text>;
            Func<HoldedStatementLine, IHtmlContent> lineCell3 = @<text>@item.Type</text>;
            Func<HoldedStatementLine, IHtmlContent> lineCell4 = @<text>@item.Description</text>;
            Func<HoldedStatementLine, IHtmlContent> lineCell5 = @<text>@item.Amount.ToSignedEuro()</text>;
            Func<HoldedStatementLine, IHtmlContent> lineCell6 = @<text>
                @if (item.Checked == true)
                {
                    <i class="fa-solid fa-check text-success"></i>
                }
                else if (item.Checked is null)
                {
                    <span class="text-muted" title="Not re-synced since Humans began reading the tick">?</span>
                }

            </text>;
            var linesTable = TableModel.For(Model.Lines)
                .Template("Date", lineCell0, o => o.Css("text-nowrap"), sortBy: l => l.Date)
                .Template("Entry", lineCell1, o => o.Css("text-nowrap text-muted small"), sortBy: l => l.EntryNumber)
                .Template("Counterparty", lineCell2, o => o.Css("text-nowrap"), sortBy: l => l.Counterparty?.AccountNum)
                .Template("Type", lineCell3, o => o.Css("text-muted small"))
                .Template("Description", lineCell4)
                .Template("Amount", lineCell5, o => o.End(), sortBy: l => l.Amount)
                .Template("Checked", lineCell6, o => o.Css("text-center").HeaderCss("text-center"), sortBy: l => l.Checked == true ? 1 : 0)
                .Css("align-middle")
                .Build();
        <partial name="_Table" model="linesTable" />
    }
</div>
