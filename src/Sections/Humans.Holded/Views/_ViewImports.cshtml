@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml — every namespace and
   tag helper this section's views need has to be named here. See Finance's copy. *@
@using Humans.Holded.Models
@using Humans.Finance.Contracts
@using Humans.Base.Extensions
@using Humans.Base
@using Microsoft.Extensions.Localization
@* No HoldedResource: /Holded is an English-only finance-admin screen with zero Localizer call
   sites. SharedLocalizer is bound for the first view here that needs a string. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
