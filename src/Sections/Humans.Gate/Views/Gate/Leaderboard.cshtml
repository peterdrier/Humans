@model IReadOnlyList<GateLeaderboardRow>
@{
    ViewData["Title"] = "Gate leaderboard";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/_content/Humans.Gate/css/gate/gate.css")" asp-append-version="true" />
}

@* The kiosk is chromeless (no browser back), so this return path is mandatory. *@
<a asp-action="Index" class="gate-back">&larr; Back to scanning</a>

<h1>Gate leaderboard</h1>
<p class="text-muted">
    <strong>@ViewData["TotalAdmitted"]</strong> admitted ·
    <strong>@ViewData["TotalScanned"]</strong> scans (last 7 days)
</p>

@if (Model.Count == 0)
{
    <empty-state>No scans yet.</empty-state>
}
else
{
        Func<GateLeaderboardRow, IHtmlContent> scannerCell0 = @<text><vc:human user-id="@item.ScannedByUserId" /></text>;
        Func<GateLeaderboardRow, IHtmlContent> scannerCell1 = @<text>@item.Admitted</text>;
        Func<GateLeaderboardRow, IHtmlContent> scannerCell2 = @<text>@item.Rejected</text>;
        Func<GateLeaderboardRow, IHtmlContent> scannerCell3 = @<text>@item.Total</text>;
        var leaderboardTable = TableModel.For(Model)
            .Template("Scanner", scannerCell0)
            .Template("Admitted", scannerCell1, o => o.End(), sortBy: r => r.Admitted)
            .Template("Issues caught", scannerCell2, o => o.End(), sortBy: r => r.Rejected)
            .Template("Total", scannerCell3, o => o.End(), sortBy: r => r.Total)
            .Css("align-middle")
            .Build();
    <partial name="_Table" model="leaderboardTable" />
}
