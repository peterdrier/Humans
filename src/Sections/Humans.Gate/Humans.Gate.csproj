<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Gate.Tests" />
    <!-- The one assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not. -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Settings\Humans.Settings.csproj" />
    <!--
      Tickets' contracts leaf: ticket lookups, participation writes and Humans-issued tickets.
      The leaf references Humans.Base only, so it cannot cycle
      (memory/architecture/section-project-cycle-fix.md).
    -->
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
    <ProjectReference Include="..\Humans.EarlyEntry\Humans.EarlyEntry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package here: those ship with no PackageVersion on purpose and would fail
      the build with NU1010 under Central Package Management. IMemoryCache arrives through the
      framework reference Sdk.Razor already adds.
    -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
