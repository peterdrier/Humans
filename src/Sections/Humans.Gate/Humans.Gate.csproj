<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Gate.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\..\Humans.Application\Humans.Application.csproj" />
    <ProjectReference Include="..\..\Humans.Infrastructure\Humans.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Humans.UI\Humans.UI.csproj" />
    <ProjectReference Include="..\Humans.Gate.Contracts\Humans.Gate.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <!--
      Tickets' contracts leaf: GateVendorCheckInJob mirrors a gate admit back to the vendor
      through ITicketVendorMirror rather than naming the vendor port. Added at G5 lane 5b-3
      with the job (nobodies-collective/Humans#866) — Base used to carry this edge. The leaf
      references Humans.Interfaces only, so it cannot cycle
      (memory/architecture/section-project-cycle-fix.md).
    -->
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
    <ProjectReference Include="..\Humans.EarlyEntry\Humans.EarlyEntry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package here: those ship with no PackageVersion on purpose and would fail
      the build with NU1010 under Central Package Management. Identity's IPasswordHasher (the
      staff-PIN hasher) and IMemoryCache arrive through the framework reference Sdk.Razor
      already adds (design §15 step 1).
      Hangfire is the vendor check-in mirror: both the enqueue sites and, since G5 lane 5b-3,
      the two jobs themselves (Contracts/GateRetentionJob, Contracts/GateVendorCheckInJob).
    -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
