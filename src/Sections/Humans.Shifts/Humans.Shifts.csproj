<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Shifts.Tests" />
    <!-- The one assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
    <!--
      AuthorizationPolicyTests builds its own ServiceCollection rather than the full
      Section.Register graph, so it registers IsAnyTeamManagerOrCoordinatorHandler
      directly (backs PolicyNames.ShiftDepartmentManager).
    -->
    <InternalsVisibleTo Include="Humans.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <!-- IIssueQueueOwner: this section declares the issue queue it owns. -->
    <ProjectReference Include="..\Humans.Issues\Humans.Issues.csproj" />
    <!--
      Humans.Base above carries the shared enums whose persisted strings this section reads;
      the section's own persisted-string enums (SignupStatus, ShiftPriority, SignupPolicy,
      RotaPeriod, ShiftPeriod, BuildSubPeriod) live in Contracts/, with their
      EnumStringStabilityTests rows in tests/Humans.Shifts.Tests/Enums.
    -->
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <!-- Fills Onboarding's IOnboardingShiftsStep slot. The leaf only, which references Base alone. -->
    <ProjectReference Include="..\Humans.Onboarding.Contracts\Humans.Onboarding.Contracts.csproj" />
    <!--
      Outbound section references, all acyclic: none of these references Humans.Shifts.
        Camps         — ICampService: camp labels and rosters for the summary-by-camp.
        Auth          — the coordinator/manager authorization surface.
        EarlyEntry    — VolunteerTrackingExportService implements IEarlyEntryProvider;
                        the section project, since EarlyEntry's contracts are a folder.
        Email         — the "email a rota" coordinator message.
        Governance    — early-entry capacity reads the membership tier.
        Notifications — signup approval/refusal notifies the volunteer.
        Settings      — ISettingsService: the app-wide event calendar (nobodies-collective/Humans#1630).
        Teams         — a rota's department is a team row. The *section* project, not
                        only the leaf: ShiftAdminController derives from
                        HumansTeamControllerBase, which Teams ships public under its own
                        Contracts/ folder. Acyclic — Humans.Teams
                        names no Humans.Shifts type at all.
        Tickets       — early entry gates on the volunteer holding a ticket.
    -->
    <ProjectReference Include="..\Humans.Settings\Humans.Settings.csproj" />
    <ProjectReference Include="..\Humans.Auth\Humans.Auth.csproj" />
    <!--
      Calendar owns the personal iCal feed; ShiftSignupService implements its
      ICalendarFeedContributor. Calendar's Contracts/ is a folder, not a leaf, so the
      reference is to the section project — acyclic because the contributor fan-out
      inverts the arrow: Calendar names no section but Users.Contracts
      (nobodies-collective/Humans#866, G5 lane 4b-2c).
    -->
    <ProjectReference Include="..\Humans.Calendar\Humans.Calendar.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Consent\Humans.Consent.csproj" />
    <ProjectReference Include="..\Humans.Notifications.Contracts\Humans.Notifications.Contracts.csproj" />
    <!-- Permissions: declares Shifts.Manage and Shifts.Approve, and checks them on teams. -->
    <ProjectReference Include="..\Humans.Permissions\Humans.Permissions.csproj" />
    <ProjectReference Include="..\Humans.Teams\Humans.Teams.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
    <ProjectReference Include="..\Humans.EarlyEntry\Humans.EarlyEntry.csproj" />
    <!-- Fills Google's IGoogleGroupMembershipSource slot for the department shift lists. -->
    <ProjectReference Include="..\Humans.Google\Humans.Google.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClosedXML: the volunteer-tracking XLSX export builder. -->
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <!-- VolunteerBuildStatusConfiguration's JSON column converter. Arrived transitively
         through Humans.Application until G5 lane 5c dropped that reference. -->
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation; keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Section-help markdown (ISectionHelp). Embedded, not fetched: the help modal renders
      synchronously on the section's landing page. The logical name is fixed here so
      SectionHelpEntry.FromEmbeddedMarkdown can address it without probing.
    -->
    <None Remove="Docs\help\*.md" />
    <EmbeddedResource Include="Docs\help\*.md"
                      LogicalName="$(AssemblyName).Docs.help.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
