@model Humans.Shifts.Services.AppEventSettingsMoveSnapshot
@{
    ViewData["Title"] = "Carry Event Settings to Settings";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Carry Event Settings to Settings</h1>
    <small class="text-muted">Issue #1104</small>
</div>

<p class="text-muted">
    The app-wide event values (public year, event name, timezone, gate-opening
    date, build calendar, early-entry window and capacity) now live in the
    Settings section. This screen copies them off the Shifts rows, keeping each
    row's id so <code>Rota.EventSettingsId</code> still resolves. Run it once
    after deploy — until then Settings has no active event and the shift, gate
    and store pages read as "no active event". Idempotent: rows already in
    Settings are left untouched, so it is safe to re-run.
</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Shifts event rows</h6>
                <p class="h2 mb-0">@Model.TotalCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Already in Settings</h6>
                <p class="h2 mb-0 text-success">@Model.CarriedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Remaining</h6>
                <p class="h2 mb-0 @(Model.RemainingCount == 0 ? "text-success" : "text-warning")">
                    @Model.RemainingCount
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        @if (Model.RemainingCount == 0)
        {
            <p class="mb-0">
                Every Shifts event row is in Settings. The old columns can be
                retired in the follow-up step.
            </p>
        }
        else
        {
            <form method="post" asp-action="Run">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-right-arrow-left me-1"></i>
                    Carry @Model.RemainingCount event row@(Model.RemainingCount == 1 ? "" : "s") into Settings
                </button>
            </form>
        }
    </div>
</div>

@if (Model.TotalCount > 0)
{
    <div class="card mb-4">
        <div class="card-header">Event rows</div>
        @{
            var carryTable = TableModel.For(Model.Rows)
                .Column("Event", r => r.EventName)
                .Column("Year", r => r.Year)
                .Column("Active", r => r.IsActive ? "Yes" : "No")
                .Column("In Settings", r => r.AlreadyCarried ? "Yes" : "No")
                .Build();
        }
        <partial name="_Table" model="carryTable" />
    </div>
}
