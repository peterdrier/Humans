@using Humans.Base.Interfaces
@using Humans.Base.Models
@model Humans.Shifts.Models.PostEventStats

@{
    ViewData["Title"] = "Post-Event Stats";

    static string CompletionBadgeClass(int pct) =>
        pct >= 90 ? "bg-success" : pct >= 75 ? "bg-warning text-dark" : "bg-danger";

    int totalSignups = Model.TotalConfirmed + Model.TotalNoShow;

    var totalShifts = new StatTileViewModel("Total Shifts", Model.TotalShifts.ToString(), Subline: $"{Model.ShiftsWithData} with outcome data");
    var confirmed = new StatTileViewModel("Confirmed", Model.TotalConfirmed.ToString(), Subline: "completed signups");
    var noShows = new StatTileViewModel("No-Shows", Model.TotalNoShow.ToString(), Subline: "recorded no-shows", Severity: Model.TotalNoShow > 0 ? TileSeverity.Warning : TileSeverity.Normal);
    var completion = totalSignups > 0
        ? new StatTileViewModel("Completion Rate", $"{Model.CompletionPct}%", Subline: $"{Model.NoShowPct}% no-show rate")
        : new StatTileViewModel("Completion Rate", "—", Subline: "no outcome data recorded");
}

<div class="container py-4">
    <page-header title="Post-Event Stats" />

    <p class="text-muted mb-4">
        Completion and no-show rates across all confirmed/no-show signups in the event.
        Only shifts marked with <strong>NoShow</strong> by a coordinator are counted — shifts with no
        outcome recorded are excluded from the no-show rate.
    </p>

    <div class="stats">
        <partial name="_StatTile" model="totalShifts" />
        <partial name="_StatTile" model="confirmed" />
        <partial name="_StatTile" model="noShows" />
        <partial name="_StatTile" model="completion" />
    </div>

    @if (Model.Departments.Count == 0)
    {
        <empty-state>No departments with shift data found for this event.</empty-state>
    }
    else
    {
        <div class="card">
            <div class="card-header fw-semibold">Department Breakdown</div>
            @{
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> departmentCell = @<text>
                    @if (item.DepartmentSlug is not null)
                    {
                        <a asp-controller="ShiftAdmin" asp-action="Index"
                           asp-route-slug="@item.DepartmentSlug" class="text-decoration-none">
                            @item.DepartmentName
                        </a>
                    }
                    else
                    {
                        @item.DepartmentName
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> completionCell = @<text>
                    @if (item.TotalConfirmed + item.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.CompletionPct)">@item.CompletionPct%</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> setUpCell = @<text>
                    @if (item.Build.TotalConfirmed + item.Build.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.Build.CompletionPct)" title="@item.Build.TotalConfirmed confirmed, @item.Build.TotalNoShow no-shows">
                            @item.Build.CompletionPct%
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> eventCell = @<text>
                    @if (item.Event.TotalConfirmed + item.Event.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.Event.CompletionPct)" title="@item.Event.TotalConfirmed confirmed, @item.Event.TotalNoShow no-shows">
                            @item.Event.CompletionPct%
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> strikeCell = @<text>
                    @if (item.Strike.TotalConfirmed + item.Strike.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.Strike.CompletionPct)" title="@item.Strike.TotalConfirmed confirmed, @item.Strike.TotalNoShow no-shows">
                            @item.Strike.CompletionPct%
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }

                </text>;
                var deptTable = TableModel.For(Model.Departments)
                    .Template("Department", departmentCell, sortBy: d => d.DepartmentName)
                    .Column("Confirmed", r => r.TotalConfirmed, o => o.End())
                    .Column("No-Shows", r => r.TotalNoShow, o => o.End())
                    .Template("Completion", completionCell, o => o.End(), sortBy: d => d.TotalConfirmed + d.TotalNoShow > 0 ? d.CompletionPct : (int?)null)
                    .Template("Set-Up", setUpCell, o => o.Css("text-center").HeaderCss("text-center"), sortBy: d => d.Build.CompletionPct)
                    .Template("Event", eventCell, o => o.Css("text-center").HeaderCss("text-center"), sortBy: d => d.Event.CompletionPct)
                    .Template("Strike", strikeCell, o => o.Css("text-center").HeaderCss("text-center"), sortBy: d => d.Strike.CompletionPct)
                    .Css("align-middle")
                    .Build();
            }
            <partial name="_Table" model="deptTable" />
        </div>
        <p class="text-muted small mt-2">
            <i class="fa-solid fa-circle-info me-1"></i>
            Period badges show completion rate (green ≥ 90%, amber ≥ 75%, red &lt; 75%).
            AdminOnly shifts and hidden rotas are excluded.
        </p>
    }
</div>
