@model Humans.Shifts.Models.PostEventStats

@{
    ViewData["Title"] = "Post-Event Stats";

    static string CompletionBadgeClass(int pct) =>
        pct >= 90 ? "bg-success" : pct >= 75 ? "bg-warning text-dark" : "bg-danger";

    int totalSignups = Model.TotalConfirmed + Model.TotalNoShow;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Post-Event Stats</h2>
    </div>

    <p class="text-muted mb-4">
        Completion and no-show rates across all confirmed/no-show signups in the event.
        Only shifts marked with <strong>NoShow</strong> by a coordinator are counted — shifts with no
        outcome recorded are excluded from the no-show rate.
    </p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Total Shifts</div>
                    <div class="fs-3 fw-bold">@Model.TotalShifts</div>
                    <div class="text-muted small">@Model.ShiftsWithData with outcome data</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Confirmed</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalConfirmed</div>
                    <div class="text-muted small">completed signups</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 @(Model.TotalNoShow > 0 ? "border-warning" : "")">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">No-Shows</div>
                    <div class="fs-3 fw-bold @(Model.TotalNoShow > 0 ? "text-warning" : "")">@Model.TotalNoShow</div>
                    <div class="text-muted small">recorded no-shows</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Completion Rate</div>
                    @if (totalSignups > 0)
                    {
                        <div class="fs-3 fw-bold">@Model.CompletionPct%</div>
                        <div class="text-muted small">@Model.NoShowPct% no-show rate</div>
                    }
                    else
                    {
                        <div class="fs-3 fw-bold text-muted">—</div>
                        <div class="text-muted small">no outcome data recorded</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Departments.Count == 0)
    {
        <div class="alert alert-info">No departments with shift data found for this event.</div>
    }
    else
    {
        <div class="card">
            <div class="card-header fw-semibold">Department Breakdown</div>
            @{
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell0 = @<text>
                    @if (item.DepartmentSlug is not null)
                    {
                        <a asp-controller="ShiftAdmin" asp-action="Index"
                           asp-route-slug="@item.DepartmentSlug" class="text-decoration-none">
                            @item.DepartmentName
                        </a>
                    }
                    else
                    {
                        @item.DepartmentName
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell1 = @<text>@item.TotalConfirmed</text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell2 = @<text>@item.TotalNoShow</text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell3 = @<text>
                    @if (item.TotalConfirmed + item.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.CompletionPct)">@item.CompletionPct%</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell4 = @<text>
                    @if (item.Build.TotalConfirmed + item.Build.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.Build.CompletionPct)" title="@item.Build.TotalConfirmed confirmed, @item.Build.TotalNoShow no-shows">
                            @item.Build.CompletionPct%
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell5 = @<text>
                    @if (item.Event.TotalConfirmed + item.Event.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.Event.CompletionPct)" title="@item.Event.TotalConfirmed confirmed, @item.Event.TotalNoShow no-shows">
                            @item.Event.CompletionPct%
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }

                </text>;
                Func<Humans.Shifts.Models.PostEventDepartmentRow, IHtmlContent> deptCell6 = @<text>
                    @if (item.Strike.TotalConfirmed + item.Strike.TotalNoShow > 0)
                    {
                        <span class="badge @CompletionBadgeClass(item.Strike.CompletionPct)" title="@item.Strike.TotalConfirmed confirmed, @item.Strike.TotalNoShow no-shows">
                            @item.Strike.CompletionPct%
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }

                </text>;
                var deptTable = TableModel.For(Model.Departments)
                    .Template("Department", deptCell0, sortBy: d => d.DepartmentName)
                    .Template("Confirmed", deptCell1, o => o.End(), sortBy: d => d.TotalConfirmed)
                    .Template("No-Shows", deptCell2, o => o.End(), sortBy: d => d.TotalNoShow)
                    .Template("Completion", deptCell3, o => o.End(), sortBy: d => d.TotalConfirmed + d.TotalNoShow > 0 ? d.CompletionPct : (int?)null)
                    .Template("Set-Up", deptCell4, o => o.Css("text-center").HeaderCss("text-center"), sortBy: d => d.Build.CompletionPct)
                    .Template("Event", deptCell5, o => o.Css("text-center").HeaderCss("text-center"), sortBy: d => d.Event.CompletionPct)
                    .Template("Strike", deptCell6, o => o.Css("text-center").HeaderCss("text-center"), sortBy: d => d.Strike.CompletionPct)
                    .Css("align-middle")
                    .Build();
            }
            <partial name="_Table" model="deptTable" />
        </div>
        <p class="text-muted small mt-2">
            <i class="fa-solid fa-circle-info me-1"></i>
            Period badges show completion rate (green ≥ 90%, amber ≥ 75%, red &lt; 75%).
            AdminOnly shifts and hidden rotas are excluded.
        </p>
    }
</div>
