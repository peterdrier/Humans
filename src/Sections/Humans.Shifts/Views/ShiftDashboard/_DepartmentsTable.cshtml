@model (IReadOnlyList<DepartmentStaffingRow> Rows, ShiftPeriod? SelectedPeriod)

@{
    var periodSelected = Model.SelectedPeriod.HasValue;
}

@if (Model.Rows.Count == 0)
{
    return;
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>@Localizer["Shifts_ShiftDash_Departments_Title"]</strong>
        <span class="text-muted small">@Localizer["Shifts_ShiftDash_Departments_SortNote"]</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th></th>
                    <th>@Localizer["Shifts_ShiftDash_Departments_Col_Department"]</th>
                    <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_Filled"]</th>
                    <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_Pct"]</th>
                    <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_SlotsRemaining"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var rowId = "dept-" + row.DepartmentId.ToString("N");
                    var pct = StaffingCoveragePresentation.Percentage(row.FilledSlots, row.TotalSlots);
                    // Subgroups are always worth a drill-down; with no period selected the per-period breakdown is too.
                    var hasDrilldown = row.Subgroups.Count > 0 || !periodSelected;
                    if (hasDrilldown)
                    {
                    <tr role="button" data-bs-toggle="collapse" data-bs-target="#@rowId" aria-expanded="false" aria-controls="@rowId">
                        <td class="text-muted"><i class="fa-solid fa-chevron-right"></i></td>
                        <td>
                            @if (!string.IsNullOrEmpty(row.DepartmentSlug))
                            {
                                <a asp-controller="Team" asp-action="Details" asp-route-slug="@row.DepartmentSlug"
                                   data-dashboard-team-link="true">@row.DepartmentName</a>
                            }
                            else
                            {
                                @row.DepartmentName
                            }
                        </td>
                        <td class="text-end">@row.FilledSlots / @row.TotalSlots</td>
                        <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(pct).BadgeClass">@pct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(pct).StatusKey]</span></span></td>
                        <td class="text-end">@row.SlotsRemaining</td>
                    </tr>
                    <tr class="collapse" id="@rowId">
                        <td colspan="5" class="bg-light">
                            @if (row.Subgroups.Count > 0)
                            {
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_Filled"]</th>
                                            <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_Pct"]</th>
                                            <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_SlotsRemaining"]</th>
                                            @if (!periodSelected)
                                            {
                                                <th class="text-end">@SharedLocalizer["Shifts_SetUp"]</th>
                                                <th class="text-end">@SharedLocalizer["Shifts_Event"]</th>
                                                <th class="text-end">@SharedLocalizer["Shifts_Strike"]</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sub in row.Subgroups)
                                        {
                                            var sPct = StaffingCoveragePresentation.Percentage(sub.FilledSlots, sub.TotalSlots);
                                            <tr>
                                                <td>
                                                    @if (sub.IsDirect)
                                                    {
                                                        <span class="badge bg-secondary me-1">@Localizer["Shifts_ShiftDash_Departments_Direct"]</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(sub.Slug))
                                                    {
                                                        <a asp-controller="Team" asp-action="Details" asp-route-slug="@sub.Slug">@sub.Name</a>
                                                    }
                                                    else
                                                    {
                                                        @sub.Name
                                                    }
                                                </td>
                                                <td class="text-end">@sub.FilledSlots / @sub.TotalSlots</td>
                                                <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(sPct).BadgeClass">@sPct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(sPct).StatusKey]</span></span></td>
                                                <td class="text-end">@sub.SlotsRemaining</td>
                                                @if (!periodSelected)
                                                {
                                                    var bPct = StaffingCoveragePresentation.Percentage(sub.Build.FilledSlots, sub.Build.TotalSlots);
                                                    var ePct = StaffingCoveragePresentation.Percentage(sub.Event.FilledSlots, sub.Event.TotalSlots);
                                                    var stPct = StaffingCoveragePresentation.Percentage(sub.Strike.FilledSlots, sub.Strike.TotalSlots);
                                                    <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(bPct).BadgeClass">@bPct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(bPct).StatusKey]</span></span></td>
                                                    <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(ePct).BadgeClass">@ePct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(ePct).StatusKey]</span></span></td>
                                                    <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(stPct).BadgeClass">@stPct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(stPct).StatusKey]</span></span></td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else if (!periodSelected)
                            {
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>@Localizer["Shifts_ShiftDash_Departments_Col_Period"]</th>
                                            <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_Filled"]</th>
                                            <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_Pct"]</th>
                                            <th class="text-end">@Localizer["Shifts_ShiftDash_Departments_Col_SlotsRemaining"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (label, p) in new[] {
                                            (SharedLocalizer["Shifts_SetUp"].Value, row.Build),
                                            (SharedLocalizer["Shifts_Event"].Value, row.Event),
                                            (SharedLocalizer["Shifts_Strike"].Value, row.Strike) })
                                        {
                                            var pPct = StaffingCoveragePresentation.Percentage(p.FilledSlots, p.TotalSlots);
                                            <tr>
                                                <td>@label</td>
                                                <td class="text-end">@p.FilledSlots / @p.TotalSlots</td>
                                                <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(pPct).BadgeClass">@pPct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(pPct).StatusKey]</span></span></td>
                                                <td class="text-end">@p.SlotsRemaining</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </td>
                    </tr>
                    }
                    else
                    {
                    <tr>
                        <td></td>
                        <td>
                            @if (!string.IsNullOrEmpty(row.DepartmentSlug))
                            {
                                <a asp-controller="Team" asp-action="Details" asp-route-slug="@row.DepartmentSlug">@row.DepartmentName</a>
                            }
                            else
                            {
                                @row.DepartmentName
                            }
                        </td>
                        <td class="text-end">@row.FilledSlots / @row.TotalSlots</td>
                        <td class="text-end"><span class="badge @StaffingCoveragePresentation.Describe(pct).BadgeClass">@pct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(pct).StatusKey]</span></span></td>
                        <td class="text-end">@row.SlotsRemaining</td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Stop propagation so a team link inside a collapse row navigates without toggling the row.
    (function () {
        document.querySelectorAll('[data-dashboard-team-link="true"]').forEach(function (el) {
            el.addEventListener('click', function (e) { e.stopPropagation(); });
        });
    })();
</script>
