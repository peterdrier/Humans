@model (DashboardOverview Overview, ShiftPeriod? SelectedPeriod)

@{
    var o = Model.Overview;
    var slotsPct = StaffingCoveragePresentation.Percentage(o.FilledSlots, o.TotalSlots);
    var engagedPct = StaffingCoveragePresentation.Percentage(o.TicketHoldersEngaged, o.TicketHolderCount);
    var unreached = Math.Max(0, o.TicketHolderCount - o.TicketHoldersEngaged);

    // TEMP: ticket figures are not shareable yet; flip once they are. DashboardOverview still computes them.
    var showTicketData = false;
}

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">@Localizer["Shifts_ShiftDash_Overview_ShiftsFilled"]</div>
                <div class="fs-3 fw-bold">@o.FilledSlots <span class="text-muted fs-6">/ @o.TotalSlots (@slotsPct.ToString("0")%)</span></div>
                @if (!Model.SelectedPeriod.HasValue)
                {
                    <div class="mt-2">
                        <span class="badge @StaffingCoveragePresentation.Describe(o.PeriodFillRates.BuildPct).BadgeClass me-1">@SharedLocalizer["Shifts_SetUp"] @o.PeriodFillRates.BuildPct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(o.PeriodFillRates.BuildPct).StatusKey]</span></span>
                        <span class="badge @StaffingCoveragePresentation.Describe(o.PeriodFillRates.EventPct).BadgeClass me-1">@SharedLocalizer["Shifts_Event"] @o.PeriodFillRates.EventPct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(o.PeriodFillRates.EventPct).StatusKey]</span></span>
                        <span class="badge @StaffingCoveragePresentation.Describe(o.PeriodFillRates.StrikePct).BadgeClass">@SharedLocalizer["Shifts_Strike"] @o.PeriodFillRates.StrikePct.ToString("0")% <span class="visually-hidden">@Localizer[StaffingCoveragePresentation.Describe(o.PeriodFillRates.StrikePct).StatusKey]</span></span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">@Localizer["Shifts_ShiftDash_Overview_TicketHolders"]</div>
                @if (showTicketData)
                {
                    <div class="fs-3 fw-bold">@o.TicketHolderCount</div>
                    <div class="text-muted small">@Localizer["Shifts_ShiftDash_Overview_TicketHoldersSubline"]</div>
                }
                else
                {
                    <div class="fs-3 fw-bold text-muted">@SharedLocalizer["Common_NotAvailable"]</div>
                    <div class="text-muted small">@Localizer["Shifts_ShiftDash_Overview_TicketData_Hidden"]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg">
        <div class="card h-100 @(showTicketData ? "border-primary" : "")">
            <div class="card-body">
                <div class="text-muted small text-uppercase">@Localizer["Shifts_ShiftDash_Overview_TicketHoldersEngaged"]</div>
                @if (showTicketData)
                {
                    <div class="fs-3 fw-bold">@o.TicketHoldersEngaged <span class="text-muted fs-6">/ @o.TicketHolderCount (@engagedPct.ToString("0")%)</span></div>
                    <div class="text-muted small">@string.Format(Localizer["Shifts_ShiftDash_Overview_EngagedSubline"].Value, unreached)</div>
                }
                else
                {
                    <div class="fs-3 fw-bold text-muted">@SharedLocalizer["Common_NotAvailable"]</div>
                    <div class="text-muted small">@Localizer["Shifts_ShiftDash_Overview_TicketData_Hidden"]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">@Localizer["Shifts_ShiftDash_Overview_NonTicketSignups"]</div>
                @if (showTicketData)
                {
                    <div class="fs-3 fw-bold">@o.NonTicketSignups</div>
                    <div class="text-muted small">@Localizer["Shifts_ShiftDash_Overview_NonTicketSubline"]</div>
                }
                else
                {
                    <div class="fs-3 fw-bold text-muted">@SharedLocalizer["Common_NotAvailable"]</div>
                    <div class="text-muted small">@Localizer["Shifts_ShiftDash_Overview_TicketData_Hidden"]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg">
        <div class="card h-100 @(o.StalePendingCount > 0 ? "border-warning" : "")">
            <div class="card-body">
                <div class="text-muted small text-uppercase">@Localizer["Shifts_ShiftDash_Overview_StalePending"]</div>
                <div class="fs-3 fw-bold">@o.StalePendingCount</div>
                <div class="text-muted small">@Localizer["Shifts_ShiftDash_Overview_StaleSubline"]</div>
            </div>
        </div>
    </div>
</div>
