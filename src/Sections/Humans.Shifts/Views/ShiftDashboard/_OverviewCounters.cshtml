@using Humans.Base.Interfaces
@using Humans.Base.Models
@model (DashboardOverview Overview, ShiftPeriod? SelectedPeriod)

@{
    var o = Model.Overview;
    var slotsPct = StaffingCoveragePresentation.Percentage(o.FilledSlots, o.TotalSlots);
    var engagedPct = StaffingCoveragePresentation.Percentage(o.TicketHoldersEngaged, o.TicketHolderCount);
    var unreached = Math.Max(0, o.TicketHolderCount - o.TicketHoldersEngaged);

    // TEMP: ticket figures are not shareable yet; flip once they are. DashboardOverview still computes them.
    var showTicketData = false;

    var fill = o.PeriodFillRates;
    var buildFill = StaffingCoveragePresentation.Describe(fill.BuildPct);
    var eventFill = StaffingCoveragePresentation.Describe(fill.EventPct);
    var strikeFill = StaffingCoveragePresentation.Describe(fill.StrikePct);
    Func<dynamic, IHtmlContent> periodBadges = @<div class="mt-2">
        <span class="badge @buildFill.BadgeClass me-1">@SharedLocalizer["Shifts_SetUp"] @fill.BuildPct.ToString("0")% <span class="visually-hidden">@Localizer[buildFill.StatusKey]</span></span>
        <span class="badge @eventFill.BadgeClass me-1">@SharedLocalizer["Shifts_Event"] @fill.EventPct.ToString("0")% <span class="visually-hidden">@Localizer[eventFill.StatusKey]</span></span>
        <span class="badge @strikeFill.BadgeClass">@SharedLocalizer["Shifts_Strike"] @fill.StrikePct.ToString("0")% <span class="visually-hidden">@Localizer[strikeFill.StatusKey]</span></span>
    </div>;

    var notAvailable = SharedLocalizer["Common_NotAvailable"].Value;
    var ticketDataHidden = Localizer["Shifts_ShiftDash_Overview_TicketData_Hidden"].Value;
    var ticketHolders = showTicketData
        ? new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_TicketHolders"].Value, o.TicketHolderCount.ToString(), Subline: Localizer["Shifts_ShiftDash_Overview_TicketHoldersSubline"].Value)
        : new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_TicketHolders"].Value, notAvailable, Subline: ticketDataHidden);
    var engaged = showTicketData
        ? new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_TicketHoldersEngaged"].Value, o.TicketHoldersEngaged.ToString(), $"/ {o.TicketHolderCount} ({engagedPct:0}%)", string.Format(Localizer["Shifts_ShiftDash_Overview_EngagedSubline"].Value, unreached))
        : new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_TicketHoldersEngaged"].Value, notAvailable, Subline: ticketDataHidden);
    var nonTicket = showTicketData
        ? new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_NonTicketSignups"].Value, o.NonTicketSignups.ToString(), Subline: Localizer["Shifts_ShiftDash_Overview_NonTicketSubline"].Value)
        : new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_NonTicketSignups"].Value, notAvailable, Subline: ticketDataHidden);
    IHtmlContent? periodBadgesOrNone = null;
    if (!Model.SelectedPeriod.HasValue)
    {
        periodBadgesOrNone = periodBadges(0);
    }
    var filled = new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_ShiftsFilled"].Value, o.FilledSlots.ToString(), $"/ {o.TotalSlots} ({slotsPct:0}%)", Extra: periodBadgesOrNone);
    var stale = new StatTileViewModel(Localizer["Shifts_ShiftDash_Overview_StalePending"].Value, o.StalePendingCount.ToString(), Subline: Localizer["Shifts_ShiftDash_Overview_StaleSubline"].Value, Severity: o.StalePendingCount > 0 ? TileSeverity.Warning : TileSeverity.Normal);
}

<div class="stats" style="--stats-cols: 5">
    <partial name="_StatTile" model="filled" />
    <partial name="_StatTile" model="ticketHolders" />
    <partial name="_StatTile" model="engaged" />
    <partial name="_StatTile" model="nonTicket" />
    <partial name="_StatTile" model="stale" />
</div>
