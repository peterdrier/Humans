@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by ShiftsPageRenderTests (step 12). *@
@using Humans.Application.DTOs
@using Humans.Application.Enums
@using Humans.Application.Extensions
@using Humans.Domain.Entities
@using Humans.Domain.Enums
@using Humans.Shifts
@using Humans.Shifts.Contracts
@using Humans.Shifts.Controllers
@using Humans.Shifts.Domain
@using Humans.Shifts.Helpers
@using Humans.Shifts.Models
@using Humans.Shifts.Services
@using Humans.Shifts.Services.Dtos
@using Humans.Teams.Contracts
@using Humans.UI
@using Humans.UI.Authorization
@using Humans.UI.Extensions
@using Humans.UI.Models
@using Humans.UI.Models.Tables
@using Humans.UI.ViewComponents
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NodaTime
@using NodaTime.Text
@* Localizer is the section's own 328-key set. SharedLocalizer covers the fifteen keys the
   section renders that stayed in Humans.UI's: Common_*, Nav_MyProfile, Teams_Title,
   Profile_BuildStrip_Title, and the five Shifts_ keys pinned there by a renderer this
   assembly cannot be referenced from — see ShiftsResource's remarks for which and why. A
   call site on the wrong one of the two renders its raw key in all six languages. *@
@inject IStringLocalizer<ShiftsResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Everything the section's views open — <vc:human>, <vc:human-search>, <vc:audit-log> —
   is Humans.UI's. <vc:shift-signups> is this section's own component, public under
   Contracts/, and the section does not render it. *@
@addTagHelper *, Humans.UI
@addTagHelper *, Humans.Shifts
