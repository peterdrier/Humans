@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by ShiftsPageRenderTests (step 12). *@
@using Humans.Base.Extensions
@using Humans.Base.Enums
@using Humans.Shifts
@using Humans.Shifts.Contracts
@using Humans.Shifts.Controllers
@using Humans.Shifts.Domain
@using Humans.Shifts.Helpers
@using Humans.Shifts.Models
@using Humans.Shifts.Services
@using Humans.Shifts.Services.Dtos
@using Humans.Teams.Contracts
@using Humans.Base
@using Humans.Base.Authorization
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Humans.Base.ViewComponents
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NodaTime
@using NodaTime.Text
@* Localizer is the section's own 328-key set. SharedLocalizer covers the keys the
   section renders that stayed in Humans.UI's: Common_*, Nav_MyProfile, Teams_Title,
   Profile_BuildStrip_Title, Medical_Badge (Shared/_VolunteerProfileBadges, which arrived
   from Humans.UI at G5 lane 4b-i — nobodies-collective/Humans#866), and the five Shifts_
   keys pinned there by a renderer this assembly cannot be referenced from — see
   ShiftsResource's remarks for which and why. A call site on the wrong one of the two
   renders its raw key in all six languages. *@
@inject IStringLocalizer<ShiftsResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Everything the section's views open — <vc:human>, <vc:human-search> — is Humans.UI's.
   <vc:shift-signups> is this section's own component, public under Contracts/, and the
   section does not render it. (The audit-log component was listed here too, but no Shifts
   view has ever rendered it; it now lives in Humans.AuditLog, and
   AuditLogPageRenderTests scans for the tag literally — nobodies-collective/Humans#866.) *@
@addTagHelper *, Humans.Base
@addTagHelper *, Humans.Shifts
