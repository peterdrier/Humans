@model Humans.Shifts.ViewComponents.ShiftsGalleryViewModel

@* The wg-* classes are the gallery page's; this renders inside it. *@

@functions {
    private static IHtmlContent ParamsBlock(params (string Name, string Description)[] entries)
    {
        var html = new System.Text.StringBuilder();
        html.Append("<dl class=\"wg-params\">");
        foreach (var (name, desc) in entries)
        {
            html.Append($"<dt>{System.Net.WebUtility.HtmlEncode(name)}</dt><dd>{desc}</dd>");
        }
        html.Append("</dl>");
        return new HtmlString(html.ToString());
    }
}

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_RotaHeader.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_RotaHeader.cshtml</span>
    </div>
    <div class="wg-card-note">Rota title block — name, description, priority, signup-policy line. Used at the top of rota detail pages.</div>
    @ParamsBlock(
        ("@@model", "<code>RotaHeaderViewModel</code> — Rota (RotaInfo), ShowPreferenceStar (bool)")
    )
    <div class="wg-card-example @(Model.Rota is null ? "is-empty" : "")">
        @if (Model.Rota is not null)
        {
            @await Html.PartialAsync("_RotaHeader", new RotaHeaderViewModel
            {
                Rota = Model.Rota,
                ShowPreferenceStar = true,
            })
        }
        else
        {
            <text>(No rota in the active event — visit <a href="/Admin/Events">/Admin/Events</a> and create a rota under any department to see this populated.)</text>
        }
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_RotaBadges.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_RotaBadges.cshtml</span>
    </div>
    <div class="wg-card-note">Priority, period, visibility, preference, and tag badges shared by rota headers and the public shifts browser.</div>
    @ParamsBlock(
        ("@@model", "<code>RotaHeaderViewModel</code> -- Rota plus ShowPreferenceStar, ShowPeriodBadge, ShowTags, BadgeSpacingClass")
    )
    <div class="wg-card-example">
        @{
            var widgetGalleryBadgeRota = new RotaInfo(
                Id: Guid.Empty,
                EventSettingsId: Guid.Empty,
                TeamId: Guid.Empty,
                Name: "Gate Support",
                Description: null,
                PracticalInfo: null,
                Priority: ShiftPriority.Essential,
                Policy: SignupPolicy.Public,
                Period: RotaPeriod.Build,
                IsVisibleToVolunteers: false,
                Tags: [new ShiftTagSummary(Guid.NewGuid(), "Outdoor"), new ShiftTagSummary(Guid.NewGuid(), "Radio")]);
        }
        @await Html.PartialAsync("_RotaBadges", new RotaHeaderViewModel
        {
            Rota = widgetGalleryBadgeRota,
            ShowPreferenceStar = true,
            BadgeSpacingClass = "me-1",
        })
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_RotaDetails.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_RotaDetails.cshtml</span>
    </div>
    <div class="wg-card-note">Optional rota description and practical-info markdown block shared by rota headers and the public shifts browser.</div>
    @ParamsBlock(
        ("@@model", "<code>RotaHeaderViewModel</code> -- Rota plus ShowDescription, ShowPracticalInfo, DescriptionCssClass, PracticalInfoCssClass")
    )
    <div class="wg-card-example">
        @await Html.PartialAsync("_RotaDetails", new RotaHeaderViewModel
        {
            Rota = new RotaInfo(
                Id: Guid.Empty,
                EventSettingsId: Guid.Empty,
                TeamId: Guid.Empty,
                Name: "Gate Support",
                Description: "Welcome volunteers, check wristbands, and keep arrivals moving.",
                PracticalInfo: "Meet at the gate desk. Bring water and a charged phone.",
                Priority: ShiftPriority.Normal,
                Policy: SignupPolicy.Public,
                Period: RotaPeriod.Event,
                IsVisibleToVolunteers: true,
                Tags: []),
            DescriptionCssClass = "text-muted small mb-2",
            PracticalInfoCssClass = "text-muted small mb-0",
        })
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_EventRotaTable.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_EventRotaTable.cshtml</span>
    </div>
    <div class="wg-card-note">The shifts table — one row per shift with phase badge, slot count, and signup chips. Rendered here for the first rota of the first department in the active event (up to 8 shifts).</div>
    @ParamsBlock(
        ("@@model", "<code>EventRotaTableViewModel</code> — Shifts (List&lt;ShiftDisplayItem&gt;), EventSettings, UserSignupShiftIds, UserSignupStatuses, ShowSignups, plus filter state (FilterDepartmentId, FilterFromDate/ToDate, FilterPeriod, FilterPeriods, FilterTagIds, Sort)")
    )
    <div class="wg-card-example @(Model.RotaShifts.Count == 0 ? "is-empty" : "")">
        @if (Model.RotaShifts.Count > 0 && Model.EventSettings is not null)
        {
            @await Html.PartialAsync("_EventRotaTable", new EventRotaTableViewModel
            {
                Shifts = Model.RotaShifts.ToList(),
                EventSettings = Model.EventSettings,
                UserSignupShiftIds = Model.UserSignupShiftIds.ToHashSet(),
                ShowSignups = true,
            })
        }
        else
        {
            <text>(No rota with shifts found in the active event — create a rota under any department in <a href="/Admin/Events">/Admin/Events</a> with at least one shift.)</text>
        }
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">&lt;vc:dietary-missing-banner&gt;</span>
            <span class="wg-card-kind kind-vc">ViewComponent</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/ViewComponents/DietaryMissingBannerViewComponent.cs</span>
    </div>
    <div class="wg-card-note">
        Gentle dietary-info prompt shown on /Shifts and /Shifts/Mine, with an "I don't want to answer" opt-out. It never
        blocks signups. Self-gates: renders only when the user has a qualifying cantina signup and Cantina's
        dietary profile has neither a preference nor the opt-out — so it's empty here unless your account matches.
    </div>
    @ParamsBlock(
        ("userId", "<code>Guid</code> — required")
    )
    <div class="wg-card-example">
        <vc:dietary-missing-banner user-id="@Model.CurrentUserId" />
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_VolunteerProfileBadges.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_VolunteerProfileBadges.cshtml</span>
    </div>
    <div class="wg-card-note">
        Badges showing volunteer event profile info — skills, quirks, dietary, languages, optional medical. Synthetic sample below.
    </div>
    @ParamsBlock(
        ("@@model", "<code>VolunteerBadgesViewModel</code> (skills from VEP; dietary from Cantina, medical from Profile)")
    )
    <div class="wg-auth-line"><code>CanRevealMedical=true</code> only for a MedicalDataViewer — gate at the call site; the text itself comes from the audited reveal, never the model.</div>
    <div class="wg-card-example">
        @await Html.PartialAsync("_VolunteerProfileBadges",
            new VolunteerBadgesViewModel(
                UserId: Guid.Empty,
                Skills: ["Welding", "First Aid"],
                Quirks: ["Early riser", "Coffee snob"],
                Languages: ["English", "Spanish"],
                DietaryPreference: null,
                HasMedicalConditions: false,
                CanRevealMedical: true))
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">&lt;vc:shift-signups&gt;</span>
            <span class="wg-card-kind kind-vc">ViewComponent</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Contracts/ShiftSignupsViewComponent.cs</span>
    </div>
    <div class="wg-card-note">A human's shift signups for the active event, split into Upcoming / Pending / Past.</div>
    @ParamsBlock(
        ("userId", "<code>Guid</code> — required"),
        ("viewMode", "<code>ShiftSignupsViewMode</code> — Self · Admin"),
        ("displayName", "<code>string?</code> — caller-provided name to label the panel")
    )
    <div class="wg-card-example">
        <vc:shift-signups user-id="@Model.CurrentUserId" view-mode="@ShiftSignupsViewMode.Self" />
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_StaffingChart.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_StaffingChart.cshtml</span>
    </div>
    <div class="wg-card-note">Per-day staffing chart: confirmed vs total slots, set-up / event / strike. Caller passes a unique chart id so multiple instances can coexist. Synthetic days below.</div>
    @ParamsBlock(
        ("@@model", "<code>(List&lt;DailyStaffingData&gt; Data, string ChartId)</code> tuple — slots and bookings by day")
    )
    <div class="wg-card-example">
        @await Html.PartialAsync("_StaffingChart", (Data: new List<DailyStaffingData>
        {
            new(-1, "Day -1", ConfirmedCount: 8, TotalSlots: 12, MinSlots: 6, Period: "Set-up"),
            new(0, "Day 0", ConfirmedCount: 15, TotalSlots: 20, MinSlots: 10, Period: "Event"),
            new(1, "Day 1", ConfirmedCount: 5, TotalSlots: 10, MinSlots: 4, Period: "Strike"),
        }, ChartId: "wg-staffing-chart"))
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">_StaffingHoursChart.cshtml</span>
            <span class="wg-card-kind kind-pa">Partial</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/Views/Shared/_StaffingHoursChart.cshtml</span>
    </div>
    <div class="wg-card-note">Per-day staffing hours, stacked by shift priority (Essential / Important / Normal). Hours = duration × MaxVolunteers; all-day shifts count 8h per slot. Synthetic days below.</div>
    @ParamsBlock(
        ("@@model", "<code>(List&lt;DailyStaffingHours&gt; Data, string ChartId)</code> tuple")
    )
    <div class="wg-card-example">
        @await Html.PartialAsync("_StaffingHoursChart", (Data: new List<DailyStaffingHours>
        {
            new(-1, "Day -1", EssentialHours: 12.5, ImportantHours: 8.0, NormalHours: 4.0),
            new(0, "Day 0", EssentialHours: 20.0, ImportantHours: 15.0, NormalHours: 10.0),
            new(1, "Day 1", EssentialHours: 6.0, ImportantHours: 5.0, NormalHours: 2.0),
        }, ChartId: "wg-staffing-hours-chart"))
    </div>
</div>

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">ShiftsSearchResultViewComponent.cs</span>
            <span class="wg-card-kind kind-vc">ViewComponent</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.Shifts/ViewComponents/ShiftsSearchResultViewComponent.cs</span>
    </div>
    <div class="wg-card-note">One rota-search result row (<code>&lt;vc:shifts-search-result&gt;</code>), keyed by rota id. Shifts stitches the owning team's name itself; the link is the department-filtered list, since there is no single-rota page. Renders nothing when the id does not resolve.</div>
    @ParamsBlock(
        ("rota-id", "<code>Guid</code> — the matched rota")
    )
    <div class="wg-card-example">
        @if (Model.Rota is not null)
        {
            <div class="list-group">
                <vc:shifts-search-result rota-id="@Model.Rota.Id" />
            </div>
        }
        else
        {
            <div class="text-muted small">No rota in the active burn to key the row from.</div>
        }
    </div>
</div>

