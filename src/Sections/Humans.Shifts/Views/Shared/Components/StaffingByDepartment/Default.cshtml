@model Humans.Shifts.ViewComponents.StaffingByDepartmentViewModel

<div class="card">
    <div class="card-head">
        <h3>Staffing by department</h3>
        <small>
            @if (Model.Total.HasValue)
            {
                <text>event-wide · @Model.Filled / @Model.Total shifts</text>
            }
        </small>
    </div>
    <div class="staffing">
        <p class="text-muted px-3">
            Live staffing tile coming — see
            <a asp-controller="Shifts" asp-action="Index">Shifts</a>.
        </p>
    </div>
</div>
