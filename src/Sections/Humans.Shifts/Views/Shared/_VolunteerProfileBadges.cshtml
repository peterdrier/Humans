@model Humans.Shifts.Contracts.VolunteerBadgesViewModel

@if (Model != null)
{
    <span class="volunteer-badges">
        @foreach (var skill in Model.Skills)
        {
            <span class="badge bg-info me-1">@skill</span>
        }
        @foreach (var quirk in Model.Quirks)
        {
            <span class="badge bg-secondary me-1">@quirk</span>
        }
        @if (!string.IsNullOrEmpty(Model.DietaryPreference))
        {
            <span class="badge bg-success me-1">@Model.DietaryPreference</span>
        }
        @foreach (var lang in Model.Languages)
        {
            <span class="badge bg-primary me-1">@lang</span>
        }
        @if (Model.CanRevealMedical)
        {
            @* Shifts never knows whether conditions are on file: the click posts to Users' audited reveal and
               shows what comes back. Medical_Badge is in SharedResource; Localizer here would render the raw key. *@
            <button type="button" class="badge bg-danger border-0 medical-reveal"
                    data-reveal-url="@Url.Action("RevealMedical", "ProfileView", new { id = Model.UserId })"
                    data-none-text="@Localizer["Shifts_Medical_NoneOnFile"].Value"
                    data-failed-text="@Localizer["Shifts_Medical_RevealFailed"].Value"
                    title="@Localizer["Shifts_Medical_RevealTitle"].Value">
                <i class="fa-solid fa-eye me-1"></i>@SharedLocalizer["Medical_Badge"]
            </button>
        }
    </span>
}
