@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error. *@
@using Humans.Containers
@using Humans.Containers.Contracts
@using Humans.Base
@using Humans.Base.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ContainersResource> Localizer
@* Shared strings (Common_*, Camp_Plural) come from SharedLocalizer explicitly, so the set a key comes from is
   visible at the call site. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
