@model IReadOnlyList<Humans.Finance.Contracts.ExpenseReconLine>

@functions {
    private static (string Css, string Label) LineBadge(ExpenseReconLineStatus status) => status switch
    {
        ExpenseReconLineStatus.Booked => ("bg-success", "Booked"),
        ExpenseReconLineStatus.Pending => ("bg-secondary", "Pending"),
        ExpenseReconLineStatus.Missing => ("bg-danger", "Missing"),
        _ => ("bg-danger", "Duplicated"),
    };
}

@{
    Func<ExpenseReconLine, IHtmlContent> reportCell = @<text><a href="/Expenses/@item.ExpenseReportId">@item.ExpenseReportId.ToString()[..8]</a></text>;
    Func<ExpenseReconLine, IHtmlContent> expectedCell = @<text>@item.ExpectedAmount.ToEuro()</text>;
    Func<ExpenseReconLine, IHtmlContent> entryCell = @<text>
        @if (item.LedgerEntryNumber is { } entry)
        {
            <a asp-action="CreditorStatement" asp-route-accountNum="@item.LedgerAccountNum">@item.LedgerAccountNum</a>
            <span>#@entry</span>
            <div class="small text-muted">@item.LedgerDate?.ToInvariantDate()</div>
        }
        else
        {
            <span class="text-muted">—</span>
        }
    </text>;
    Func<ExpenseReconLine, IHtmlContent> statusCell = @<text>
        <span class="badge @LineBadge(item.Status).Css">@LineBadge(item.Status).Label</span>
        @if (item.Status is ExpenseReconLineStatus.Missing or ExpenseReconLineStatus.Pending)
        {
            <div class="small text-muted">push: @item.PushState</div>
        }
        @if (item.DuplicateEntryNumbers.Count > 0)
        {
            <div class="small">@item.DuplicateEntryNumbers.Count extra · @item.ExcessAmount.ToEuro()</div>
        }
    </text>;
    var table = TableModel.For(Model)
        .Column("Date", l => l.DocumentDate.ToInvariantDate(), o => o.Css("text-nowrap"))
        .Human("Member", l => l.CreditorUserId, HumanLink.None)
        .Template("Report", reportCell)
        .Column("Line", l => l.LineId is null ? "(whole report, legacy)" : l.Description)
        .Template("Expected", expectedCell, o => o.End().Css("text-nowrap"), sortBy: l => l.ExpectedAmount)
        .Template("Ledger entry", entryCell, sortBy: l => l.LedgerEntryNumber)
        .Template("Status", statusCell, sortBy: l => l.Status)
        .Css("align-middle")
        .Build();
}
<div class="mb-4"><partial name="_Table" model="table" /></div>
