@model Humans.Finance.Models.CreditorsPageVm
@{
    ViewData["Title"] = "Creditor Accounts";

    // Header links toggle the direction of the active column and open every other one ascending.
    string ToggleDir(string col) => Model.SortBy == col && Model.SortDir == "asc" ? "desc" : "asc";
    string Header(string label, string col) =>
        Model.SortBy == col ? label + (Model.SortDir == "asc" ? " ▲" : " ▼") : label;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Creditor Accounts</h1>
    <div class="d-flex gap-2">
        <a href="/Holded" class="btn btn-outline-secondary"
           title="Ledger mirror status, sync buttons and the full account list live on the Holded admin screen.">
            <i class="fa-solid fa-rotate me-1"></i>Holded sync
        </a>
        <a asp-controller="BudgetAdmin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Finance
        </a>
    </div>
</div>

<p class="text-muted">
    Holded creditor accounts (40000000–40000999). <strong>Balance</strong> is shown from the member's
    side: a positive figure is money the organisation owes them, a negative one is money they owe it.
    Holded's own view of the same account, debit and credit as posted, is linked from each statement.
    Bind a member to an account from their expense report, and unbind here. An account should carry
    exactly one member — a row showing two is flagged and needs one of them cleared.
</p>

@if (Model.Unresolved.Count > 0)
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning-subtle">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>Unresolved creditor links
        </div>
        <div class="card-body">
            <p class="text-muted">
                These members pushed an expense report but their Holded creditor-account number never
                resolved — neither the one-shot push lookup nor Holded's own contact list has a number
                for them. There is no automatic retry; bind each one manually once you know their
                creditor account (40000000–40000999) in Holded.
            </p>
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Member</th><th>Source</th><th>Bind to account</th></tr></thead>
                <tbody>
                @foreach (var b in Model.Unresolved)
                {
                    <tr>
                        <td>@b.MemberName</td>
                        <td class="text-muted small">@b.Source</td>
                        <td>
                            <form asp-action="BindCreditor" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@b.UserId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <input type="number" name="supplierAccountNum" class="form-control form-control-sm"
                                       style="max-width: 10rem" placeholder="e.g. 40000004" required
                                       min="40000000" max="40000999" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Bind</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Accounts.Any())
{
    <div class="card"><div class="card-body text-center py-5 text-muted">
        No creditor balances cached yet — run the ledger-mirror sync from
        <a href="/Holded">the Holded admin screen</a>. (The Unmatched page's "Sync Now" pulls purchase
        documents, which never populate creditor balances.)
    </div></div>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Creditors" asp-route-sort="account" asp-route-dir="@ToggleDir("account")"
                           class="text-decoration-none">@Header("Account", "account")</a>
                    </th>
                    <th>
                        <a asp-action="Creditors" asp-route-sort="name" asp-route-dir="@ToggleDir("name")"
                           class="text-decoration-none">@Header("Name", "name")</a>
                    </th>
                    <th class="text-end">
                        <a asp-action="Creditors" asp-route-sort="balance" asp-route-dir="@ToggleDir("balance")"
                           class="text-decoration-none">@Header("Balance", "balance")</a>
                    </th>
                    <th>
                        <a asp-action="Creditors" asp-route-sort="member" asp-route-dir="@ToggleDir("member")"
                           class="text-decoration-none">@Header("Member", "member")</a>
                    </th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Accounts)
            {
                <tr>
                    @* A null balance means no cached ledger lines, which is exactly when
                       CreditorStatement 404s — a contact with no journal activity yet. Show the
                       number without a link rather than a dead one. *@
                    <td>
                        @if (r.Balance.HasValue)
                        {
                            <a asp-action="CreditorStatement" asp-route-accountNum="@r.SupplierAccountNum">@r.SupplierAccountNum</a>
                        }
                        else
                        {
                            <span title="No cached ledger activity yet — nothing to show on a statement.">@r.SupplierAccountNum</span>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(r.Name) ? "—" : r.Name)</td>
                    <td class="text-end">
                        @if (r.Balance is { } bal)
                        {
                            <span class="@(bal > 0 ? "text-danger fw-semibold" : "")">@bal.ToEuro()</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    @* Every binding is listed, not just one. Two members on a single 400000xx point one
                       person's expense payments at the other's creditor account; the automatic push
                       paths record what Holded assigned rather than refusing it, so this table is
                       where that collision has to become visible. *@
                    <td>
                        @if (r.Bindings.Count == 0)
                        {
                            <span class="text-muted"><i class="fa-solid fa-link-slash me-1"></i>unbound</span>
                        }
                        else
                        {
                            @if (r.HasCollision)
                            {
                                <div class="text-danger small fw-semibold mb-1">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Collision —
                                    @r.Bindings.Count members share this account. Unbind all but the one who owns it in Holded.
                                </div>
                            }
                            @foreach (var b in r.Bindings)
                            {
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span><i class="fa-solid fa-link me-1 text-success"></i>@b.MemberName</span>
                                    <span class="text-muted small">(@b.Source)</span>
                                    <form asp-action="UnbindCreditor" method="post" class="d-inline"
                                          data-confirm="Clear @b.MemberName's creditor account binding? Their next expense push will resolve it again from Holded.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@b.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0">Unbind</button>
                                    </form>
                                </div>
                            }
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
