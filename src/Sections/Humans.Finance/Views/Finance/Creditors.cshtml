@using System.Globalization
@model Humans.Finance.Models.CreditorsPageVm
@{
    ViewData["Title"] = "Creditor Accounts";

    // `<input type="number">` speaks invariant, and so does the controller that parses it back.
    string Amount(decimal? value) => (value ?? 0m).ToString("0.00", CultureInfo.InvariantCulture);

    string ToggleDir(string col) => Model.SortBy == col && Model.SortDir == "asc" ? "desc" : "asc";
    string Header(string label, string col) =>
        Model.SortBy == col ? label + (Model.SortDir == "asc" ? " ▲" : " ▼") : label;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Creditor Accounts</h1>
    <div class="d-flex gap-2">
        <a asp-action="Sepa" class="btn btn-outline-secondary"
           title="Generated payout files, their transfers, and the button that books each payment into Holded.">
            <i class="fa-solid fa-file-invoice-dollar me-1"></i>SEPA transfers
        </a>
        <a asp-action="HoldedDuplicates" class="btn btn-outline-secondary"
           title="Expense lines whose Holded document was created twice, and the button that removes the extras.">
            <i class="fa-solid fa-clone me-1"></i>Duplicate docs
        </a>
        <a asp-action="ExpenseRecon" class="btn btn-outline-secondary"
           title="Approved expense lines against the Holded documents and creditor balances.">
            <i class="fa-solid fa-scale-balanced me-1"></i>Expense recon
        </a>
        <a href="/Holded" class="btn btn-outline-secondary"
           title="Ledger mirror status, sync buttons and the full account list live on the Holded admin screen.">
            <i class="fa-solid fa-rotate me-1"></i>Holded sync
        </a>
        <a asp-controller="BudgetAdmin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Finance
        </a>
    </div>
</div>

@if (Model.DuplicateFlaggedAccounts > 0 || Model.ReconProblems > 0)
{
    <div class="alert alert-danger">
        @if (Model.DuplicateFlaggedAccounts > 0)
        {
            <div>
                <i class="fa-solid fa-clone me-1"></i>
                <strong>@Model.DuplicateFlaggedAccounts creditor account@(Model.DuplicateFlaggedAccounts == 1 ? "" : "s")</strong>
                carr@(Model.DuplicateFlaggedAccounts == 1 ? "ies" : "y") duplicate documents in Holded: an expense line matches more
                than one purchase document, so the balance is inflated. Those rows cannot be paid until the extras are removed on
                <a asp-action="HoldedDuplicates" class="alert-link">Duplicate docs</a>.
            </div>
        }
        @if (Model.ReconProblems > 0)
        {
            <div>
                <i class="fa-solid fa-scale-unbalanced me-1"></i>
                <strong>@Model.ReconProblems expense reconciliation problem@(Model.ReconProblems == 1 ? "" : "s")</strong>:
                approved expense lines and Holded disagree. See the
                <a asp-action="ExpenseRecon" class="alert-link">expense reconciliation</a>.
            </div>
        }
    </div>
}
@if (Model.DuplicateFlaggedAccounts == 0 && Model.DuplicateCheckUnavailable)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>
        Holded's document list could not be read, so duplicate documents cannot be ruled out; no payout can be generated until it can.
    </div>
}
@if (Model.ReconUnavailable)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>
        The expense reconciliation cannot be computed: the Holded document mirror has never synced.
        See the <a asp-action="ExpenseRecon" class="alert-link">expense reconciliation</a>.
    </div>
}

<p class="text-muted">
    Holded creditor accounts (40000000–41999999). <strong>Balance</strong> is shown from the member's
    side: a positive figure is money the organisation owes them, a negative one is money they owe it.
    Holded's own view of the same account, debit and credit as posted, is linked from each statement.
    Bind a member to an account from their expense report, and unbind here. An account should carry
    exactly one member — a row showing two is flagged and needs one of them cleared.
</p>

<p class="text-muted">
    <strong>Pay out</strong> ticks the accounts to include in a SEPA credit-transfer file for the
    bank's "Enviar ficheros". Only single-bound accounts with a positive balance and an IBAN on their
    Holded contact can be paid; the amount defaults to the full balance and a partial payout leaves
    the remainder owed. Nothing here marks a report or a member as paid — the balance clears when the
    payment is booked in Holded and the next ledger sync picks it up. Book it from
    <a asp-action="Sepa">SEPA transfers</a> once the file is with the bank.
</p>

@if (Model.Unresolved.Count > 0)
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning-subtle">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>Unresolved creditor links
        </div>
        <div class="card-body">
            <p class="text-muted">
                These members pushed an expense report but their Holded creditor-account number never
                resolved — neither the one-shot push lookup nor Holded's own contact list has a number
                for them. There is no automatic retry; bind each one manually once you know their
                creditor account (40000000–41999999) in Holded.
            </p>
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Member</th><th>Source</th><th>Bind to account</th></tr></thead>
                <tbody>
                @foreach (var b in Model.Unresolved)
                {
                    <tr>
                        <td>@b.MemberName</td>
                        <td class="text-muted small">@b.Source</td>
                        <td>
                            <form asp-action="BindCreditor" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@b.UserId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <input type="number" name="supplierAccountNum" class="form-control form-control-sm"
                                       style="max-width: 10rem" placeholder="e.g. 40000004" required
                                       min="40000000" max="41999999" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Bind</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Accounts.Any())
{
    <div class="card"><div class="card-body text-center py-5 text-muted">
        No creditor balances cached yet — run the ledger-mirror sync from
        <a href="/Holded">the Holded admin screen</a>. (The Unmatched page's "Sync Now" pulls purchase
        documents, which never populate creditor balances.)
    </div></div>
}
else
{
    @* Standalone, not wrapped around the table: each row already carries an Unbind form, and HTML
       forbids nesting one form in another. The payout inputs join this one by id instead. *@
    <form id="sepaForm" asp-action="GenerateSepa" method="post"
          class="d-flex justify-content-end align-items-center gap-2 mb-3">
        @Html.AntiForgeryToken()
        @if (Model.Sepa.IsAvailable)
        {
            <label class="text-muted small mb-0" for="maxPerTransfer">Cap per transfer (€)</label>
            <input type="number" id="maxPerTransfer" name="maxPerTransfer" form="sepaForm"
                   class="form-control form-control-sm" style="max-width: 7rem"
                   step="0.01" min="0.01" required value="@Amount(Model.Sepa.MaxPerTransfer)" />
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-file-arrow-down me-1"></i>Generate SEPA file
            </button>
        }
        else
        {
            <span class="text-warning-emphasis small">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.Sepa.UnavailableReason
            </span>
        }
    </form>

    @* Default on: hides rows we owe nothing to, so the screen opens on the accounts a payout would touch. Client-side
       only; unticking reveals the rest. *@
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="owedOnly" checked>
        <label class="form-check-label" for="owedOnly">Only show accounts we owe money to</label>
    </div>

    <div class="card">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 14rem">Pay out</th>
                    <th>
                        <a asp-action="Creditors" asp-route-sort="account" asp-route-dir="@ToggleDir("account")"
                           class="text-decoration-none">@Header("Account", "account")</a>
                    </th>
                    <th>
                        <a asp-action="Creditors" asp-route-sort="name" asp-route-dir="@ToggleDir("name")"
                           class="text-decoration-none">@Header("Name", "name")</a>
                    </th>
                    <th class="text-end">
                        <a asp-action="Creditors" asp-route-sort="balance" asp-route-dir="@ToggleDir("balance")"
                           class="text-decoration-none">@Header("Balance", "balance")</a>
                    </th>
                    <th class="text-end" title="Approved, still-owing purchase documents on the bound Holded contact: how many payments a payout to this row would post.">
                        <a asp-action="Creditors" asp-route-sort="opendocs" asp-route-dir="@ToggleDir("opendocs")"
                           class="text-decoration-none">@Header("Open docs", "opendocs")</a>
                    </th>
                    <th>
                        <a asp-action="Creditors" asp-route-sort="member" asp-route-dir="@ToggleDir("member")"
                           class="text-decoration-none">@Header("Member", "member")</a>
                    </th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Accounts)
            {
                <tr class="creditor-row" data-owed="@(r.Balance is > 0m ? "1" : "0")">
                    @* Only a single-bound account with a positive balance and a Holded IBAN can be
                       paid; everything else says why instead of offering a box. The service
                       re-derives the same rules — this column is display, not the gate. *@
                    <td>
                        @if (!Model.Sepa.IsAvailable)
                        {
                            <span class="text-muted small">—</span>
                        }
                        else if (r.IsPayable)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="checkbox" form="sepaForm"
                                       name="selected" value="@r.SupplierAccountNum"
                                       aria-label="Include account @r.SupplierAccountNum in the SEPA file" />
                                <div class="input-group input-group-sm" style="max-width: 8rem">
                                    <span class="input-group-text">€</span>
                                    <input type="number" class="form-control" form="sepaForm"
                                           step="0.01" min="0.01"
                                           max="@Amount(r.Balance)" value="@Amount(r.Balance)"
                                           name="amounts[@r.SupplierAccountNum]"
                                           aria-label="Amount to pay account @r.SupplierAccountNum" />
                                </div>
                            </div>
                            <div class="text-muted small">@r.IbanMasked</div>
                        }
                        else if (r.HasDuplicateDocuments == true)
                        {
                            <a asp-action="HoldedDuplicates" class="small text-danger">@r.NotPayableReason</a>
                        }
                        else
                        {
                            <span class="text-muted small">@r.NotPayableReason</span>
                        }
                    </td>
                    @* A null balance means no cached ledger lines, which is exactly when
                       CreditorStatement 404s — a contact with no journal activity yet. Show the
                       number without a link rather than a dead one. *@
                    <td>
                        @if (r.Balance.HasValue)
                        {
                            <a asp-action="CreditorStatement" asp-route-accountNum="@r.SupplierAccountNum">@r.SupplierAccountNum</a>
                        }
                        else
                        {
                            <span title="No cached ledger activity yet — nothing to show on a statement.">@r.SupplierAccountNum</span>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(r.Name) ? "—" : r.Name)</td>
                    <td class="text-end">
                        @if (r.Balance is { } bal)
                        {
                            <span class="@(bal > 0 ? "finance-positive fw-semibold" : bal < 0 ? "finance-negative fw-semibold" : "")">@bal.ToEuro()</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (r.OpenDocs is { } open)
                        {
                            @open
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    @* Every binding, not just one: the automatic push paths record what Holded assigned rather than
                       refusing, so this table is where a collision becomes visible. *@
                    <td>
                        @if (r.Bindings.Count == 0)
                        {
                            <span class="text-muted"><i class="fa-solid fa-link-slash me-1"></i>unbound</span>
                        }
                        else
                        {
                            @if (r.HasCollision)
                            {
                                <div class="text-danger small fw-semibold mb-1">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Collision —
                                    @r.Bindings.Count members share this account. Unbind all but the one who owns it in Holded.
                                </div>
                            }
                            @foreach (var b in r.Bindings)
                            {
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span><i class="fa-solid fa-link me-1 text-success"></i>@b.MemberName</span>
                                    <span class="text-muted small">(@b.Source)</span>
                                    <form asp-action="UnbindCreditor" method="post" class="d-inline"
                                          data-confirm="Clear @b.MemberName's creditor account binding? Their next expense push will resolve it again from Holded.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@b.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0">Unbind</button>
                                    </form>
                                </div>
                            }
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <script>
        // Idempotency guard: success answers with a download, so the page never navigates and a second click would
        // write a second payout file. A reload re-enables it, and the balances are stale by then anyway.
        document.getElementById('sepaForm')?.addEventListener('submit', function (e) {
            var btn = e.target.querySelector('button[type="submit"]');
            if (!btn) return;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Generating…';
        });

        // Display only: the selection posts from #sepaForm, and only payable rows carry a checkbox.
        (function () {
            var owedOnly = document.getElementById('owedOnly');
            if (!owedOnly) return;
            function apply() {
                document.querySelectorAll('tr.creditor-row').forEach(function (row) {
                    row.style.display = (owedOnly.checked && row.dataset.owed !== '1') ? 'none' : '';
                });
            }
            owedOnly.addEventListener('change', apply);
            apply();
        })();
    </script>
}
