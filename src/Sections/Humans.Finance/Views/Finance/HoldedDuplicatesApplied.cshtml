@model Humans.Finance.Models.HoldedDuplicateApplyResult
@{
    ViewData["Title"] = "Duplicate Holded Documents — applied";
    ViewData[Humans.Base.ViewComponents.AdminNavComposition.ParentKey] = "Creditors";
    // Holded's own sign: a negative creditor balance is money the organisation owes.
    string Owed(decimal? balance) => balance is { } b ? (-b).ToEuro() : "—";
}

<page-header title="Duplicate Holded Documents — applied">
    <a asp-action="HoldedDuplicates" class="btn btn-outline-secondary">Run the check again</a>
    <a asp-action="Creditors" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Creditor Accounts
    </a>
</page-header>

@if (Model.Error is { } error)
{
    <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>@error</div>
}
else
{
    <div class="alert @(Model.Failures == 0 ? "alert-success" : "alert-warning")">
        Deleted <strong>@Model.DeletedDocuments document@(Model.DeletedDocuments == 1 ? "" : "s")</strong> and
        <strong>@Model.DeletedContacts contact@(Model.DeletedContacts == 1 ? "" : "s")</strong>.
        @if (Model.Failures > 0)
        {
            <span>@Model.Failures deletion@(Model.Failures == 1 ? "" : "s") failed — see below.</span>
        }
        @if (Model.SyncError is { } syncError)
        {
            <div class="mt-1">The ledger sync afterwards failed (@syncError); the deletions stand and the next nightly sync will pick them up.</div>
        }
    </div>

        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell0 = @<text><vc:human user-id="@item.UserId" link="None" /> <div class="text-muted small">@item.ContactName</div></text>;
        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell1 = @<text>
            @if (item.SupplierAccountNum is { } account)
            {
                <a asp-action="CreditorStatement" asp-route-accountNum="@account">@account</a>
            }
            else
            {
                <span>—</span>
            }

        </text>;
        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell2 = @<text>@Owed(item.BalanceBefore)</text>;
        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell3 = @<text>@Owed(item.BalanceAfter)</text>;
        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell4 = @<text>@(item.DeletedDocIds.Count == 0 ? "—" : string.Join(", ", item.DeletedDocIds))</text>;
        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell5 = @<text>@(item.DeletedContactIds.Count == 0 ? "—" : string.Join(", ", item.DeletedContactIds))</text>;
        Func<HoldedDuplicateMemberResult, IHtmlContent> resultCell6 = @<text>
            @foreach (var f in item.Failures)
            {
                <div>@f</div>
            }

        </text>;
        var membersTable = TableModel.For(Model.Members)
            .Template("Member", resultCell0)
            .Template("Account", resultCell1, sortBy: m => m.SupplierAccountNum)
            .Template("Owed before", resultCell2, o => o.End(), sortBy: m => m.BalanceBefore)
            .Template("Owed after", resultCell3, o => o.End(), sortBy: m => m.BalanceAfter)
            .Template("Deleted documents", resultCell4, o => o.Css("font-monospace small"))
            .Template("Deleted contacts", resultCell5, o => o.Css("font-monospace small"))
            .Template("Failures", resultCell6, o => o.Css("small text-danger").NoSort())
            .Css("align-middle")
            .Build();
    <partial name="_Table" model="membersTable" />
}
