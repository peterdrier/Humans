@model Humans.Finance.Models.SepaPayoutsPageVm
@{
    ViewData["Title"] = "SEPA Transfers";

    // Generation stamps are instants; the treasurer reads them in the org's own timezone.
    var madrid = NodaTime.DateTimeZoneProviders.Tzdb["Europe/Madrid"];
}

<style>
    .collapsed > .fa-chevron-down { transform: rotate(-90deg); }
</style>

<page-header title="SEPA Transfers">
    <div class="d-flex align-items-center gap-3">
        <span class="small text-muted">Holded bank feed synced @(Model.BankFeedSyncedAt?.ToDateTime() ?? "never")</span>
        <a asp-action="Creditors" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Creditor Accounts
        </a>
    </div>
</page-header>

<p class="text-muted">
    Every payout file generated from <a asp-action="Creditors">Creditor Accounts</a>, and the credit
    transfers inside it. <strong>Book</strong> settles the transfer in Holded: the member's open
    purchase documents are paid oldest first from the configured treasury account, and whatever they
    do not cover — a loan the member made, say — is posted as one journal entry, debit the creditor
    account, credit the bank. Booking is what closes the loop after the file has been uploaded to the
    bank; a booked transfer cannot be booked again. Sabadell debits one line per transfer but drops
    the remittance text, so each line is matched to a transfer on amount and date; once every
    transfer in a file has its line, <strong>Book file</strong> books them all in one go. Two
    unbooked transfers of one amount, or two lines for one transfer, are flagged below and settled by
    hand. <strong>Withdraw</strong> takes a transfer the bank cancelled by hand out of its file: the
    row stays for the record, no bank line is paired with it, the member is told, and their account
    is payable again. <strong>Cancel file</strong> is for a file the bank rejected whole: every transfer in it
    is withdrawn at once, without emailing anyone, so the accounts can go into a new file. Booked and cancelled
    files start collapsed; click a file's name to open it.
</p>

<form method="get" asp-action="Sepa" class="d-flex align-items-center gap-2 mb-3">
    <label for="days" class="form-label mb-0">Pair a bank line dated within</label>
    <input type="number" id="days" name="days" class="form-control form-control-sm" style="width: 5rem"
           min="0" max="90" value="@Model.ToleranceDays" />
    <span>days of the file date</span>
    <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
    <span class="text-muted small">Default @Humans.Finance.Services.IFinanceAdminService.DefaultSepaMatchToleranceDays. Widen it when the bank executed a file late; every booking from this view uses the same window.</span>
</form>

@if (Model.Run is { IsRunning: true } running)
{
    <div class="alert alert-info">
        <i class="fa-solid fa-spinner fa-spin me-1"></i>@running.What, started
        @running.StartedAt.ToDateTime(madrid). This page refreshes itself; leaving it
        does not stop the booking.
    </div>
    <script>setTimeout(function () { location.reload(); }, 3000);</script>
}
else if (Model.Run is { Result: { } last } finished)
{
    <div class="alert @(last.Succeeded ? "alert-success" : "alert-danger")">
        <strong>Last booking</strong> (@finished.What.ToLowerInvariant(),
        @finished.StartedAt.ToDateTime(madrid)): @last.Message
    </div>
}

@if (Model.UnavailableReason is { } unavailable)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@unavailable
    </div>
}

@if (Model.BankFeedError is { } bankFeedError)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@bankFeedError
    </div>
}

@if (Model.UnmatchedMovements.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">Bank lines needing a human</div>
        @{
            Func<SepaBankMovementVm, IHtmlContent> dateCell = @<text>@item.Date.ToInvariantDate()</text>;
            Func<SepaBankMovementVm, IHtmlContent> unmatchedAmountCell = @<text>@item.Amount.ToEuro()</text>;
            var unmatchedTable = TableModel.For(Model.UnmatchedMovements)
                .Template("Date", dateCell, c => c.Css("text-nowrap"), sortBy: m => m.Date)
                .Template("Amount", unmatchedAmountCell, o => o.Css("text-nowrap").End(), sortBy: m => m.Amount)
                .Column("Description", r => r.Description ?? "—", o => o.Css("text-muted small"))
                .Column("Account", r => r.ParsedAccountNum?.ToString() ?? "—")
                .Column("Why", r => r.Reason, o => o.Css("text-muted small"))
                .Css("align-middle")
                .Build();
        }
        <partial name="_Table" model="unmatchedTable" />
    </div>
}

@if (Model.Files.Count == 0)
{
    <div class="card"><div class="card-body text-center py-5 text-muted">
        No payout files generated yet — tick creditor accounts on
        <a asp-action="Creditors">Creditor Accounts</a> and generate one.
    </div></div>
}

@foreach (var file in Model.Files)
{
    <div class="card mb-4">
        @{
            var withdrawn = file.Transfers.Count(t => t.Row.IsWithdrawn);
            var cancelled = withdrawn == file.Transfers.Count;
            var unbooked = file.Transfers.Where(t => !t.Row.IsBooked && !t.Row.IsWithdrawn).ToList();
            var matched = unbooked.Count(t => t.Row.CanBook);
            var allMatched = unbooked.Count > 0 && matched == unbooked.Count
                             && Model.UnavailableReason is null;
            // A cancelled file summarises what it held; any other file what it still pays.
            var summarised = cancelled ? file.Transfers : file.Transfers.Where(t => !t.Row.IsWithdrawn).ToList();
            var summaryTotal = summarised.Sum(t => t.Row.Amount).ToEuro();
            var collapseId = $"sepa-file-{file.FileId:N}";
            var expanded = unbooked.Count > 0;
            var canCancel = Humans.Finance.Services.SepaBankBooking.CancelFileRefusal(file.Transfers.Select(t => t.Row).ToList()) is null;
        }
        <div class="card-header d-flex justify-content-between align-items-center gap-3">
            <button type="button" class="btn btn-link text-reset text-decoration-none p-0 text-start @(expanded ? "" : "collapsed")"
                    data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@collapseId">
                <i class="fa-solid fa-chevron-down fa-fw me-1 small"></i>
                <span class="font-monospace">@file.FileName</span>
                @if (cancelled)
                {
                    <span class="badge text-bg-dark ms-2" title="Cancelled whole: every transfer was withdrawn and the bank never executed it.">Cancelled</span>
                }
                else if (unbooked.Count == 0)
                {
                    <span class="badge text-bg-success ms-2">Done</span>
                }
                @if (withdrawn > 0 && !cancelled)
                {
                    <span class="badge text-bg-dark ms-2" title="Cancelled at the bank before execution and withdrawn from this file; not counted toward booking it.">@withdrawn withdrawn</span>
                }
                <span class="ms-2">@summarised.Count transfers · <strong>@summaryTotal</strong></span>
            </button>
            <span class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    @file.GeneratedAt.ToDateTime(madrid) by <vc:human user-id="@file.GeneratedByUserId" link="None" />
                </span>
                @if (canCancel)
                {
                    <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="CancelSepaFile" method="post"
                          data-confirm="Are you sure? Cancel the whole file @file.FileName (@summarised.Count transfers, @summaryTotal)? Only do this once the bank has rejected the file. Every transfer in it is marked withdrawn, their accounts become payable again, and no member is emailed. This cannot be undone.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="fileId" value="@file.FileId" />
                        <input type="hidden" name="days" value="@Model.ToleranceDays" />
                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">
                            <i class="fa-solid fa-ban me-1"></i>Cancel file
                        </button>
                    </form>
                }
            </span>
        </div>
        <div class="collapse @(expanded ? "show" : "")" id="@collapseId">
        @if (allMatched)
        {
            <div class="card-body border-bottom d-flex justify-content-between align-items-center gap-3">
                <div>
                    <strong>Every unbooked transfer in this file has its Sabadell line</strong>
                    <span class="text-muted">(@matched of @matched)</span> — check the lines below, then book them all.
                </div>
                <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="BookSepaFileMatches" method="post"
                      data-confirm="Book all @matched transfers of @file.FileName, each against the Sabadell line shown on its row? This posts real payments, and a journal entry for anything a member's documents do not cover.">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fileId" value="@file.FileId" />
                    <input type="hidden" name="days" value="@Model.ToleranceDays" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                        <i class="fa-solid fa-file-invoice-dollar me-1"></i>Book file
                    </button>
                </form>
            </div>
        }
        else if (unbooked.Count > 0 && matched > 0 && Model.UnavailableReason is null)
        {
            <div class="card-body border-bottom text-muted small">
                @matched of @unbooked.Count unbooked transfers have a Sabadell line; the file is booked
                only once all of them do.
            </div>
        }
        @if (file.BatchLine is { } batch && Model.UnavailableReason is null)
        {
            <div class="card-body border-bottom">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <strong>The bank debited this whole file as one line:</strong>
                        @batch.Date.ToInvariantDate() · @batch.Amount.ToEuro()
                        <div class="font-monospace small">@batch.MovementId</div>
                        <div class="text-muted small">@(batch.Description ?? "—")</div>
                        <div class="small">
                            @if (batch.QuotesFileReference)
                            {
                                <span class="badge text-bg-success">Line quotes this file's reference</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Matched on total and date only — check the line is this file</span>
                            }
                        </div>
                        @if (batch.NotProcessableReason is { } notProcessable)
                        {
                            <div class="text-muted small mt-1">Cannot process: @notProcessable</div>
                        }
                    </div>
                    @if (batch.NotProcessableReason is null)
                    {
                        <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="BookSepaFile" method="post"
                              data-confirm="Process @file.FileName against Sabadell line @batch.MovementId (@batch.Amount.ToEuro())? This books every unbooked transfer in the file: real payments, and a journal entry for anything a member's documents do not cover.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileId" value="@file.FileId" />
                            <input type="hidden" name="bankMovementId" value="@batch.MovementId" />
                            <input type="hidden" name="days" value="@Model.ToleranceDays" />
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                                <i class="fa-solid fa-file-invoice-dollar me-1"></i>Process
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
        @{
            Func<SepaTransferVm, IHtmlContent> memberCell = @<text><vc:human user-id="@item.Row.UserId" link="None" /><div class="text-muted small">@item.Row.CreditorName</div></text>;
            Func<SepaTransferVm, IHtmlContent> amountCell = @<text>@item.Row.Amount.ToEuro()</text>;
            Func<SepaTransferVm, IHtmlContent> statusCell = @<text>
                @if (item.Row.WithdrawnAt is { } withdrawnAt)
                {
                    <span class="badge text-bg-dark">Withdrawn</span>
                    <div class="text-muted small">@withdrawnAt.ToDateTime(madrid) by <vc:human user-id="@(item.Row.WithdrawnByUserId ?? Guid.Empty)" link="None" /></div>
                }
                else if (item.Row.BookedAt is { } bookedAt)
                {
                    <span class="badge text-bg-success">Booked</span>
                    @if (item.Row.ReconcilePending && item.Row.JournalEntryAmount is { } entryAmount)
                    {
                        <span class="badge text-bg-warning" title="Holded only links treasury objects to a bank line, never a ledger entry, so this share of the line is matched in Holded by hand; the sweep cannot clear it.">@entryAmount.ToEuro() of this line was posted as a journal entry and needs a manual match in Holded (@item.Row.HoldedBankMovementId)</span>
                    }
                    else if (item.Row.ReconcilePending)
                    {
                        <span class="badge text-bg-warning" title="While Holded reads the line pending, the sweep re-issues the reconcile from the recorded payment ids every two hours and stamps the row once the line reads reconciled. A line that reads partial is a human's to finish in Holded.">Reconcile pending (@item.Row.HoldedBankMovementId)</span>
                    }
                    <div class="text-muted small">@bookedAt.ToDateTime(madrid) by
                        @if (item.Row.BookedByUserId is { } bookedBy)
                        {
                            <vc:human user-id="@bookedBy" link="None" />
                        }
                        else
                        {
                            <text>automatic sweep</text>
                        }
                    </div>
                }
                else
                {
                    <span class="badge text-bg-secondary">Generated</span>
                }

            </text>;
            Func<SepaTransferVm, IHtmlContent> bookCell = @<text>
                @if (item.Row.IsWithdrawn)
                {
                    <span class="text-muted small">cancelled at the bank — nothing to book</span>
                }
                else if (item.Row.IsBooked)
                {
                    <div class="text-muted small font-monospace">@(item.Row.HoldedBankMovementId ?? "—")</div>
                }
                else if (Model.UnavailableReason is not null)
                {
                    <span class="text-muted small">—</span>
                }
                else if (item.Row.NotBookableReason is { } reason)
                {
                    <span class="text-muted small">@reason</span>
                }
                else if (item.Row.CanBook)
                {
                    @if (item.Row.CandidateMatchedByText)
                    {
                        <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="BookSepaTransfer" method="post"
                              data-confirm="Book @item.Row.Amount.ToEuro() to @item.MemberName against Sabadell line @item.Row.CandidateBankMovementId? This posts real payments, and a journal entry for anything the member's documents do not cover.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="transferId" value="@item.Row.TransferId" />
                            <input type="hidden" name="bankMovementId" value="@item.Row.CandidateBankMovementId" />
                            <input type="hidden" name="days" value="@Model.ToleranceDays" />
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="fa-solid fa-file-invoice-dollar me-1"></i>Book against this line
                            </button>
                        </form>
                        <span class="badge text-bg-success">Line names this account</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Matched on amount and date only</span>
                        <div class="small">booked with the file, above</div>
                    }
                    <div class="text-muted small">
                        @(item.Row.CandidateBankMovementDate?.ToInvariantDate() ?? "—")
                        · @(item.Row.CandidateBankMovementAmount?.ToEuro() ?? "—")
                        <div class="font-monospace">@item.Row.CandidateBankMovementId</div>
                        <div>@(item.Row.CandidateBankMovementDescription ?? "—")</div>
                    </div>
                }
                else if (file.BatchLine is not null)
                {
                    <span class="text-muted small">paid by the file's one bank line — Process above</span>
                }
                else
                {
                    <span class="text-muted small">waiting for the Sabadell line</span>
                }

            </text>;
            Func<SepaTransferVm, IHtmlContent> withdrawCell = @<text>
                @if (Humans.Finance.Services.SepaBankBooking.WithdrawRefusal(item.Row) is { } cannotWithdraw)
                {
                    @if (!item.Row.IsWithdrawn)
                    {
                        <span class="text-muted small">@cannotWithdraw</span>
                    }
                }
                else
                {
                    <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="WithdrawSepaTransfer" method="post"
                          data-confirm="Withdraw the @item.Row.Amount.ToEuro() transfer to @item.MemberName from @file.FileName? Only do this once the bank has cancelled it: the row is kept as withdrawn, no bank line will be paired with it, and the member is emailed that it was cancelled.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transferId" value="@item.Row.TransferId" />
                        <input type="hidden" name="days" value="@Model.ToleranceDays" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fa-solid fa-ban me-1"></i>Withdraw
                        </button>
                    </form>
                }

            </text>;
            var transfersTable = TableModel.For(file.Transfers)
                .Link("Account", r => r.Row.SupplierAccountNum, r => Url.Action("CreditorStatement", new { accountNum = r.Row.SupplierAccountNum }))
                .Template("Member", memberCell)
                .Column("IBAN", r => r.Row.IbanMasked, o => o.Css("font-monospace small"))
                .Template("Amount", amountCell, o => o.Css("text-nowrap").End(), sortBy: t => t.Row.Amount)
                .Template("Status", statusCell, sortBy: t => t.Row.IsWithdrawn ? 2 : t.Row.IsBooked ? 1 : 0)
                .Template("Book", bookCell, o => o.NoSort())
                .Template("Withdraw", withdrawCell, o => o.NoSort())
                .Css("align-middle")
                .Build();
        }
        <partial name="_Table" model="transfersTable" />
        </div>
    </div>
}
