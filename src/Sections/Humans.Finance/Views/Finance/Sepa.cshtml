@model Humans.Finance.Models.SepaPayoutsPageVm
@{
    ViewData["Title"] = "SEPA Transfers";

    // Generation stamps are instants; the treasurer reads them in the org's own timezone.
    var madrid = NodaTime.DateTimeZoneProviders.Tzdb["Europe/Madrid"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">SEPA Transfers</h1>
    <a asp-action="Creditors" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Creditor Accounts
    </a>
</div>

<p class="text-muted">
    Every payout file generated from <a asp-action="Creditors">Creditor Accounts</a>, and the credit
    transfers inside it. <strong>Book</strong> settles the transfer in Holded: the member's open
    purchase documents are paid oldest first from the configured treasury account, and whatever they
    do not cover — a loan the member made, say — is posted as one journal entry, debit the creditor
    account, credit the bank. Booking is what closes the loop after the file has been uploaded to the
    bank; a booked transfer cannot be booked again.
</p>

@if (Model.UnavailableReason is { } unavailable)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@unavailable
    </div>
}

@if (Model.BankFeedError is { } bankFeedError)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@bankFeedError
    </div>
}

@if (Model.UnmatchedMovements.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">Bank lines needing a human</div>
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th>Description</th>
                    <th>Account</th>
                    <th>Why</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model.UnmatchedMovements)
            {
                <tr>
                    <td>@m.Date.ToInvariantDate()</td>
                    <td class="text-end">@m.Amount.ToEuro()</td>
                    <td class="text-muted small">@(m.Description ?? "—")</td>
                    <td>@(m.ParsedAccountNum?.ToString() ?? "—")</td>
                    <td class="text-muted small">@m.Reason</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.Files.Count == 0)
{
    <div class="card"><div class="card-body text-center py-5 text-muted">
        No payout files generated yet — tick creditor accounts on
        <a asp-action="Creditors">Creditor Accounts</a> and generate one.
    </div></div>
}

@foreach (var file in Model.Files)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="font-monospace">@file.FileName</span>
            <span class="text-muted small">
                @file.GeneratedAt.ToDateTime(madrid) by @file.GeneratedByName
            </span>
        </div>
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Member</th>
                    <th>IBAN</th>
                    <th class="text-end">Amount</th>
                    <th>Status</th>
                    <th style="width: 16rem">Book</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in file.Transfers)
            {
                <tr>
                    <td>
                        <a asp-action="CreditorStatement" asp-route-accountNum="@t.Row.SupplierAccountNum">@t.Row.SupplierAccountNum</a>
                    </td>
                    <td>@t.MemberName<div class="text-muted small">@t.Row.CreditorName</div></td>
                    <td class="font-monospace small">@t.Row.IbanMasked</td>
                    <td class="text-end">@t.Row.Amount.ToEuro()</td>
                    <td>
                        @if (t.Row.BookedAt is { } bookedAt)
                        {
                            <span class="badge text-bg-success">Booked</span>
                            @if (t.Row.ReconcilePending)
                            {
                                <span class="badge text-bg-warning">Reconcile pending (@t.Row.HoldedBankMovementId)</span>
                            }
                            <div class="text-muted small">@bookedAt.ToDateTime(madrid) by @t.BookedByName</div>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Generated</span>
                        }
                    </td>
                    @* Booking is idempotent in the service; this column is display, not the gate. *@
                    <td>
                        @if (t.Row.IsBooked)
                        {
                            <div class="text-muted small font-monospace">@(t.Row.HoldedBankMovementId ?? "—")</div>
                        }
                        else if (Model.UnavailableReason is not null)
                        {
                            <span class="text-muted small">—</span>
                        }
                        else if (t.Row.NotBookableReason is { } reason)
                        {
                            <span class="text-muted small">@reason</span>
                        }
                        else if (t.Row.CanBook)
                        {
                            <form asp-action="BookSepaTransfer" method="post"
                                  data-confirm="Book @t.Row.Amount.ToEuro() to @t.MemberName against Sabadell line @t.Row.CandidateBankMovementId? This posts real payments, and a journal entry for anything the member's documents do not cover.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="transferId" value="@t.Row.TransferId" />
                                <input type="hidden" name="bankMovementId" value="@t.Row.CandidateBankMovementId" />
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i>Book against this line
                                </button>
                            </form>
                            <div class="text-muted small">
                                @(t.Row.CandidateBankMovementDate?.ToInvariantDate() ?? "—")
                                · @(t.Row.CandidateBankMovementAmount?.ToEuro() ?? "—")
                                <div class="font-monospace">@t.Row.CandidateBankMovementId</div>
                                <div>@(t.Row.CandidateBankMovementDescription ?? "—")</div>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">waiting for the Sabadell line</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
