@model Humans.Finance.Contracts.ExpenseReconReport
@{
    ViewData["Title"] = "Expense Reconciliation";
    var totals = Model.Totals;
    var lines = Model.Lines.OrderBy(l => l.Status).ThenByDescending(l => l.DocumentDate).ToList();
    var problemLines = lines.Where(l => l.IsProblem).ToList();
    var okLines = lines.Where(l => !l.IsProblem).ToList();
    var members = Model.Members.OrderByDescending(m => m.IsWarning)
        .ThenBy(m => m.MemberName, StringComparer.OrdinalIgnoreCase).ToList();
}

@functions {
    private static (string Css, string Label) MemberBadge(ExpenseReconMember member) => member.Status switch
    {
        ExpenseReconMemberStatus.Balanced => ("bg-success", "Balanced"),
        ExpenseReconMemberStatus.Off => ("bg-warning text-dark", OffReasons(member)),
        _ => member.IsWarning ? ("bg-warning text-dark", "No creditor account") : ("bg-secondary", "No creditor account"),
    };

    private static string OffReasons(ExpenseReconMember m) => string.Join(" · ", new[]
    {
        m.MissingLines > 0 ? $"{m.MissingLines} missing" : null,
        m.UnclaimedPurchaseCount > 0 ? $"{m.UnclaimedPurchaseCount} unclaimed" : null,
        m.UnmatchedTransfers.Count > 0 ? $"{m.UnmatchedTransfers.Count} SEPA not in ledger" : null,
    }.Where(r => r is not null));
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="mb-0">Expense Reconciliation</h1>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="HoldedDuplicates" class="btn btn-outline-secondary">
            <i class="fa-solid fa-clone me-1"></i>Duplicate docs
        </a>
        <a asp-action="Sepa" class="btn btn-outline-secondary">
            <i class="fa-solid fa-file-invoice-dollar me-1"></i>SEPA transfers
        </a>
        <a asp-action="Creditors" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Creditor Accounts
        </a>
    </div>
</div>

<p class="text-muted">
    Read only, from the Holded ledger mirror: each approved expense line (after the authorised-maximum allocation)
    expects one purchase line on the account its member's bound contact is on, with the same description
    (<code>ER: …</code>) and amount, counted one for one. Each member's account is then split into those purchases,
    booked SEPA payments and other movements. The year filters lines and stray purchases by date; member accounts are
    always all-time, as the ledger's are. Fixes live on the pages linked above.
</p>

@if (!Model.IsAvailable)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.UnavailableReason
        Run the ledger sync from the <a href="/Holded" class="alert-link">Holded page</a>.
    </div>
    return;
}

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <span class="text-muted">Year:</span>
    <a asp-action="ExpenseRecon" class="btn btn-sm @(Model.Year is null ? "btn-secondary" : "btn-outline-secondary")">All</a>
    @foreach (var y in Model.Years)
    {
        <a asp-action="ExpenseRecon" asp-route-year="@y"
           class="btn btn-sm @(Model.Year == y ? "btn-secondary" : "btn-outline-secondary")">@y</a>
    }
    <span class="ms-auto text-muted small">Ledger synced @Model.MirrorSyncedAt?.ToInvariantTimestamp()</span>
</div>

<div class="card mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div>
            <span class="badge bg-light text-dark">@totals.Reports reports</span>
            <span class="badge bg-light text-dark">@totals.Lines lines</span>
            <span class="badge bg-light text-dark">@totals.LedgerPurchases ledger purchases</span>
            <span class="badge @(totals.DuplicateLines > 0 ? "bg-danger" : "bg-light text-dark")">@totals.DuplicateLines duplicates · @totals.ExcessAmount.ToEuro() excess</span>
            <span class="badge @(totals.Orphans > 0 ? "bg-danger" : "bg-light text-dark")">@totals.Orphans orphans</span>
            <span class="badge @(totals.MembersOff > 0 ? "bg-warning text-dark" : "bg-light text-dark")">@totals.MembersOff members off (warning)</span>
        </div>
        <div class="ms-auto">
            @if (totals.Problems == 0)
            {
                <span class="text-success fw-semibold"><i class="fa-solid fa-check me-1"></i>0 problems</span>
                @if (totals.Warnings > 0)
                {
                    <span class="text-warning fw-semibold ms-1">· @totals.Warnings member balance warning@(totals.Warnings == 1 ? "" : "s")</span>
                }
            }
            else
            {
                <span class="text-danger fw-semibold">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>@totals.Problems problem@(totals.Problems == 1 ? "" : "s")@(totals.Warnings > 0 ? $" · {totals.Warnings} member balance warning{(totals.Warnings == 1 ? "" : "s")}" : "")
                </span>
            }
        </div>
    </div>
</div>

@if (problemLines.Count > 0)
{
    <h2 class="h4">Lines with problems</h2>
    @await Html.PartialAsync("_ExpenseReconLines", problemLines)
}

@if (Model.Orphans.Count > 0)
{
    <h2 class="h4">Orphan purchases</h2>
    <p class="text-muted">Ledger purchase lines carrying the expense push's marker that no line claims or counts as its duplicate.</p>
    <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>Date</th><th>Account</th><th>Entry</th><th>Description</th><th class="text-end">Amount</th><th>Kind</th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orphans.OrderByDescending(o => o.Date))
                {
                    <tr>
                        <td class="text-nowrap">@o.Date.ToInvariantDate()</td>
                        <td><a asp-action="CreditorStatement" asp-route-accountNum="@o.AccountNum">@o.AccountNum</a></td>
                        <td>@o.EntryNumber</td>
                        <td>@o.Description</td>
                        <td class="text-end text-nowrap">@o.Amount.ToEuro()</td>
                        <td>
                            <span class="badge bg-danger">@(o.Kind == ExpenseReconOrphanKind.UnboundContact ? "Unbound contact" : "No matching line")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Members</h2>
<p class="text-muted">
    Shown from the member's side: positive is owed to them. The ledger balance is the sum of the four columns before
    it. A warning means a real mismatch: a missing line, a marked purchase no line claims, or a booked SEPA transfer
    with no payment on its day. <strong>Other</strong> (unmarked purchases, journal entries such as a loan, payments
    made by hand) is information, not a warning. An open transfer is generated but not booked yet.
</p>
<div class="table-responsive mb-4">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Member</th><th>Account</th><th class="text-end">Expenses</th><th class="text-end">SEPA paid</th>
                <th class="text-end">Unclaimed</th><th class="text-end">Other</th><th class="text-end">Ledger</th>
                <th>Status</th><th>Open SEPA transfers</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in members)
            {
                var (css, label) = MemberBadge(m);
                <tr>
                    <td><vc:human user-id="@m.UserId" link="None" /></td>
                    <td>
                        @if (m.SupplierAccountNum is { } account)
                        {
                            <a asp-action="CreditorStatement" asp-route-accountNum="@account">@account</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">@((-m.ExpensePurchases).ToEuro())</td>
                    <td class="text-end text-nowrap">@((-m.SepaPaid).ToEuro())</td>
                    <td class="text-end text-nowrap">@((-m.UnclaimedPurchases).ToEuro())</td>
                    <td class="text-end text-nowrap">
                        @if (m.OtherMovements.Count == 0)
                        {
                            @((-m.OtherTotal).ToEuro())
                        }
                        else
                        {
                            <details>
                                <summary>@((-m.OtherTotal).ToEuro())</summary>
                                @foreach (var o in m.OtherMovements)
                                {
                                    <div class="small text-start">@o.Date.ToInvariantDate() · @o.Type · @o.Description · @((-o.Amount).ToEuro())</div>
                                }
                            </details>
                        }
                    </td>
                    <td class="text-end text-nowrap">@((-m.LedgerBalance).ToEuro())</td>
                    <td>
                        <span class="badge @css">@label</span>
                        @foreach (var t in m.UnmatchedTransfers)
                        {
                            <div class="small"><a asp-action="Sepa">@t.FileName</a> · @t.Amount.ToEuro() not in ledger</div>
                        }
                    </td>
                    <td>
                        @foreach (var t in m.OpenTransfers)
                        {
                            <div class="small"><a asp-action="Sepa">@t.FileName</a> · @t.Amount.ToEuro()</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (okLines.Count > 0)
{
    <details class="mb-4">
        <summary class="h5">@okLines.Count booked or pending line@(okLines.Count == 1 ? "" : "s")</summary>
        @await Html.PartialAsync("_ExpenseReconLines", okLines)
    </details>
}
