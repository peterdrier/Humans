@model Humans.Finance.Models.FinanceOverviewVm
@{
    ViewData["Title"] = "Finance";
    var ledger = Model.Ledger;
    var owed = Model.Owed;
    var work = Model.Work;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;

    Func<FinanceAccountLineVm, IHtmlContent> holdedCell =
        @<text><span class="@(item.Amount < 0m ? "text-danger fw-bold" : item.Amount == 0m ? "text-muted" : "")">@item.Amount.ToEuro()</span></text>;
    Func<FinanceAccountLineVm, IHtmlContent> sourceCell = @<text>
        @if (item.Source is { } source)
        {
            <span class="@(source.Balance is null ? "text-danger" : "")">@(source.Balance?.ToEuro() ?? "unknown")</span>
        }
    </text>;
    Func<FinanceAccountLineVm, IHtmlContent> differenceCell = @<text>
        @if (item.Source is { } source)
        {
            <a asp-action="@source.ReconcileAction" class="@(item.Difference == 0m ? "text-success" : "text-danger fw-bold")">@(item.Difference?.ToEuro() ?? "unknown")</a>
        }
    </text>;
    Func<FinanceAccountLineVm, IHtmlContent> unreconciledCell = @<text>
        @if (item.BankFeed is { } feed)
        {
            <span class="@(feed.Unreconciled is null ? "text-danger" : feed.Unreconciled > 0 ? "text-warning fw-bold" : "text-success")"
                  title="Bank lines of the last @Humans.Finance.Services.SepaBankBooking.FeedWindowDays days not reconciled in Holded. Bank feed read @(feed.SyncedAt?.ToDateTime() ?? "never").">@(feed.Unreconciled?.ToString(invariant) ?? "unknown")</span>
        }
    </text>;
    var cashTable = ledger is null ? null : TableModel.For(ledger.CashAccounts)
        .Link("Account", a => a.Name, a => $"/Holded/Accounts/{a.AccountNum.ToString(invariant)}")
        .Column("Number", a => a.AccountNum.ToString(invariant))
        .Template("In Holded", holdedCell, o => o.End().Css("text-nowrap"), sortBy: a => a.Amount)
        .Template("At the source", sourceCell, o => o.End().Css("text-nowrap"), sortBy: a => a.Source?.Balance)
        .Template("Difference", differenceCell, o => o.End().Css("text-nowrap"), sortBy: a => a.Difference)
        .Template("Unreconciled", unreconciledCell, o => o.End().Css("text-nowrap"), sortBy: a => a.BankFeed?.Unreconciled)
        .Footer(new TableFooterCell("Total"), new TableFooterCell(""),
            new TableFooterCell(ledger.CashTotal.ToEuro(), "text-end fw-bold"),
            new TableFooterCell(""), new TableFooterCell(""), new TableFooterCell(""))
        .Css("table-sm mb-0")
        .Build();

    Func<FinanceSepaTransferVm, IHtmlContent> sepaAmountCell = @<text>@item.Amount.ToEuro()</text>;
    var sepaTable = TableModel.For(Model.SepaInProgress)
        .Human("Member", t => t.UserId, HumanLink.None)
        .Column("Sent", t => t.GeneratedAt, o => o.Date().Css("text-nowrap"))
        .Link("File", t => t.FileName, _ => Url.Action("Sepa"))
        .Template("Amount", sepaAmountCell, o => o.End().Css("text-nowrap"), sortBy: t => t.Amount)
        .Footer(new TableFooterCell("Total"), new TableFooterCell(""), new TableFooterCell(""),
            new TableFooterCell(Model.SepaInProgress.Sum(t => t.Amount).ToEuro(), "text-end fw-bold"))
        .Css("table-sm mb-0")
        .Build();
}

<page-header title="Finance">
    <div class="d-flex align-items-center gap-3">
        <span class="small text-muted">Holded ledger synced @(Model.LedgerSyncedAt?.ToDateTime() ?? "never")</span>
        <a href="/Holded" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-rotate me-1"></i>Holded sync
        </a>
    </div>
</page-header>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-baseline">
                <span>Cash on hand</span>
                @if (ledger is not null)
                {
                    <span class="fs-5 fw-bold">@ledger.CashTotal.ToEuro()</span>
                }
            </div>
            @if (ledger is null)
            {
                <div class="card-body text-muted">The Holded ledger mirror has never synced.</div>
            }
            else
            {
                <partial name="_Table" model="cashTable" />
            }
        </div>
    </div>

    <div class="col-lg-6 d-flex flex-column gap-3">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-baseline">
                <span>Position</span>
                @if (Model.NetPosition is { } net)
                {
                    <span class="fs-5 fw-bold @(net < 0m ? "text-danger" : "text-success")">@net.ToEuro()</span>
                }
            </div>
            <table class="table table-sm mb-0">
                <tbody>
                    <tr class="fw-bold">
                        <td class="ps-3">Cash on hand</td>
                        <td class="text-end pe-3">@(ledger?.CashTotal.ToEuro() ?? "—")</td>
                    </tr>
                    <tr class="fw-bold">
                        <td class="ps-3">Plus owed to us</td>
                        <td class="text-end pe-3">@(ledger?.ReceivablesTotal.ToEuro() ?? "—")</td>
                    </tr>
                    @foreach (var r in ledger?.Receivables ?? [])
                    {
                        <tr><td class="ps-4">@r.Name</td><td class="text-end pe-3 @(r.Amount == 0m ? "text-muted" : "")">@r.Amount.ToEuro()</td></tr>
                    }
                    <tr class="fw-bold">
                        <td class="ps-3">Less what we owe</td>
                        <td class="text-end pe-3">@(owed.Total is { } owedTotal ? (-owedTotal).ToEuro() : "—")</td>
                    </tr>
                    @if (owed.Unavailable is { } owedUnavailable)
                    {
                        <tr><td colspan="2" class="ps-4 text-danger small"><i class="fa-solid fa-circle-exclamation me-1"></i>@owedUnavailable</td></tr>
                    }
                    else
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Creditors">Members awaiting reimbursement</a>
                                <div class="small text-muted">@owed.MemberAccounts account@(owed.MemberAccounts == 1 ? "" : "s")@(owed.InSepaFiles > 0m ? " · " + owed.InSepaFiles.ToEuro() + " already in SEPA files, not booked yet" : "")</div>
                            </td>
                            <td class="text-end pe-3">@owed.Members.ToEuro()</td>
                        </tr>
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Creditors">Suppliers</a>
                                <div class="small text-muted">@owed.SupplierAccounts account@(owed.SupplierAccounts == 1 ? "" : "s") with a balance owed</div>
                            </td>
                            <td class="text-end pe-3">@owed.Suppliers.ToEuro()</td>
                        </tr>
                        <tr>
                            <td class="ps-4">
                                Taxes owed to Hacienda
                                <div class="small text-muted">VAT payable and IRPF withheld (475)</div>
                            </td>
                            <td class="text-end pe-3">@(owed.Taxes?.ToEuro() ?? "—")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td class="ps-3">Net position</td>
                        <td class="text-end pe-3 @(Model.NetPosition < 0m ? "text-danger" : Model.NetPosition > 0m ? "text-success" : "")">@(Model.NetPosition?.ToEuro() ?? "—")</td>
                    </tr>
                </tbody>
            </table>
            @if (ledger is null)
            {
                <div class="card-footer small text-muted">The Holded ledger mirror has never synced.</div>
            }
        </div>

        <div class="card flex-grow-1">
            <div class="card-header d-flex justify-content-between align-items-baseline">
                <span>SEPA transfers in progress</span>
                <span class="fs-5 fw-bold">@Model.SepaInProgress.Sum(t => t.Amount).ToEuro()</span>
            </div>
            @if (Model.SepaInProgress.Count == 0)
            {
                <div class="card-body text-muted">Nothing sent to the bank is waiting to be booked.</div>
            }
            else
            {
                <partial name="_Table" model="sepaTable" />
                <div class="card-footer small">Sent to the bank, not booked in Holded yet. <a asp-action="Sepa">SEPA payouts</a></div>
            }
        </div>
    </div>
</div>

<h2 class="h4 mb-3">Work to do</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg">
        <a href="/Expenses/Review" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Awaiting coordinator</div>
                <div class="fs-3 fw-bold">@work.AwaitingCoordinator</div>
                <div class="text-muted small">Submitted reports@(work.OldestAwaitingCoordinator is { } oc ? " · oldest " + oc.ToDate() : "")</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a href="/Expenses/Review" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Awaiting finance approval</div>
                <div class="fs-3 fw-bold @(work.AwaitingFinance > 0 ? "text-warning" : "")">@work.AwaitingFinance</div>
                <div class="text-muted small">Endorsed by a coordinator@(work.OldestAwaitingFinance is { } of ? " · oldest " + of.ToDate() : "")</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="ExpenseRecon" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Pushing to Holded</div>
                <div class="fs-3 fw-bold">@(work.PushingToHolded?.ToString() ?? "—")</div>
                <div class="text-muted small">@(work.PushingToHolded is null ? "Expense recon unavailable" : "Approved expense lines not in the ledger yet")</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="Creditors" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Ready to pay</div>
                <div class="fs-3 fw-bold">@(work.CreditorsUnavailable is null ? work.ReadyToPay.ToString() : "—")</div>
                <div class="text-muted small">@(work.CreditorsUnavailable is null ? $"Members owed {work.ReadyToPayAmount.ToEuro()}, not in a SEPA file" : "Creditor accounts unavailable")</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="Sepa" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Waiting for bank line</div>
                <div class="fs-3 fw-bold">@(work.AwaitingBankLine?.ToString() ?? "—")</div>
                <div class="text-muted small">@(work.AwaitingBankLine is null ? "Bank feed unavailable" : "Transfers sent, no Sabadell line in Holded yet")</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="Sepa" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Transfers to book</div>
                <div class="fs-3 fw-bold @(work.TransfersToBook > 0 ? "text-warning" : "")">@(work.TransfersToBook?.ToString() ?? "—")</div>
                <div class="text-muted small">@(work.TransfersToBook is null ? "Bank feed unavailable" : "Sabadell line found, not booked yet")</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="ExpenseRecon" class="card h-100 text-decoration-none text-reset @(work.Problems > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Problems</div>
                <div class="fs-3 fw-bold @(work.Problems > 0 ? "text-danger" : "")">@(work.Problems?.ToString() ?? "—")</div>
                <div class="text-muted small">
                    @if (work.ReconProblems is { } rp)
                    {
                        <text>@rp recon problem@(rp == 1 ? "" : "s") · @work.DuplicateAccounts other duplicate-doc account@(work.DuplicateAccounts == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>Expense recon unavailable</text>
                    }
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-header">Budget vs actual@(Model.Budget is { } by ? " · " + by.YearName : "")</div>
            @if (Model.Budget is not { } b)
            {
                <div class="card-body text-muted">No active budget year.</div>
            }
            else
            {
                <div class="card-body pb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Spent</span>
                        <span><strong>@b.Spent.ToEuro(0)</strong> of @b.Planned.ToEuro(0) (@b.SpentPercent%)</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Budget spent" aria-valuenow="@b.SpentPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @(b.SpentPercent > 100 ? "bg-danger" : "bg-success")" style="width: @Math.Min(b.SpentPercent, 100)%"></div>
                    </div>
                </div>
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var o in b.OverBudget)
                        {
                            <tr><td class="ps-3">Over budget: @o.Name</td><td class="text-end pe-3 text-danger">+@o.Over.ToEuro(0)</td></tr>
                        }
                        @if (b.OverBudget.Count == 0)
                        {
                            <tr><td class="ps-3 text-muted" colspan="2">No category over budget.</td></tr>
                        }
                    </tbody>
                </table>
                <div class="card-footer small"><a asp-controller="BudgetAdmin" asp-action="YearDetail" asp-route-id="@b.YearId">Budget detail</a></div>
            }
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-header">Runway</div>
            @if (Model.Runway is not { } rw)
            {
                <div class="card-body text-muted">No active budget year.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="ps-3">Planned spend this month</td><td class="text-end pe-3">@rw.ThisMonth.ToEuro()</td></tr>
                        <tr><td class="ps-3">Planned spend next month</td><td class="text-end pe-3">@rw.NextMonth.ToEuro()</td></tr>
                        <tr><td class="ps-3">Funds run out</td><td class="text-end pe-3 @(rw.FundsRunOut is null ? "" : "text-danger")">@(rw.FundsRunOut ?? "Not within the plan")</td></tr>
                    </tbody>
                </table>
                <div class="card-footer small"><a asp-action="CashFlow">Cash flow</a></div>
            }
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-header">Tax calendar</div>
            @if (ledger is null)
            {
                <div class="card-body text-muted">The Holded ledger mirror has never synced.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var t in ledger.TaxFilings)
                        {
                            <tr>
                                <td class="ps-3">
                                    @t.Name, Q@(t.Quarter) @t.Year (Modelo @t.Model)
                                    <div class="small text-muted">due @t.DueDate.ToDate()@(t.IsComplete ? "" : " · quarter so far")</div>
                                </td>
                                <td class="text-end pe-3">@t.Amount.ToEuro()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-header">Income this year</div>
            @if (Model.Income is not { } inc)
            {
                <div class="card-body text-muted">No active budget year.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="ps-3">Ticket sales, paid (gross)</td><td class="text-end pe-3">@inc.TicketSalesPaid.ToEuro()</td></tr>
                        <tr><td class="ps-3">Ticketing income target</td><td class="text-end pe-3">@inc.TicketingTarget.ToEuro()</td></tr>
                        <tr><td class="ps-3">All budgeted income</td><td class="text-end pe-3">@inc.BudgetedIncome.ToEuro()</td></tr>
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
