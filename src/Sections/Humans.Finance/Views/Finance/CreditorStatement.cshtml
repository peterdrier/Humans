@model Humans.Finance.Models.CreditorStatementVm
@{
    ViewData["Title"] = $"Creditor {Model.Ledger.SupplierAccountNum}";
    ViewData[Humans.Base.ViewComponents.AdminNavComposition.ParentKey] = "Creditors";
    var ledger = Model.Ledger;
    var lines = Model.Lines;

    var c = ledger.Contact;

    // Ledger instants are Madrid midnight; the UTC calendar date is the previous day.
    var madrid = NodaTime.DateTimeZoneProviders.Tzdb["Europe/Madrid"];

    var m = Model.Match;
    string Amt(decimal v) => v.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture);

    Func<SepaPayoutTransferRow, IHtmlContent> sepaFileCell =
        @<text><a asp-action="Sepa" class="font-monospace small">@item.FileName</a></text>;
    Func<SepaPayoutTransferRow, IHtmlContent> sepaStatusCell = @<text>
        @if (item.WithdrawnAt is { } withdrawnAt)
        {
            <span class="badge text-bg-dark">Withdrawn</span>
            <span class="text-muted small">@withdrawnAt.InZone(madrid).Date.ToInvariantDate()</span>
        }
        else if (item.BookedAt is { } bookedAt)
        {
            <span class="badge text-bg-success">Booked</span>
            <span class="text-muted small">@bookedAt.InZone(madrid).Date.ToInvariantDate()</span>
        }
        else
        {
            <span class="badge text-bg-secondary">Generated</span>
        }
    </text>;
    Func<SepaPayoutTransferRow, IHtmlContent> sepaAmountCell = @<text>@item.Amount.ToEuro()</text>;
    var sepaTable = TableModel.For(Model.SepaTransfers)
        .Column("Generated", t => t.GeneratedAt.InZone(madrid).Date.ToInvariantDate(), o => o.Css("text-nowrap"))
        .Template("File", sepaFileCell, sortBy: t => t.FileName)
        .Column("IBAN", t => t.IbanMasked, o => o.Css("font-monospace small"))
        .Template("Status", sepaStatusCell, o => o.Css("text-nowrap"))
        .Template("Amount", sepaAmountCell, o => o.Css("text-nowrap").End(), sortBy: t => t.Amount)
        .Css("align-middle")
        .Build();

    Func<Humans.Expenses.Contracts.ExpenseReportDto, IHtmlContent> reportCell =
        @<text><a href="/Expenses/@item.Id">@item.Id.ToString()[..8]…</a></text>;
    Func<Humans.Expenses.Contracts.ExpenseReportDto, IHtmlContent> payableCell = @<text>@item.Payable.ToEuro()</text>;
    var reportsTable = TableModel.For(Model.ExpenseReports)
        .Template("Report", reportCell, o => o.Css("text-nowrap"))
        .Column("Status", r => r.Status, o => o.Css("text-nowrap"))
        .Column("Subject", r => r.Note)
        .Column("Approved", r => r.ApprovedAt?.InZone(madrid).Date.ToInvariantDate(), o => o.Css("text-nowrap"))
        .Column("Holded documents", r => r.HoldedDocIds.Count, o => o.Number().End())
        .Template("Payable", payableCell, o => o.End(), sortBy: r => r.Payable)
        .Css("align-middle")
        .Build();
}

<page-header title="@($"{ledger.SupplierAccountNum}{(string.IsNullOrEmpty(c?.Name) ? "" : " · " + c.Name)}")">
    <a href="https://app.holded.com/accounting/ledger/@ledger.SupplierAccountNum" target="_blank" rel="noopener noreferrer"
       class="btn btn-outline-primary" title="This account's ledger in Holded itself.">
        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>See in Holded
    </a>
    <a href="/Holded/Accounts/@ledger.SupplierAccountNum" class="btn btn-outline-secondary"
       title="The same account in Holded's own sign convention — debit and credit as posted.">
        <i class="fa-solid fa-book me-1"></i>General ledger
    </a>
    <a asp-action="Creditors" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>All Creditors
    </a>
</page-header>

@if (ledger.ContactUnavailableReason is { } unknown)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>
        The ledger lines are right, but who this account belongs to is not known. @unknown
    </div>
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center"><div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">Balance</h6>
            <span class="fs-4 @(Model.OwedBalance > 0 ? "finance-positive" : Model.OwedBalance < 0 ? "finance-negative" : "")">@Model.OwedBalance.ToEuro()</span>
            <div class="text-muted small mt-1">positive = owed to the member</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(m.HasWarnings ? "border-danger" : "")"><div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted"><i class="fa-solid fa-scale-balanced me-1"></i>Expenses vs ledger</h6>
            <table class="table table-sm mb-2 small">
                <thead><tr><th></th><th class="text-end">Count</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    <tr title="Holded documents our expense reports created. Capped lines that were not booked do not count.">
                        <td>Expense docs</td>
                        <td class="text-end @(m.CountsMatch ? "" : "text-danger fw-bold")">@m.ExpenseDocCount</td>
                        <td class="text-end @(m.AmountsMatch ? "" : "text-danger fw-bold")">@Amt(m.ExpenseAmount)</td>
                    </tr>
                    <tr title="Purchase entries on this account in the ledger mirror.">
                        <td>Ledger purchases</td>
                        <td class="text-end @(m.CountsMatch ? "" : "text-danger fw-bold")">@m.PurchaseCount</td>
                        <td class="text-end @(m.AmountsMatch ? "" : "text-danger fw-bold")">@Amt(m.PurchaseAmount)</td>
                    </tr>
                    <tr title="Payment lines on this account, net of money the member paid back.">
                        <td>Payments</td>
                        <td class="text-end">@m.PaymentCount</td>
                        <td class="text-end">@Amt(m.PaymentAmount)</td>
                    </tr>
                </tbody>
            </table>
            @if (m.HasWarnings)
            {
                <div class="text-danger small fw-semibold">
                    @foreach (var w in m.Warnings)
                    {
                        <div><i class="fa-solid fa-triangle-exclamation me-1"></i>@w</div>
                    }
                </div>
            }
            else
            {
                <div class="text-success small"><i class="fa-solid fa-check me-1"></i>Expenses and ledger match</div>
            }
        </div></div>
    </div>
    @if (c is not null)
    {
        <div class="col-md-5">
            <div class="card h-100"><div class="card-body">
                <h6 class="card-subtitle mb-3 text-muted"><i class="fa-solid fa-address-card me-1"></i>Holded contact</h6>
                <dl class="row mb-0 small">
                    @if (!string.IsNullOrWhiteSpace(c.Name))
                    {
                        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@c.Name</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.TradeName))
                    {
                        <dt class="col-sm-3">Trade name</dt><dd class="col-sm-9">@c.TradeName</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Email))
                    {
                        <dt class="col-sm-3">Email</dt><dd class="col-sm-9"><a href="mailto:@c.Email">@c.Email</a></dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Phone))
                    {
                        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@c.Phone</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Mobile))
                    {
                        <dt class="col-sm-3">Mobile</dt><dd class="col-sm-9">@c.Mobile</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Iban))
                    {
                        <dt class="col-sm-3">IBAN</dt><dd class="col-sm-9"><code>@c.Iban</code></dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.TaxCode))
                    {
                        <dt class="col-sm-3">Tax code</dt><dd class="col-sm-9">@c.TaxCode</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Address))
                    {
                        <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@c.Address</dd>
                    }
                </dl>
            </div></div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header">Ledger — everything the mirror holds for this account (credit = owed/in, debit = paid/out; balance = running total after each line, positive = owed to the member)</div>
    @if (lines.Count == 0)
    {
        <div class="card-body py-4"><empty-state class="mb-0">No cached ledger lines for this account.</empty-state></div>
    }
    else
    {
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead><tr>
                <th>Date</th>
                <th>Description</th>
                <th>Type</th>
                <th class="text-end">In</th>
                <th class="text-end">Out</th>
                <th class="text-end">Balance</th>
            </tr></thead>
            <tbody>
            @foreach (var row in lines)
            {
                var l = row.Line;
                <tr>
                    <td class="text-nowrap">@l.Date.InZone(madrid).ToDateTimeUnspecified().ToInvariantDate()</td>
                    <td>@row.Description</td>
                    <td class="text-muted small">@l.Type</td>
                    <td class="text-end">@(row.Credit > 0 ? row.Credit.ToEuro() : "")</td>
                    <td class="text-end">@(row.Debit > 0 ? row.Debit.ToEuro() : "")</td>
                    <td class="text-end @(row.RunningBalance > 0 ? "finance-positive" : row.RunningBalance < 0 ? "finance-negative" : "")">@row.RunningBalance.ToEuro()</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="card mt-4">
    <div class="card-header">SEPA payments sent to this account (from our payout files; booked = settled in Holded)</div>
    @if (Model.SepaTransfers.Count == 0)
    {
        <div class="card-body py-4"><empty-state class="mb-0">No SEPA payout file has paid this account.</empty-state></div>
    }
    else
    {
        <partial name="_Table" model="sepaTable" />
    }
</div>

<div class="card mt-4">
    <div class="card-header">Expense reports booked to this account (submitted and later; approved reports are the ones pushed to Holded)</div>
    @if (Model.ExpenseReports.Count == 0)
    {
        <div class="card-body py-4"><empty-state class="mb-0">No expense reports are booked to this account.</empty-state></div>
    }
    else
    {
        <partial name="_Table" model="reportsTable" />
    }
</div>
