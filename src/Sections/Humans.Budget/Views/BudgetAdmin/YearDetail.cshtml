@model FinanceOverviewViewModel
@using Humans.Base.Models.Tables
@using Humans.Finance.Contracts
@using Microsoft.AspNetCore.Html
@{
    // Only the three total cards carry the euro sign; the columns below are all euros.
    string Amount(decimal value) => value.ToString("N2", System.Globalization.CultureInfo.CurrentUICulture);
    ViewData["Title"] = $"Finance - {Model.Year.Name}";
    var year = Model.Year;
    var allYears = Model.AllYears;
    var incomeLabels = Model.IncomeSlices.Select(s => s.Name).ToList();
    var incomeData = Model.IncomeSlices.Select(s => s.Amount).ToList();
    var expenseLabels = Model.ExpenseSlices.Select(s => s.Name).ToList();
    var expenseData = Model.ExpenseSlices.Select(s => s.Amount).ToList();
}

<page-header title="@year.Name" badge="@year.Status.ToString()" badge-class="@(EnumBadgeMap.For(year.Status) + " fs-6")">
    @if (allYears.Count > 1)
    {
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fa-solid fa-calendar me-1"></i>Switch Year
            </button>
            <ul class="dropdown-menu">
                @foreach (var y in allYears.OrderByDescending(y => y.Year, StringComparer.Ordinal))
                {
                    <li>
                        <a asp-action="YearDetail" asp-route-id="@y.Id" class="dropdown-item @(y.Id == year.Id ? "active" : "")">
                            @y.Name
                            <status-badge value="@y.Status" class="ms-1" />
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
    <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="SyncDepartments" asp-route-id="@year.Id" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrows-rotate me-1"></i>Sync Departments
        </button>
    </form>
    @if (!year.Groups.Any(g => g.IsTicketingGroup))
    {
        <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="EnsureTicketingGroup" asp-route-id="@year.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning">
                <i class="fa-solid fa-ticket me-1"></i>Add Ticketing Group
            </button>
        </form>
    }
    <a asp-action="AuditLog" asp-route-yearId="@year.Id" class="btn btn-outline-secondary">
        <i class="fa-solid fa-clock-rotate-left me-1"></i>Audit Log
    </a>
    <a asp-action="Admin" class="btn btn-outline-primary">
        <i class="fa-solid fa-gear me-1"></i>Admin
    </a>
</page-header>


<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total Income</h6>
                <h3 class="card-title mb-0 text-success">@Model.TotalIncome.ToEuro()</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total Expenses</h6>
                <h3 class="card-title mb-0 text-danger">@Math.Abs(Model.TotalExpenses).ToEuro()</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Net Balance</h6>
                <h3 class="card-title mb-0 @(Model.NetBalance >= 0 ? "text-success" : "text-danger")">
                    @Model.NetBalance.ToEuro()
                </h3>
            </div>
        </div>
    </div>
</div>

@if (Model.IncomeSlices.Any() || Model.ExpenseSlices.Any())
{
    <div class="card mb-4">
        <div class="card-header" role="button" data-bs-toggle="collapse" data-bs-target="#summaryCharts">
            <i class="fa-solid fa-chart-pie me-1"></i>Budget Summary Charts
            <small class="text-muted ms-2">(includes restricted groups)</small>
        </div>
        <div id="summaryCharts" class="collapse">
            <div class="card-body">
                <div class="row">
                    @if (Model.IncomeSlices.Any())
                    {
                        <div class="col-lg-6 mb-3">
                            <h6 class="text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i>Income</h6>
                            <canvas id="financeIncomeChart" style="max-height: 250px;"></canvas>
                        </div>
                    }
                    @if (Model.ExpenseSlices.Any())
                    {
                        <div class="col-lg-6 mb-3">
                            <h6 class="text-danger"><i class="fa-solid fa-arrow-trend-down me-1"></i>Expenses</h6>
                            <canvas id="financeExpenseChart" style="max-height: 250px;"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (!year.Groups.Any())
{
    <div class="card">
        <div class="card-body text-center py-4">
            <empty-state class="mb-2">No groups yet. Add groups in Finance Admin to start building the budget.</empty-state>
            <a asp-action="Admin" class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-plus me-1"></i>Go to Finance Admin
            </a>
        </div>
    </div>
}

<div class="accordion" id="budgetAccordion">
@foreach (var group in year.Groups.OrderBy(g => g.SortOrder))
{
    var groupId = group.Id.ToString("N");
    var allGroupLineItems = group.Categories.SelectMany(c => c.LineItems).Where(li => !li.IsCashflowOnly).ToList();
    var groupActual = allGroupLineItems.Sum(li => li.Amount);
    var groupBudget = group.Categories.Sum(c => c.AllocatedAmount);
    // A mixed group (Ticketing: revenue and fees) has no single direction, so its header shows signed
    // nets and a neutral variance label; a one-direction group shows magnitudes like its categories do.
    var groupMixed = group.Categories.Any(c => c.AllocatedAmount < 0) && group.Categories.Any(c => c.AllocatedAmount > 0);
    var groupIsExpense = groupBudget < 0;
    // Each category's variance is positive when favourable, so the group's is their sum.
    var groupRemaining = group.Categories.Sum(c =>
    {
        var actual = c.LineItems.Where(li => !li.IsCashflowOnly).Sum(li => li.Amount);
        return c.AllocatedAmount < 0 ? Math.Abs(c.AllocatedAmount) - Math.Abs(actual) : actual - c.AllocatedAmount;
    });
    var groupHolded = group.Categories.Sum(c =>
        Math.Abs(Model.HoldedActualsByCategory.GetValueOrDefault(c.Id)?.Actual ?? 0m) * (c.AllocatedAmount < 0 ? -1 : 1));
    decimal GroupFigure(decimal signed) => groupMixed ? signed : Math.Abs(signed);

    <div class="accordion-item mb-2">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#group-@groupId">
                <div class="budget-row me-3">
                    <div>
                        <strong>@group.Name</strong>
                        <span class="text-muted ms-2">(@group.Categories.Count categories)</span>
                        @if (group.IsRestricted)
                        {
                            <span class="badge bg-danger ms-1">Restricted</span>
                        }
                        @if (group.IsDepartmentGroup)
                        {
                            <span class="badge bg-info ms-1">Department</span>
                        }
                        @if (group.IsTicketingGroup)
                        {
                            <span class="badge bg-warning text-dark ms-1">Ticketing</span>
                        }
                    </div>
                    <span class="budget-num">@Amount(GroupFigure(groupBudget))</span>
                    <span class="budget-num">@Amount(GroupFigure(groupActual))</span>
                    <span class="budget-num @(groupRemaining >= 0 ? "text-success" : "text-danger")">@Amount(groupRemaining)</span>
                    <span class="budget-num budget-figure-holded">@Amount(GroupFigure(groupHolded))</span>
                </div>
            </button>
        </h2>
        <div id="group-@groupId" class="accordion-collapse collapse show" data-bs-parent="#budgetAccordion">
            <div class="accordion-body p-0">
                @if (group.IsTicketingGroup && group.TicketingProjection is not null)
                {
                    var proj = group.TicketingProjection;
                    var projCollapseId = $"proj-{groupId}";
                    var actualTicketsSold = (int)(ViewBag.ActualTicketsSold ?? 0);
                    var hasDates = proj.StartDate.HasValue && proj.EventDate.HasValue;
                    var remainingDays = (int)(ViewBag.RemainingDays ?? 0);
                    var projectedRemaining = (int)(ViewBag.ProjectedRemaining ?? 0);
                    var totalTickets = (int)(ViewBag.TotalTickets ?? 0);
                    <div class="p-3 bg-light border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong role="button" data-bs-toggle="collapse" data-bs-target="#@projCollapseId">
                                <i class="fa-solid fa-chart-line me-1"></i>Projection Parameters
                            </strong>
                            @if (year.Status == BudgetYearStatus.Active)
                            {
                                <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="SyncTicketingBudget" asp-route-yearId="@year.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa-solid fa-arrows-rotate me-1"></i>Sync Actuals
                                    </button>
                                </form>
                            }
                        </div>
                        <div id="@projCollapseId" class="collapse">
                            <form asp-action="UpdateTicketingProjection" asp-route-groupId="@group.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="budgetYearId" value="@year.Id" />
                                <div class="row g-2 mb-2">
                                    <div class="col-md-3">
                                        <label class="form-label form-label-sm">Start Date</label>
                                        <input type="date" name="startDate" id="proj-startDate" class="form-control form-control-sm"
                                               value="@(proj.StartDate.ToInvariantDate())" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label form-label-sm">Event Date</label>
                                        <input type="date" name="eventDate" id="proj-eventDate" class="form-control form-control-sm"
                                               value="@(proj.EventDate.ToInvariantDate())" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label form-label-sm">Initial Sales Count</label>
                                        <input type="number" name="initialSalesCount" class="form-control form-control-sm"
                                               value="@proj.InitialSalesCount" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label form-label-sm">Daily Sales Rate</label>
                                        <input type="number" name="dailySalesRate" id="proj-dailySalesRate" class="form-control form-control-sm"
                                               step="0.1" value="@proj.DailySalesRate" />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-md-3">
                                        <label class="form-label form-label-sm">Total Ticket Count (target)</label>
                                        <input type="number" id="proj-totalTickets" class="form-control form-control-sm"
                                               value="@totalTickets" />
                                        <div class="small text-muted mt-1" id="proj-ticketBreakdown">
                                            @if (hasDates)
                                            {
                                                <text>Sold so far: <strong>@actualTicketsSold</strong> &middot; Projected remaining: <strong>@projectedRemaining</strong> (at @proj.DailySalesRate/day &times; @remainingDays days)</text>
                                            }
                                            else
                                            {
                                                <text>Set Start Date and Event Date to enable projection</text>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label form-label-sm">Avg Ticket Price (&euro;)</label>
                                        <input type="number" name="averageTicketPrice" class="form-control form-control-sm"
                                               step="0.01" value="@proj.AverageTicketPrice" />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label form-label-sm">VAT (%)</label>
                                        <input type="number" name="vatRate" class="form-control form-control-sm"
                                               min="0" max="21" value="@proj.VatRate" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label form-label-sm">Stripe Fee (%)</label>
                                        <input type="number" name="stripeFeePercent" class="form-control form-control-sm"
                                               step="0.01" value="@proj.StripeFeePercent" />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label form-label-sm">Stripe Fixed</label>
                                        <input type="number" name="stripeFeeFixed" class="form-control form-control-sm"
                                               step="0.01" value="@proj.StripeFeeFixed" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label form-label-sm">TT Fee (%)</label>
                                        <input type="number" name="ticketTailorFeePercent" class="form-control form-control-sm"
                                               step="0.01" value="@proj.TicketTailorFeePercent" />
                                    </div>
                                    <div class="col-md-1 d-flex align-items-end" authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Save</button>
                                    </div>
                                </div>
                            </form>
                            <script>
                            (function() {
                                var actualSold = @actualTicketsSold;
                                var dailyRateInput = document.getElementById('proj-dailySalesRate');
                                var totalInput = document.getElementById('proj-totalTickets');
                                var startDateInput = document.getElementById('proj-startDate');
                                var eventDateInput = document.getElementById('proj-eventDate');
                                var breakdownEl = document.getElementById('proj-ticketBreakdown');

                                function getRemainingDays() {
                                    var eventDate = eventDateInput.value;
                                    if (!eventDate) return 0;
                                    var today = new Date();
                                    today.setUTCHours(0, 0, 0, 0);
                                    var event_ = new Date(eventDate + 'T00:00:00Z');
                                    var diff = Math.floor((event_ - today) / (1000 * 60 * 60 * 24));
                                    return Math.max(0, diff);
                                }

                                function hasDates() {
                                    return startDateInput.value && eventDateInput.value;
                                }

                                function updateBreakdown(dailyRate) {
                                    if (!hasDates()) {
                                        breakdownEl.innerHTML = 'Set Start Date and Event Date to enable projection';
                                        return;
                                    }
                                    var days = getRemainingDays();
                                    var projected = Math.round(dailyRate * days);
                                    breakdownEl.innerHTML = 'Sold so far: <strong>' + actualSold +
                                        '</strong> &middot; Projected remaining: <strong>' + projected +
                                        '</strong> (at ' + dailyRate.toFixed(1) + '/day &times; ' + days + ' days)';
                                }

                                dailyRateInput.addEventListener('input', function() {
                                    if (!hasDates()) return;
                                    var rate = parseFloat(this.value) || 0;
                                    var days = getRemainingDays();
                                    var projected = Math.round(rate * days);
                                    totalInput.value = actualSold + projected;
                                    updateBreakdown(rate);
                                });

                                totalInput.addEventListener('input', function() {
                                    if (!hasDates()) return;
                                    var target = parseInt(this.value) || 0;
                                    var days = getRemainingDays();
                                    if (days > 0) {
                                        var newRate = Math.round(((target - actualSold) / days) * 10) / 10;
                                        if (newRate < 0) newRate = 0;
                                        dailyRateInput.value = newRate.toFixed(1);
                                        updateBreakdown(newRate);
                                    }
                                });

                                startDateInput.addEventListener('change', function() {
                                    var rate = parseFloat(dailyRateInput.value) || 0;
                                    var days = getRemainingDays();
                                    var projected = Math.round(rate * days);
                                    totalInput.value = actualSold + projected;
                                    updateBreakdown(rate);
                                });

                                eventDateInput.addEventListener('change', function() {
                                    var rate = parseFloat(dailyRateInput.value) || 0;
                                    var days = getRemainingDays();
                                    var projected = Math.round(rate * days);
                                    totalInput.value = actualSold + projected;
                                    updateBreakdown(rate);
                                });
                            })();
                            </script>
                        </div>
                    </div>
                }

                @if (group.Categories.Any())
                {
                    <div class="budget-row budget-colhead ps-4">
                        <span>Category</span>
                        <span class="budget-num">Budget</span>
                        <span class="budget-num">Lines</span>
                        <span class="budget-num">@(groupMixed ? "Variance" : groupIsExpense ? "Remaining" : "Vs target")</span>
                        <span class="budget-num">Holded</span>
                    </div>
                    <div class="accordion" id="categories-@groupId">
                    @foreach (var cat in group.Categories.OrderBy(c => c.SortOrder))
                    {
                        var catId = cat.Id.ToString("N");
                        var catLineItems = cat.LineItems.Where(li => !li.IsCashflowOnly).ToList();
                        var catActual = catLineItems.Sum(li => li.Amount);
                        var catBudget = cat.AllocatedAmount;

                        var isExpenseBudget = catBudget < 0;
                        var displayBudget = Math.Abs(catBudget);
                        var displayActual = Math.Abs(catActual);
                        // Positive is good either way: expense remaining = |budget| - |actual| (under budget);
                        // income remaining = actual - budget (over target).
                        var displayRemaining = isExpenseBudget
                            ? Math.Abs(catBudget) - Math.Abs(catActual)
                            : catActual - catBudget;
                        // Null when Holded booked nothing here: the row only exists for a non-zero actual.
                        var holded = Model.HoldedActualsByCategory.GetValueOrDefault(cat.Id);

                        <div class="accordion-item border-0 border-bottom">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 ps-4" type="button" data-bs-toggle="collapse" data-bs-target="#cat-@catId">
                                    <div class="budget-row me-3">
                                        <span>
                                            @cat.Name
                                            @if (cat.ExpenditureType == ExpenditureType.CapEx)
                                            {
                                                <span class="budget-capex ms-1" title="Capital expenditure">CapEx</span>
                                            }
                                        </span>
                                        <span class="budget-num">@Amount(displayBudget)</span>
                                        <span class="budget-num">@Amount(displayActual)</span>
                                        <span class="budget-num @(displayRemaining >= 0 ? "text-success" : "text-danger")">@Amount(displayRemaining)</span>
                                        <span class="budget-num budget-figure-holded">@(holded is null ? "–" : Amount(Math.Abs(holded.Actual)))</span>
                                    </div>
                                </button>
                            </h2>
                            <div id="cat-@catId" class="accordion-collapse collapse">
                                <div class="accordion-body p-0">
                                    @{
                                        var lineItems = cat.LineItems.OrderBy(li => li.SortOrder).ToList();
                                        var hasDocs = holded is not null && holded.Docs.Count > 0;
                                        Func<BudgetLineItemDetail, IHtmlContent> descriptionCell =
                                            @<text>@item.Description@if (item.IsAutoGenerated)
                                                {<span class="badge bg-secondary ms-1">Auto</span>}@if (item.IsCashflowOnly)
                                                {<span class="badge bg-info ms-1">Cashflow</span>}@if (!string.IsNullOrWhiteSpace(item.Notes))
                                                {<span class="budget-note ms-1">@item.Notes</span>}</text>;
                                        Func<BudgetLineItemDetail, IHtmlContent> amountCell =
                                            @<text><span class="@(item.Amount >= 0 ? "text-success" : "text-danger")">@Amount(item.Amount)</span></text>;
                                        Func<BudgetLineItemDetail, IHtmlContent> vatCell =
                                            @<text>@if (item.VatRate > 0)
                                                {<span class="badge bg-warning text-dark">@(item.VatRate)%</span>}
                                                else
                                                {<span class="text-muted">0%</span>}</text>;
                                        var lineItemsTable = TableModel.For(lineItems)
                                            .Template("Description", descriptionCell)
                                            .Template("Amount", amountCell, c => c.End())
                                            .Template("VAT", vatCell)
                                            .Column("Expected", li => li.ExpectedDate, c => c.Date())
                                            .RowCss(li => li.IsAutoGenerated ? (li.Description.StartsWith("Projected:", StringComparison.Ordinal) ? "table-light fst-italic" : "table-light") : null)
                                            .Footer(new TableFooterCell(lineItems.Any(li => li.IsCashflowOnly) ? "Total excl. cashflow" : "Total"), new TableFooterCell(Amount(catActual), "text-end"), new TableFooterCell(""), new TableFooterCell(""))
                                            .Css("budget-table")
                                            .Empty("No line items yet.")
                                            .Build();
                                    }
                                    <div class="budget-detail row g-4 mx-0 px-3 py-3">
                                        <div class="@(hasDocs ? "col-lg-5" : "col-lg-7") ps-3">
                                            <div class="budget-subhead mb-1">Line items (@lineItems.Count)</div>
                                            <partial name="_Table" model="lineItemsTable" />
                                        </div>
                                        @if (hasDocs)
                                        {
                                            Func<CategoryActualDoc, IHtmlContent> docCell =
                                                @<text><a href="@item.HoldedUrl" target="_blank" rel="noopener">@(string.IsNullOrWhiteSpace(item.DocNumber) ? item.HoldedDocId : item.DocNumber)<i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i></a></text>;
                                            Func<CategoryActualDoc, IHtmlContent> supplierCell =
                                                @<text>@item.ContactName@if (!string.IsNullOrWhiteSpace(item.Description))
                                                    {<span class="budget-doc-desc" title="@item.Description">@item.Description</span>}</text>;
                                            var docsTable = TableModel.For(holded!.Docs.OrderByDescending(d => d.Date).ThenBy(d => d.DocNumber, StringComparer.Ordinal).ToList())
                                                .Template("Document", docCell)
                                                .Template("Supplier", supplierCell)
                                                .Column("Date", d => d.Date, c => c.Date())
                                                .Column("Amount", d => d.Total, c => c.Currency().End())
                                                .Footer(new TableFooterCell("Total"), new TableFooterCell(""), new TableFooterCell(""), new TableFooterCell(Amount(Math.Abs(holded.Actual)), "text-end"))
                                                .Css("budget-table")
                                                .Build();
                                            <div class="col-lg-7">
                                                <div class="budget-subhead mb-1">Holded documents (@holded.Docs.Count)</div>
                                                <partial name="_Table" model="docsTable" />
                                            </div>
                                        }
                                        <div class="col-12 ps-3 pt-0">
                                            <a asp-action="CategoryDetail" asp-route-id="@cat.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="fa-solid fa-pen me-1"></i>Manage Line Items
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                }
                @if (!group.IsTicketingGroup)
                {
                    <div class="p-3 border-top bg-light">
                        <form authorize-policy="@Humans.Finance.Contracts.FinancePolicies.Manage" asp-action="CreateCategory" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="budgetGroupId" value="@group.Id" />
                            <input type="hidden" name="budgetYearId" value="@year.Id" />
                            <div class="col-md-4">
                                <label class="form-label form-label-sm">Category Name</label>
                                <input type="text" name="name" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label form-label-sm">Allocated Amount (&euro;, incl. VAT/IVA)</label>
                                <input type="number" name="allocatedAmount" class="form-control form-control-sm" step="0.01" value="0" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label form-label-sm">Type</label>
                                <select name="expenditureType" class="form-select form-select-sm">
                                    <option value="@ExpenditureType.OpEx">OpEx</option>
                                    <option value="@ExpenditureType.CapEx">CapEx</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                    <i class="fa-solid fa-plus me-1"></i>Add
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
}
</div>

@if (Model.IncomeSlices.Any() || Model.ExpenseSlices.Any())
{
    <partial name="_BudgetChartSupport" />

    <script>

    function renderFinanceCharts() {
        var incomeColors = window.HumansBudgetCharts.incomeColors();
        var expenseColors = window.HumansBudgetCharts.expenseColors();
        var tooltipCallback = {
            label: function(ctx) {
                return ctx.label + ': \u20ac' + ctx.raw.toLocaleString(document.documentElement.lang || 'en', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
        };
        var legendOpts = {
            position: 'bottom',
            labels: { padding: 12, usePointStyle: true, font: { size: 11 } }
        };

        var incomeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(incomeLabels));
        var incomeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(incomeData));
        var expenseLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(expenseLabels));
        var expenseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(expenseData));

        var incomeEl = document.getElementById('financeIncomeChart');
        if (incomeEl && incomeData.length > 0) {
            new Chart(incomeEl, {
                type: 'doughnut',
                data: {
                    labels: incomeLabels,
                    datasets: [{
                        data: incomeData,
                        backgroundColor: incomeColors.slice(0, incomeData.length),
                        borderWidth: 2,
                        borderColor: window.HumansBudgetCharts.surfaceColor()
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: legendOpts, tooltip: { callbacks: tooltipCallback } }
                }
            });
        }

        var expenseEl = document.getElementById('financeExpenseChart');
        if (expenseEl && expenseData.length > 0) {
            new Chart(expenseEl, {
                type: 'doughnut',
                data: {
                    labels: expenseLabels,
                    datasets: [{
                        data: expenseData,
                        backgroundColor: expenseColors.slice(0, expenseData.length),
                        borderWidth: 2,
                        borderColor: window.HumansBudgetCharts.surfaceColor()
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: legendOpts, tooltip: { callbacks: tooltipCallback } }
                }
            });
        }
    }
    window.HumansBudgetCharts.load(renderFinanceCharts);
    </script>
}
