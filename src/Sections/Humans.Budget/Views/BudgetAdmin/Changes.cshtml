@{
    ViewData["Title"] = "Budget changes";
    var yearId = ViewBag.YearId as Guid?;
    var years = ViewBag.Years as IReadOnlyList<BudgetYearSummarySnapshot> ?? [];
    // Only Budget's own actions: subject ids alone could match other sections' entries.
    var budgetActions = $"{BudgetAuditActions.BudgetChanged.Name},{BudgetAuditActions.BudgetAuditLogCopied.Name}";
}

<page-header title="Budget changes">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Finance
    </a>
</page-header>


@if (years.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Changes" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Filter by Year</label>
                    <select name="yearId" class="form-select js-auto-submit">
                        <option value="">All Years</option>
                        @foreach (var y in years.OrderByDescending(y => y.Year, StringComparer.Ordinal))
                        {
                            <option value="@y.Id" selected="@(yearId == y.Id ? "selected" : null)">@y.Name@(y.IsArchived ? " (Archived)" : "")</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
}

@if (yearId is { } selectedYearId)
{
    <vc:audit-log subject-id="@selectedYearId" include-targets="true" actions="@budgetActions" limit="500" layout="table"
                  columns="when,actor,description" title="Budget changes" empty-text="No budget changes." />
}
else
{
    <vc:audit-log subject-ids="@years.Select(y => y.Id).ToList()" include-targets="true" actions="@budgetActions" limit="500" layout="table"
                  columns="when,actor,description" title="Budget changes" empty-text="No budget changes." />
}
