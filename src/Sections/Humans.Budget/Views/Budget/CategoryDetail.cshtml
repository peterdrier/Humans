@model Humans.Budget.Models.CoordinatorCategoryDetailViewModel
@{
    ViewData["Title"] = Localizer["Budget_TitleYear", Model.Category.Name].Value;
    var category = Model.Category;
    var group = category.BudgetGroup;
    var lineItemTotal = category.LineItems.Where(li => !li.IsCashflowOnly).Sum(li => li.Amount);
    var unallocated = category.AllocatedAmount - lineItemTotal;

    var vatProjections = VatProjection.ForLineItems(category.LineItems);
}

<nav aria-label="@Localizer["Budget_BreadcrumbNavigation"]" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Budget_Title"]</a></li>
        @if (group is not null)
        {
            <li class="breadcrumb-item">@group.Name</li>
        }
        <li class="breadcrumb-item active">@category.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@category.Name</h1>
    @if (Model.CanEdit)
    {
        <span class="badge bg-success fs-6">@Localizer["Budget_CategoryEditable"]</span>
    }
    else
    {
        <span class="badge bg-secondary fs-6">@Localizer["Budget_CategoryReadOnly"]</span>
    }
</div>


<div class="alert alert-warning d-flex align-items-center" role="alert">
    <i class="fa-solid fa-triangle-exclamation fa-lg me-2"></i>
    <div>
        <strong>@Localizer["Budget_VatGuidanceIntro"]</strong>
        @Localizer["Budget_VatGuidanceBody"] <strong>@Localizer["Budget_VatGuidanceWarning"]</strong>
        @Localizer["Budget_VatGuidanceRate"]
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">@Localizer["Budget_TotalAllocated"] <span class="text-muted">@Localizer["Budget_IncludingVat"]</span></h6>
                <h3 class="card-title mb-0">@category.AllocatedAmount.ToEuro()</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">@Localizer["Budget_DetailedInLineItems"]</h6>
                <h3 class="card-title mb-0">@lineItemTotal.ToEuro()</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">@Localizer["Budget_Unallocated"]</h6>
                <h3 class="card-title mb-0 @(unallocated < 0 ? "text-danger" : "")">
                    @unallocated.ToEuro()
                </h3>
            </div>
        </div>
    </div>
</div>

@if (category.AllocatedAmount != 0)
{
    var pct = Math.Abs(lineItemTotal / category.AllocatedAmount * 100);
    var barClass = pct > 100 ? "bg-danger" : pct > 80 ? "bg-warning" : "bg-success";
    <div class="mb-4">
        <div class="d-flex justify-content-between mb-1">
            <small class="text-muted">@Localizer["Budget_Utilization"]</small>
            <small class="text-muted">@pct.ToString("N0")%</small>
        </div>
        <div class="progress" style="height: 8px;">
            <div class="progress-bar @barClass" style="width: @Math.Min(pct, 100).ToString("N0")%"></div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Localizer["Budget_LineItems"]</span>
        <span class="badge bg-secondary">@Localizer["Budget_ItemCount", category.LineItems.Count]</span>
    </div>
    @if (category.LineItems.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Budget_Description"]</th>
                        <th class="text-end">@Localizer["Budget_ColAmount"] <small class="text-muted fw-normal">@Localizer["Budget_IncludingVat"]</small></th>
                        <th>@Localizer["Budget_Vat"]</th>
                        <th>@Localizer["Budget_ResponsibleTeam"]</th>
                        <th>@Localizer["Budget_Notes"]</th>
                        <th>@Localizer["Budget_ExpectedDate"]</th>
                        @if (Model.CanEdit)
                        {
                            <th class="text-end" style="min-width: 120px;">@Localizer["Budget_Actions"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in category.LineItems.OrderBy(li => li.SortOrder))
                    {
                        var editId = $"edit-{item.Id.ToString("N")}";
                        var amountClass = item.Amount >= 0 ? "text-success" : "text-danger";
                        <tr class="@(item.IsAutoGenerated ? (item.Description.StartsWith("Projected:") ? "table-light fst-italic" : "table-light") : "")">
                            <td>
                                @item.Description
                                @if (item.IsAutoGenerated)
                                {
                                    <span class="badge bg-secondary ms-1" title="@Localizer["Budget_AutoGeneratedTitle"]">@Localizer["Budget_Auto"]</span>
                                }
                                @if (item.IsCashflowOnly)
                                {
                                    <span class="badge bg-info ms-1" title="@Localizer["Budget_CashflowOnlyTitle"]">@Localizer["Budget_CashflowOnly"]</span>
                                }
                            </td>
                            <td class="text-end @amountClass">@item.Amount.ToEuro()</td>
                            <td>
                                @if (item.VatRate > 0)
                                {
                                    <span class="badge bg-warning text-dark">@item.VatRate%</span>
                                }
                                else
                                {
                                    <span class="text-muted">0%</span>
                                }
                            </td>
                            <td>@(item.ResponsibleTeamName ?? "\u2014")</td>
                            <td class="text-muted">@(item.Notes ?? "")</td>
                            <td>@item.ExpectedDate?.ToDate()</td>
                            @if (Model.CanEdit)
                            {
                                <td class="text-end">
                                    <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#@editId">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <form asp-action="DeleteLineItem" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="budgetCategoryId" value="@category.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" data-confirm="@Localizer["Budget_DeleteLineItemConfirm"]">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                        @if (Model.CanEdit)
                        {
                            <tr class="collapse" id="@editId">
                                <td colspan="7" class="bg-light">
                                    <form asp-action="UpdateLineItem" asp-route-id="@item.Id" method="post" class="row g-2 p-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="budgetCategoryId" value="@category.Id" />
                                        <div class="col-md-2">
                                            <label class="form-label form-label-sm">@Localizer["Budget_Description"]</label>
                                            <input type="text" name="description" class="form-control form-control-sm" value="@item.Description" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label form-label-sm">@Localizer["Budget_ColAmount"] @Localizer["Budget_IncludingVat"]</label>
                                            <input type="number" name="amount" class="form-control form-control-sm" step="0.01" value="@item.Amount" required />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label form-label-sm">@Localizer["Budget_Vat"] %</label>
                                            <select name="vatRate" class="form-select form-select-sm">
                                                @foreach (var rate in new[] { 0, 10, 21 })
                                                {
                                                    if (item.VatRate == rate)
                                                    {
                                                        <option value="@rate" selected>@rate%</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@rate">@rate%</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label form-label-sm">@Localizer["Budget_ResponsibleTeam"]</label>
                                            <select name="responsibleTeamId" class="form-select form-select-sm">
                                                <option value="">@Localizer["Budget_None"]</option>
                                                @foreach (var team in Model.Teams)
                                                {
                                                    if (item.ResponsibleTeamId == team.Id)
                                                    {
                                                        <option value="@team.Id" selected>@team.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@team.Id">@team.Name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label form-label-sm">@Localizer["Budget_Notes"]</label>
                                            <input type="text" name="notes" class="form-control form-control-sm" value="@item.Notes" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label form-label-sm">@Localizer["Budget_ExpectedDate"]</label>
                                            <input type="date" name="expectedDate" class="form-control form-control-sm" value="@item.ExpectedDate.ToInvariantDate()" />
                                        </div>
                                        <div class="col-md-1">
                                            <button type="submit" class="btn btn-primary btn-sm w-100">@Localizer["Budget_Save"]</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center text-muted py-4">
            @if (Model.CanEdit)
            {
                <text>@Localizer["Budget_NoLineItemsEditable"]</text>
            }
            else
            {
                <text>@Localizer["Budget_NoLineItems"]</text>
            }
        </div>
    }
    @if (Model.CanEdit)
    {
        <div class="card-footer bg-light">
            <h6 class="mb-2">@Localizer["Budget_AddLineItem"]</h6>
            <form asp-action="CreateLineItem" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="budgetCategoryId" value="@category.Id" />
                <div class="col-md-2">
                    <label class="form-label form-label-sm">@Localizer["Budget_Description"]</label>
                    <input type="text" name="description" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">@Localizer["Budget_ColAmount"] @Localizer["Budget_IncludingVat"]</label>
                    <input type="number" name="amount" class="form-control form-control-sm" step="0.01" value="0" required />
                </div>
                <div class="col-md-1">
                    <label class="form-label form-label-sm">@Localizer["Budget_Vat"] %</label>
                    <select name="vatRate" class="form-select form-select-sm">
                        <option value="0" selected>0%</option>
                        <option value="10">10%</option>
                        <option value="21">21%</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">@Localizer["Budget_ResponsibleTeam"]</label>
                    <select name="responsibleTeamId" class="form-select form-select-sm">
                        <option value="">@Localizer["Budget_None"]</option>
                        @foreach (var team in Model.Teams)
                        {
                            if (category.TeamId == team.Id)
                            {
                                <option value="@team.Id" selected>@team.Name</option>
                            }
                            else
                            {
                                <option value="@team.Id">@team.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">@Localizer["Budget_Notes"]</label>
                    <input type="text" name="notes" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">@Localizer["Budget_ExpectedDate"]</label>
                    <input type="date" name="expectedDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="fa-solid fa-plus me-1"></i>@Localizer["Budget_Add"]
                    </button>
                </div>
            </form>
        </div>
    }
</div>

@if (vatProjections.Any())
{
    <div class="card mt-4">
        <div class="card-header">
            <i class="fa-solid fa-receipt me-1"></i>@Localizer["Budget_VatProjections"]
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Budget_Source"]</th>
                        <th class="text-end">@Localizer["Budget_VatAmount"]</th>
                        <th>@Localizer["Budget_Rate"]</th>
                        <th>@Localizer["Budget_Direction"]</th>
                        <th>@Localizer["Budget_SettlementDate"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vat in vatProjections)
                    {
                        <tr class="fst-italic text-muted">
                            <td>
                                <i class="fa-solid fa-receipt me-1"></i>
                                @Localizer["Budget_VatOn", vat.SourceDescription]
                            </td>
                            <td class="text-end @(vat.IsExpense ? "text-danger" : "text-success")">
                                @(vat.IsExpense ? "-" : "+")@vat.VatAmount.ToEuro()
                            </td>
                            <td><span class="badge bg-warning text-dark">@vat.VatRate%</span></td>
                            <td>
                                @if (vat.IsExpense)
                                {
                                    <span class="badge bg-danger">@Localizer["Budget_VatLiability"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@Localizer["Budget_VatCredit"]</span>
                                }
                            </td>
                            <td>@vat.SettlementDate.ToDate()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>@Localizer["Budget_BackToBudget"]
    </a>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-confirm]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            if (!confirm(this.getAttribute('data-confirm'))) {
                e.preventDefault();
            }
        });
    });
});
</script>
