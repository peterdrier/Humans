@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by BudgetPageRenderTests (step 12). *@
@using Humans.Base.Extensions
@using Humans.Budget
@using Humans.Budget.Contracts
@using Humans.Budget.Controllers
@using Humans.Budget.Models
@using Humans.Budget.Services
@using Humans.Base
@using Humans.Base.Models
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<BudgetResource> Localizer
@* No SharedLocalizer: every Localizer[…] call in Budget's views is a Budget_ key, and all
   21 carved out of SharedResource — including Budget_ColCategory, which Expenses' report
   grid also renders and now reads through IStringLocalizer<BudgetResource> (§15.3b). *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
