@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error.
   `<vc:human>`'s component lives in Humans.Base, so `@addTagHelper *, Humans.Base`
   resolves it; a component still in Humans.Web would render as inert literal markup.
   Guarded by EmailPageRenderTests. *@
@using Humans.Base.Extensions
@using Humans.Base.Enums
@using Humans.Email
@using Humans.Email.Contracts
@using Humans.Email.Controllers
@using Humans.Email.Models
@using Humans.Base
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Microsoft.Extensions.Localization
@* SharedLocalizer covers Common_ keys and the Enum_EmailOutboxStatus_ badge names, which other sections use too. *@
@inject IStringLocalizer<EmailResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@addTagHelper *, Humans.Email
