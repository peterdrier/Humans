@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EmailResource> HtmlLocalizer
@{
    ViewData["Title"] = Localizer["Email_Unsubscribe_Title"].Value;
    var categoryName = Localizer["Email_CommPrefs_Name_Marketing"].Value;
}

<page-header title="@(string.Format(Localizer["Email_Unsubscribe_Heading"].Value, categoryName))" />

@if (ViewData["UserId"] is Guid userId)
{
    var human = await Component.InvokeAsync(typeof(Humans.Base.ViewComponents.HumanViewComponent), new
    {
        userId,
        link = Humans.Base.ViewComponents.HumanLink.None,
    });
    using var humanWriter = new System.IO.StringWriter();
    human.WriteTo(humanWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    var humanHtml = new Microsoft.AspNetCore.Html.HtmlString($"<strong>{humanWriter.ToString().Trim()}</strong>");
    <p>@HtmlLocalizer["Email_Unsubscribe_Greeting", humanHtml]</p>
}

<p>@Html.Raw(string.Format(Localizer["Email_Unsubscribe_ConfirmMessage"].Value, Html.Encode(categoryName)))</p>

<form method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">@Localizer["Email_Unsubscribe_ConfirmButton"]</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">@SharedLocalizer["Common_Cancel"]</a>
</form>
