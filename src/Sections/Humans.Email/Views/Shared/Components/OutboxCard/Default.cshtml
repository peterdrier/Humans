@model Humans.Email.ViewComponents.OutboxCardViewModel
@* Admin-only card on /Users/Admin/{id}: no localization keys (memory/code/localization-admin-exempt.md). *@

<div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-envelope me-2"></i> Email Outbox</span>
        <a asp-controller="MemberOutbox" asp-action="AdminOutbox" asp-route-id="@Model.UserId" class="btn btn-sm btn-outline-primary">
            View emails <span class="badge bg-secondary ms-1">@Model.MessageCount</span>
        </a>
    </div>
</div>
