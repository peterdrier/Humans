@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EmailResource> HtmlLocalizer
@model Humans.Email.Models.SendMessageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var recipient = await Component.InvokeAsync(typeof(Humans.Base.ViewComponents.HumanViewComponent), new
    {
        userId = Model.RecipientId,
        link = Humans.Base.ViewComponents.HumanLink.None,
    });
    using var recipientWriter = new System.IO.StringWriter();
    recipient.WriteTo(recipientWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    var recipientHtml = new Microsoft.AspNetCore.Html.HtmlString(recipientWriter.ToString().Trim());
}

<nav aria-label="@Localizer["Email_BreadcrumbNavigation"]">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><vc:human user-id="@Model.RecipientId" /></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Email_SendMessage_Breadcrumb"]</li>
    </ol>
</nav>

<h1>@HtmlLocalizer["Email_SendMessage_Heading", recipientHtml]</h1>


<div class="card">
    <div class="card-body">
        <form asp-controller="FacilitatedMessage" asp-action="SendMessage" asp-route-id="@Model.RecipientId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RecipientId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @await Html.PartialAsync("_EmailComposer", new EmailComposerViewModel
            {
                BodyName = "Message",
                BodyValue = Model.Message,
                BodyLabel = Localizer["Email_SendMessage_MessageLabel"].Value,
                BodyRows = 8,
                BodyMaxLength = 2000,
                Category = nameof(MessageCategory.FacilitatedMessages),
                RecipientCount = 1,
                RecipientUserId = Model.RecipientId,
            })

            <div class="mb-3 form-check">
                <input asp-for="IncludeContactInfo" class="form-check-input" type="checkbox" />
                <label asp-for="IncludeContactInfo" class="form-check-label">
                    @Localizer["Email_SendMessage_IncludeContactInfo"]
                    @if (!string.IsNullOrEmpty(Model.SenderEmail))
                    {
                        <span class="text-muted">(@Model.SenderEmail)</span>
                    }
                </label>
                <div class="form-text">@Localizer["Email_SendMessage_IncludeContactInfoHelp"]</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Email_SendMessage_Send"]</button>
                <a asp-controller="ProfileView" asp-action="ViewProfile" asp-route-id="@Model.RecipientId" class="btn btn-outline-secondary">@SharedLocalizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
