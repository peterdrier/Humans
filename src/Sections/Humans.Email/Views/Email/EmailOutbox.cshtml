@using Humans.Base.Interfaces
@using Microsoft.AspNetCore.Html
@using Humans.Email.Services
@model Humans.Email.Models.EmailOutboxViewModel
@{
    ViewData["Title"] = "Email Outbox";
}
@functions {
    static string FormatApproxCount(int count)
    {
        if (count < 1000) return count.ToString();
        if (count < 10_000) return $"~{count / 1000.0:0.#}k";
        return $"~{count / 1000}k";
    }
}

<page-header title="Email Outbox">
    <page-header-subtitle>
        @if (Model.IsPaused)
        {
            <span class="text-warning fw-semibold"><i class="fa-solid fa-circle-pause me-1"></i>Sending paused</span>
        }
        else
        {
            <span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Sending active</span>
        }
    </page-header-subtitle>
    <a href="/Settings#email" class="btn btn-outline-secondary">Manage sending</a>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Back</a>
</page-header>


<div class="stats" style="--stats-cols: 5">
    <partial name="_StatTile" model='new StatTileViewModel("Total Messages", FormatApproxCount(Model.TotalMessageCount))' />
    <partial name="_StatTile" model='new StatTileViewModel("Queued", Model.QueuedCount.ToString())' />
    <partial name="_StatTile" model='new StatTileViewModel("Sent (24h)", Model.SentLast24HoursCount.ToString())' />
    <partial name="_StatTile" model='new StatTileViewModel("Failed", Model.FailedCount.ToString(), Severity: Model.FailedCount > 0 ? TileSeverity.Critical : TileSeverity.Normal)' />
    <partial name="_StatTile" model='new StatTileViewModel("Messages per run", Model.OutboxBatchSize.ToString())' />
</div>

<div class="card">
    <div class="card-header">Recent Messages (last 50)</div>
    @if (!Model.Messages.Any())
    {
        <div class="card-body"><empty-state class="mb-0">No messages in the outbox.</empty-state></div>
    }
    else
    {
        Func<EmailOutboxMessageDto, IHtmlContent> recipientCell = @<text>
            @if (item.UserId.HasValue)
            {
                <vc:human user-id="@item.UserId.Value" />
            }
            else
            {
                @(item.RecipientName ?? "—")
            }
        </text>;
        Func<EmailOutboxMessageDto, IHtmlContent> statusCell = @<text>
            <status-badge value="@item.Status" />
            @if (item.RetryCount > 0)
            {
                <small class="text-muted ms-1">×@item.RetryCount</small>
            }
        </text>;
        Func<EmailOutboxMessageDto, IHtmlContent> sentAtCell = @<text>
            @if (item.SentAt.HasValue)
            {
                @item.SentAt.Value.ToInvariantTimestamp()
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </text>;
        Func<EmailOutboxMessageDto, IHtmlContent> actionsCell = @<text>
            @if (item.Status == EmailOutboxStatus.Failed)
            {
                <form method="post" asp-action="RetryEmailOutboxMessage" asp-route-id="@item.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-primary">Retry</button>
                </form>
                <form method="post" asp-action="DiscardEmailOutboxMessage" asp-route-id="@item.Id" class="d-inline ms-1">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                            data-confirm="Discard this message? It cannot be recovered.">Discard</button>
                </form>
            }
        </text>;
        Func<EmailOutboxMessageDto, IHtmlContent> lastErrorCell = @<text>
            @if (!string.IsNullOrEmpty(item.LastError))
            {
                <span class="text-danger" title="@item.LastError">@item.LastError[..Math.Min(80, item.LastError.Length)]@(item.LastError.Length > 80 ? "…" : "")</span>
            }
        </text>;
        var outboxTable = TableModel.For(Model.Messages)
            .Template("Name", recipientCell)
            .Column("Template", r => r.TemplateName, o => o.Code().Css("small"))
            .Column("Email Address", r => r.RecipientEmail, c => c.Css("small"))
            .Template("Status", statusCell)
            .Column("Queued At", r => r.CreatedAt.ToInvariantTimestamp(), c => c.Css("text-nowrap small"))
            .Template("Sent At", sentAtCell, c => c.Css("text-nowrap small"))
            .Template("Actions", actionsCell, c => c.NoSort())
            .Template("Error", lastErrorCell)
            .Build();
        <partial name="_Table" model="outboxTable" />
    }
</div>

<div class="row g-3 mt-4">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Daily Send Volume (Last 90 Days)</span>
                <a asp-action="BackfillDailyCountsPreview" class="btn btn-sm btn-outline-secondary">Backfill from outbox history</a>
            </div>
            @if (!Model.DailyCounts.Any())
            {
                <div class="card-body"><empty-state class="mb-0">No daily send counts recorded yet.</empty-state></div>
            }
            else
            {
                Func<Humans.Email.Services.DailySendCountRow, IHtmlContent> sentCell = @<text><span class="text-success">@item.SentCount</span></text>;
                Func<Humans.Email.Services.DailySendCountRow, IHtmlContent> failedCell = @<text><span class="text-danger">@item.FailedCount</span></text>;
                var dailyTable = TableModel.For(Model.DailyCounts)
                    .Column("Date (UTC)", r => r.Date.ToInvariantDate())
                    .Template("Sent", sentCell)
                    .Template("Failed", failedCell)
                    .Build();
                <partial name="_Table" model="dailyTable" />
            }
        </div>
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Top Templates (Last 90 Days)</div>
            @if (!Model.TopTemplates.Any())
            {
                <div class="card-body"><empty-state class="mb-0">No daily send counts recorded yet.</empty-state></div>
            }
            else
            {
                Func<Humans.Email.Services.TemplateSendCountRow, IHtmlContent> sentSentCell = @<text><span class="text-success">@item.SentCount</span></text>;
                Func<Humans.Email.Services.TemplateSendCountRow, IHtmlContent> failedFailedCell = @<text><span class="text-danger">@item.FailedCount</span></text>;
                var templateTable = TableModel.For(Model.TopTemplates)
                    .Column("Template", r => r.TemplateName, o => o.Code().Css("small"))
                    .Template("Sent", sentSentCell)
                    .Template("Failed", failedFailedCell)
                    .Build();
                <partial name="_Table" model="templateTable" />
            }
        </div>
    </div>
</div>
