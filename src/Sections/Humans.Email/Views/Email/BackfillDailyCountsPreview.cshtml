@model Humans.Email.Models.BackfillDailyCountsViewModel
@{
    ViewData["Title"] = "Backfill Daily Send Counts";
    ViewData[Humans.Base.ViewComponents.AdminNavComposition.ParentKey] = nameof(EmailController.EmailOutbox);
}

<h1>Backfill Daily Send Counts</h1>
<p class="text-muted">
    Recomputes (Date, Template) rows from retained outbox history for any combination that
    has no <code>email_daily_send_counts</code> row yet. Existing rows — written by the
    processor, or by an earlier run of this backfill — are never touched.
</p>

@if (Model.RowsToAdd == 0)
{
    <div class="alert alert-info">Nothing to backfill — every (Date, Template) combination in retained outbox history already has a row.</div>
}
else
{
    <div class="alert alert-warning">
        This would add <strong>@Model.RowsToAdd</strong> row(s), covering
        <strong>@Model.EarliestDate.ToInvariantDate()</strong> through <strong>@Model.LatestDate.ToInvariantDate()</strong> (UTC).
    </div>

    <div class="card mb-3">
        <div class="card-header">Sample (first @Model.Sample.Count of @Model.RowsToAdd)</div>
        @{
            var sampleTable = TableModel.For(Model.Sample)
                .Column("Date (UTC)", r => r.Date, o => o.Date())
                .Column("Template", r => r.TemplateName, o => o.Code().Css("small"))
                .Column("Would add Sent", r => r.SentCount, o => o.Number().Css("text-success"))
                .Column("Would add Failed", r => r.FailedCount, o => o.Number().Css("text-danger"))
                .Build();
        }
        <partial name="_Table" model="sampleTable" />
    </div>

    <form method="post" asp-action="BackfillDailyCounts">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-warning"
                data-confirm="Add @Model.RowsToAdd daily send count row(s) from outbox history? This cannot be run in reverse.">
            Backfill @Model.RowsToAdd Row(s)
        </button>
        <a asp-action="EmailOutbox" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
