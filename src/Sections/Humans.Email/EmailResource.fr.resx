  <data name="Email_ApplicationSubmitted_Subject" xml:space="preserve">
    <value>Nouvelle candidature d'adhésion : {0}</value>
    <comment>{0} = applicant name</comment>
  </data>
  <data name="Email_Welcome_Subject" xml:space="preserve">
    <value>Bienvenue sur Humans !</value>
  </data>
  <data name="Email_ApplicationSubmitted_Body" xml:space="preserve">
    <value>&lt;h2&gt;Nouvelle demande d'adhésion&lt;/h2&gt;
&lt;p&gt;Une nouvelle demande d'adhésion a été soumise.&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;strong&gt;Candidat :&lt;/strong&gt; {0}&lt;/li&gt;
    &lt;li&gt;&lt;strong&gt;ID de demande :&lt;/strong&gt; {1}&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;a href="{2}/Governance/Applications/Admin/{1}"&gt;Examiner la demande&lt;/a&gt;&lt;/p&gt;</value>
    <comment>{0} = applicant name, {1} = application ID, {2} = base URL</comment>
  </data>
  <data name="Email_Welcome_Body" xml:space="preserve">
    <value>&lt;h2&gt;Bienvenue !&lt;/h2&gt;
&lt;p&gt;Bonjour {0},&lt;/p&gt;
&lt;p&gt;Bienvenue sur le portail Humans !&lt;/p&gt;
&lt;p&gt;Voici ce que vous pouvez faire :&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;a href="{1}/Profile"&gt;Compléter votre profil&lt;/a&gt;&lt;/li&gt;
    &lt;li&gt;&lt;a href="{1}/Teams"&gt;Rejoindre des équipes et groupes de travail&lt;/a&gt;&lt;/li&gt;
    &lt;li&gt;&lt;a href="{1}/Consent"&gt;Consulter les documents légaux&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Si vous avez des questions, n'hésitez pas à nous contacter.&lt;/p&gt;
&lt;p&gt;Cordialement,&lt;br/&gt;L'équipe Humans&lt;/p&gt;</value>
    <comment>{0} = user name, {1} = base URL</comment>
  </data>
  <data name="Email_FacilitatedMessage_Subject" xml:space="preserve">
    <value>Message Humans de : {0}</value>
  </data>
  <data name="Email_FacilitatedMessage_Body" xml:space="preserve">
    <value>&lt;h2&gt;Message de {1}&lt;/h2&gt;&lt;p&gt;Bonjour {0},&lt;/p&gt;&lt;p&gt;{1} vous a envoyé un message via Humans :&lt;/p&gt;&lt;hr /&gt;&lt;p&gt;{2}&lt;/p&gt;&lt;hr /&gt;{3}</value>
  </data>
  <data name="Email_FacilitatedMessage_NoContactInfo" xml:space="preserve">
    <value>Cet humain a choisi de ne pas partager ses coordonnées.</value>
  </data>

