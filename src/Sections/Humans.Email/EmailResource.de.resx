  <data name="Email_ApplicationSubmitted_Body" xml:space="preserve">
    <value>&lt;h2&gt;Neuer Mitgliedschaftsantrag&lt;/h2&gt;
&lt;p&gt;Ein neuer Mitgliedschaftsantrag wurde eingereicht.&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;strong&gt;Antragsteller:&lt;/strong&gt; {0}&lt;/li&gt;
    &lt;li&gt;&lt;strong&gt;Antrags-ID:&lt;/strong&gt; {1}&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;a href="{2}/Governance/Applications/Admin/{1}"&gt;Antrag prüfen&lt;/a&gt;&lt;/p&gt;</value>
    <comment>{0} = applicant name, {1} = application ID, {2} = base URL</comment>
  </data>
  <data name="Email_Welcome_Body" xml:space="preserve">
    <value>&lt;h2&gt;Willkommen!&lt;/h2&gt;
&lt;p&gt;Hallo {0},&lt;/p&gt;
&lt;p&gt;Willkommen im Humans-Portal!&lt;/p&gt;
&lt;p&gt;Das kannst du tun:&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;a href="{1}/Profile"&gt;Dein Profil vervollständigen&lt;/a&gt;&lt;/li&gt;
    &lt;li&gt;&lt;a href="{1}/Teams"&gt;Teams und Arbeitsgruppen beitreten&lt;/a&gt;&lt;/li&gt;
    &lt;li&gt;&lt;a href="{1}/Consent"&gt;Rechtliche Dokumente prüfen&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Bei Fragen melde dich gerne bei uns.&lt;/p&gt;
&lt;p&gt;Mit freundlichen Grüßen,&lt;br/&gt;Das Humans-Team&lt;/p&gt;</value>
    <comment>{0} = user name, {1} = base URL</comment>
  </data>
  <data name="Email_FacilitatedMessage_Subject" xml:space="preserve">
