@model TeamPageViewModel

@{
    ViewData["Title"] = Localizer["Tasks_Team_Title", Model.TeamName].Value;
}

@section Crumbs {
    <a href="@Url.Action("Index", "Tasks")">@SharedLocalizer["Nav_Tasks"]</a>
    <span>@Model.TeamName</span>
}

<page-header title="@(Localizer["Tasks_Team_Title", Model.TeamName].Value)">
    <page-header-subtitle><a href="@Url.Action("Details", "Team", new { slug = Model.TeamSlug })">@Localizer["Tasks_Team_TeamPage"]</a></page-header-subtitle>
    <a href="@Url.Action("Open", "Tasks")" class="btn btn-outline-secondary">@Localizer["Tasks_List_Open"]</a>
    <a href="@Url.Action("Index", "Tasks")" class="btn btn-outline-secondary">@Localizer["Tasks_Team_All"]</a>
    @if (Model.CanAdd)
    {
        <a href="#add" class="btn btn-primary">@Localizer["Tasks_Team_AddTitle"]</a>
    }
</page-header>

@{
    var teamUrl = Url.Action("Team", "Tasks", new { slug = Model.TeamSlug }) + Context.Request.QueryString;
}

@if (Model.Requests.Count > 0)
{
    <div class="card mb-4" id="requests">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">@Localizer["Tasks_Requests_Title"]</h2>
            <span class="text-muted small">@Model.Requests.Count</span>
        </div>
        <partial name="_Requests" model="new RequestsViewModel(Model.Requests, ShowTask: true, ReturnUrl: teamUrl)" />
    </div>
}

<partial name="_Filter" model="new TaskFilterViewModel(Model.Filter, null, null, Model.Statuses)" />
<partial name="_TaskRows" model='new TaskRowsModel(Model.Tasks, ShowTeam: false, ShowStatus: true, Model.Places, Model.Blockers, teamUrl, Localizer["Tasks_List_Empty"].Value)' />

@if (Model.CanAdd)
{
    <div class="card mt-4 col-lg-8" id="add">
        <div class="card-header"><h2 class="h5 mb-0">@Localizer["Tasks_Team_AddTitle"]</h2></div>
        <div class="card-body">
            <partial name="_TaskForm" model='new TaskFormViewModel(Model.AddForm, "new", true, Url.Action("Add", new { slug = Model.TeamSlug })!, [new TeamChoice(Model.TeamId, Model.TeamName, Model.TeamSlug)], Model.Events)' />
        </div>
    </div>
}
