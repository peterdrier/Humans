@* The filters of a task list: which event, which team, which priority, which status, whether done and cancelled tasks count, and only tasks with no dates. *@
@model TaskFilterViewModel

<form method="get" class="d-flex flex-wrap align-items-end gap-3 mb-3">
    @if (Model.Events is not null)
    {
        <div>
            <label class="form-label" for="filter-event">@Localizer["Tasks_Filter_Event"]</label>
            <select class="form-select" id="filter-event" name="Event">
                <option value="@TaskListFilter.ActiveEvent" selected="@(Model.Filter is TaskListFilter { EventChoice: TaskListFilter.ActiveEvent })">@Localizer["Tasks_Filter_ActiveEvent"]</option>
                <option value="@TaskListFilter.AnyEvent" selected="@(Model.Filter is TaskListFilter { EventChoice: TaskListFilter.AnyEvent })">@Localizer["Tasks_Filter_AnyEvent"]</option>
                @foreach (var e in Model.Events)
                {
                    <option value="@e.Id" selected="@(Model.Filter is TaskListFilter list && list.SpecificEventId == e.Id)">@e.Name</option>
                }
            </select>
        </div>
    }
    @if (Model.Teams is not null)
    {
        <div>
            <label class="form-label" for="filter-team">@Localizer["Tasks_Col_Team"]</label>
            <select class="form-select" id="filter-team" name="Team">
                <option value="">@Localizer["Tasks_Filter_AnyTeam"]</option>
                @foreach (var team in Model.Teams)
                {
                    <option value="@team.Id" selected="@(Model.Filter.Team == team.Id)">@team.Name</option>
                }
            </select>
        </div>
    }
    <div>
        <label class="form-label" for="filter-priority">@Localizer["Tasks_Col_Priority"]</label>
        <select class="form-select" id="filter-priority" name="Priority">
            <option value="">@Localizer["Tasks_Filter_AnyPriority"]</option>
            @foreach (var priority in new[] { SlotPriority.Critical, SlotPriority.Important, SlotPriority.NiceToHave })
            {
                <option value="@priority" selected="@(Model.Filter.Priority == priority)">@SharedLocalizer.EnumDisplay(priority)</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label" for="filter-status">@Localizer["Tasks_Col_Status"]</label>
        <select class="form-select" id="filter-status" name="Status">
            <option value="">@Localizer["Tasks_Filter_AnyStatus"]</option>
            @foreach (var status in Model.Statuses)
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@Localizer[$"Enum_TaskItemStatus_{status}"]</option>
            }
        </select>
    </div>
    @if (Model.Filter is TaskListFilter finishedFilter)
    {
        <div class="form-check mb-2">
            <input type="checkbox" class="form-check-input" id="filter-finished" name="Finished" value="true" checked="@finishedFilter.Finished" />
            <label class="form-check-label" for="filter-finished">@Localizer["Tasks_Filter_Finished"]</label>
        </div>
    }
    @if (Model.OfferUndated)
    {
        <div class="form-check mb-2">
            <input type="checkbox" class="form-check-input" id="filter-undated" name="Undated" value="true" checked="@Model.Filter.Undated" />
            <label class="form-check-label" for="filter-undated">@Localizer["Tasks_Filter_Undated"]</label>
        </div>
    }
    <button type="submit" class="btn btn-outline-secondary">@Localizer["Tasks_Filter_Apply"]</button>
</form>
