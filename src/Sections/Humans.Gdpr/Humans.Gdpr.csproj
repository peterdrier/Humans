<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Still Microsoft.NET.Sdk, not Sdk.Razor: Gdpr has no views, only a controller. The
    /Profile/Me/DownloadData export action stays on Users' ProfileController — that one
    would be a URL change, out of scope. /Guest/DownloadData moved here at
    nobodies-collective/Humans#1091 instead: it calls this section's own
    IGdprExportService directly and its route was already Guest-prefixed, so relocating
    the controller (byte-identical route, via attribute routing) is not a URL change.
    No Views/ tree follows because the action only ever returns File()/Redirect.
  -->

  <ItemGroup>
    <!-- GuestDataController: [Authorize], IActionResult, File()/RedirectToAction — the
         framework reference is not transitive through the Humans.Base ProjectReference
         below, so every controller-owning section declares its own (Auth's shape). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Gdpr.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No Humans.Infrastructure and no Humans.UI reference: Gdpr owns no tables, so there is
      no DbContext, no repository and no AddSectionDbContext call, and it has no views. The
      orchestrator injects IEnumerable<IUserDataContributor> from its own leaf, IClock and
      ILogger — nothing else. The one Humans.Application type it names,
      NodaTimeFormattingExtensions.ToIso8601, ships from Base, so the hub ProjectReference
      went away at G5 lane 5c. (Humans.Domain, the other project this note used to name, no
      longer exists — deleted in G5 lane 3b.)
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
