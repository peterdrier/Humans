<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Still Microsoft.NET.Sdk, not Sdk.Razor: Gdpr has one controller and no views, because
    its only action returns File() or a redirect. /Guest/DownloadData lives here because
    it calls this section's own IGdprExportService and nothing else; /Profile/Me/DownloadData
    stays on Users' ProfileController, since moving it would change a URL.
  -->

  <ItemGroup>
    <!-- GuestDataController: [Authorize], IActionResult, File()/RedirectToAction — the
         framework reference is not transitive through the Humans.Base ProjectReference
         below, so every controller-owning section declares its own (Auth's shape). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Gdpr.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No Humans.Infrastructure and no Humans.UI reference: Gdpr owns no tables, so there is
      no DbContext, no repository and no AddSectionDbContext call, and it has no views. The
      orchestrator injects IEnumerable<IUserDataContributor> from its own leaf, IClock and
      ILogger — nothing else.
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation; keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
