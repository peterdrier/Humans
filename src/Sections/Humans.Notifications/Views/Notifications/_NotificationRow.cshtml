@model Humans.Notifications.Services.NotificationRowDto
@inject NodaTime.IClock Clock
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<NotificationsResource> HtmlLocalizer

@{
    var borderClass = Model switch
    {
        { IsResolved: true } => "notification-border-resolved",
        { Class: NotificationClass.Actionable, Priority: NotificationPriority.Critical } => "notification-border-danger",
        { Class: NotificationClass.Actionable, Priority: NotificationPriority.High } => "notification-border-warning",
        { Class: NotificationClass.Actionable } => "notification-border-success",
        _ => "notification-border-muted"
    };

    var bgClass = Model switch
    {
        { IsResolved: true } => "notification-row-resolved",
        { Class: NotificationClass.Actionable } => "notification-row-actionable",
        _ => "notification-row-informational"
    };

    var timeAgo = TimeAgo(Model.CreatedAt, Localizer);
    var resolvedTimeAgo = Model.ResolvedAt.HasValue ? TimeAgo(Model.ResolvedAt.Value, Localizer) : "";
    var hasActionUrl = !string.IsNullOrEmpty(Model.ActionUrl);
}

<div class="notification-row @borderClass @bgClass" data-notification-id="@Model.Id">
    @if (Model.IsResolved)
    {
        var resolver = await Component.InvokeAsync(typeof(HumanViewComponent), new
        {
            userId = Model.ResolvedByUserId ?? Guid.Empty,
            link = HumanLink.None,
        });
        using var resolverWriter = new System.IO.StringWriter();
        resolver.WriteTo(resolverWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
        // Template indentation must not add whitespace before the localized sentence's punctuation.
        var resolverHtml = new Microsoft.AspNetCore.Html.HtmlString(resolverWriter.ToString().Trim());
        <div class="notification-row-line">
            <span class="notification-title notification-title-resolved">@Model.Title</span>
            <span class="notification-timestamp">@timeAgo</span>
        </div>
        <div class="notification-resolved-label">
            @HtmlLocalizer["Notifications_HandledBy", resolverHtml, resolvedTimeAgo]
        </div>
    }
    else if (hasActionUrl)
    {
        <a href="@Url.Action("ClickThrough", "Notifications", new { id = Model.Id })"
           class="notification-row-line notification-action-btn">
            <span class="notification-title">@Model.Title</span>
            <span class="notification-timestamp">@timeAgo</span>
        </a>
    }
    else
    {
        <div class="notification-row-line">
            <span class="notification-title">@Model.Title</span>
            <span class="notification-timestamp">@timeAgo</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Body))
    {
        <div class="notification-body">@Model.Body</div>
    }
    @if (!string.IsNullOrEmpty(Model.TargetGroupName))
    {
        // Role sends store the role name; a group without a label shows as stored.
        var audience = Localizer[$"Notifications_Audience_{Model.TargetGroupName}"];
        <div class="notification-audience">@string.Format(Localizer["Notifications_SentTo"].Value, audience.ResourceNotFound ? Model.TargetGroupName : audience.Value)</div>
    }
</div>

@functions {
    string TimeAgo(DateTime utcTime, IStringLocalizer localizer)
    {
        var now = Clock.GetCurrentInstant();
        var then = NodaTime.Instant.FromDateTimeUtc(DateTime.SpecifyKind(utcTime, DateTimeKind.Utc));
        var span = (now - then).ToTimeSpan();
        if (span.TotalMinutes < 1) return localizer["Notifications_TimeAgo_JustNow"].Value;
        if (span.TotalMinutes < 60) return string.Format(localizer["Notifications_TimeAgo_Minutes"].Value, (int)span.TotalMinutes);
        if (span.TotalHours < 24) return string.Format(localizer["Notifications_TimeAgo_Hours"].Value, (int)span.TotalHours);
        if (span.TotalDays < 7) return string.Format(localizer["Notifications_TimeAgo_Days"].Value, (int)span.TotalDays);
        return utcTime.ToWeekdayDayMonth();
    }
}
