<div class="split-panels" authorize-policy="AdminOnly">
    <div class="card">
        <div class="card-head">
            <h3>Recent activity</h3>
            <small>last 24h</small>
        </div>
        @await Component.InvokeAsync("AuditLog", new { limit = 8, layout = "activity", showCard = false, emptyText = "No recent activity." })
    </div>
</div>
