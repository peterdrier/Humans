@model Guid

@* The wg-* classes are the gallery page's (Debug's /Debug/WidgetGallery); this renders inside its
   ChromeSlots.WidgetGallery slot, so the section owns its own cards and Debug names nothing here. *@

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent ParamsBlock(params (string Name, string Description)[] entries)
    {
        var html = new System.Text.StringBuilder();
        html.Append("<dl class=\"wg-params\">");
        if (entries.Length == 0)
        {
            html.Append("<dd class=\"wg-params-none\">(no parameters — uses ambient request context)</dd>");
        }
        else
        {
            foreach (var (name, desc) in entries)
            {
                html.Append($"<dt>{System.Net.WebUtility.HtmlEncode(name)}</dt><dd>{desc}</dd>");
            }
        }
        html.Append("</dl>");
        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }
}

<div class="wg-card">
    <div class="wg-card-header">
        <div>
            <span class="wg-card-name">&lt;vc:audit-log&gt;</span>
            <span class="wg-card-kind kind-vc">ViewComponent</span>
        </div>
        <span class="wg-card-path">src/Sections/Humans.AuditLog/ViewComponents/AuditLogViewComponent.cs</span>
    </div>
    <div class="wg-card-note">Filtered audit log — the only sanctioned way for a section to <em>show</em> audit history. Filters can stack; the AuditLog section owns the read and the render.</div>
    @ParamsBlock(
        ("entityType", "<code>string?</code> — e.g. <code>User</code>, <code>Team</code>, <code>Application</code>"),
        ("entityId", "<code>Guid?</code> — scoped to one entity"),
        ("entityIds", "<code>IReadOnlyList&lt;Guid&gt;?</code> — several entities of one type, merged newest-first"),
        ("userId", "<code>Guid?</code> — scoped to actions taken by/on a user"),
        ("resourceId", "<code>Guid?</code> — scoped to one Google resource"),
        ("googleSyncOnly", "<code>bool</code> — with <code>userId</code>, only Google-sync entries"),
        ("actions", "<code>string?</code> — CSV of audit action names"),
        ("since", "<code>Instant?</code> — drop entries older than this"),
        ("limit", "<code>int</code> — page size (default 20)"),
        ("layout", "<code>string</code> — <code>line</code> (default, narrative), <code>table</code>, or <code>sync</code>"),
        ("columns", "<code>string?</code> — CSV subset of When/Actor/Action/Subject/Description/Target; <code>table</code> only"),
        ("columnLabels", "<code>string?</code> — keyed header overrides, <code>when:Fecha,actor:Remitente</code>; <code>table</code> only. Unknown/unsupplied keys keep the English name"),
        ("title", "<code>string</code> — heading text (default \"Audit History\")"),
        ("emptyText", "<code>string</code> — no-rows copy (default \"No audit history.\")"),
        ("showCard", "<code>bool</code> — wrap in a Bootstrap card (default true)")
    )
    <div class="wg-card-example">
        <vc:audit-log user-id="@Model" limit="10" title="Recent audit entries for current human" />
        <vc:audit-log user-id="@Model" limit="10" layout="table" columns="when,actor,description"
                      title="Same entries, layout=&quot;table&quot;" />
    </div>
</div>
