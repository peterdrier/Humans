@inject Microsoft.Extensions.Localization.IStringLocalizer<AuditLogResource> Localizer
@model Humans.AuditLog.Contracts.AuditEvent

@{
    var render = Model.RenderStructured();
    var actorIsSubject = Model.ActorUserId.HasValue && Model.SubjectUserId.HasValue
        && Model.ActorUserId.Value == Model.SubjectUserId.Value;
}

<div class="d-flex align-items-baseline gap-1 small flex-wrap">
    <span class="text-muted text-nowrap">@Model.OccurredAt.ToInvariantTimestamp()</span>
    <span class="text-muted">—</span>
    @if (render.Verb != null)
    {
        @if (Model.ActorUserId.HasValue)
        {
            <vc:human user-id="@Model.ActorUserId.Value" />
        }
        else
        {
            <span class="text-muted">@Localizer["AuditLog_System"]</span>
        }

        @* Use a separate translated form when the subject is suppressed. *@
        var noVisibleSubject = actorIsSubject || !Model.SubjectUserId.HasValue;
        var displayVerb = Model.Action.ToLocalizedAuditVerb(noVisibleSubject, Localizer);
        <span>@displayVerb</span>

        @if (Model.SubjectUserId.HasValue && !actorIsSubject)
        {
            <vc:human user-id="@Model.SubjectUserId.Value" />
        }

        @if (Model.TargetTeamId.HasValue && !string.IsNullOrEmpty(Model.TargetTeamName))
        {
            <span class="text-muted">@Localizer["AuditLog_InTeam"]</span>
            <a asp-controller="Team" asp-action="Details" asp-route-slug="@Model.TargetTeamSlug" class="text-decoration-none">@Model.TargetTeamName</a>
        }

        @* Tail descriptions (ShiftSignup*); sentence-style (Team*, Role*, Member*) would be redundant. *@
        @if (render.ShouldRenderDescriptionTail)
        {
            <span class="text-muted">— @Model.Description</span>
        }
    }
    else
    {
        @* Unmapped: actor · ActionName · subject · in team · "description". *@
        @if (Model.ActorUserId.HasValue)
        {
            <vc:human user-id="@Model.ActorUserId.Value" />
        }
        else
        {
            <span class="text-muted">@Localizer["AuditLog_System"]</span>
        }
        <span class="text-muted">·</span>
        <span>@Model.Action.ToAuditBadgeLabel(Localizer)</span>
        @if (Model.SubjectUserId.HasValue && !actorIsSubject)
        {
            <span class="text-muted">·</span>
            <vc:human user-id="@Model.SubjectUserId.Value" />
        }
        @if (Model.TargetTeamId.HasValue && !string.IsNullOrEmpty(Model.TargetTeamName))
        {
            <span class="text-muted">@Localizer["AuditLog_InTeam"]</span>
            <a asp-controller="Team" asp-action="Details" asp-route-slug="@Model.TargetTeamSlug" class="text-decoration-none">@Model.TargetTeamName</a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <span class="text-muted">— @Model.Description</span>
        }
    }
</div>
