<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Camps' cross-section surface, carved into its own leaf project rather than a Contracts/
    folder because Base consumes it: ShiftManagementService reads CampSeasonInfo,
    SystemTeamSyncJob takes the two camp-lead reads, and Shell's
    ProfileSummaryViewModelBuilder binds CampUserInfo (see
    memory/architecture/section-project-cycle-fix.md).

    It holds exactly what lives outside the section: the read surface other sections and
    Base inject, the two camp-lead reads SystemTeamSyncJob takes,
    the verbs Humans.Development's two dev seeders drive, and the flat projections those
    signatures name. The directory, detail, admin, roster, join-request, role-management,
    compliance, image and early-entry DTOs are internal to the section.

    The camp enums named by the leaf's records live here rather than in the section's
    internal Domain/ (Budget's rule). CampSpecialRole is section-only and stays in Domain/.
    Teams' hard floor does not apply: no
    Humans.UI partial renders any of them — _CampCard.cshtml is the section's own view.

    Its only project reference is Humans.Base.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
