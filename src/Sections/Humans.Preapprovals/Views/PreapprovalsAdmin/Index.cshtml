@model AdminIndexViewModel
@{
    ViewData["Title"] = "Pre-approval programs";

    Func<ProgramInfo, IHtmlContent> nameCell =
        @<text><a asp-action="Program" asp-route-programId="@item.Id" class="text-decoration-none">@item.Name</a></text>;
    Func<ProgramInfo, IHtmlContent> applicationsCell = @<text>
        @if (item.OpenApplications > 0)
        {
            <span class="badge bg-warning text-dark">@item.OpenApplications</span>
        }
    </text>;
    Func<ProgramInfo, IHtmlContent> statusCell = @<text>
        <status-badge value="@item.Status" />
        @if (item.AcceptsApplications && item.IsAcceptingApplications(Model.Today))
        {
            <span class="badge bg-info text-dark">Accepting applications</span>
        }
    </text>;
    var table = TableModel.For(Model.Programs)
        .Template("Program", nameCell)
        .Column("Kind", p => p.Kind == ProgramKind.FixedPerPerson ? $"{p.PerPersonAmount!.Value.ToEuro()} per person" : "Per grant")
        .Column("Committed", p => p.Granted, o => o.Currency().End())
        .Column("Ceiling", p => p.TotalCeiling, o => o.Currency().End())
        .Column("Remaining", p => p.Remaining, o => o.Currency().End())
        .Column("Not claimed", p => p.NotClaimed(Model.Today), o => o.Currency().End().Css("text-muted"))
        .Template("Applications", applicationsCell, o => o.Css("text-center").HeaderCss("text-center"), sortBy: p => p.OpenApplications)
        .Column("Claim by", p => p.ClaimBy, o => o.Date())
        .Template("Status", statusCell)
        .RowCss(p => p.DeadlinePassed(Model.Today) ? "text-muted" : null)
        .Css("align-middle")
        .Build();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0"><i class="fa-solid fa-stamp me-2"></i>Pre-approval programs</h1>
    @if (Model.CanAdminister)
    {
        <a asp-action="New" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>New program</a>
    }
</div>

@if (Model.Programs.Count == 0)
{
    <empty-state>No programs yet.</empty-state>
}
else
{
    <partial name="_Table" model="table" />
}
