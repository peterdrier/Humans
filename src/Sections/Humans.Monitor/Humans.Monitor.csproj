<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Monitor.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.AuditLog byte-identical to their
      originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No Humans.Infrastructure reference: Monitor owns no tables, so there is no DbContext, no
      repository and no AddSectionDbContext call (G5-SECTION-TEMPLATE.md step 1). Scanner's
      shape. DriveActivityMonitorService reads Google through GoogleIntegration's connector
      abstraction and writes through IAuditLogService; neither needs Infrastructure.

      Monitor is the *consumer* end of every edge it has — its only inbound reference is
      Shell naming DriveActivityMonitorJob, which now lives in this project's Contracts/
      folder (G5 jobs move, nobodies-collective/Humans#866). That is what makes
      Monitor -> GoogleIntegration + AuditLog legal where AuditLog -> GoogleIntegration was
      not: AuditLog is a horizontal (peters-hard-rules.md), and Monitor is not.
      MonitorArchitectureTests.SectionReferencesOnlyBaseAndTheLeavesItConsumes pins it.
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.GoogleIntegration.Contracts\Humans.GoogleIntegration.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <!-- SyncAudit.cshtml emits <vc:google-sync-log>, so that section's tag helpers must be
         referenced for @addTagHelper *, Humans.GoogleIntegration to bind. Monitor reads
         neither the audit log nor the sync log itself. -->
    <ProjectReference Include="..\Humans.GoogleIntegration\Humans.GoogleIntegration.csproj" />
    <ProjectReference Include="..\Humans.Settings.Contracts\Humans.Settings.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package here: those ship with no PackageVersion on purpose and would fail
      the build with NU1010 under Central Package Management. Everything the controller needs
      arrives through the framework reference Sdk.Razor already adds (design §15 step 1).
      No EF Core either — the section owns no tables.

      Hangfire.Core arrives with DriveActivityMonitorJob (G5 jobs move): the job carries
      [DisableConcurrentExecution]. Package, not project — no cycle is possible. It used to
      arrive transitively through Humans.Application, which G5 lane 5c dropped.
    -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
