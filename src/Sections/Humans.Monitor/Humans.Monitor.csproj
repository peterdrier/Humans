<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- MonitorController: the framework reference is not transitive through Humans.Base,
         so every controller-owning section declares its own. No views, so not Sdk.Razor. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Web adds this to ImplicitUsings; Microsoft.NET.Sdk does not. -->
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Monitor.Tests" />
    <!-- The one assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No Humans.Infrastructure reference: Monitor owns no tables, so there is no DbContext, no
      repository and no AddSectionDbContext call.

      Monitor is the consumer end of every edge it has: no section references it, and the
      Shell's reference is the discovery one every section gets. Humans.GoogleIntegration is
      referenced whole because its contracts are a Contracts/ folder, not a separate project.
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.GoogleIntegration\Humans.GoogleIntegration.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <ProjectReference Include="..\Humans.Settings\Humans.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package here: those ship with no PackageVersion on purpose and would fail
      the build with NU1010 under Central Package Management. No EF Core either — the section
      owns no tables.

      Hangfire.Core is here for [DisableConcurrentExecution] on DriveActivityMonitorJob.
    -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
