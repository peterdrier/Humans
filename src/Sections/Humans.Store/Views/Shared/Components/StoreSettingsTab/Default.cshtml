@model StoreSettingsViewModel

@* Explicit asp-controller/asp-action: inside /Settings, ambient route data would resolve against the wrong controller. *@
<form class="mw-540" method="post" asp-controller="StoreAdmin" asp-action="SaveSettings">
    <div class="mb-3">
        <label class="form-label" for="DepositLiabilityAccountNum">Deposit liability account</label>
        <partial name="~/Views/StoreAdmin/_AccountPicker.cshtml"
                 model="@(new AccountPickerModel("DepositLiabilityAccountNum", "DepositLiabilityAccountNum", "Deposit liability account", Model.DepositLiabilityAccountNum, Model.DepositAccountChoices))" />
        <div class="form-text">Refundable deposits on camp orders are booked here (fianzas recibidas, 18x or 56x), never to income. Unset, orders with deposits can't be invoiced.</div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="SimplifiedInvoiceThresholdEur">Simplified invoice limit (EUR)</label>
        <input class="form-control" type="number" min="0" step="0.01" asp-for="SimplifiedInvoiceThresholdEur" style="max-width: 10rem;" />
        <div class="form-text">An order without counterparty details gets a simplified invoice only up to this total; above it, a full invoice is required.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save settings</button>
</form>
<partial name="~/Views/StoreAdmin/_AccountPickerScripts.cshtml" />
