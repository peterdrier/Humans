@model ProductInputModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "Create product" : "Edit product";
}

<page-header title="@(isCreate ? "Create product" : "Edit product")">
    <a asp-action="Catalog" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to catalog
    </a>
</page-header>


<div class="card">
    <div class="card-body">
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-2">
                    <label asp-for="Year" class="form-label">Year</label>
                    <input asp-for="Year" class="form-control" />
                    <span asp-validation-for="Year" class="text-danger small"></span>
                </div>
                <div class="col-md-10">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="UnitPriceEur" class="form-label">Unit price ex. VAT (€)</label>
                    <input asp-for="UnitPriceEur" id="priceExVat" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="UnitPriceEur" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VatRatePercent" class="form-label">VAT %</label>
                    <input asp-for="VatRatePercent" id="vatRate" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="VatRatePercent" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Unit price incl. VAT (€)</label>
                    <input id="priceInclVat" type="number" step="0.01" min="0" class="form-control" />
                    <div class="form-text">Enter either price — the other updates automatically.</div>
                </div>
                <div class="col-md-3">
                    <label asp-for="DepositAmountEur" class="form-label">Deposit (€, optional)</label>
                    <input asp-for="DepositAmountEur" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="DepositAmountEur" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="OrderableUntil" class="form-label">Orderable until</label>
                    <input asp-for="OrderableUntil" type="date" class="form-control" />
                    <span asp-validation-for="OrderableUntil" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active (visible to camp leads)</label>
                        <span asp-validation-for="IsActive" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <h2 class="h5 mt-4">Accounting</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="HoldedRevenueAccountNum" class="form-label">Income account</label>
                    <partial name="_AccountPicker" model="@(new AccountPickerModel("HoldedRevenueAccountNum", "HoldedRevenueAccountNum", "Income account", Model.HoldedRevenueAccountNum, Model.AccountChoices.Income))" />
                    <div class="form-text">Where camp sales of this item are booked.</div>
                </div>
                <div class="col-md-4">
                    <label for="HoldedExpenseAccountNum" class="form-label">Cost account</label>
                    <partial name="_AccountPicker" model="@(new AccountPickerModel("HoldedExpenseAccountNum", "HoldedExpenseAccountNum", "Cost account", Model.HoldedExpenseAccountNum, Model.AccountChoices.Cost))" />
                    <div class="form-text">Where what NCA spends on this item is booked.</div>
                </div>
                <div class="col-md-4">
                    <label for="HoldedTransferAccountNum" class="form-label">Team usage account</label>
                    <partial name="_AccountPicker" model="@(new AccountPickerModel("HoldedTransferAccountNum", "HoldedTransferAccountNum", "Team usage account", Model.HoldedTransferAccountNum, Model.AccountChoices.TeamUsage))" />
                    <div class="form-text">Credited when a department's team order uses this item.</div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save
                </button>
                <a asp-action="Catalog" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@if (!isCreate)
{
    <div class="mt-4">
        <vc:audit-log entity-type="@AuditEntityTypes.Product" entity-id="@Model.Id"
                      actions="StoreProductPriceChanged" title="Price history" limit="20" />
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AccountPickerScripts" />
    <script nonce="@Context.Items["CspNonce"]">
        (function () {
            var exInput = document.getElementById('priceExVat');
            var inclInput = document.getElementById('priceInclVat');
            var vatInput = document.getElementById('vatRate');

            function multiplier() {
                var rate = parseFloat(vatInput.value);
                return isNaN(rate) ? 1 : 1 + rate / 100;
            }

            function round2(v) { return Math.round(v * 100) / 100; }

            function syncInclFromEx() {
                var ex = parseFloat(exInput.value);
                inclInput.value = isNaN(ex) ? '' : round2(ex * multiplier()).toFixed(2);
            }

            function syncExFromIncl() {
                var incl = parseFloat(inclInput.value);
                exInput.value = isNaN(incl) ? '' : round2(incl / multiplier()).toFixed(2);
            }

            exInput.addEventListener('input', syncInclFromEx);
            inclInput.addEventListener('input', syncExFromIncl);
            vatInput.addEventListener('input', syncInclFromEx);

            syncInclFromEx();
        })();
    </script>
}
