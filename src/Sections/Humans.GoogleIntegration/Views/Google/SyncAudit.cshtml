@model Humans.GoogleIntegration.Models.SyncAuditViewModel
@{
    ViewData["Title"] = Model.Title;
    // A resource audit sits under Resource sync; a human's under Users / Humans, where it is opened from.
    ViewData["AdminNavParent"] = Model.UserId is null ? "Sync" : "UsersAdmin/AdminList";
}

<page-header title="@Model.Title">
    @if (Model.BackUrl != null)
    {
        <a href="@Model.BackUrl" class="btn btn-outline-secondary">@(Model.BackLabel ?? "Back")</a>
    }
</page-header>

<vc:google-sync-log resource-id="@Model.ResourceId" user-id="@Model.UserId"
                    title="Sync entries" empty-text="No sync log entries found." />
