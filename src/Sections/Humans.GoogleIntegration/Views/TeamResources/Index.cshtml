@model TeamResourcesViewModel
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = string.Format(Localizer["GoogleIntegration_TeamResources_Title"].Value, Model.TeamName);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Team" asp-action="Index">@SharedLocalizer["Teams_Title"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Team" asp-action="Details" asp-route-slug="@Model.TeamSlug">@Model.TeamName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["GoogleIntegration_TeamResources_Breadcrumb"]</li>
    </ol>
</nav>

<h1>@Localizer["GoogleIntegration_TeamResources_Heading"]</h1>
<p class="text-muted">@Localizer["GoogleIntegration_TeamResources_Team"]: @Model.TeamName</p>


<div class="card mb-4">
    <div class="card-header">@Localizer["GoogleIntegration_TeamResources_ServiceAccountTitle"]</div>
    <div class="card-body">
        <p class="mb-2">@Localizer["GoogleIntegration_TeamResources_ShareWithServiceAccount"]</p>
        <div class="input-group mb-3" style="max-width: 600px;">
            <input type="text" class="form-control" value="@Model.ServiceAccountEmail" readonly id="serviceAccountEmail">
            <button class="btn btn-outline-secondary" type="button" id="copyServiceAccountBtn">@Localizer["GoogleIntegration_TeamResources_Copy"]</button>
        </div>
        <ul class="mb-0 text-muted small">
            <li><strong>@Localizer["GoogleIntegration_TeamResources_DriveFolders"]:</strong> @Localizer["GoogleIntegration_TeamResources_DriveFoldersHelp"]</li>
            <li><strong>Drive Files:</strong> Share the file's parent Shared Drive with the service account as Contributor.</li>
            <li><strong>@Localizer["GoogleIntegration_TeamResources_GoogleGroups"]:</strong> @Localizer["GoogleIntegration_TeamResources_GoogleGroupsHelp"]</li>
        </ul>
    </div>
</div>

@if (Model.Resources.Any())
{
    <div class="card mb-4">
        <div class="card-header">@Localizer["GoogleIntegration_TeamResources_LinkedResources"]</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["GoogleIntegration_TeamResources_Name"]</th>
                        <th>@Localizer["GoogleIntegration_TeamResources_Type"]</th>
                        <th>Permission</th>
                        <th>Restrict Inheritance</th>
                        <th>@Localizer["GoogleIntegration_TeamResources_LastSynced"]</th>
                        <th>@SharedLocalizer["Common_Status"]</th>
                        <th>@Localizer["GoogleIntegration_TeamResources_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var resource in Model.Resources)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(resource.Url))
                                {
                                    <a href="@resource.Url" target="_blank" rel="noopener noreferrer">@resource.Name</a>
                                }
                                else
                                {
                                    @resource.Name
                                }
                            </td>
                            <td>
                                @if (string.Equals(resource.ResourceType, "Drive Folder", StringComparison.Ordinal))
                                {
                                    <span class="badge bg-info">Drive Folder</span>
                                }
                                else if (string.Equals(resource.ResourceType, "Drive File", StringComparison.Ordinal))
                                {
                                    <span class="badge bg-warning text-dark">Drive File</span>
                                }
                                else if (string.Equals(resource.ResourceType, "Google Group", StringComparison.Ordinal))
                                {
                                    <span class="badge bg-primary">Google Group</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@resource.ResourceType</span>
                                }
                            </td>
                            <td>
                                @if (resource.IsDriveResource)
                                {
                                    <form asp-action="UpdatePermissionLevel" asp-route-slug="@Model.TeamSlug" asp-route-resourceId="@resource.Id" method="post" class="d-inline permission-form">
                                        @Html.AntiForgeryToken()
                                        @{
                                            var currentLevel = resource.DrivePermissionLevel.ToString();
                                        }
                                        <select name="level" class="form-select form-select-sm d-inline-block permission-select" style="width: auto; min-width: 140px;" data-original="@currentLevel"
                                                disabled="@(Model.CanManage ? null : "disabled")">
                                            @foreach (var opt in new[] { ("Viewer", "Viewer"), ("Commenter", "Commenter"), ("Contributor", "Contributor (add/modify)"), ("ContentManager", "Content Manager (move/delete)"), ("Manager", "Manager") })
                                            {
                                                if (opt.Item1 == currentLevel)
                                                {
                                                    <option value="@opt.Item1" selected>@opt.Item2</option>
                                                }
                                                else
                                                {
                                                    <option value="@opt.Item1">@opt.Item2</option>
                                                }
                                            }
                                        </select>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (resource.IsDriveFolder && !Model.CanManage)
                                {
                                    <span class="badge @(resource.RestrictInheritedAccess ? "bg-warning text-dark" : "bg-secondary")">
                                        @(resource.RestrictInheritedAccess ? Localizer["GoogleIntegration_TeamResources_Restricted"] : Localizer["GoogleIntegration_TeamResources_Inherited"])
                                    </span>
                                }
                                else if (resource.IsDriveFolder)
                                {
                                    @if (resource.RestrictInheritedAccess)
                                    {
                                        <form asp-action="ToggleRestrictInheritedAccess" asp-route-slug="@Model.TeamSlug" asp-route-resourceId="@resource.Id" method="post" class="d-inline" data-confirm="This will re-enable inherited permissions on this folder. Are you sure?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="restrict" value="false" />
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                <i class="fa-solid fa-lock me-1"></i>Restricted
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleRestrictInheritedAccess" asp-route-slug="@Model.TeamSlug" asp-route-resourceId="@resource.Id" method="post" class="d-inline" data-confirm="This will disable inherited permissions on this folder, restricting access to only direct permissions. Are you sure?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="restrict" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid fa-lock-open me-1"></i>Inherited
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (resource.LastSyncedAt.HasValue)
                                {
                                            @resource.LastSyncedAt.Value.ToDateTime()
                                }
                                else
                                {
                                    <span class="text-muted">@SharedLocalizer["Admin_Never"]</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(resource.ErrorMessage))
                                {
                                    <span class="badge bg-danger" title="@resource.ErrorMessage">Error</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                @if (Model.CanManage)
                                {
                                    <div class="d-flex gap-1" role="group">
                                        <form asp-action="UnlinkResource" asp-route-slug="@Model.TeamSlug" asp-route-resourceId="@resource.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Are you sure you want to deactivate this resource?">Deactivate</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info mb-4">
        @Localizer["GoogleIntegration_TeamResources_NoResources"]
    </div>
}

@if (Model.CanManage)
{
    <div class="card mb-4">
        <div class="card-header">Link Google Drive Resource</div>
        <div class="card-body">
            <form asp-action="LinkDriveResource" asp-route-slug="@Model.TeamSlug" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="resourceUrl" class="form-label">Drive URL</label>
                    <input type="url" class="form-control" id="resourceUrl" name="ResourceUrl"
                           placeholder="https://drive.google.com/drive/folders/... or https://docs.google.com/spreadsheets/d/..." required>
                    <div class="form-text">Paste a Google Drive folder, Sheets, Docs, Slides, or other file URL.</div>
                </div>
                <div class="mb-3">
                    <label for="permissionLevel" class="form-label">Permission Level</label>
                    <select class="form-select" id="permissionLevel" name="PermissionLevel" style="max-width: 300px;">
                        <option value="Viewer">Viewer (read-only)</option>
                        <option value="Commenter">Commenter</option>
                        <option value="Contributor" selected>Contributor (add/modify)</option>
                        <option value="ContentManager">Content Manager (move/delete)</option>
                        <option value="Manager">Manager</option>
                    </select>
                    <div class="form-text">Permission level granted to team humans for this resource.</div>
                </div>
                <button type="submit" class="btn btn-primary">Link Resource</button>
            </form>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Team" asp-action="Details" asp-route-slug="@Model.TeamSlug" class="btn btn-outline-secondary">@Localizer["GoogleIntegration_TeamResources_BackToTeam"]</a>
    <a asp-controller="TeamAdmin" asp-action="Members" asp-route-slug="@Model.TeamSlug" class="btn btn-outline-primary">@Localizer["GoogleIntegration_TeamResources_ManageMembers"]</a>
</div>

<script>
    document.getElementById('copyServiceAccountBtn').addEventListener('click', function () {
        navigator.clipboard.writeText(document.getElementById('serviceAccountEmail').value);
    });

    document.querySelectorAll('.permission-select').forEach(function (select) {
        select.addEventListener('change', function () {
            if (confirm('Are you sure you want to change the permission level?')) {
                this.closest('form').submit();
            } else {
                this.value = this.getAttribute('data-original');
            }
        });
    });
</script>
