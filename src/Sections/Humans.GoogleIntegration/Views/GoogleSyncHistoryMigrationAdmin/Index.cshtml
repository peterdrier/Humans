@model Humans.GoogleIntegration.Controllers.GoogleSyncHistoryMigrationViewModel
@{
    ViewData["Title"] = "Google Sync History Migration";
    Layout = "_AdminLayout";
    var report = Model.Report;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Google Sync History Migration</h1>
    <small class="text-muted">Issue #1083</small>
</div>

<p class="text-muted">
    The Google-sync wing moved out of <code>audit_log</code> into this section's
    <code>google_sync_log</code>; new syncs already write there. The rows written before that
    are still on <code>audit_log</code>, in six Google-only columns. This page copies them
    forward. Nothing on <code>audit_log</code> is changed or deleted — the columns are dropped
    in a later change, once this has been run and verified.
</p>
<p class="text-muted">
    Each copy keeps its source audit row's id, so running this twice moves nothing the second
    time. What you see below is the dry run: it writes nothing until you press the button.
</p>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Google rows on audit_log</h6>
                <p class="h2 mb-0">@report.Examined</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Already moved</h6>
                <p class="h2 mb-0 text-success">@report.AlreadyPresent</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Would move</h6>
                <p class="h2 mb-0 @(report.Movable == 0 ? "text-success" : "text-primary")">@report.Movable</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Cannot map</h6>
                <p class="h2 mb-0 @(report.Skipped == 0 ? "text-success" : "text-warning")">@report.Skipped</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        @if (report.Movable == 0)
        {
            <p class="mb-0">
                Nothing left to move.
                @if (report.Skipped > 0)
                {
                    <text>
                        @report.Skipped audit row(s) carry a resource id but no sync payload this
                        table can hold; they stay where they are.
                    </text>
                }
            </p>
        }
        else
        {
            <form method="post" asp-action="Run">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"
                        data-confirm="Copy @report.Movable audit row(s) into google_sync_log? The audit rows are left untouched.">
                    <i class="fa-solid fa-arrow-right-arrow-left me-1"></i>
                    Copy @report.Movable row(s) into google_sync_log
                </button>
            </form>
        }
    </div>
</div>

@if (report.MovableRows.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            Rows that would move
            @if (report.Movable > report.MovableRows.Count)
            {
                <span class="text-muted">— showing the @report.MovableRows.Count most recent of @report.Movable</span>
            }
        </div>
        @{
            var movableTable = TableModel.For(report.MovableRows)
                .Column("When", r => r.OccurredAt, c => c.DateTime())
                .Column("Action", r => r.Action)
                .Column("Resource", r => r.ResourceName ?? "(unknown)")
                .Column("Email", r => r.UserEmail)
                .Column("Role", r => r.Role)
                .Column("Source", r => r.Source)
                .Column("Succeeded", r => r.Success)
                .Build();
        }
        <partial name="_Table" model="movableTable" />
    </div>
}

@if (report.SkippedRows.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            Rows that cannot be mapped
            @if (report.Skipped > report.SkippedRows.Count)
            {
                <span class="text-muted">— showing the @report.SkippedRows.Count most recent of @report.Skipped</span>
            }
        </div>
        @{
            var skippedTable = TableModel.For(report.SkippedRows)
                .Column("When", r => r.OccurredAt, c => c.DateTime())
                .Column("Action", r => r.Action)
                .Column("Reason", r => r.Reason)
                .Build();
        }
        <partial name="_Table" model="skippedTable" />
    </div>
}
