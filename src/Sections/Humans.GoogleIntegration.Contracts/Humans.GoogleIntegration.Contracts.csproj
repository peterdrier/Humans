<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GoogleIntegration's cross-section surface, its own leaf because the section is referenced
    in both directions: Teams, Notifications, Surveys and Monitor inject its services while it
    consumes their leaves (memory/architecture/section-project-cycle-fix.md). It holds only what
    something outside the section injects, plus the entities, enums and projections those
    signatures name. Two absences are load-bearing: ISystemTeamSync is Teams' (its leaf), and
    IDriveActivityMonitorService is Monitor's. GoogleWorkspaceOptions is public because Camps'
    CampRoleService and Users' ProfileController bind it. GoogleSyncSource stays in Base because
    Humans.AuditLog.Contracts names it in IAuditLogService's signature.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
