<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Issues' cross-section surface, carved into its own leaf project because a consumer
    outside the section names it: IssueCategory is named by Humans.Agent (route_to_issue),
    so a Contracts/ *folder* inside Humans.Issues would make another section — and, before
    G5 lane 5b-1, Base — reference Humans.Issues and cycle (design §15.5b,
    memory/architecture/section-project-cycle-fix.md).

    CleanupIssuesJob used to be the load-bearing reason for this leaf. It is not any more:
    lane 5b-1 re-measured the "recurring jobs cannot leave Base" claim and found it false —
    RecurringJob.AddOrUpdate<T>(id, …) rewrites the stored type string at every startup, so
    the job id, not the assembly, is the stable key — and the job now lives in
    Humans.Issues/Contracts/ next to the IIssuesRetention it drives. IIssuesRetention has
    no consumer outside the section today and could follow it in; that is a later pass.

    It holds exactly what lives outside the section: the retention call the job drives, and
    IssueCategory. The nav-badge count (IIssuesServiceRead.GetActionableCountForViewerAsync)
    left this leaf at nobodies-collective/Humans#1091 — its sole external caller, Shell's
    NavBadgesViewComponent, dissolved into this section's own user-menu chrome contribution,
    so the method moved onto the internal-only IIssuesService. Everything else Issues does —
    the triage surface, the thread, the list projection, the mutation results — has no
    consumer outside the section and stays internal.

    References Humans.Interfaces only — the bottom of the graph.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <!--
      AuditAction: IssueAuditEvent carries it, and the thread is on the leaf now that the
      Backdoor machine API reads it (nobodies-collective/Humans#1128). AuditLog.Contracts
      references Humans.Base only, so the chain still terminates.
    -->
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Instant/LocalDate on the issue read models. -->
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
