@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   The section owns member-facing strings for /Settings; _EventSettingsForm stays
   admin-exempt (memory/code/localization-admin-exempt.md). *@
@using Humans.Settings
@using Humans.Settings.Models
@using Humans.Base.Models.Tables
@using Microsoft.Extensions.Localization
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@inject IStringLocalizer<SettingsResource> Localizer
