@model Humans.Settings.Services.EventSettingsCarrySnapshot
@{
    ViewData["Title"] = "Carry event settings";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Carry event settings</h1>
    <small class="text-muted">Issue #1104</small>
</div>

<p class="text-muted">
    Copies the app-wide event values — public year, event name, timezone,
    gate-opening date, build calendar, early-entry window and capacity — off the
    Shifts rows into this section's own table, keeping each row's id so
    <code>Rota.EventSettingsId</code> still resolves. Nothing reads this table
    yet, so running it changes nothing users can see; it is the step that has to
    happen before anything can be pointed at it. Idempotent: rows already here
    are left untouched, so it is safe to re-run.
</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Shifts event rows</h6>
                <p class="h2 mb-0">@Model.TotalCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Already carried</h6>
                <p class="h2 mb-0 text-success">@Model.CarriedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Pending</h6>
                <p class="h2 mb-0 @(Model.PendingCount == 0 ? "text-success" : "text-warning")">
                    @Model.PendingCount
                </p>
                <small class="text-muted">
                    @Model.RemainingCount not carried, @Model.StaleStatusCount status stale
                </small>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        @if (Model.PendingCount == 0)
        {
            <p class="mb-0">
                Every Shifts event row is here and holds the same Active/Inactive
                status. Pointing the sections at this table, and retiring the old
                columns, are the follow-up steps.
            </p>
        }
        else
        {
            @if (Model.StaleStatusCount > 0)
            {
                <p class="text-warning">
                    @Model.StaleStatusCount carried row@(Model.StaleStatusCount == 1 ? "" : "s")
                    no longer agree@(Model.StaleStatusCount == 1 ? "s" : "") with Shifts about which
                    cycle is active. Re-running reconciles the status only — the app-wide values
                    edited here are left alone.
                </p>
            }
            <form method="post" asp-action="Run">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-right-arrow-left me-1"></i>
                    Carry @Model.PendingCount event row@(Model.PendingCount == 1 ? "" : "s") across
                </button>
            </form>
        }
    </div>
</div>

@if (Model.TotalCount > 0)
{
    <div class="card mb-4">
        <div class="card-header">Event rows</div>
        @{
            // Carried rows link to their own edit screen — that is the only lookup
            // for an inactive row, which /Settings/Admin's default GET will not load.
            var carryTable = TableModel.For(Model.Rows)
                .Column("Event", r => r.EventName)
                .Column("Year", r => r.Year)
                .Column("Active", r => r.IsActive ? "Yes" : "No")
                .Column("Carried", r => !r.AlreadyCarried ? "No" : r.StatusIsStale ? "Yes — status stale" : "Yes")
                .RowHref(r => r.AlreadyCarried ? Url.Action("Index", "SettingsAdmin", new { id = r.Id }) : null)
                .Build();
        }
        <partial name="_Table" model="carryTable" />
    </div>
}
