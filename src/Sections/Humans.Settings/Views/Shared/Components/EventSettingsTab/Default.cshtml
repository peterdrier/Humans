@using Humans.Settings.ViewComponents
@model EventSettingsTabViewModel

@if (Model.Settings is null)
{
    <p class="text-muted">@Localizer["Settings_NoEventConfigured"]</p>
}
else if (Model.CanEdit)
{
    <partial name="_EventSettingsForm" model="Model.Settings" />
}
else
{
    <dl class="row mb-0">
        <dt class="col-sm-4 col-lg-3">@Localizer["Settings_EventName"]</dt>
        <dd class="col-sm-8 col-lg-9">@Model.Settings.EventName</dd>

        <dt class="col-sm-4 col-lg-3">@Localizer["Settings_GateOpeningDate"]</dt>
        <dd class="col-sm-8 col-lg-9">@Model.Settings.GateOpeningDate</dd>

        <dt class="col-sm-4 col-lg-3">@Localizer["Settings_BuildWindow"]</dt>
        <dd class="col-sm-8 col-lg-9">@Localizer["Settings_BuildRange", Model.Settings.BuildStartOffset]</dd>

        <dt class="col-sm-4 col-lg-3">@Localizer["Settings_EventWindow"]</dt>
        <dd class="col-sm-8 col-lg-9">@Localizer["Settings_EventRange", Model.Settings.EventEndOffset]</dd>

        <dt class="col-sm-4 col-lg-3">@Localizer["Settings_StrikeWindow"]</dt>
        <dd class="col-sm-8 col-lg-9">@Localizer["Settings_StrikeRange", Model.Settings.EventEndOffset + 1, Model.Settings.StrikeEndOffset]</dd>
    </dl>
}
