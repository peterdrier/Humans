@model Humans.Settings.Models.EventSettingsViewModel
@{
    ViewData["Title"] = "Event Settings";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Event Settings</h1>
    <small class="text-muted">Issue #1104</small>
</div>

<p class="text-muted">
    The app-wide event values, read by every section (nobodies-collective/Humans#1630). Shifts'
    own knobs (browsing switch, global volunteer cap, reminder lead time) stay on
    <a asp-controller="Shifts" asp-action="Settings">/Shifts/Settings</a> and are not moving.
    Editing <strong>@Model.EventName</strong> (@Model.GateOpeningDate).
</p>

<partial name="_EventSettingsForm" model="Model" />
