<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Users.Tests" />
    <!-- The one assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
    <!-- Shell-level tests over this section's controllers and policies. -->
    <InternalsVisibleTo Include="Humans.Web.Tests" />
    <!--
      DeletionConfirmationLeavesNoOutboxRowTests runs this section's deletion job and its
      UsersEmails builder against Email's real outbox: the Article 17 invariant it guards
      spans both sections and the table under test is Email's (same rationale as that test
      project's ProjectReference here).
    -->
    <InternalsVisibleTo Include="Humans.Email.Tests" />
    <!--
      These harnesses seed this section's rows through an in-memory UsersDbContext; each
      grant goes when its harness stops building another section's context directly.
    -->
    <InternalsVisibleTo Include="Humans.Camps.Tests" />
    <InternalsVisibleTo Include="Humans.Shifts.Tests" />
    <InternalsVisibleTo Include="Humans.Teams.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
    <!--
      The Profile-side entities are internal to this section and named across it: a global using.
    -->
    <Using Include="Humans.Users.Domain" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <!-- IIssueQueueOwner: this section declares the issue queue it owns. -->
    <ProjectReference Include="..\Humans.Issues\Humans.Issues.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <!--
      Outbound section references, all acyclic: none of them names a Humans.Users type.
      Docs/Users.md, Cross-Section Dependencies, says what each one is for.
    -->
    <!--
      Views/Profile/Index.cshtml renders <vc:my-camps />, whose MyCampsViewComponent is
      public in Humans.Camps/Contracts/ but whose tag helper Razor only generates from
      the declaring assembly — @addTagHelper needs the assembly, not its Contracts leaf.
      Acyclic — Humans.Camps names nothing in Humans.Users.
    -->
    <ProjectReference Include="..\Humans.Camps\Humans.Camps.csproj" />
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <!-- ProfileController injects IAuditViewerService and AdminDetail.cshtml renders
         <vc:audit-log>. AuditLog reaches back only to Humans.Users.Contracts: no cycle. -->
    <ProjectReference Include="..\Humans.Auth\Humans.Auth.csproj" />
    <ProjectReference Include="..\Humans.Consent\Humans.Consent.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr\Humans.Gdpr.csproj" />
    <!--
      Governance for the tier and application reads on the profile pages, and
      GoogleIntegration for IGoogleSyncService (SuspendNonCompliantMembersJob drops the
      suspended human from their teams' Drive/Groups). Acyclic: neither names a Humans.Users type.
    -->
    <ProjectReference Include="..\Humans.Governance.Contracts\Humans.Governance.Contracts.csproj" />
    <ProjectReference Include="..\Humans.GoogleIntegration\Humans.GoogleIntegration.csproj" />
    <ProjectReference Include="..\Humans.Notifications.Contracts\Humans.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Onboarding.Contracts\Humans.Onboarding.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Shifts.Contracts\Humans.Shifts.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Settings\Humans.Settings.csproj" />
    <!--
      Humans.Cantina: ICantinaService (Contracts/ folder), read by SectionThingsToDo to pair the
      medical prompt with the dietary nudge. Acyclic: Cantina references Users.Contracts only.
    -->
    <ProjectReference Include="..\Humans.Cantina\Humans.Cantina.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jobs/ProcessAccountDeletionsJob.cs and Jobs/SuspendNonCompliantMembersJob.cs:
         [DisableConcurrentExecution] and IRecurringJob. Package, not project, so no cycle. -->
    <PackageReference Include="Hangfire.Core" />
    <!-- Helpers/ProfilePictureProcessor.cs — profile-picture resize/orient on upload. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation; keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Section-help markdown (ISectionHelp). Embedded, not fetched: the help modal renders
      synchronously on the section's landing page. The logical name is fixed here so
      SectionHelpEntry.FromEmbeddedMarkdown can address it without probing.
    -->
    <None Remove="Docs\help\*.md" />
    <EmbeddedResource Include="Docs\help\*.md"
                      LogicalName="$(AssemblyName).Docs.help.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
