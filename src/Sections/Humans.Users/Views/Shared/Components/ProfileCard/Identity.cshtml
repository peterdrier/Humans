@model Humans.Users.Models.ProfileCardViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<UsersResource> HtmlLocalizer
@{
    var human = await Component.InvokeAsync(typeof(Humans.Base.ViewComponents.HumanViewComponent), new
    {
        userId = Model.UserId,
        link = Humans.Base.ViewComponents.HumanLink.None,
    });
    using var humanWriter = new System.IO.StringWriter();
    human.WriteTo(humanWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    var humanHtml = new Microsoft.AspNetCore.Html.HtmlString(humanWriter.ToString().Trim());
    var hasLocation = !string.IsNullOrEmpty(Model.City) || !string.IsNullOrEmpty(Model.CountryCode);
}

<div class="card mb-3">
    <div class="card-body d-flex flex-column gap-3">
        <div class="text-center">
            <vc:human user-id="@Model.UserId" layout="Avatar" size="160" link="None" />
            <h1 class="h2 mt-3 mb-1">@humanHtml</h1>
            @if (!string.IsNullOrEmpty(Model.Pronouns))
            {
                <div class="text-muted">@Model.Pronouns</div>
            }
            <vc:nobodies-email-badge user-id="@Model.UserId" mode="badge" />
        </div>

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <div>@Html.SanitizedMarkdown(Model.Bio)</div>
        }

        <dl class="profile-facts mb-0">
            @if (hasLocation)
            {
                <dt>@SharedLocalizer["Profile_Location"]</dt>
                <dd>@string.Join(", ", new[] { Model.City, Model.CountryCode }.Where(s => !string.IsNullOrEmpty(s)))</dd>
            }
            @if (Model.Languages.Count > 0)
            {
                <dt>@Localizer["Users_Profile_Languages"]</dt>
                <dd>
                    @foreach (var lang in Model.Languages)
                    {
                        <span class="badge @lang.ProficiencyBadgeClass me-1">@lang.LanguageName <small class="opacity-75">(@Localizer.EnumDisplay(lang.Proficiency))</small></span>
                    }
                </dd>
            }
            @if (!string.IsNullOrEmpty(Model.FormattedBirthday))
            {
                <dt>@Localizer["Users_Profile_DateOfBirth"]</dt>
                <dd>@Model.FormattedBirthday</dd>
            }
            @foreach (var email in Model.PublicUserEmails)
            {
                <dt><i class="fa-solid fa-envelope me-1"></i>@Localizer["Users_CommPrefs_Email"]</dt>
                <dd>
                    <a href="mailto:@email.Email" class="text-break">@email.Email</a>
                    @if (email.VisibilityBadgeKey is not null)
                    {
                        <span class="badge bg-light text-muted border">@Localizer[email.VisibilityBadgeKey]</span>
                    }
                </dd>
            }
            @foreach (var field in Model.ContactFields)
            {
                <dt><i class="@field.IconClass me-1"></i>@field.Label</dt>
                <dd>
                    @if (!string.IsNullOrEmpty(field.LinkUrl))
                    {
                        <a href="@field.LinkUrl" target="_blank" rel="noopener noreferrer" class="text-break">@field.Value</a>
                    }
                    else
                    {
                        <span class="text-break">@field.Value</span>
                    }
                    @if (field.VisibilityBadgeKey is not null)
                    {
                        <span class="badge bg-light text-muted border">@Localizer[field.VisibilityBadgeKey]</span>
                    }
                </dd>
            }
        </dl>

        @if (Model.CanSendMessage)
        {
            <a asp-controller="FacilitatedMessage" asp-action="SendMessage" asp-route-id="@Model.UserId" class="btn btn-outline-primary">
                <i class="fa-solid fa-envelope me-1"></i> @HtmlLocalizer["Users_SendMessage_Button", humanHtml]
            </a>
        }
        @if (Model.IsOwnProfile)
        {
            <a asp-controller="Profile" asp-action="Edit" class="btn btn-primary">@SharedLocalizer["Common_EditProfile"]</a>
        }
    </div>
</div>

<partial name="_ProfileBoardInfo" model="Model" />
