@using Humans.Teams.Contracts
@model Humans.Users.Models.ProfileCardViewModel
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<UsersResource> HtmlLocalizer
@{
    var human = await Component.InvokeAsync(typeof(Humans.Base.ViewComponents.HumanViewComponent), new
    {
        userId = Model.UserId,
        link = Humans.Base.ViewComponents.HumanLink.None,
    });
    using var humanWriter = new System.IO.StringWriter();
    human.WriteTo(humanWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    // The same encoded name fits the heading and localized sentence without template indentation.
    var humanHtml = new Microsoft.AspNetCore.Html.HtmlString(humanWriter.ToString().Trim());
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Localizer["Users_Profile_Information"]</span>
        @if (Model.IsOwnProfile)
        {
            <a asp-controller="Profile" asp-action="Edit" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Common_Edit"]</a>
        }
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-auto">
                <vc:human user-id="@Model.UserId"
                          layout="Avatar"
                          size="160"
                          link="None" />
            </div>
            <div class="col">
                <h4>@humanHtml</h4>
                @if (!string.IsNullOrEmpty(Model.Pronouns))
                {
                    <span class="text-muted me-2">@Model.Pronouns</span>
                }
                @if ((await AuthService.AuthorizeAsync(User, UsersPolicies.Read)).Succeeded
                    && !string.IsNullOrEmpty(Model.PreferredLanguage?.ToFlagClass()))
                {
                    <span class="@Model.PreferredLanguage.ToFlagClass()" title="@Model.PreferredLanguage.ToDisplayLanguageName()"></span>
                }
                <vc:nobodies-email-badge user-id="@Model.UserId" mode="badge" />
                @if (Model.Teams.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var team in Model.Teams)
                        {
                            <a asp-controller="Team" asp-action="Details" asp-route-slug="@team.TeamSlug"
                               class="btn btn-sm @(team.IsSystemTeam ? "btn-outline-secondary" : "btn-outline-primary")">
                                @team.TeamName
                                @if (team.IsCoordinator)
                                {
                                    <span class="ms-1">@await Html.PartialAsync("_RoleBadge", TeamMemberRole.Coordinator)</span>
                                }
                            </a>
                        }
                    </div>
                }
                @if (Model.Languages.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var lang in Model.Languages)
                        {
                            <span class="badge @lang.ProficiencyBadgeClass">
                                @lang.LanguageName
                                <small class="ms-1 opacity-75">(@Localizer.EnumDisplay(lang.Proficiency))</small>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <hr />
        <dl class="row mb-0">
            <dt class="col-3">@SharedLocalizer["Profile_Location"]</dt>
            <dd class="col-9">
                @if (!string.IsNullOrEmpty(Model.City) || !string.IsNullOrEmpty(Model.CountryCode))
                {
                    @Model.City
                    @if (!string.IsNullOrEmpty(Model.City) && !string.IsNullOrEmpty(Model.CountryCode))
                    {
                        <text>, </text>
                    }
                    @Model.CountryCode
                }
                else
                {
                    <text>@SharedLocalizer["Common_NotProvided"]</text>
                }
            </dd>

            @if (!string.IsNullOrEmpty(Model.FormattedBirthday))
            {
                <dt class="col-3">@Localizer["Users_Profile_DateOfBirth"]</dt>
                <dd class="col-9">@Model.FormattedBirthday</dd>
            }
        </dl>

        @if (Model.PublicUserEmails.Count > 0 || Model.ContactFields.Count > 0)
        {
            <hr />
            <h6 class="text-muted mb-2">@Localizer["Users_Profile_ContactInformation"]</h6>
            <dl class="row mb-0">
                @foreach (var email in Model.PublicUserEmails)
                {
                    <dt class="col-3">
                        <i class="fa-solid fa-envelope me-1"></i>
                        @Localizer["Users_CommPrefs_Email"]
                    </dt>
                    <dd class="col-9">
                        <a href="mailto:@email.Email">@email.Email</a>
                        @if (email.IsPrimary)
                        {
                            <span class="badge bg-primary ms-1" title="@Localizer["Users_Profile_NotificationTarget"]" data-bs-toggle="tooltip"><i class="fa-solid fa-bell"></i> @Localizer["Users_Profile_NotificationTargetShort"]</span>
                        }
                        @if (email.VisibilityBadgeKey is not null)
                        {
                            <span class="badge bg-light text-muted border ms-1">@Localizer[email.VisibilityBadgeKey]</span>
                        }
                    </dd>
                }
                @foreach (var field in Model.ContactFields)
                {
                    <dt class="col-3">
                        <i class="@field.IconClass me-1"></i>
                        @field.Label
                    </dt>
                    <dd class="col-9">
                        @if (!string.IsNullOrEmpty(field.LinkUrl))
                        {
                            <a href="@field.LinkUrl" target="_blank" rel="noopener noreferrer">@field.Value</a>
                        }
                        else
                        {
                            @field.Value
                        }
                        @if (field.VisibilityBadgeKey is not null)
                        {
                            <span class="badge bg-light text-muted border ms-1">@Localizer[field.VisibilityBadgeKey]</span>
                        }
                    </dd>
                }
            </dl>
        }
        else if (Model.IsOwnProfile)
        {
            <hr />
            <p class="text-muted mb-0">
                @Localizer["Users_Profile_NoContactInfo"] <a asp-controller="Profile" asp-action="Edit">@Localizer["Users_Profile_AddSome"]</a>
            </p>
        }

        @if (Model.CanSendMessage)
        {
            <hr />
            <a asp-controller="FacilitatedMessage" asp-action="SendMessage" asp-route-id="@Model.UserId"
               class="btn btn-outline-primary">
                <i class="fa-solid fa-envelope me-1"></i>
                @HtmlLocalizer["Users_SendMessage_Button", humanHtml]
            </a>
        }

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <hr />
            <h6 class="text-muted mb-2">@Localizer["Users_Profile_Bio"]</h6>
            <div class="mb-0">@Html.SanitizedMarkdown(Model.Bio)</div>
        }

        @if (!string.IsNullOrEmpty(Model.ContributionInterests))
        {
            <hr />
            <h6 class="text-muted mb-2">@Localizer["Users_Profile_ContributionInterests"]</h6>
            <p class="mb-0 pre-line">@Model.ContributionInterests</p>
        }

        @if (Model.VolunteerHistory.Count > 0)
        {
            <hr />
            <h6 class="text-muted mb-2">@Localizer["Users_Profile_BurnerCV"]</h6>
            <partial name="_ProfileCvEntries" model="Model.VolunteerHistory" />
        }
        else if (Model.IsOwnProfile)
        {
            <hr />
            <p class="text-muted mb-0">
                @Localizer["Users_Profile_NoCVEntries"] <a asp-controller="Profile" asp-action="Edit">@Localizer["Users_Profile_AddFirstEntry"]</a>
            </p>
        }
    </div>
</div>

<partial name="_ProfileBoardInfo" model="Model" />
