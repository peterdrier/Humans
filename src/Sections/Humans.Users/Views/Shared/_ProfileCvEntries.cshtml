@model IReadOnlyList<Humans.Users.Models.VolunteerHistoryEntryViewModel>

@foreach (var entry in Model)
{
    <div class="d-flex align-items-center py-1">
        <span class="text-muted me-3" style="min-width: 50px; font-size: 0.85em;">@entry.FormattedDate</span>
        <span class="fw-medium me-3" style="min-width: 180px;">@entry.EventName</span>
        @if (!string.IsNullOrEmpty(entry.Description))
        {
            var previewLength = entry.Description.Length > 80
                && char.IsHighSurrogate(entry.Description[79]) && char.IsLowSurrogate(entry.Description[80]) ? 79 : 80;
            <span class="text-muted text-truncate" style="font-size: 0.9em;">@(entry.Description.Length > 80 ? entry.Description[..previewLength] + "..." : entry.Description)</span>
        }
    </div>
}
