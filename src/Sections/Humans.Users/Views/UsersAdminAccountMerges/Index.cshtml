@model Humans.Users.Models.AccountMergeQueueViewModel
@{
    ViewData["Title"] = "Account Merges";
}

<page-header title="Account Merges" />

<h2 class="h5">Merge two accounts by hand</h2>
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label">First account</label>
        <vc:human-search field-name="a" instance-key="merge-a" scope="All" allow-email="true" placeholder="Name or email" />
    </div>
    <div class="col-md-5">
        <label class="form-label">Second account</label>
        <vc:human-search field-name="b" instance-key="merge-b" scope="All" allow-email="true" placeholder="Name or email" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Compare</button>
    </div>
</form>

<h2 class="h5">Pairs to look at</h2>
@if (Model.Rows.Count == 0)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check me-2"></i>No accounts need merging.
    </div>
}
else
{
    @foreach (var row in Model.Rows)
    {
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center">
                <i class="fa-solid fa-code-merge me-2"></i>
                @if (row.SharedEmail is null)
                {
                    <span class="badge bg-primary">Picked by hand</span>
                }
                else
                {
                    <span>Shared email: <code class="ms-1">@row.SharedEmail</code></span>
                    <span class="badge bg-info text-dark ms-2">Detected duplicate</span>
                }
                @if (row.AlreadyMerged)
                {
                    <span class="badge bg-secondary ms-2">Already merged</span>
                }
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header"><i class="fa-solid fa-user me-1"></i>Account A</div>
                            <div class="card-body">
                                <partial name="_ProfileCard" model="row.AccountA" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header"><i class="fa-solid fa-user me-1"></i>Account B</div>
                            <div class="card-body">
                                <partial name="_ProfileCard" model="row.AccountB" />
                            </div>
                        </div>
                    </div>
                </div>

                @if (row.AlreadyMerged)
                {
                    <p class="text-muted mb-0">
                        <i class="fa-solid fa-circle-info me-1"></i>One of these accounts has already been merged into the other.
                    </p>
                }
                else
                {
                    var groupId = $"{row.AccountA.UserId}-{row.AccountB.UserId}";
                    <form asp-action="Merge" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <strong>Keep which account?</strong>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="survivorUserId"
                                       id="keep-a-@groupId" value="@row.AccountA.UserId" checked />
                                <label class="form-check-label" for="keep-a-@groupId">
                                    Keep <strong><vc:human user-id="@row.AccountA.UserId" link="Admin" raw="true" /></strong> (Account A), archive Account B
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="survivorUserId"
                                       id="keep-b-@groupId" value="@row.AccountB.UserId" />
                                <label class="form-check-label" for="keep-b-@groupId">
                                    Keep <strong><vc:human user-id="@row.AccountB.UserId" link="Admin" raw="true" /></strong> (Account B), archive Account A
                                </label>
                            </div>
                        </div>
                        <input type="hidden" name="archivedUserId" value="@row.AccountB.UserId" id="archived-@groupId" />
                        <div class="mb-2">
                            <label for="notes-@groupId" class="form-label">Notes (optional)</label>
                            <textarea id="notes-@groupId" name="notes" class="form-control" rows="2" placeholder="Reason for merge..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success"
                                data-confirm="Merge these accounts? The archived account will be permanently tombstoned.">
                            <i class="fa-solid fa-code-merge me-1"></i>Merge
                        </button>
                    </form>
                }
            </div>
        </div>
    }
}

<h2 class="h5 mt-4">Recently merged</h2>
@{
    var recentTable = TableModel.For(Model.Recent)
        .Column("When", r => r.When, c => c.DateTime())
        .Human("Kept", r => r.KeptUserId, HumanLink.Admin)
        .Column("Merged away", r => r.MergedAwayUserId, c => c.Code())
        .Human("By", r => r.By ?? r.KeptUserId, HumanLink.Admin)
        .Column("How", r => r.Failed ? "Stopped part-way" : r.By is null ? "Self-service" : "By hand")
        .Column("Details", r => r.Details)
        .RowCss(r => r.Failed ? "table-danger" : null)
        .Empty("No merges yet.")
        .Build();
}
<partial name="_Table" model="recentTable" />

<p class="text-muted small mt-3">
    People merge their own accounts: adding an address that another account has confirmed mails a link, and
    confirming it while signed in merges the two. A merge that stopped part-way is finished by merging the
    same two accounts again with "Merge two accounts by hand".
</p>

<a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mt-3">
    <i class="fa-solid fa-arrow-left me-1"></i>Back to Admin
</a>

<script>
    // site.js handles [data-confirm] globally; a second handler fired the dialog twice.

    // The archived account is whichever radio is NOT chosen.
    document.querySelectorAll('form input[name="survivorUserId"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            var form = this.closest('form');
            var archived = form.querySelector('input[name="archivedUserId"]');
            if (!archived) return;
            var radios = form.querySelectorAll('input[name="survivorUserId"]');
            radios.forEach(function (r) {
                if (!r.checked) archived.value = r.value;
            });
        });
    });
</script>
