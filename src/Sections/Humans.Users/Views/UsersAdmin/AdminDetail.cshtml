@inject IAuthorizationService AuthService
@model Humans.Users.Models.AdminHumanDetailViewModel
@{
    ViewData["Title"] = string.Format(Localizer["Users_AdminHumanDetail_Title"].Value, Model.DisplayName);
    var isAdmin = (await AuthService.AuthorizeAsync(User, PolicyNames.AdminOnly)).Succeeded;
    var stateLabel = Model.State == UserState.DeletePending ? "Delete Pending" : Model.State.ToString();
    var stateBadgeClass = StatusBadgeExtensions.GetMembershipStatusBadgeClass(stateLabel);
}

@section Crumbs {
    <span><vc:human user-id="@Model.UserId" layout="Text" link="Public" /></span>
}


<vc:merged-accounts user-id="@Model.UserId" />

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">@Localizer["Users_AdminHuman_Information"]</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2">
                        <vc:human user-id="@Model.UserId"
                                  layout="Avatar"
                                  size="80"
                                  link="None" />
                    </div>
                    <div class="col-md-10">
                        <h4>@Model.DisplayName</h4>
                        <p class="text-muted mb-1">@Model.Email</p>
                        <span class="badge @stateBadgeClass">@stateLabel</span>
                    </div>
                </div>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-3">@SharedLocalizer["AdminHuman_MembershipTier"]</dt>
                    <dd class="col-sm-9">@Model.MembershipTier</dd>

                    <dt class="col-sm-3">Language</dt>
                    <dd class="col-sm-9"><span class="@Model.PreferredLanguage.ToFlagClass() me-1"></span>@Model.PreferredLanguage.ToDisplayLanguageName()</dd>

                    @if (Model.Languages.Count > 0)
                    {
                        <dt class="col-sm-3">@Localizer["Users_Profile_Languages"]</dt>
                        <dd class="col-sm-9">
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var lang in Model.Languages)
                                {
                                    <span class="badge @lang.ProficiencyBadgeClass">
                                        @lang.LanguageName
                                        <small class="ms-1 opacity-75">(@lang.Proficiency)</small>
                                    </span>
                                }
                            </div>
                        </dd>
                    }

                    <dt class="col-sm-3">@Localizer["Users_AdminHuman_UserId"]</dt>
                    <dd class="col-sm-9"><code>@Model.UserId</code></dd>

                    <dt class="col-sm-3">@SharedLocalizer["Admin_Joined"]</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToDateTime()</dd>

                    <dt class="col-sm-3">@SharedLocalizer["Admin_LastLogin"]</dt>
                    <dd class="col-sm-9">
                        @if (Model.LastLoginAt.HasValue)
                        {
                            @Model.LastLoginAt.Value.ToDateTime()
                        }
                        else
                        {
                            <span class="text-muted">@SharedLocalizer["Admin_Never"]</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.AdminNotes))
        {
            <div class="card mb-4">
                <div class="card-header">@Localizer["Users_AdminHuman_AdminNotes"]</div>
                <div class="card-body">
                    <p class="mb-0" style="white-space: pre-wrap;">@Model.AdminNotes</p>
                    <small class="text-muted mt-2 d-block">@Localizer["Users_AdminHuman_AdminNotesGdprHint"]</small>
                </div>
            </div>
        }

        @if (Model.Applications.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header">@Localizer["Users_AdminHuman_RecentApplications"]</div>
                <div class="list-group list-group-flush">
                    @foreach (var app in Model.Applications)
                    {
                        <a asp-controller="GovernanceApplications" asp-action="AdminDetail" asp-route-id="@app.Id" class="list-group-item list-group-item-action d-flex justify-content-between">
                                    <span>@app.SubmittedAt.ToDate()</span>
                            <span class="badge bg-secondary">@app.Status</span>
                        </a>
                    }
                </div>
            </div>
        }

        <vc:shift-signups user-id="@Model.UserId" view-mode="@ShiftSignupsViewMode.Admin" display-name="@Model.DisplayName" />

        @* Section-contributed parts (IUserPart) — UserCalendar (Calendar), Role Assignments (Auth), Email Outbox and Communication Preferences (Email), each auto-hides when empty *@
        <vc:user-parts slot="@Humans.Base.Interfaces.UserPartSlots.AdminDetail" user-id="@Model.UserId" view-mode="@ProfileCardViewMode.Admin" />

        <vc:audit-log user-id="@Model.UserId" limit="50" title="@Localizer["Users_AdminHuman_AuditHistory"].Value" />

    </div>

    <div class="col-md-4">
        @* Section-contributed parts (IUserPart) — TicketHoldings (Tickets), each auto-hides when empty *@
        <vc:user-parts slot="@Humans.Base.Interfaces.UserPartSlots.AdminDetailSidebar" user-id="@Model.UserId" view-mode="@ProfileCardViewMode.Admin" />

        <div class="card mb-4">
            <div class="card-header">@Localizer["Users_AdminHuman_Statistics"]</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-8">@Localizer["Users_AdminHuman_ApplicationCount"]</dt>
                    <dd class="col-4 text-end">@Model.ApplicationCount</dd>
                    <dt class="col-8">@Localizer["Users_AdminHuman_ConsentCount"]</dt>
                    <dd class="col-4 text-end">@Model.ConsentCount</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-at me-1"></i> Emails</span>
                @* AdminEmails is self-or-Admin only; AdminDetail reaches further — gate to avoid 403 *@
                @if (isAdmin)
                {
                    <a asp-controller="ProfileEmails" asp-action="AdminEmails" asp-route-id="@Model.UserId"
                       class="btn btn-sm btn-outline-secondary">
                        @Localizer["Users_AdminDetail_ManageEmails"]
                    </a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.UserEmails.Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var email in Model.UserEmails)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <code class="text-break">@email.Email</code>
                                    <div class="d-flex gap-1 flex-shrink-0 ms-2">
                                        @if (email.IsVerified)
                                        {
                                            <span class="badge bg-success" title="Verified">
                                                <i class="fa-solid fa-check"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning" title="Unverified">
                                                <i class="fa-solid fa-clock"></i>
                                            </span>
                                        }
                                        @if (email.IsPrimary)
                                        {
                                            <span class="badge bg-primary" title="@Localizer["Users_EmailGrid_Primary"]">
                                                <i class="fa-solid fa-bell"></i>
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (email.Visibility.HasValue)
                                {
                                    <small class="text-muted">Visibility: @email.Visibility</small>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="card-body">
                        <span class="text-muted">No email records</span>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">@SharedLocalizer["TeamDetail_Actions"]</div>
            <div class="card-body">
                @if (Model.State is UserState.Suspended or UserState.AdminSuspended)
                {
                    <form asp-action="UnsuspendHuman" asp-route-id="@Model.UserId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100 mb-2">@Localizer["Users_AdminHuman_UnsuspendMember"]</button>
                    </form>
                }
                else
                {
                    <form asp-action="SuspendHuman" asp-route-id="@Model.UserId" method="post"
                          data-confirm="@Localizer["Users_AdminHuman_SuspendConfirm"].Value">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <textarea name="notes" class="form-control" rows="2" placeholder="@Localizer["Users_AdminHuman_SuspendReasonPlaceholder"].Value"></textarea>
                            <small class="form-text text-muted">@Localizer["Users_AdminHuman_AdminNotesGdprHint"]</small>
                        </div>
                        <button type="submit" class="btn btn-danger w-100">@Localizer["Users_AdminHuman_SuspendMember"]</button>
                    </form>
                }
                @if (Model.State is not UserState.Rejected and not UserState.Deleted and not UserState.Merged)
                {
                    <hr />
                    <form asp-action="RejectSignup" asp-route-id="@Model.UserId" method="post"
                          data-confirm="Are you sure you want to reject this human's signup? This cannot be undone.">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <textarea name="reason" class="form-control" rows="2" placeholder="Reason for rejection..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="fa-solid fa-ban me-1"></i> Reject Signup
                        </button>
                    </form>
                }
                <environment exclude="Production">
                    <hr />
                    <form asp-action="PurgeHuman" asp-route-id="@Model.UserId" method="post"
                          data-confirm="PURGE @Model.DisplayName? This severs their login — they will get a completely fresh account next time they sign in.">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fa-solid fa-skull-crossbones me-1"></i> Purge (Dev/QA Only)
                        </button>
                        <small class="form-text text-muted">Severs OAuth link and locks account. Next login creates a fresh user.</small>
                    </form>
                </environment>
            </div>
        </div>
    </div>
</div>
