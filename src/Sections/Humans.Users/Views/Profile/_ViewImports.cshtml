@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Folder-level rather than one Views/_ViewImports.cshtml because Humans.Users still grants
   InternalsVisibleTo to Humans.Web: a root _ViewImports in both assemblies generates the
   same internal Views__ViewImports type and Shell fails with CS0436. Collapse these four
   into one root file in the commit that moves ProfileController and drops the grant. *@
@using Humans.Application.DTOs
@using Humans.Application.Extensions
@using Humans.Domain.Entities
@using Humans.Domain.Enums
@using Humans.Shifts
@using Humans.Shifts.Contracts
@using Humans.Users
@using Humans.Users.Contracts
@using Humans.Users.Controllers
@using Humans.Users.Models
@using Humans.Users.Services
@using Humans.UI
@using Humans.UI.Authorization
@using Humans.UI.Extensions
@using Humans.UI.Helpers
@using Humans.UI.Models
@using Humans.UI.Models.Tables
@using Humans.UI.ViewComponents
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NodaTime
@* Users' ~250 keys are still in Humans.UI's SharedResource — the resx carve into
   UsersResource has not happened yet, so this binds to the shared set exactly as the
   Shell _ViewImports these views came from did. Rebind when UsersResource lands. *@
@inject IStringLocalizer<SharedResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* <vc:human> and the other shared components are Humans.UI's. *@
@addTagHelper *, Humans.UI
@addTagHelper *, Humans.Users
@addTagHelper *, Humans.Shifts
@* <vc:my-camps> is Humans.Camps'. *@
@addTagHelper *, Humans.Camps
@* No @addTagHelper for Humans.Web — a section RCL cannot reference the Shell. AccessMatrix
   moved to Humans.UI (nobodies-collective/Humans#1056) and now binds as <vc:access-matrix>;
   the three still-Shell-owned components this page renders (EventsCard, TicketHoldings,
   CommunicationPreferencesPanel) stay invoked by name until they move too. A <vc:> element
   for an unimported assembly renders as inert markup with a green build and no runtime
   error, so never add one without its @addTagHelper. *@
