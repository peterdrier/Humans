@using Humans.Governance.Contracts
@inject IAuthorizationService AuthService
@model Humans.Users.Models.ProfileViewModel
@{
    ViewData["Title"] = Model.IsOwnProfile ? Localizer["Users_Profile_Title"].Value : Model.DisplayName;
}

<div class="row align-items-start">
    <div class="@(Model.IsOwnProfile ? "col-md-8" : "col-md-12")">
        <div class="d-flex justify-content-between align-items-center">
            <h1>@(Model.IsOwnProfile ? Localizer["Users_Profile_Title"] : Model.DisplayName)</h1>
            <div class="d-flex gap-2">
                <vc:access-matrix section="Profile" />
                <a asp-controller="UsersAdmin" asp-action="AdminDetail" asp-route-id="@Model.UserId" class="btn btn-sm btn-outline-secondary" authorize-policy="HumanAdminBoardOrAdmin">
                    <i class="fa-solid fa-user-shield"></i> @SharedLocalizer["Common_Admin"] <i class="fa-solid fa-lock auth-lock-icon"></i>
                </a>
            </div>
        </div>

        @if (Model.IsOwnProfile)
        {
        }

        @if (Model.IsOwnProfile && Model.HasPendingConsents)
        {
            <div class="alert alert-warning" role="alert">
                <strong>@Localizer["Users_Profile_ActionRequired"]</strong> @string.Format(Localizer["Users_Profile_PendingConsents"].Value, Model.PendingConsentCount)
                <a asp-controller="Consent" asp-action="Index" class="alert-link">@Localizer["Users_Profile_ReviewNow"]</a>
            </div>
        }

        @if (Model.IsOwnProfile && !Model.IsApproved)
        {
            <div class="alert alert-info" role="alert">
                <strong>@Localizer["Users_Profile_PendingApproval"]</strong> @Localizer["Users_Profile_PendingApprovalDescription"]
            </div>
        }

        @if (Model.IsOwnProfile && Model.TierApplicationStatus != null)
        {
            var alertClass = Model.TierApplicationStatus switch
            {
                ApplicationStatus.Approved => "alert-success",
                ApplicationStatus.Rejected => "alert-danger",
                _ => "alert-info"
            };
            <div class="alert @alertClass" role="alert">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        @string.Format(Localizer["Users_Profile_TierApplicationStatus"].Value, Model.TierApplicationTier)
                        <span class="badge @Model.TierApplicationBadgeClass ms-1">@SharedLocalizer["ApplicationStatus_" + Model.TierApplicationStatus.ToString()]</span>
                    </span>
                    <a asp-controller="Governance" asp-action="Index" class="alert-link">@Localizer["Users_Profile_TierApplicationDetails"]</a>
                </div>
            </div>
        }

        @{
            var cardViewMode = Model.IsOwnProfile
                ? ProfileCardViewMode.Self
                : (await AuthService.AuthorizeAsync(User, PolicyNames.TeamsAdminBoardOrAdmin)).Succeeded
                    ? ProfileCardViewMode.Admin
                    : ProfileCardViewMode.Public;
        }
        <vc:profile-card user-id="@Model.UserId" view-mode="@cardViewMode" />

        @if (Model.IsOwnProfile)
        {
            <vc:my-camps />
        }

        <vc:user-parts slot="@Humans.Base.Interfaces.UserPartSlots.Profile" user-id="@Model.UserId" view-mode="@cardViewMode" />

        @if (!Model.IsOwnProfile && Model.CanViewShiftSignups)
        {
            <vc:shift-signups user-id="@Model.UserId" view-mode="@ShiftSignupsViewMode.Admin" display-name="@Model.DisplayName" />
            <vc:volunteer-build-strip user-id="@Model.UserId" />
        }

        @if (Model.NoShowHistory != null && Model.NoShowHistory.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fa-solid fa-user-xmark me-1"></i> @Localizer["Users_Profile_NoShowHistory", Model.NoShowHistory!.Count]</h5>
                </div>
                <div class="card-body p-0">
                    @{
                        var noShowTable = TableModel.For(Model.NoShowHistory!)
                            .Column(SharedLocalizer["Common_Shift"].Value, r => r.ShiftLabel)
                            .Column(SharedLocalizer["Common_Department"].Value, r => r.DepartmentName)
                            .Column(SharedLocalizer["Common_Date"].Value, r => r.ShiftDateLabel)
                            .Column(Localizer["Users_Profile_MarkedBy"].Value, r => r.MarkedByName)
                            .Column(Localizer["Users_Profile_MarkedAt"].Value, r => r.MarkedAtLabel)
                            .Build();
                    }
                    <partial name="_Table" model="noShowTable" />
                </div>
            </div>
        }

        @if (Model.CanViewSentMessages)
        {
            @* The AuditLog section ships no resource set, so this page passes its own copy in. *@
            var sentMessageHeaders = $"when:{SharedLocalizer["Common_Date"].Value}"
                                     + $",actor:{SharedLocalizer["Common_Sender"].Value}"
                                     + $",description:{SharedLocalizer["Common_Preview"].Value}";
            <vc:audit-log entity-type="User" entity-id="@Model.UserId"
                          actions="FacilitatedMessageSent" limit="50"
                          layout="table" columns="when,actor,description"
                          column-labels="@sentMessageHeaders"
                          title="@Localizer["Users_Profile_SentMessages"].Value"
                          empty-text="@Localizer["Users_Profile_NoSentMessages"].Value" />
        }
    </div>

    @if (Model.IsOwnProfile)
    {
        <div class="col-md-4">
            <vc:user-parts slot="@Humans.Base.Interfaces.UserPartSlots.ProfileSidebar" user-id="@Model.UserId" view-mode="@cardViewMode" />

            <div class="card mb-4">
                <div class="card-header">@Localizer["Users_Profile_QuickActions"]</div>
                <div class="list-group list-group-flush">
                    <a asp-controller="Profile" asp-action="Edit" class="list-group-item list-group-item-action">@SharedLocalizer["Common_EditProfile"]</a>
                    <a asp-controller="Consent" asp-action="Index" class="list-group-item list-group-item-action">
                        @SharedLocalizer["Dashboard_ManageConsents"]
                        @if (Model.HasPendingConsents)
                        {
                            <span class="badge bg-warning text-dark float-end">@Model.PendingConsentCount</span>
                        }
                    </a>
                    <a asp-controller="ShiftProfile" asp-action="ShiftInfo" class="list-group-item list-group-item-action">@Localizer["Users_Profile_ShiftInfo"]</a>
                    <a asp-controller="CantinaProfile" asp-action="Dietary" class="list-group-item list-group-item-action">@Localizer["Users_Profile_DietaryLink"]</a>
                    <a asp-controller="Profile" asp-action="Medical" class="list-group-item list-group-item-action">@Localizer["Users_Profile_DietaryMedical_MedicalConditions_Title"]</a>
                    <a asp-controller="ProfileEmails" asp-action="Emails" class="list-group-item list-group-item-action">@Localizer["Users_Emails_Title"]</a>
                    <a asp-controller="CommunicationPreferences" asp-action="Index" class="list-group-item list-group-item-action">@Localizer["Users_CommPrefs_Title"]</a>
                    <a asp-controller="Governance" asp-action="Index" class="list-group-item list-group-item-action">@SharedLocalizer["Nav_Governance"]</a>
                    <a asp-controller="MyData" asp-action="Index" class="list-group-item list-group-item-action">@Localizer["Users_ProfilePrivacy_Title"]</a>
                    <a asp-controller="MemberOutbox" asp-action="MyOutbox" class="list-group-item list-group-item-action">@Localizer["Users_Profile_MyEmails"]</a>
                </div>
            </div>
        </div>
    }
</div>
