@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml (guarded by TourPageRenderTests).
   Humans.Base is load-bearing: its NonceTagHelper stamps the CSP nonce on _TourLayout's inline script.
   No localizer binding: Tour is deliberately English-only. *@
@using Humans.Tour
@using Humans.Tour.Controllers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
