@* Deliberately hardcoded English: the audience is other burn orgs evaluating the platform, not members. Do not
   wire it through a localizer or add resx keys in an i18n sweep. *@
@{
    ViewData["Title"] = "What is Humans";
}

<section class="tour-hero">
    <div class="tour-hero-slideshow">
        <div class="tour-hero-slide active" style="background-image: url('/_content/Humans.Tour/img/hero-10.webp')"></div>
        <div class="tour-hero-slide" data-bg="/_content/Humans.Tour/img/hero-3.webp"></div>
        <div class="tour-hero-slide" data-bg="/_content/Humans.Tour/img/hero-13.webp"></div>
    </div>
    <div class="tour-hero-overlay"></div>
    <div class="tour-hero-vignette" aria-hidden="true"></div>
    <div class="tour-hero-grain" aria-hidden="true"></div>
    <div class="tour-hero-ghost" aria-hidden="true">HUMANS</div>
    <canvas class="tour-hero-dust" id="tour-dust-canvas" aria-hidden="true"></canvas>
    <div class="tour-hero-content">
        <p class="tour-hero-tag">Free &amp; open source &middot; built by burners, for burns</p>
        <span class="tour-hero-annotation" aria-hidden="true">goodbye, drawer full of spreadsheets</span>
        <h1>What is Humans? Your whole burn, in one place.</h1>
        <p class="tour-hero-lead">
            Humans is the membership platform that runs Nobodies Collective, the Spanish nonprofit
            behind the Elsewhere burn. It manages the full lifecycle of a burn organization —
            from a volunteer's first signup through teams, shifts, tickets, governance, and money —
            with GDPR built in and an audit trail the Board can actually read.
        </p>
        <div class="tour-hero-ctas">
            <a class="tour-btn tour-btn--solid" href="#people">See what's inside &darr;</a>
            <a class="tour-btn tour-btn--ghost" href="/About">The engineering story</a>
        </div>
    </div>
    <div class="tour-hero-stats">
        <div class="tour-hero-stats-inner">
            <div class="tour-stat"><strong>2000+</strong><span>humans</span></div>
            <div class="tour-stat"><strong>45+</strong><span>sections</span></div>
            <div class="tour-stat"><strong>7</strong><span>languages</span></div>
            <div class="tour-stat"><strong>0</strong><span>spreadsheets</span></div>
        </div>
    </div>
</section>

<section class="tour-section" id="people">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">01 &mdash; the front door</span>
            <h2>People</h2>
            <p class="tour-section-lead">
                Everything starts with a person signing themselves up. From there, the system
                runs the paperwork so nobody else has to.
            </p>
        </div>
        <div class="tour-cap anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    Sign in with Google or a one-time email link, fill in a profile, sign the
                    required documents, and you are in the Volunteers team. Admission takes a name
                    and the required consents; nobody has to notice you first.
                </p>
                <p>
                    The legal documents live in the legal team's GitHub repository and sync in on
                    their own. Every signature is a permanent, tamper-proof record against the exact
                    Spanish text, which is the binding version. Members see what they still owe and
                    get a reminder before a deadline lapses.
                </p>
                <p>
                    GDPR is built in, not bolted on. A member can download everything the system
                    holds on them, gathered from every section that stores personal data, or ask to
                    be forgotten: deletion runs after a 30-day grace period they can cancel.
                </p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Self-service signup</strong><span>Google sign-in or a magic link, a profile, consents, and automatic admission to the volunteer pool.</span></li>
                <li><strong>Consent you can prove</strong><span>Documents synced from GitHub, append-only signature records, reminders before deadlines.</span></li>
                <li><strong>GDPR as a feature</strong><span>One-click data export and a real right-to-deletion path with a grace period.</span></li>
                <li><strong>Profiles with privacy tiers</strong><span>Members choose who sees each contact field.</span></li>
                <li><strong>Automatic provisioning</strong><span>Team memberships and Google Workspace access follow a person on their own.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-section tour-section--alt">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">02 &mdash; who does what, where, and when</span>
            <h2>Organize</h2>
        </div>
        <div class="tour-cap tour-cap--flip anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    Departments and their sub-teams each get a page, join requests, role
                    definitions, and linked Google Shared Drives and Groups. Join a team and the
                    access arrives; leave and it goes, with drift detected and reconciled.
                </p>
                <p>
                    Shifts run on rotas for build, event and strike, with single or range signups,
                    voluntelling by coordinators, skills and working-style preferences, and a
                    coordinator dashboard that shows coverage and urgency per day.
                </p>
                <p>Visible to everyone, not locked in a coordinator's head.</p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Teams</strong><span>Own pages, membership, roles, and Workspace groups and drives per team.</span></li>
                <li><strong>Shifts</strong><span>Rotas, signups, priorities, and live coverage numbers, not guesswork.</span></li>
                <li><strong>Community calendar</strong><span>One-off and recurring team events, plus a personal calendar feed of your own commitments.</span></li>
                <li><strong>Working groups</strong><span>The Board's register of working groups, their coordinators, deliverables and dates.</span></li>
                <li><strong>Cantina roster</strong><span>Who is on site each day and what they can and cannot eat, for the kitchen.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-section">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">03 &mdash; building the city</span>
            <h2>Camps &amp; the site</h2>
        </div>
        <div class="tour-cap anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    Theme camps (barrios) register each year with their leads, images and
                    placement details. Camp leads then draw their footprint on an interactive map of
                    the site, inside a placement window the city planning team controls, and every
                    polygon edit is kept in history.
                </p>
                <p>
                    Shipping containers have their own register and photos, and get placed on the
                    same map each year. Rides to and from the burn get a board of their own.
                </p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Camps</strong><span>Per-year registrations, leads, workshop leads, and camp members.</span></li>
                <li><strong>City planning map</strong><span>Barrio polygons drawn on a real map of the site, with append-only edit history.</span></li>
                <li><strong>Containers</strong><span>Year-over-year container register, placed on the map per year.</span></li>
                <li><strong>Event guide</strong><span>Events submitted, moderated, browsed and bookmarked into a personal schedule.</span></li>
                <li><strong>Rideshare</strong><span>Drivers post offers, riders post requests, and a map board helps them find each other.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-break" style="background-image: url('/_content/Humans.Tour/img/whatis-3.jpg')">
    <blockquote class="anim anim-fade-up">
        Built by the people who build the city.
        <span class="tour-annotation" aria-hidden="true">literally us, on our days off</span>
    </blockquote>
</section>

<section class="tour-section tour-section--alt">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">04 &mdash; follow the money</span>
            <h2>Money</h2>
        </div>
        <div class="tour-cap tour-cap--flip anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    A store where camps and departments order from the org's catalog, pay by card
                    through Stripe or by bank transfer, and receive one consolidated invoice per camp
                    order. Members file expense reports with receipts; approved reports are booked
                    into the accounting system automatically.
                </p>
                <p>
                    Budgets are planned per fiscal year, and actual spend is read from a local
                    mirror of the association's Holded books, so no page waits on the accounting
                    API. The treasurer generates SEPA payout files for what members are owed.
                </p>
                <p>The Board sees where the money is without asking anyone to update a sheet.</p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Camp services store</strong><span>Per-year catalog with VAT and deposits, Stripe checkout, consolidated invoicing.</span></li>
                <li><strong>Expenses</strong><span>Receipts and supplier invoices attached, Finance approval, booked into Holded.</span></li>
                <li><strong>Pre-approvals</strong><span>Pools such as creativity grants and travel, pre-authorized per person before they spend.</span></li>
                <li><strong>Budgets</strong><span>Fiscal-year budgets with groups, categories, line items, and a field-level change log.</span></li>
                <li><strong>Ledger &amp; payouts</strong><span>Accounting mirror, creditor balances, and SEPA payout files for the bank.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-section">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">05 &mdash; who approved that, and when</span>
            <h2>Govern</h2>
        </div>
        <div class="tour-cap anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    Colaborador and Asociado membership tiers are applied for, voted on by the
                    Board, and run on synchronized two-year terms. Governance and admin roles carry
                    real start and end dates.
                </p>
                <p>
                    The Asociados' binding assembly votes run here too: the electorate is frozen the
                    moment a vote opens, the tally stays sealed until it closes, and ranked ballots
                    are counted by instant runoff.
                </p>
                <p>When someone asks "who approved that, and when", the answer is one search away.</p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Applications &amp; votes</strong><span>Membership tiers applied for, voted on, recorded.</span></li>
                <li><strong>Assembly votes</strong><span>Frozen electorate, sealed tally, results stored once.</span></li>
                <li><strong>Roles with terms</strong><span>Governance and admin roles with start and end dates, not tribal memory.</span></li>
                <li><strong>Audit trail</strong><span>Every privileged or automated action leaves a record the Board can read.</span></li>
                <li><strong>Drive watchdog</strong><span>Flags permission changes on managed Google Drive folders that the system did not make.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-section tour-section--alt">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">06 &mdash; seven languages, one outbox</span>
            <h2>Communicate</h2>
        </div>
        <div class="tour-cap tour-cap--flip anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    Every email goes through one outbox with retries, a pause switch, per-category
                    preferences and unsubscribe links, and admins can see each send. In-app
                    notifications land in an inbox, and marketing audiences are computed from Humans
                    and synced into MailerLite.
                </p>
                <p>
                    Surveys support branching questions in several languages and three anonymity
                    levels, from identified to fully anonymous. An issue tracker routes bug reports
                    and questions to the people who own that part of the app.
                </p>
                <p>
                    The whole member-facing UI ships in seven languages: English, Spanish, Catalan,
                    German, French, Italian, and Dutch, because a Spanish burn is not an English-only crowd.
                </p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Email outbox</strong><span>Every mail the system sends is queued, retried, and visible to admins.</span></li>
                <li><strong>Notifications</strong><span>An in-app inbox, plus live counts of work waiting for review.</span></li>
                <li><strong>Surveys</strong><span>Branching, multilingual, with identified, completion-tracked or anonymous answers.</span></li>
                <li><strong>Help when you need it</strong><span>Role-aware guide pages, a global search, an issue tracker, and an AI helper.</span></li>
                <li><strong>Seven languages</strong><span>en &middot; es &middot; ca &middot; de &middot; fr &middot; it &middot; nl, enforced by tests.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-section">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">07 &mdash; live data, not last Tuesday's printout</span>
            <h2>At the gate</h2>
        </div>
        <div class="tour-cap anim anim-fade-up">
            <div class="tour-cap-copy">
                <p>
                    Ticket orders and attendees sync from Ticket Tailor every few minutes, are
                    matched to members by verified email, and can be transferred between members.
                </p>
                <p>
                    At the door, a gate tablet scans each ticket and the server decides: a red,
                    amber or green card, a photo ID check, and one permanent admission record.
                    Early entry is checked against every source that grants it, so a build crew
                    member is let in on the right day and not before.
                </p>
                <p>The gate crew works from live data, in the desert, on whatever device is charged.</p>
            </div>
            <ul class="tour-cap-list">
                <li><strong>Ticketing</strong><span>Vendor sync, auto-matching to members, and ticket transfers.</span></li>
                <li><strong>Gate admission</strong><span>Server-decided scans with ID confirmation and an append-only record.</span></li>
                <li><strong>Early entry</strong><span>One list combined from shifts, camps and teams, matching who is actually allowed in.</span></li>
                <li><strong>Grants &amp; codes</strong><span>Entitlements like cheaper tickets or early entry, and discount codes sent in waves.</span></li>
                <li><strong>Phone scanner</strong><span>Read-only ticket lookup from a phone browser camera.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="tour-break" style="background-image: url('/_content/Humans.Tour/img/whatis-2.jpg')">
    <blockquote class="anim anim-fade-up">
        Over 2,000 real people trust this system, and a volunteer Board relies on it to run
        a legal Spanish asociaci&oacute;n.
    </blockquote>
</section>

<section class="tour-section tour-section--dark">
    <div class="tour-container">
        <div class="anim anim-fade-up">
            <span class="tour-kicker">Humans for your burn</span>
            <h2>Take the parts your burn needs.</h2>
            <p class="tour-section-lead">
                Humans is built as independent sections — People, Teams, Shifts, Tickets, Store,
                Expenses, Governance, and more — each owning its own data and talking to the
                others through narrow interfaces. That structure is the roadmap: a deployment per
                burn, configured with the sections your org actually uses. Run People + Shifts +
                Gate and skip the rest, or add your language. The modularity is real today;
                per-burn configuration is where the project is headed.
            </p>
        </div>
        <div class="tour-eng-grid anim anim-fade-up">
            <div><strong>Not vibe-coded</strong><span>Strict layering and section isolation, enforced by custom Roslyn analyzers at the line of code.</span></div>
            <div><strong>Tested like it matters</strong><span>Per-section test suites, architecture tests, and mutation testing on the rules that count.</span></div>
            <div><strong>Nothing invisible</strong><span>Automation that acts without leaving an audit entry is treated as a bug.</span></div>
            <div><strong>Actually open</strong><span>AGPL-3.0, developed in the open, section by section.</span></div>
            <div><strong>Reviewed before it lands</strong><span>Every change is a pull request with automated review and its own preview deployment on a copy of the QA database.</span></div>
            <div><strong>An API for agents</strong><span>Key-authenticated machine endpoints, one personal key per human, so every call is tied to a named person.</span></div>
        </div>
        <p class="anim anim-fade-up" style="margin-top: 2rem;">
            Curious how it's built — and how well? <a href="/About">Read the engineering story</a>.
        </p>
    </div>
</section>

<section class="tour-close">
    <div class="tour-container anim anim-fade-up">
        <span class="tour-hero-annotation" aria-hidden="true">yes, it runs a real burn</span>
        <h2>Bring Humans to your burn.</h2>
        <p class="tour-section-lead" style="margin: 0 auto;">
            We built this for ourselves and we would love for it to run your burn too.
            Write to us — we are volunteers, we get it.
        </p>
        <div class="tour-close-ctas">
            <a class="tour-btn tour-btn--solid" href="mailto:humans@nobodies.team">humans@nobodies.team</a>
            <a class="tour-btn tour-btn--outline" href="https://github.com/nobodies-collective/Humans">Source on GitHub</a>
        </div>
    </div>
</section>

<footer class="tour-footer">
    <div class="tour-container">
        Humans &middot; free and open source (AGPL-3.0) &middot; built by burners, for burns
    </div>
</footer>
