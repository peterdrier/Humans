@model Humans.Google.Models.SyncTabContentViewModel
@using Humans.Base.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthService
@{
    var result = Model.Result;
    var resourceType = Model.ResourceType;
    var canExecuteActions = (await AuthService.AuthorizeAsync(User, PolicyNames.AdminOnly)).Succeeded;
    var canViewAudit = (await AuthService.AuthorizeAsync(User, PolicyNames.BoardOrAdmin)).Succeeded;
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="card-title mb-0">@result.TotalResources</h2>
                <p class="card-text text-muted">Total</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="card-title mb-0 text-success">@result.InSyncCount</h2>
                <p class="card-text text-muted">In Sync</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center @(result.DriftCount > 0 ? "border-warning" : "")">
            <div class="card-body">
                <h2 class="card-title mb-0 text-warning">@result.DriftCount</h2>
                <p class="card-text text-muted">Drifted</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center @(result.ErrorCount > 0 ? "border-danger" : "")">
            <div class="card-body">
                <h2 class="card-title mb-0 text-danger">@result.ErrorCount</h2>
                <p class="card-text text-muted">Errors</p>
            </div>
        </div>
    </div>
</div>

@{
    var downgrades = result.Diffs
        .SelectMany(d => d.Members.Where(m => m.State == MemberSyncState.Downgrade).Select(m => Tuple.Create(d, m)))
        .ToList();

    Func<MemberSyncStatus, IHtmlContent> teamsCell = @<text>
        @foreach (var team in item.TeamLinks)
        {
            <a href="/Teams/@team.Slug" class="badge bg-light text-dark border me-1 text-decoration-none">@team.Name</a>
        }
    </text>;
    Func<Tuple<ResourceSyncDiff, MemberSyncStatus>, IHtmlContent> downgradeNameCell = @<text>
        @if (item.Item2.UserId is { } userId)
        {
            <vc:human user-id="@userId" link="None" />
        }
        else
        {
            @item.Item2.DisplayName
        }
    </text>;
    Func<Tuple<ResourceSyncDiff, MemberSyncStatus>, IHtmlContent> downgradeTeamsCell = x => teamsCell(x.Item2);
    var downgradesTable = TableModel.For(downgrades)
        .Column("Resource", x => x.Item1.ResourceName)
        .Column("Email", x => x.Item2.Email)
        .Template("Name", downgradeNameCell, sortBy: x => x.Item2.DisplayName)
        .Column("Current", x => x.Item2.CurrentRole)
        .Column("Expected", x => x.Item2.ExpectedRole)
        .Template("Teams", downgradeTeamsCell, o => o.NoSort())
        .Build();

    static (string Label, string Badge) MemberState(MemberSyncState state) => state switch
    {
        MemberSyncState.Correct => ("Correct", "bg-success"),
        MemberSyncState.Missing => ("Missing", "bg-warning text-dark"),
        MemberSyncState.Inherited => ("Inherited", "bg-secondary"),
        MemberSyncState.WrongRole => ("Wrong Role", "bg-info text-dark"),
        MemberSyncState.Downgrade => ("Downgrade", "bg-danger"),
        _ => ("Extra", "bg-danger")
    };
    Func<MemberSyncStatus, IHtmlContent> memberNameCell = @<text>
        @if (item.UserId is { } userId)
        {
            <vc:human user-id="@userId" layout="AvatarName" size="24" link="Admin" />
        }
        else if (!string.IsNullOrEmpty(item.DisplayName) && !string.Equals(item.DisplayName, item.Email, StringComparison.Ordinal))
        {
            @item.DisplayName
        }
    </text>;
    Func<MemberSyncStatus, IHtmlContent> memberStateCell =
        @<text><span class="badge @MemberState(item.State).Badge">@MemberState(item.State).Label</span></text>;
}
@if (downgrades.Count > 0)
{
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger-subtle">
            <strong>Pending downgrades (@downgrades.Count)</strong>
            <small class="text-muted ms-2">Direct roles above what teams/workgroups grant. When Drive sync mode is AddAndRemove, the next sync lowers each to its expected role. Give anyone who needs the access a team role or permission level first.</small>
        </div>
        <partial name="_Table" model="downgradesTable" />
    </div>
}

@if (result.Diffs.Count == 0)
{
    <empty-state>No resources found for this type.</empty-state>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input sync-changes-toggle" type="checkbox" id="changesOnly-@resourceType" checked>
            <label class="form-check-label" for="changesOnly-@resourceType">Show changes only</label>
        </div>
        @if (canExecuteActions && result.DriftCount > 0)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-success"
                        data-action="executeAll" data-sync-action="1" data-resource-type="@resourceType">
                    Add All Missing
                </button>
                <button class="btn btn-sm btn-outline-primary"
                        data-action="executeAll" data-sync-action="2" data-resource-type="@resourceType">
                    Sync All
                </button>
            </div>
        }
    </div>

    @for (var i = 0; i < result.Diffs.Count; i++)
    {
        var diff = result.Diffs[i];
        var hasError = diff.ErrorMessage is not null;
        // A source-only claim (e.g. a Workgroup folder) has no google_resources row to audit or execute against.
        var isLinked = diff.ResourceId != Guid.Empty;
        var collapseId = $"collapse-{resourceType}-{i}";
        var showPermission = diff.PermissionLevel is not null;

        <div class="card mb-2@(diff.IsInSync ? " resource-in-sync" : "")">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-link p-0 text-decoration-none"
                            data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                        <i class="fa-solid fa-chevron-right collapse-icon"></i>
                    </button>
                    <span>
                        @if (diff.Url is not null)
                        {
                            <a href="@diff.Url" target="_blank" rel="noopener noreferrer">@diff.ResourceName</a>
                        }
                        else
                        {
                            @diff.ResourceName
                        }
                    </span>
                    @if (hasError)
                    {
                        <span class="badge bg-danger">Error</span>
                    }
                    else if (diff.IsInSync)
                    {
                        <span class="badge bg-success">In Sync</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Drifted</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">
                        @if (diff.LinkedTeams.Count > 0)
                        {
                            @foreach (var team in diff.LinkedTeams)
                            {
                                <a href="/Teams/@team.Slug" class="badge bg-light text-dark border me-1 text-decoration-none">
                                    @team.Name
                                    @if (team.PermissionLevel is not null)
                                    {
                                        <span class="text-muted fw-normal">&middot; @team.PermissionLevel</span>
                                    }
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </small>
                    @if (!isLinked)
                    {
                        <small class="text-muted font-monospace">@diff.GoogleId</small>
                    }
                    @if (canViewAudit && isLinked)
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           href="@Url.Action("Resource", "Google", new { id = diff.ResourceId })">Audit</a>
                    }
                    @if (canExecuteActions && isLinked && !diff.IsInSync && !hasError)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                data-action="executeSingle" data-resource-id="@diff.ResourceId"
                                data-sync-action="1" data-resource-name="@diff.ResourceName">
                            Add Missing
                        </button>
                        <button class="btn btn-sm btn-outline-primary"
                                data-action="executeSingle" data-resource-id="@diff.ResourceId"
                                data-sync-action="2" data-resource-name="@diff.ResourceName">
                            Sync All
                        </button>
                    }
                </div>
            </div>

            <div class="collapse" id="@collapseId">
                <div class="card-body p-0">
                    @if (hasError)
                    {
                        <div class="alert alert-danger m-3 mb-0">@diff.ErrorMessage</div>
                    }
                    else if (diff.Members.Count > 0)
                    {
                        var membersBuilder = TableModel.For(diff.Members)
                            .Column("Email", m => m.Email)
                            .Template("Name", memberNameCell)
                            .Template("Status", memberStateCell, sortBy: m => MemberState(m.State).Label);
                        if (showPermission)
                        {
                            membersBuilder.Column("Role (current / expected)", m => $"{m.CurrentRole ?? "\u2014"} / {m.ExpectedRole ?? "\u2014"}");
                        }
                        var membersTable = membersBuilder
                            .Template("Teams", teamsCell, o => o.NoSort())
                            .RowCss(_ => "member-row")
                            .RowData("member-state", m => ((int)m.State).ToString(System.Globalization.CultureInfo.InvariantCulture))
                            .Build();
                        <partial name="_Table" model="membersTable" />
                    }
                    else
                    {
                        <empty-state class="p-3">No members</empty-state>
                    }
                </div>
            </div>
        </div>
    }
}
