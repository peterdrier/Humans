<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Governance.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\..\Humans.Application\Humans.Application.csproj" />
    <ProjectReference Include="..\..\Humans.Infrastructure\Humans.Infrastructure.csproj" />
    <ProjectReference Include="..\Humans.Governance.Contracts\Humans.Governance.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <!-- ConsentResource only: the statutes page renders one Consent key, whose set came
         home at Consent's G5. Acyclic — Humans.Consent references
         Humans.Governance.Contracts, never this project (design §15 step 3b). -->
    <ProjectReference Include="..\Humans.Consent\Humans.Consent.csproj" />
    <!--
      Onboarding, for OnboardingResource: the board-voting detail page reuses four
      OnboardingReview_* applicant-summary labels, and a resource marker is a section
      type rather than a Contracts/ one (design §15 step 3b, Budget's rule). Acyclic —
      Humans.Onboarding names only Humans.Governance.Contracts.
    -->
    <ProjectReference Include="..\Humans.Onboarding\Humans.Onboarding.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/TermRenewalReminderJob.cs — [DisableConcurrentExecution] and IRecurringJob,
         since G5 lane 5b-4. Package, not project, so no cycle is possible; it was already
         arriving transitively. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
    <!--
      Stateless drives Application's state machine (Domain/Application.cs). It used to arrive
      transitively through Humans.Domain, which declared it; G5 lane 3b deleted that project,
      so the dependency is now declared where it is actually used. Nothing else in the
      solution names Stateless.
    -->
    <PackageReference Include="Stateless" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
