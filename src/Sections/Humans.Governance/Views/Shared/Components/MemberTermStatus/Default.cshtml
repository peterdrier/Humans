@using Humans.Governance.ViewComponents
@model MemberTermStatusViewModel

@* ─── Term expiry warnings (Colaborador/Asociado) ─── *@
<div class="row justify-content-center mb-4">
    <div class="col-lg-8">
        @if (Model.TermExpired)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-danger me-3">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong>@SharedLocalizer["Dashboard_TermExpired"]</strong>
                        <br /><small class="text-muted">@SharedLocalizer["Dashboard_MembershipTier"]: @Model.MembershipTier</small>
                    </div>
                    <a asp-controller="GovernanceApplications" asp-action="Create" class="btn btn-sm btn-primary ms-3">@SharedLocalizer["Dashboard_RenewNow"]</a>
                </div>
            </div>
        }
        else if (Model.TermExpiresSoon)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-warning me-3">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="flex-grow-1">
                        @Html.Raw(string.Format(SharedLocalizer["Dashboard_TermExpiresSoon"].Value, Model.TermExpiresAt?.ToDate()))
                        <br /><small class="text-muted">@SharedLocalizer["Dashboard_MembershipTier"]: @Model.MembershipTier</small>
                    </div>
                    <a asp-controller="GovernanceApplications" asp-action="Create" class="btn btn-sm btn-warning ms-3">@SharedLocalizer["Dashboard_RenewNow"]</a>
                </div>
            </div>
        }
        else if (Model.HasPendingApplication)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-info me-3">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                    <div>
                        <strong>@SharedLocalizer["Dashboard_TierApplicationPending"]</strong>
                        <br /><small class="text-muted">@SharedLocalizer["Dashboard_MembershipTier"]: @Model.MembershipTier</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="dashboard-action-icon dashboard-action-icon-sm dashboard-action-icon-success me-3">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <strong>@SharedLocalizer["Dashboard_TierActive"]</strong>
                        <span class="badge bg-primary ms-2">@Model.MembershipTier</span>
                        @if (Model.TermExpiresAt.HasValue)
                        {
                            <br /><small class="text-muted">@Html.Raw(string.Format(SharedLocalizer["Dashboard_TermExpires"].Value, Model.TermExpiresAt.Value.ToDate()))</small>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
