@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error. *@
@using Humans.Base.Extensions
@using Humans.Base.Enums
@using Humans.Users.Contracts
@using Humans.Consent
@using Humans.Governance
@using Humans.Onboarding
@using Humans.Governance.Contracts
@using Humans.Governance.Controllers
@using Humans.Governance.Domain
@using Humans.Governance.Models
@using Humans.Governance.Services.Dtos
@using Humans.Base
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Humans.Base.ViewComponents
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GovernanceResource> Localizer
@* Application_*, ApplicationStatus_*, AdminApp_Applicant and the Profile / OnboardingReview
   singles stay in SharedResource: ProfileController renders the same tier-application form
   during profile setup and the Onboarding review queue renders the rest. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@* The statutes tabs' empty-state string is Consent vocabulary. *@
@inject IStringLocalizer<ConsentResource> ConsentLocalizer
@* Four OnboardingReview_* applicant-summary labels, rendered here over a tier application. *@
@inject IStringLocalizer<OnboardingResource> OnboardingLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
