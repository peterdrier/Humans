@model IReadOnlyList<Humans.Governance.Services.Dtos.TermExpiryDriftRow>
@{
    ViewData["Title"] = "Term expiry correction (temp)";

    Func<TermExpiryDriftRow, IHtmlContent> applicantCell = @<text><vc:human user-id="@item.UserId" /></text>;
    Func<TermExpiryDriftRow, IHtmlContent> tierCell = @<text><span class="badge bg-info">@item.MembershipTier</span></text>;
    Func<TermExpiryDriftRow, IHtmlContent> detailCell =
        @<text><a asp-action="AdminDetail" asp-route-id="@item.ApplicationId" class="btn btn-sm btn-outline-secondary">Detail</a></text>;
    var table = TableModel.For(Model)
        .Template("Applicant", applicantCell)
        .Template("Tier", tierCell)
        .Column("Approved", r => r.ResolvedOn.ToInvariantDate())
        .Column("Stored expiry", r => r.StoredExpiry.ToInvariantDate(), o => o.Css("text-danger"))
        .Column("Expected expiry", r => r.ExpectedExpiry.ToInvariantDate(), o => o.Css("text-success"))
        .Template("", detailCell, o => o.NoSort())
        .Empty("Nothing to fix.")
        .Build();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Term expiry correction <span class="badge bg-warning text-dark">temp</span></h1>
    <span class="text-muted">@Model.Count drifted</span>
</div>

<p class="text-muted">
    Approved applications whose stored expiry is not what the calculator gives for their approval date.
    Terms end 31 December of the current cycle's odd year; approvals from 1 October of an odd year belong to the next cycle.
    Rows here were approved under the old rule (two years out, then bumped to odd). Fixing writes one audit entry per row.
</p>

<div class="card">
    <div class="card-body p-0">
        <partial name="_Table" model="table" />
    </div>
    @if (Model.Count > 0)
    {
        <div class="card-footer">
            <form method="post" asp-action="AdminTermExpiryFix">
                <button type="submit" class="btn btn-danger"
                        data-confirm="Rewrite the term expiry on @Model.Count approved application(s) to the calculator value? Each rewrite is audit-logged.">Fix all @Model.Count</button>
            </form>
        </div>
    }
</div>
