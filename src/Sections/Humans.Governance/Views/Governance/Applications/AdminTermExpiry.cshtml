@model IReadOnlyList<Humans.Governance.Services.Dtos.TermExpiryDriftRow>
@{
    ViewData["Title"] = "Term expiry correction (temp)";
    Layout = "_AdminLayout";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
        <li class="breadcrumb-item"><a asp-action="Admin">Applications</a></li>
        <li class="breadcrumb-item active" aria-current="page">Term expiry correction</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Term expiry correction <span class="badge bg-warning text-dark">temp</span></h1>
    <span class="text-muted">@Model.Count drifted</span>
</div>

<p class="text-muted">
    Approved applications whose stored expiry is not what the calculator gives for their approval date.
    Terms end 31 December of the current cycle's odd year; approvals from 1 October of an odd year belong to the next cycle.
    Rows here were approved under the old rule (two years out, then bumped to odd). Fixing writes one audit entry per row.
</p>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Tier</th>
                        <th>Approved</th>
                        <th>Stored expiry</th>
                        <th>Expected expiry</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Nothing to fix.</td></tr>
                    }
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td><vc:human user-id="@row.UserId" /></td>
                            <td><span class="badge bg-info">@row.MembershipTier</span></td>
                            <td>@row.ResolvedOn.ToInvariantDate()</td>
                            <td class="text-danger">@(row.StoredExpiry.ToInvariantDate() ?? "—")</td>
                            <td class="text-success">@row.ExpectedExpiry.ToInvariantDate()</td>
                            <td><a asp-action="AdminDetail" asp-route-id="@row.ApplicationId" class="btn btn-sm btn-outline-secondary">Detail</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Count > 0)
    {
        <div class="card-footer">
            <form method="post" asp-action="AdminTermExpiryFix">
                <button type="submit" class="btn btn-danger"
                        data-confirm="Rewrite the term expiry on @Model.Count approved application(s) to the calculator value? Each rewrite is audit-logged.">Fix all @Model.Count</button>
            </form>
        </div>
    }
</div>
