@model AssemblyVoteBallotsViewModel
@{
    ViewData["Title"] = "Vote ballots";

    Func<AssemblyBallotDisclosureRow, IHtmlContent> memberCell = @<text>
        @if (item.UserId is { } userId)
        {
            <vc:human user-id="@userId" link="None" />
        }
        else
        {
            <text>—</text>
        }
    </text>;
    Func<AssemblyBallotDisclosureRow, IHtmlContent> rosterCell = @<text>
        @if (item.IsOfficial)
        {
            <span class="badge bg-primary">Official</span>
        }
        else
        {
            <span class="badge bg-secondary">Indicative</span>
        }
    </text>;
    Func<AssemblyBallotDisclosureRow, IHtmlContent> choiceCell = @<text>
        @if (item.Choice == AssemblyBallotChoice.Ranked && item.Ranking is { Count: > 0 } ranking)
        {
            @string.Join(" > ", ranking.Select(Model.LabelFor))
        }
        else
        {
            @item.Choice
        }
    </text>;
    var table = TableModel.For(Model.Ballots.OrderByDescending(b => b.IsOfficial).ThenBy(b => b.DisplayName, StringComparer.CurrentCulture).ToList())
        .Template("Member", memberCell)
        .Template("Roster", rosterCell)
        .Template("Choice / ranking", choiceCell)
        .Column("Revision", b => b.Revision, o => o.Number().End())
        .Css("align-middle")
        .Empty("No ballots cast.")
        .Build();
}

@* Admin routes are localization-exempt — plain English literals throughout. *@

<div class="alert alert-warning" role="alert">
    Viewing this list has been recorded in the audit log.
</div>

<page-header title="Individual ballots" />

<div class="card">
    <div class="card-body p-0">
        <partial name="_Table" model="table" />
    </div>
</div>

<div class="mt-3">
    <a href="/Governance/Votes/@Model.VoteId/Results" class="btn btn-outline-secondary btn-sm">Back to results</a>
</div>
