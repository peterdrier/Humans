@using Humans.Base.Constants
@using Humans.Google.Contracts
@model GovernanceBodyViewModel
@{
    var title = Model.Body switch
    {
        GovernanceBody.Asociados => Localizer["Governance_Asociados"].Value,
        GovernanceBody.Colaboradores => Localizer["Governance_Colaboradores"].Value,
        _ => Localizer["Governance_TheBoard"].Value,
    };
    ViewData["Title"] = title;
}

@section Crumbs {
    <a asp-controller="Governance" asp-action="Index">@Localizer["Governance_Title"]</a>
    <span>@title</span>
}

<page-header title="@title" />

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-semibold">@Localizer["Governance_Body_MemberCount", Model.MemberIds.Count]</div>
            <div class="card-body">
                @if (Model.MemberIds.Count == 0)
                {
                    <empty-state class="mb-0">@Localizer["Governance_Body_NoMembers"]</empty-state>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var memberId in Model.MemberIds)
                        {
                            <div class="col-6 col-sm-4 col-md-3">
                                <vc:human user-id="@memberId" layout="Card" size="102" />
                                @if (Model.Positions.TryGetValue(memberId, out var office))
                                {
                                    <div class="text-center small text-muted">@Localizer[$"Governance_Position_{office}"]</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.Links is not null || Model.CanManageBoard || Model.Manage is not null)
    {
        <div class="col-lg-4">
            @if (Model.Links is { } links)
            {
                <div class="card mb-4">
                    <div class="card-header fw-semibold">@Localizer["Governance_GroupAndFiles"]</div>
                    <partial name="_BodyLinks" model="links" />
                </div>
            }
            @if (Model.Manage is { } manage)
            {
                <div class="card mb-4">
                    <div class="card-header fw-semibold">@Localizer["Governance_Manage_Title"]</div>
                    <div class="card-body">
                        <form asp-action="SetGroup" asp-route-body="@Model.Body" method="post">
                            <label for="group-prefix" class="form-label">@Localizer["Governance_Manage_GroupName"]</label>
                            <div class="input-group input-group-sm">
                                <input id="group-prefix" name="prefix" value="@manage.GroupPrefix" class="form-control" />
                                <span class="input-group-text">@@@DomainConstants.GoogleGroupDomain</span>
                                <button type="submit" class="btn btn-outline-primary">@Localizer["Governance_Save"]</button>
                            </div>
                        </form>
                    </div>
                    <ul class="list-group list-group-flush">
                        @if (manage.Files.Count == 0)
                        {
                            <li class="list-group-item text-muted small">@Localizer["Governance_Manage_NoFiles"]</li>
                        }
                        @foreach (var file in manage.Files)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <span class="flex-grow-1 text-break">
                                    @if (!string.IsNullOrEmpty(file.Url))
                                    {
                                        <a href="@file.Url" target="_blank" rel="noopener noreferrer">@file.Name</a>
                                    }
                                    else
                                    {
                                        @file.Name
                                    }
                                    <span class="badge bg-secondary ms-1">@file.Level</span>
                                </span>
                                <form asp-action="RemoveFile" asp-route-body="@Model.Body" asp-route-fileId="@file.Id" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Governance_Manage_Remove"]</button>
                                </form>
                            </li>
                        }
                    </ul>
                    <div class="card-body">
                        <form asp-action="AddFile" asp-route-body="@Model.Body" method="post" class="d-flex flex-wrap gap-2">
                            <input name="url" type="url" required class="form-control form-control-sm" placeholder="@Localizer["Governance_Manage_DriveLink"]" aria-label="@Localizer["Governance_Manage_DriveLink"]" />
                            <select name="level" class="form-select form-select-sm w-auto" aria-label="@Localizer["Governance_Manage_Access"]">
                                @foreach (var level in Enum.GetValues<DrivePermissionLevel>().Where(l => l != DrivePermissionLevel.None))
                                {
                                    if (level == DrivePermissionLevel.Contributor)
                                    {
                                        <option value="@level" selected>@level</option>
                                    }
                                    else
                                    {
                                        <option value="@level">@level</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">@Localizer["Governance_Manage_AddFile"]</button>
                        </form>
                    </div>
                </div>
            }
            @if (Model.CanManageBoard)
            {
                <div class="card">
                    <div class="card-header fw-semibold">@Localizer["Governance_ManageBoard"]</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var memberId in Model.MemberIds)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <span class="flex-grow-1"><vc:human user-id="@memberId" layout="AvatarName" size="24" /></span>
                                <form asp-action="SetBoardPosition" method="post" class="m-0 d-flex gap-1">
                                    <input type="hidden" name="userId" value="@memberId" />
                                    @{ var held = Model.Positions.TryGetValue(memberId, out var current) ? current : (BoardPosition?)null; }
                                    <select name="position" class="form-select form-select-sm" aria-label="@Localizer["Governance_Position"]">
                                        @if (held is null)
                                        {
                                            <option value="" selected>@Localizer["Governance_Position_None"]</option>
                                        }
                                        else
                                        {
                                            <option value="">@Localizer["Governance_Position_None"]</option>
                                        }
                                        @foreach (var option in Enum.GetValues<BoardPosition>())
                                        {
                                            if (held == option)
                                            {
                                                <option value="@option" selected>@Localizer[$"Governance_Position_{option}"]</option>
                                            }
                                            else
                                            {
                                                <option value="@option">@Localizer[$"Governance_Position_{option}"]</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["Governance_Save"]</button>
                                </form>
                                <form asp-action="EndBoardMember" method="post" class="m-0">
                                    <input type="hidden" name="userId" value="@memberId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Governance_EndBoardSeat"]</button>
                                </form>
                            </li>
                        }
                    </ul>
                    <div class="card-body">
                        <form asp-action="AddBoardMember" method="post" class="d-flex flex-wrap gap-2">
                            <div class="flex-grow-1">
                                <vc:human-search field-name="userId" scope="Name" exclude-user-ids="Model.MemberIds" placeholder="@Localizer["Governance_FindPerson"].Value" />
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">@Localizer["Governance_AddBoardMember"]</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
