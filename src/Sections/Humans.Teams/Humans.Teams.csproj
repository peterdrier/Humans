<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Teams.Tests" />
    <InternalsVisibleTo Include="Humans.Shifts.Tests" />
    <InternalsVisibleTo Include="Humans.Users.Tests" />
    <!--
      Humans.Application.Tests holds the tests of sections that have not moved to their own
      project yet; they seed team rows through ServiceTestHarness, which needs Teams
      internals. Each G5 move takes its own section's tests out of there into a section test
      project (which gets its own entry above), so this one comes out when the last section
      leaves Base — rewriting an unmoved section's fixtures early would be redone at its own
      G5.
    -->
    <InternalsVisibleTo Include="Humans.Application.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\..\Humans.Domain\Humans.Domain.csproj" />
    <ProjectReference Include="..\..\Humans.Application\Humans.Application.csproj" />
    <ProjectReference Include="..\Humans.GoogleIntegration.Contracts\Humans.GoogleIntegration.Contracts.csproj" />
    <ProjectReference Include="..\..\Humans.Infrastructure\Humans.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Humans.UI\Humans.UI.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <!-- TeamAdmin/Members.cshtml renders <vc:audit-log>, which moved out of Humans.UI into the
         AuditLog section in G5 lane 4b-2h (nobodies-collective/Humans#866). AuditLog reaches
         back only to Humans.Teams.Contracts, never to this project — no cycle. -->
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <ProjectReference Include="..\Humans.EarlyEntry\Humans.EarlyEntry.csproj" />
    <!--
      SystemTeamSyncJob's eligibility inputs (G5 lane 4b-2e). Camps supplies active camp
      leads, Governance the approved-tier and consent reads, Users the person read model,
      Email the added-to-team notice. All four are pure leaves (Interfaces + Domain only),
      so none of these edges cycles back into Humans.Teams. They already arrived
      transitively through Humans.Application; declared here so they survive its deletion.
    -->
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Governance.Contracts\Humans.Governance.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
