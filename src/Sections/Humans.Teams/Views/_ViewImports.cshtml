@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error. Guarded by
   TeamsPageRenderTests. *@
@using Humans.Base.Extensions
@using Humans.Base.Enums
@using Humans.Teams
@using Humans.Teams.Contracts
@using Humans.Teams.Controllers
@using Humans.Teams.Models
@using Humans.Teams.Services
@using Humans.Base
@using Humans.Base.Authorization
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Humans.Base.ViewComponents
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TeamsResource> Localizer
@* Keys other sections render too (Teams_Member, MyTeams_Role, …) and the Base enums' Enum_* keys stay in SharedResource. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@addTagHelper *, Humans.Teams
@addTagHelper *, Humans.AuditLog
