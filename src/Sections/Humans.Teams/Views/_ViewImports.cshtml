@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by TeamsPageRenderTests (step 12). *@
@using Humans.Base.Extensions
@using Humans.Base.Enums
@using Humans.Teams
@using Humans.Teams.Contracts
@using Humans.Teams.Controllers
@using Humans.Teams.Models
@using Humans.Teams.Services
@using Humans.Base
@using Humans.Base.Authorization
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Humans.Base.ViewComponents
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TeamsResource> Localizer
@* Teams_Title, Teams_Member, MyTeams_View, MyTeams_Role and TeamDetail_Actions stay in
   SharedResource — something outside the section renders each of them. Two of those
   renderers used to be Humans.UI partials; since G5 lane 4b-i (#866) _RoleBadge and
   _ShiftsSummaryCard are this section's own files, but Users' ProfileCard, Shell's widget
   gallery and Search's /Search page still render them, and MyTeams_View is read by
   Humans.Users' UsersAdmin/AdminList. The keys stay shared and every call site in this section's Shared/
   partials binds SharedLocalizer explicitly. So do the Enum_SlotPriority_* /
   Enum_RolePeriod_* keys, whose enums are Base's (§15.3b). *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@* <vc:audit-log> (TeamAdmin/Members) is the AuditLog section's own component since
   G5 lane 4b-2h (nobodies-collective/Humans#866); it used to be Humans.UI's. *@
@addTagHelper *, Humans.AuditLog
