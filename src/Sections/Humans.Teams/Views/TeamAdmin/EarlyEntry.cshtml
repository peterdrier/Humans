@model Humans.Teams.Models.TeamEarlyEntryPageViewModel
@{
    ViewData["Title"] = $"Early Entry — {Model.TeamName}";
    var availableEvents = Model.Events.Select(e => e.Id).ToHashSet();
}

<page-header title="@($"Early Entry — {Model.TeamName}")" subtitle="Each grant contributes only when its selected event is active." />

@if (Model.Grants.Any(g => g.EventSettingsId is not { } id || !availableEvents.Contains(id)))
{
    <div class="alert alert-warning">Grants without an available event do not contribute to early entry. Review each grant, select its event and Save to confirm.</div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card mb-4">
    <div class="card-header">Grants</div>
    <div class="card-body p-0">
        @if (Model.Grants.Count == 0)
        {
            <empty-state class="m-3 mb-0">No early-entry grants yet.</empty-state>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Human</th>
                        <th>Event</th>
                        <th>Entry date</th>
                        <th>Project</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grant in Model.Grants)
                    {
                        <tr>
                            <td><vc:human user-id="@grant.UserId" /></td>
                            <td colspan="3">
                                <form asp-controller="TeamAdmin" asp-action="EditEarlyEntry" asp-route-slug="@Model.Slug" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="GrantId" value="@grant.GrantId" />
                                    <div class="col">
                                        <select name="EventSettingsId" class="form-select form-select-sm" aria-label="Event" required>
                                            <option value="">Select an event</option>
                                            @foreach (var item in Model.Events)
                                            {
                                                @if (item.Id == grant.EventSettingsId)
                                                {
                                                    <option value="@item.Id" selected>@item.EventName (@item.GateOpeningDate.ToInvariantDate())</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Id">@item.EventName (@item.GateOpeningDate.ToInvariantDate())</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-auto">
                                        <input type="date" name="EntryDate" class="form-control form-control-sm"
                                               value="@grant.EntryDate.ToInvariantDate()" required />
                                    </div>
                                    <div class="col">
                                        <input type="text" name="ProjectName" class="form-control form-control-sm"
                                               value="@grant.ProjectName" maxlength="256" required
                                               aria-label="Project" />
                                    </div>
                                    <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Save</button></div>
                                </form>
                            </td>
                            <td class="text-end">
                                <form asp-controller="TeamAdmin" asp-action="RemoveEarlyEntry" asp-route-slug="@Model.Slug" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="grantId" value="@grant.GrantId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm="Remove this early-entry grant?">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-4 position-relative" style="z-index: 2;">
    <div class="card-header">Grant early entry</div>
    <div class="card-body">
        <form asp-controller="TeamAdmin" asp-action="AddEarlyEntry" asp-route-slug="@Model.Slug" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-12">
                <label class="form-label" for="ee-add-event">Event</label>
                <select id="ee-add-event" name="EventSettingsId" class="form-select" required>
                    <option value="">Select an event</option>
                    @foreach (var item in Model.Events)
                    {
                        @if (item.Id == Model.ActiveEventSettingsId)
                        {
                            <option value="@item.Id" selected>@item.EventName (@item.GateOpeningDate.ToInvariantDate())</option>
                        }
                        else
                        {
                            <option value="@item.Id">@item.EventName (@item.GateOpeningDate.ToInvariantDate())</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Human</label>
                <vc:human-search field-name="UserId"
                                 instance-key="team-ee-add"
                                 placeholder="Search by name or ticket #…"
                                 scope="Name"
                                 ticket-lookup-url="@Url.Action("LookupTicket", "TeamAdmin", new { slug = Model.Slug })" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="ee-add-date">Entry date</label>
                <input type="date" id="ee-add-date" name="EntryDate" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="ee-add-project">Project</label>
                <input type="text" id="ee-add-project" name="ProjectName" class="form-control" maxlength="256" required />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-success">Grant</button>
            </div>
        </form>
    </div>
</div>
