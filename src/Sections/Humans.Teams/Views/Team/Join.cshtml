@model Humans.Teams.Models.JoinTeamViewModel
@{
    ViewData["Title"] = string.Format(Localizer["Teams_JoinTeam_Title"].Value, Model.TeamName);
}

@section Crumbs {
    <a asp-action="Index">@SharedLocalizer["Teams_Title"]</a>
    <a asp-action="Details" asp-route-slug="@Model.TeamSlug">@Model.TeamName</a>
    <span>@Localizer["Teams_JoinTeam_Join"]</span>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">@string.Format(Localizer["Teams_JoinTeam_Title"].Value, Model.TeamName)</h4>
            </div>
            <div class="card-body">
                @if (Model.RequiresApproval)
                {
                    <div class="alert alert-info">
                        @Localizer["Teams_JoinTeam_RequiresApproval"]
                    </div>

                    <form asp-action="Join" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TeamId" />
                        <input type="hidden" asp-for="TeamName" />
                        <input type="hidden" asp-for="RequiresApproval" />

                        <div class="mb-3">
                            <label asp-for="Message" class="form-label">@Localizer["Teams_JoinTeam_MessageLabel"]</label>
                            <textarea asp-for="Message" class="form-control" rows="4" placeholder="@Localizer["Teams_JoinTeam_MessagePlaceholder"].Value"></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">@Localizer["Teams_JoinTeam_SubmitRequest"]</button>
                            <a asp-action="Details" asp-route-slug="@Model.TeamSlug" class="btn btn-outline-secondary">@SharedLocalizer["Common_Cancel"]</a>
                        </div>
                    </form>
                }
                else
                {
                    <p>@Localizer["Teams_JoinTeam_NoApprovalNeeded"]</p>

                    <form asp-action="Join" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TeamId" />
                        <input type="hidden" asp-for="TeamName" />
                        <input type="hidden" asp-for="RequiresApproval" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">@Localizer["Teams_JoinTeam_JoinTeamButton"]</button>
                            <a asp-action="Details" asp-route-slug="@Model.TeamSlug" class="btn btn-outline-secondary">@SharedLocalizer["Common_Cancel"]</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
