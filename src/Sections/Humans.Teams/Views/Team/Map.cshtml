@model Humans.Teams.Models.MapViewModel
@{
    ViewData["Title"] = Localizer["Teams_Map_Title"].Value;
}

@section Crumbs {
    <a asp-action="Index">@SharedLocalizer["Teams_Title"]</a>
    <span>@Localizer["Teams_Map_Title"]</span>
}

<page-header title="@(Localizer["Teams_Map_Title"].Value)" />

@section Styles {
    <style>
        .map-bubble {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--h-map-cluster);
            color: var(--h-text-on-dark);
            border: 2px solid var(--h-warm-white);
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--h-map-cluster) 30%, transparent), 0 1px 3px rgb(0 0 0 / 30%);
            font-weight: 600;
            line-height: 1;
            cursor: pointer;
            transition: transform 0.15s ease;
        }
        .map-bubble:hover { transform: scale(1.1); }
        .map-bubble--large {
            background: var(--h-map-cluster-large);
            box-shadow: 0 0 0 5px color-mix(in srgb, var(--h-map-cluster-large) 30%, transparent), 0 1px 3px rgb(0 0 0 / 30%);
        }
        .map-bubble--person {
            width: 14px;
            height: 14px;
            background: var(--h-map-person);
            box-shadow: 0 1px 3px rgb(0 0 0 / 40%);
        }
    </style>
}

@if (Model.Markers.Count > 0)
{
    <div class="card">
        <div class="card-header">
            @string.Format(Localizer["Teams_Map_Count"].Value, Model.Markers.Count)
        </div>
        <div class="card-body p-0">
            <div id="map" style="height: 600px; width: 100%;"></div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            @Localizer["Teams_Map_None"]
        </div>
    </div>
}

<div class="mt-3">
    <p class="text-muted small">@Localizer["Teams_Map_Privacy"]</p>
</div>

@section Scripts {
    @if (Model.Markers.Count > 0 && !string.IsNullOrEmpty(ViewData["GoogleMapsApiKey"]?.ToString()))
    {
        <script>
            (g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({
                key: "@ViewData["GoogleMapsApiKey"]",
                v: "weekly"
            });
        </script>
        <script src="https://unpkg.com/&#64;googlemaps/markerclusterer/dist/index.min.js"></script>
        <script>
            const markers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Markers, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            const _cs = getComputedStyle(document.documentElement);
            const cssVar = (name) => _cs.getPropertyValue(name).trim();
            const clrMutedText = cssVar('--h-muted-text');
            const clrTextOnDark = cssVar('--h-text-on-dark');
            const clrTextSecondary = cssVar('--h-text-secondary');

            // Diameter grows with log(count) so a 300-person cluster stays readable without swallowing its neighbours.
            function bubble(count) {
                const el = document.createElement('div');
                if (count === 1) {
                    el.className = 'map-bubble map-bubble--person';
                    return el;
                }
                const size = Math.round(24 + 12 * Math.log10(count));
                el.className = 'map-bubble' + (count >= 50 ? ' map-bubble--large' : '');
                el.style.width = el.style.height = size + 'px';
                el.style.fontSize = Math.round(size * 0.4) + 'px';
                el.textContent = count;
                return el;
            }

            function avatarHtml(m, size) {
                const s = size || 40;
                if (m.profilePictureUrl) {
                    return '<img src="' + Humans.escapeHtml(m.profilePictureUrl) + '" alt="" style="width:' + s + 'px;height:' + s + 'px;border-radius:50%;object-fit:cover;">';
                }
                const graphemes = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
                const initials = (m.displayName || '?').split(' ').filter(Boolean).slice(0, 2)
                    .map(word => graphemes.segment(word)[Symbol.iterator]().next().value.segment).join('').toUpperCase();
                return '<div style="width:' + s + 'px;height:' + s + 'px;border-radius:50%;background:' + clrMutedText + ';color:' + clrTextOnDark + ';display:flex;align-items:center;justify-content:center;font-size:' + Math.round(s * 0.4) + 'px;font-weight:600;">' + Humans.escapeHtml(initials) + '</div>';
            }

            function personHtml(m) {
                const location = [m.city, m.countryCode].filter(Boolean).join(', ');
                return '<div style="display:flex;align-items:center;gap:8px;padding:4px 0;">' +
                    avatarHtml(m, 36) +
                    '<div>' +
                    '<a href="/Profile/' + m.userId + '" style="font-weight:600;text-decoration:none;">' + Humans.escapeHtml(m.displayName) + '</a>' +
                    (location ? '<br><span style="color:' + clrTextSecondary + ';font-size:0.85em;">' + Humans.escapeHtml(location) + '</span>' : '') +
                    '</div></div>';
            }

            function groupByLocation(data) {
                const groups = {};
                for (const m of data) {
                    const key = m.latitude.toFixed(6) + ',' + m.longitude.toFixed(6);
                    if (!groups[key]) groups[key] = [];
                    groups[key].push(m);
                }
                return Object.values(groups);
            }

            async function initMap() {
                const { Map, InfoWindow } = await google.maps.importLibrary("maps");
                const { AdvancedMarkerElement } = await google.maps.importLibrary("marker");

                const map = new Map(document.getElementById("map"), {
                    zoom: 3,
                    center: { lat: 40, lng: -3 },
                    mapId: "volunteer-map",
                    mapTypeControl: false,
                    streetViewControl: false
                });

                const infoWindow = new InfoWindow();
                const mapMarkers = [];
                const groups = groupByLocation(markers);

                for (const group of groups) {
                    const first = group[0];

                    const marker = new AdvancedMarkerElement({
                        position: { lat: first.latitude, lng: first.longitude },
                        map: map,
                        title: group.length > 1 ? group.length + ' humans' : first.displayName,
                        gmpClickable: true,
                        content: bubble(group.length)
                    });

                    marker._people = group;

                    marker.addEventListener("gmp-click", function () {
                        const people = marker._people;
                        let html = '<div style="max-height:300px;overflow-y:auto;">';
                        for (const p of people) {
                            html += personHtml(p);
                        }
                        html += '</div>';
                        infoWindow.setContent(html);
                        infoWindow.open({ anchor: marker, map: map });
                    });

                    mapMarkers.push(marker);
                }

                if (typeof markerClusterer !== 'undefined') {
                    var renderer = {
                        render: function(ref) {
                            var totalPeople = 0;
                            for (var gm of ref.markers) {
                                totalPeople += (gm._people ? gm._people.length : 1);
                            }
                            return new AdvancedMarkerElement({
                                position: ref.position,
                                content: bubble(totalPeople),
                                zIndex: totalPeople
                            });
                        }
                    };
                    new markerClusterer.MarkerClusterer({
                        markers: mapMarkers,
                        map: map,
                        renderer: renderer,
                        algorithm: new markerClusterer.SuperClusterAlgorithm({ radius: 80 })
                    });
                }

                if (markers.length > 1) {
                    const bounds = new google.maps.LatLngBounds();
                    for (const m of markers) {
                        bounds.extend({ lat: m.latitude, lng: m.longitude });
                    }
                    map.fitBounds(bounds, 50);
                    // Outliers can zoom far out: fall back to a Europe-centred view.
                    google.maps.event.addListenerOnce(map, 'idle', function() {
                        if (map.getZoom() < 4) {
                            map.setCenter({ lat: 43, lng: 5 });
                            map.setZoom(4);
                        }
                    });
                } else if (markers.length === 1) {
                    map.setCenter({ lat: markers[0].latitude, lng: markers[0].longitude });
                    map.setZoom(10);
                }
            }

            initMap();
        </script>
    }
}
