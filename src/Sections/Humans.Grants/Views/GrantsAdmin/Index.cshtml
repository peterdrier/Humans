@model AdminIndexViewModel
@{
    ViewData["Title"] = "Grant programs";

    var table = TableModel.For(Model.Programs)
        .Link("Program", p => p.Name, p => Url.Action("Program", new { programId = p.Id }))
        .Column("Event", p => p.EventName)
        .Column("Entitles", p => p.Entitles, o => o.Css("small"))
        .Column("Issued by", p => p.IssuedBy == GrantIssuer.Source ? p.SourceKey : "Managers")
        .Column("Active", p => p.Count(GrantState.Active, Model.Today), o => o.Number().End())
        .Column("Expires", p => p.GrantsExpireOn, o => o.Date())
        .Column("Status", p => p.Status, o => o.EnumBadge())
        .Css("align-middle")
        .Build();
}

<page-header>
    <page-header-title><i class="fa-solid fa-gift me-2"></i>Grant programs</page-header-title>
    @if (Model.CanAdminister)
    {
        <a asp-action="New" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>New program</a>
    }
</page-header>

@if (Model.Programs.Count == 0)
{
    <empty-state>No programs yet.</empty-state>
}
else
{
    <partial name="_Table" model="table" />
}
