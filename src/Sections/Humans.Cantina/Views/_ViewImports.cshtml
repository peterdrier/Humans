@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — G5-SECTION-TEMPLATE.md
   step 3, from the split design's §2 (Views — Razor Class Library per section).
   Guarded by CantinaPageRenderTests (template step 12, render every page) — which lives in
   Humans.Integration.Tests and so never runs in CI. *@
@using Humans.Base.Extensions
@using Humans.Cantina
@using Humans.Cantina.Controllers
@using Humans.Cantina.Models
@using Humans.Cantina.Services.Dtos
@using Humans.Base.Constants
@using Humans.Users.Contracts
@using Humans.Base
@using Humans.Base.Models.Tables
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<CantinaResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Nothing in these views is a <vc:…>, but a section can only addTagHelper against
   Humans.Base — a Shell-resident component renders as inert literal markup (step 6). *@
@addTagHelper *, Humans.Base
