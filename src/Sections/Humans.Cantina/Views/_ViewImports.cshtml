@* A section RCL does NOT inherit the host's _ViewImports. Omitting a line here ships broken markup with a green build;
   CantinaPageRenderTests guards it, but only outside CI. *@
@using Humans.Base.Extensions
@using Humans.Cantina
@using Humans.Cantina.Controllers
@using Humans.Cantina.Domain
@using Humans.Cantina.Models
@using Humans.Cantina.Services.Dtos
@using Humans.Base.Constants
@using Humans.Users.Contracts
@using Humans.Base
@using Humans.Base.Models.Tables
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<CantinaResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* A Shell-resident component would render as inert markup: a section can only addTagHelper against Humans.Base and
   the sections it references. *@
@addTagHelper *, Humans.Base
@* <vc:audit-log> on the member's dietary page. *@
@addTagHelper *, Humans.AuditLog
