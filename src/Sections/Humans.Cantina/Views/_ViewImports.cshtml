@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by CantinaPageRenderTests (step 12). *@
@using Humans.Application.Extensions
@using Humans.Cantina
@using Humans.Cantina.Controllers
@using Humans.Cantina.Models
@using Humans.Cantina.Services.Dtos
@using Humans.Domain.Constants
@using Humans.Users.Contracts
@using Humans.UI
@using Humans.UI.Models.Tables
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<CantinaResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Nothing in these views is a <vc:…>, but a section can only addTagHelper against
   Humans.UI — a Shell-resident component renders as inert literal markup (step 6). *@
@addTagHelper *, Humans.Interfaces
