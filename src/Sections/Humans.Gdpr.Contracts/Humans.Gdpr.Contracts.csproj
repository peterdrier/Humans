<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gdpr's cross-section surface, carved into its own leaf project because this contract is
    implemented from outside: IUserDataContributor is the subject-rights fan-out seam that
    every service owning user-scoped tables must implement. A Contracts/ *folder* inside
    Humans.Gdpr would make all of those sections reference Humans.Gdpr itself — its internal
    orchestrator and its controller included — just to reach an interface. The leaf keeps the
    implementation invisible to its implementers
    (memory/architecture/section-project-cycle-fix.md).

    Everything here is named from outside:
      - IUserDataContributor + UserDataSlice — the contributor half, named by every
        service that implements it; each contributor declares its own section-name
        constants.
      - IGdprService + GdprExport — the orchestrator half, named by Users'
        ProfileController (the /Profile export download), Users' AccountDeletionService
        (the erasure cascade) and this section's own GuestDataController.

    References Humans.Base and nothing else — the bottom of the graph. IFanout and
    IOrchestrator live there (in the Humans.Base.Interfaces namespace, which is why the
    interface files here carry a using for it).
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
  </ItemGroup>

</Project>
