<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stays a leaf: folding into Humans.Teams would close a project cycle: Humans.Teams -> Humans.Auth -> Humans.Teams (also via Humans.Google). -->

  <!--
    It holds exactly what lives outside the section: the read surface every other section
    injects, the few members other sections call on the full service, the system-sync and
    seeding contracts, and the flat projections those signatures name
    (TeamMemberRole, RolePeriod, TeamJoinRequestStatus, SlotPriority, CallToAction).
    Everything else — the directory, detail, admin list, roster, join-request,
    role-management and early-entry DTOs — is internal to Humans.Teams.

    It references Base alone. Base references Humans.Users.Contracts, so nothing in that
    project may ever reference this one. Do not add Humans.Auth: nothing here names an Auth type, and the edge would pull
    Users and Onboarding into this leaf's chain.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
