<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Teams' cross-section surface, in its own leaf so that Base and other sections can
    reference it without referencing the section (a Contracts/ folder inside Humans.Teams
    would make Base reference a section and cycle — memory/architecture/section-project-cycle-fix.md).

    It holds exactly what lives outside the section: the read surface every other section
    injects, the few members other sections call on the full service, the system-sync,
    seeding and cache-invalidator contracts, and the flat projections those signatures name
    (TeamMemberRole, RolePeriod, TeamJoinRequestStatus, SlotPriority, CallToAction).
    Everything else — the directory, detail, admin list, roster, join-request,
    role-management and early-entry DTOs — is internal to Humans.Teams.

    Humans.Users.Contracts is referenced for GoogleEmailStatus alone. Base references
    Humans.Users.Contracts, so nothing in that project may ever reference this one. Do not
    add Humans.Auth.Contracts: nothing here names an Auth type, and the edge would pull
    Users and Onboarding into this leaf's chain.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
