@model IReadOnlyList<Humans.Campaigns.Contracts.CampaignGrantSummary>
@{
    var campaignCodesTable = TableModel.For(Model.OrderByDescending(g => g.AssignedAt).ToList())
        .Column("Campaign", g => g.CampaignTitle)
        .Column("Code", g => g.Code, o => o.Code())
        .Column("Assigned", g => g.AssignedAt, c => c.Date())
        .Build();
}
<div class="card mb-4">
    <div class="card-header"><h6 class="mb-0">Campaign Codes</h6></div>
    <div class="card-body p-0">
        <partial name="_Table" model="campaignCodesTable" />
    </div>
</div>
