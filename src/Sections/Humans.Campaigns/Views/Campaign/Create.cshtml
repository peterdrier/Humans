@{
    ViewData["Title"] = "New Campaign";
}

<h1>New Campaign</h1>


<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <partial name="_CampaignFormFields" model="@(new CampaignFormValues(
                ViewBag.Title2 as string, ViewBag.Description as string,
                ViewBag.EmailSubject as string, ViewBag.EmailBodyTemplate as string,
                ViewBag.ReplyToAddress as string))" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Campaign</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
