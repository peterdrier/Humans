@model CampaignFormValues

<div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input type="text" class="form-control" id="title" name="title" value="@Model.Title" required />
</div>

<div class="mb-3">
    <label for="description" class="form-label">Description</label>
    <markdown-editor name="description" id="description" value="@Model.Description" rows="3" />
</div>

@await Html.PartialAsync("_EmailComposer", new Humans.Base.Models.EmailComposerViewModel
{
    SubjectName = "emailSubject",
    SubjectValue = Model.EmailSubject,
    SubjectLabel = "Email Subject",
    SubjectRequired = true,
    BodyName = "emailBodyTemplate",
    BodyValue = Model.EmailBodyTemplate,
    BodyLabel = "Email Body Template",
    BodyRows = 10,
    BodyRequired = true,
    BodyHelpText = "You can use {{Code}} for the code and {{Name}} for the human's name in the subject or body.",
    Category = nameof(Humans.Users.Contracts.MessageCategory.CampaignCodes),
    RecipientSummary = "Each wave's recipients, chosen when you send it",
})

<div class="mb-3">
    <label for="replyToAddress" class="form-label">Reply-To Address <span class="text-muted">(optional)</span></label>
    <input type="email" class="form-control" id="replyToAddress" name="replyToAddress" value="@Model.ReplyToAddress" placeholder="e.g. tickets@nobodies.team">
    <small class="form-text text-muted">Recipients who reply to the campaign email will reach this address.</small>
</div>
