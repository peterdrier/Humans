@model CampaignEditSnapshot
@{
    ViewData["Title"] = "Edit Campaign";
    // A submitted form may intentionally clear persisted fields to null.
    var form = ViewData[nameof(CampaignFormValues)] as CampaignFormValues
        ?? new(Model.Title, Model.Description, Model.EmailSubject, Model.EmailBodyTemplate, Model.ReplyToAddress);
}

@section Crumbs {
    <a asp-action="Detail" asp-route-id="@Model.Id">@Model.Title</a>
    <span>Edit</span>
}

<h1>Edit Campaign</h1>


<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <partial name="_CampaignFormFields" model="@form" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
