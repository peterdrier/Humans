<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Search.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No Humans.Infrastructure reference: Search owns no tables, so there is no DbContext, no
      repository and no AddSectionDbContext call (G5-SECTION-TEMPLATE.md step 1 / the
      Data-and-DbContext steps are skipped wholesale). The orchestrator fans out over
      IUserServiceRead / ITeamServiceRead / ICampServiceRead / IShiftManagementService, all
      on their owners' contracts leaves, plus IEventServiceRead off the Events leaf.
      Scanner's, Cantina's, Mailer's and Onboarding's shape.
    -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <!-- The Events bucket. The leaf only — never the Humans.Events section project. -->
    <ProjectReference Include="..\Humans.Events.Contracts\Humans.Events.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Camps.Contracts\Humans.Camps.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Shifts.Contracts\Humans.Shifts.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <!--
      The Humans bucket renders Users' own <vc:user-search-result>
      (nobodies-collective/Humans#1062), and @addTagHelper only binds against an assembly the
      section references. An orchestrator referencing what it orchestrates is expected; only
      cycles are forbidden. Only Contracts-folder public surface and the view components the
      framework needs public are reachable through it (HUM0034) — Debug's widget-gallery
      fan-in has the same shape.
    -->
    <ProjectReference Include="..\Humans.Users\Humans.Users.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package here: those ship with no PackageVersion on purpose and would fail
      the build with NU1010 under Central Package Management. Everything the controller needs
      arrives through the framework reference Sdk.Razor already adds (design §15 step 1).
      No EF Core either — the section owns no tables.
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
