@* A section RCL does not inherit the host's _ViewImports; a missing line here ships broken
   markup on a green build. Two localizers: the section's own keys, plus SharedResource for
   Search_MinChars, which /Profile/Search renders too. One @addTagHelper per publishing
   section — drop one and that bucket renders as inert literal markup
   (ViewComponentTagHelperBindingTests, GlobalSearchSectionRenderTests). *@
@using Humans.Search
@using Humans.Search.Models
@using Humans.Search.Services.Dtos
@using Humans.Base
@using Humans.Base.Extensions
@using Humans.Users.Contracts
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SearchResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@addTagHelper *, Humans.Users
@addTagHelper *, Humans.Teams
@addTagHelper *, Humans.Camps
@addTagHelper *, Humans.Shifts
@addTagHelper *, Humans.Events
