@* A section RCL does not inherit the host's _ViewImports; a missing line here ships broken
   markup on a green build. Result rows are invoked by Type, so no publisher's tag helpers are imported. *@
@using Humans.Search
@using Humans.Search.Models
@using Humans.Search.Services.Dtos
@using Humans.Base
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SearchResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
