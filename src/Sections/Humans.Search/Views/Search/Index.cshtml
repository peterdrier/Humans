@using System.Globalization
@using Microsoft.AspNetCore.Html
@model GlobalSearchViewModel

@{
    ViewData["Title"] = Localizer["Search_GlobalTitle"].Value;

    string ChipUrl(string? filter)
    {
        var q = Model.Query ?? string.Empty;
        return filter is not null
            ? Url.Action("Index", "Search", new { q, filter })!
            : Url.Action("Index", "Search", new { q })!;
    }

    string ChipClass(string? filter) =>
        string.Equals(Model.Filter, filter, StringComparison.Ordinal)
            ? "btn btn-primary btn-sm"
            : "btn btn-outline-primary btn-sm";

    bool ShowSection(SearchBucket bucket) =>
        bucket.Hits.Count > 0 && (Model.Filter is null || string.Equals(Model.Filter, bucket.Key, StringComparison.Ordinal));
}

<page-header>
    <page-header-title><i class="fa-solid fa-magnifying-glass me-2"></i>@Localizer["Search_GlobalTitle"]</page-header-title>
</page-header>

<form method="get" class="mb-4" asp-action="Index" asp-controller="Search">
    @if (Model.Filter is not null)
    {
        <input type="hidden" name="filter" value="@Model.Filter" />
    }
    <div class="input-group mw-600">
        <input type="text" name="q" class="form-control" value="@Model.Query"
               placeholder="@Localizer["Search_GlobalPlaceholder"]"
               autofocus aria-label="@Localizer["Search_QueryAriaLabel"]" />
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass me-1"></i>@Localizer["Search_GlobalTitle"]
        </button>
    </div>
</form>

@if (!Model.HasQuery)
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info me-2"></i>
        @Localizer["Search_GlobalHint", string.Join(", ", Model.Buckets.Select(b => b.Label))]
    </div>
}
else if (Model.QueryIsTooShort)
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info me-2"></i>
        @Localizer["Search_MinChars"]
    </div>
}
else if (Model.SearchFailed)
{
    <div class="alert alert-warning" role="alert">
        @Localizer["Search_Unavailable"]
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="@Localizer["Search_FilterAriaLabel"]">
        <a href="@ChipUrl(null)" class="@ChipClass(null)">
            @Localizer["Search_FilterAll"] (@Model.TotalCount)
        </a>
        @foreach (var bucket in Model.Buckets)
        {
            <a href="@ChipUrl(bucket.Key)" class="@ChipClass(bucket.Key)">
                <i class="@bucket.IconCssClass me-1"></i>@bucket.Label (@bucket.Hits.Count)
            </a>
        }
    </div>

    @if (!Model.HasResults)
    {
        <div class="alert alert-light">
            @{
                // AppendFormat HTML-encodes every arg that isn't already IHtmlContent.
                var noResults = new HtmlContentBuilder().AppendFormat(
                    Localizer["Search_GlobalNoResults"].Value,
                    new HtmlString($"<strong>{Html.Encode(Model.Query)}</strong>"));
            }
            @noResults
        </div>
    }
    else
    {
        @* Every row is the owning section's own view component, bound from the SearchHit. *@
        @foreach (var bucket in Model.Buckets.Where(ShowSection))
        {
            <h3 class="h5 mt-4 mb-2"><i class="@bucket.IconCssClass me-2"></i>@bucket.Label</h3>
            <div class="list-group">
                @foreach (var hit in bucket.Hits)
                {
                    @await Component.InvokeAsync(bucket.ResultComponent, hit)
                }
            </div>
        }
    }
}
