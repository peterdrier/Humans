@* One type-grouped section (teams/camps/shifts/events) of global search. Every row is the
   owning section's own view component, invoked with the key this orchestrator holds — no
   Title/Subtitle/Url is projected here any more (nobodies-collective/Humans#1062). Each
   element binds only through Search's _ViewImports @addTagHelper lines; drop one and that
   bucket ships as inert literal markup on a green 200. *@
@model IReadOnlyList<GlobalSearchResult>

<div class="list-group">
    @foreach (var result in Model)
    {
        switch (result.Type)
        {
            case SearchResultType.Team:
                <vc:teams-search-result team-id="@result.Key" />
                break;
            case SearchResultType.Camp:
                <vc:camps-search-result camp-id="@result.Key" />
                break;
            case SearchResultType.Shift:
                <vc:shifts-search-result rota-id="@result.Key" />
                break;
            case SearchResultType.Event:
                <vc:events-search-result event-id="@result.Key" />
                break;
        }
    }
</div>
