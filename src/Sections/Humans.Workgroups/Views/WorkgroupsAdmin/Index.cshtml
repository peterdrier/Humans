@model AdminQueueViewModel
@{
    ViewData["Title"] = "Workgroups";

    Func<WorkgroupInfo, IHtmlContent> nameCell =
        @<text><a asp-controller="Workgroups" asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a></text>;
    Func<WorkgroupInfo, IHtmlContent> coordinatorsCell =
        @<text>@await Html.PartialAsync("_WorkgroupCoordinators", item)</text>;
    Func<WorkgroupInfo, IHtmlContent> registerCell = @<text>
        <form method="post" asp-action="Register" asp-route-id="@item.Id">
            <button type="submit" class="btn btn-sm btn-success">Register</button>
        </form>
    </text>;
    var pendingTable = TableModel.For(Model.Pending.ToList())
        .Template("Name", nameCell, sortBy: w => w.Name)
        .Template("Coordinators", coordinatorsCell)
        .Column("Applied", w => w.AppliedAt, o => o.Date())
        .Column("Days waiting", w => (Model.Now - w.AppliedAt).Days, o => o.Number())
        .Column("Status", w => w.Status)
        .Template("", registerCell, o => o.NoSort().Css("text-end"))
        .RowCss(w => w.IsRegistrationOverdue(Model.Now) ? "table-danger" : null)
        .Css("align-middle")
        .Build();

    Func<Tuple<WorkgroupInfo, WorkgroupDocumentInfo>, IHtmlContent> groupCell =
        @<text><a asp-controller="Workgroups" asp-action="Details" asp-route-slug="@item.Item1.Slug">@item.Item1.Name</a></text>;
    Func<Tuple<WorkgroupInfo, WorkgroupDocumentInfo>, IHtmlContent> documentCell =
        @<text><a asp-controller="Workgroups" asp-action="Document" asp-route-slug="@item.Item1.Slug" asp-route-id="@item.Item2.Id">@item.Item2.Title</a></text>;
    Func<Tuple<WorkgroupInfo, WorkgroupDocumentInfo>, IHtmlContent> dispositionCell =
        @<text><a asp-controller="Workgroups" asp-action="Document" asp-route-slug="@item.Item1.Slug" asp-route-id="@item.Item2.Id" class="btn btn-sm btn-outline-primary">Record disposition</a></text>;
    var awaitingTable = TableModel.For(Model.AwaitingDisposition.Select(x => Tuple.Create(x.Workgroup, x.Document)).ToList())
        .Template("Group", groupCell, sortBy: x => x.Item1.Name)
        .Template("Document", documentCell, sortBy: x => x.Item2.Title)
        .Column("Delivered", x => x.Item2.DeliveredAt, o => o.Date())
        .Template("", dispositionCell, o => o.NoSort().Css("text-end"))
        .RowCss(x => x.Item1.HasOverdueDisposition(Model.Now) ? "table-warning" : null)
        .Css("align-middle")
        .Build();

    Func<WorkgroupInfo, IHtmlContent> flagsCell = @<text>
        @if (item.IsUpdateDue(Model.Now))
        {
            <span class="badge bg-warning text-dark">Update due</span>
        }
    </text>;
    var activeTable = TableModel.For(Model.Active.ToList())
        .Template("Name", nameCell, sortBy: w => w.Name)
        .Template("Coordinators", coordinatorsCell)
        .Column("Budget", w => w.BudgetAmount, o => o.Currency())
        .Column("Holded account", w => w.HoldedAccountNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture))
        .Template("Flags", flagsCell)
        .Css("align-middle")
        .Build();

    var dormantTable = TableModel.For(Model.Register.Where(w => w.Status == WorkgroupStatus.Dormant).ToList())
        .Template("Name", nameCell, sortBy: w => w.Name)
        .Column("Reason", w => w.DormantReason)
        .Column("Ended", w => w.EndedAt, o => o.Date())
        .Css("align-middle")
        .Build();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Workgroups</h1>
    <div class="d-flex gap-2">
        <a asp-action="RegisterExisting" class="btn btn-outline-secondary btn-sm">Register an existing group</a>
        <a asp-action="Settings" class="btn btn-outline-secondary btn-sm">Settings</a>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (string.IsNullOrWhiteSpace(Model.RootDriveFolderId))
{
    <div class="alert alert-warning">
        No root Drive folder configured. Registration is refused until one is set on
        <a asp-action="Settings">Settings</a>.
    </div>
}

<h2 class="h5 mt-4">Pending applications</h2>
@{ var pending = Model.Pending.ToList(); }
@if (pending.Count == 0)
{
    <p class="text-muted">Nothing waiting on the Secretary.</p>
}
else
{
    <partial name="_Table" model="pendingTable" />
}

<h2 class="h5 mt-4">Awaiting disposition</h2>
@{ var awaiting = Model.AwaitingDisposition.ToList(); }
@if (awaiting.Count == 0)
{
    <p class="text-muted">Nothing delivered is waiting on a Board reply.</p>
}
else
{
    <partial name="_Table" model="awaitingTable" />
}

<h2 class="h5 mt-4">Active groups</h2>
@{
    var active = Model.Active.ToList();
}
@if (active.Count == 0)
{
    <p class="text-muted">No active groups.</p>
}
else
{
    <partial name="_Table" model="activeTable" />
}

<h2 class="h5 mt-4">Archive</h2>
@{ var dormant = Model.Register.Where(w => w.Status == WorkgroupStatus.Dormant).ToList(); }
@if (dormant.Count == 0)
{
    <p class="text-muted">No dormant groups.</p>
}
else
{
    <partial name="_Table" model="dormantTable" />
}
