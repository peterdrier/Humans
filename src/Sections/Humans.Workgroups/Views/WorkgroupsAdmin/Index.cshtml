@model AdminQueueViewModel
@{
    ViewData["Title"] = "Workgroups";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Workgroups</h1>
    <div class="d-flex gap-2">
        <a asp-action="RegisterExisting" class="btn btn-outline-secondary btn-sm">Register an existing group</a>
        <a asp-action="Settings" class="btn btn-outline-secondary btn-sm">Settings</a>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(Model.RootDriveFolderId))
{
    <div class="alert alert-warning">
        No root Drive folder configured. Registration is refused until one is set on
        <a asp-action="Settings">Settings</a>.
    </div>
}

<h2 class="h5 mt-4">Pending applications</h2>
@{ var pending = Model.Pending.ToList(); }
@if (pending.Count == 0)
{
    <p class="text-muted">Nothing waiting on the Secretary.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Applied</th>
                    <th>Days waiting</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in pending)
                {
                    var days = (Model.Now - w.AppliedAt).Days;
                    <tr class="@(w.IsRegistrationOverdue(Model.Now) ? "table-danger" : "")">
                        <td><a asp-controller="Workgroups" asp-action="Details" asp-route-slug="@w.Slug">@w.Name</a></td>
                        <td>@w.AppliedAt.ToDate()</td>
                        <td>@days</td>
                        <td>@w.Status</td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end flex-wrap">
                                <form method="post" asp-action="Register" asp-route-id="@w.Id">
                                    <button type="submit" class="btn btn-sm btn-success">Register</button>
                                </form>
                                @if (w.Status == WorkgroupStatus.Applied)
                                {
                                    <form method="post" asp-action="Refer" asp-route-id="@w.Id" class="d-flex gap-1">
                                        <input name="note" class="form-control form-control-sm" placeholder="Note (optional)" style="min-width: 10rem;" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Refer</button>
                                    </form>
                                }
                                <form method="post" asp-action="Refuse" asp-route-id="@w.Id" class="d-flex gap-1">
                                    <input name="reasons" class="form-control form-control-sm" placeholder="Reasons" required style="min-width: 10rem;" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Refuse</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Awaiting disposition</h2>
@{ var awaiting = Model.AwaitingDisposition.ToList(); }
@if (awaiting.Count == 0)
{
    <p class="text-muted">Nothing delivered is waiting on a Board reply.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Document</th>
                    <th>Delivered</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (w, doc) in awaiting)
                {
                    <tr class="@(w.HasOverdueDisposition(Model.Now) ? "table-warning" : "")">
                        <td>@w.Name</td>
                        <td><a asp-controller="Workgroups" asp-action="Document" asp-route-slug="@w.Slug" asp-route-id="@doc.Id">@doc.Title</a></td>
                        <td>@doc.DeliveredAt?.ToDate()</td>
                        <td class="text-end">
                            <a asp-controller="Workgroups" asp-action="Document" asp-route-slug="@w.Slug" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary">Record disposition</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Active groups</h2>
@{
    var active = Model.Active.ToList();
    var dormancyFlagged = Model.DormancyFlagged.Select(w => w.Id).ToHashSet();
    var annualDue = Model.AnnualReportDue.Select(w => w.Id).ToHashSet();
    var statusOverdue = Model.StatusOverdue.Select(w => w.Id).ToHashSet();
}
@if (active.Count == 0)
{
    <p class="text-muted">No active groups.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Coordinators</th>
                    <th>Flags</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in active)
                {
                    <tr>
                        <td><a asp-controller="Workgroups" asp-action="Details" asp-route-slug="@w.Slug">@w.Name</a></td>
                        <td>@string.Join(", ", w.CoordinatorUserIds().Select(id => Model.DisplayName(id)))</td>
                        <td>
                            @if (dormancyFlagged.Contains(w.Id))
                            {
                                <span class="badge bg-secondary">Quiet since @w.DormantSince?.ToDate()</span>
                            }
                            @if (w.IsCloseCandidate(Model.Now))
                            {
                                <span class="badge bg-danger">Close candidate</span>
                            }
                            @if (annualDue.Contains(w.Id))
                            {
                                <span class="badge bg-warning text-dark">Annual report due</span>
                            }
                            @if (statusOverdue.Contains(w.Id))
                            {
                                <span class="badge bg-danger">Status overdue</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end flex-wrap">
                                @if (w.IsCloseCandidate(Model.Now) || dormancyFlagged.Contains(w.Id))
                                {
                                    <form method="post" asp-action="Close" asp-route-id="@w.Id" class="d-flex gap-1">
                                        <input name="reasons" class="form-control form-control-sm" placeholder="Reasons" required style="min-width: 10rem;" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Close</button>
                                    </form>
                                }
                                <form method="post" asp-action="Withdraw" asp-route-id="@w.Id" class="d-flex gap-1">
                                    <input name="reasons" class="form-control form-control-sm" placeholder="Reasons" required style="min-width: 10rem;" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Withdraw</button>
                                </form>
                                @{ var wc = w.CoordinatorUserIds().ToList(); }
                                <form method="post" asp-action="Coordinators" asp-route-id="@w.Id" class="d-flex gap-1" title="Override coordinators">
                                    @for (var slot = 0; slot < 2; slot++)
                                    {
                                        <select name="coordinatorUserIds" class="form-select form-select-sm">
                                            <option value="">—</option>
                                            @foreach (var member in w.CurrentMembers())
                                            {
                                                <option value="@member.UserId" selected="@(wc.Count > slot && wc[slot] == member.UserId)">@(Model.People.GetValueOrDefault(member.UserId)?.BurnerName ?? "—")</option>
                                            }
                                        </select>
                                    }
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Archive</h2>
@{ var dormant = Model.Register.Where(w => w.Status == WorkgroupStatus.Dormant).ToList(); }
@if (dormant.Count == 0)
{
    <p class="text-muted">No dormant groups.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Reason</th>
                    <th>Ended</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in dormant)
                {
                    <tr>
                        <td><a asp-controller="Workgroups" asp-action="Details" asp-route-slug="@w.Slug">@w.Name</a></td>
                        <td>@w.DormantReason</td>
                        <td>@w.EndedAt?.ToDate()</td>
                        <td class="text-end">
                            <form method="post" asp-action="Reactivate" asp-route-id="@w.Id">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Reactivate</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
