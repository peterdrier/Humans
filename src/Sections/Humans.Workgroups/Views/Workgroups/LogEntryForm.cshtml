@model LogEntryFormViewModel
@{
    ViewData["Title"] = Localizer[Model.Id is null ? "Workgroups_LogEntryNewTitle" : "Workgroups_LogEntryEditTitle"];
    var kinds = new[] { WorkgroupLogKind.Update, WorkgroupLogKind.Disclosure, WorkgroupLogKind.Note };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Workgroups_Title"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-slug="@Model.Slug">@Model.Slug</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<h1>@ViewData["Title"]</h1>

<div class="card" style="max-width: 720px;">
    <div class="card-body">
        <form method="post" asp-action="SaveLogEntry" asp-route-slug="@Model.Slug">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Slug" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Kind" class="form-label">@Localizer["Workgroups_Field_LogKind"]</label>
                <select asp-for="Kind" class="form-select">
                    @foreach (var kind in kinds)
                    {
                        <option value="@kind" selected="@(kind == Model.Kind ? "selected" : null)">@Localizer.EnumDisplay(kind)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="OccurredOn" class="form-label">@Localizer["Workgroups_Field_OccurredOn"]</label>
                <input asp-for="OccurredOn" type="date" class="form-control" />
                <span asp-validation-for="OccurredOn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">@Localizer["Workgroups_Field_LogTitle"]</label>
                <input asp-for="Title" class="form-control" maxlength="200" />
            </div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label">@Localizer["Workgroups_Field_LogBody"]</label>
                <markdown-editor asp-for="Body" rows="8" />
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@SharedLocalizer["Common_Save"]</button>
                <a asp-action="Details" asp-route-slug="@Model.Slug" class="btn btn-outline-secondary">@SharedLocalizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
