@model RegisterViewModel
@{
    ViewData["Title"] = Localizer["Workgroups_Title"];

    Func<WorkgroupInfo, IHtmlContent> nameCell =
        @<text><a asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a></text>;
    Func<WorkgroupInfo, IHtmlContent> coordinatorsCell =
        @<text>@await Html.PartialAsync("_WorkgroupCoordinators", item)</text>;
    Func<WorkgroupInfo, IHtmlContent> pendingStatusCell = @<text>
        <status-badge value="@item.Status" localizer="@Localizer" />
        @if (item.IsRegistrationOverdue(Model.Now))
        {
            <span class="badge bg-danger ms-1">@Localizer["Workgroups_RegistrationOverdue"]</span>
        }
    </text>;
    var pendingTable = TableModel.For(Model.Pending)
        .Template(SharedLocalizer["Common_General"], nameCell, sortBy: w => w.Name)
        .Template(Localizer["Workgroups_Coordinators"], coordinatorsCell)
        .Template(SharedLocalizer["Common_Status"], pendingStatusCell)
        .Column(Localizer["Workgroups_AppliedOn"], w => w.AppliedAt, o => o.Date())
        .Css("align-middle")
        .Build();

    Func<WorkgroupInfo, IHtmlContent> archiveStatusCell = @<text>
        <status-badge value="@item.Status" localizer="@Localizer" />
        @if (item.Status == WorkgroupStatus.Dormant && item.DormantReason is { } reason)
        {
            <span class="text-muted small ms-1">(@Localizer.EnumDisplay(reason))</span>
        }
    </text>;
    var archiveTable = TableModel.For(Model.Archive)
        .Template(SharedLocalizer["Common_General"], nameCell, sortBy: w => w.Name)
        .Template(SharedLocalizer["Common_Status"], archiveStatusCell)
        .Column(Localizer["Workgroups_Reasons"], w => w.Reasons, o => o.Css("small text-muted"))
        .Column(Localizer["Workgroups_Ended"], w => w.EndedAt, o => o.Date())
        .Css("align-middle")
        .Build();

}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0"><i class="fa-solid fa-people-group me-2"></i>@Localizer["Workgroups_Title"]</h1>
    <a asp-action="Apply" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i>@Localizer["Workgroups_Apply"]
    </a>
</div>

<p class="text-muted">@Localizer["Workgroups_Intro"]</p>

<h2 class="h4 mt-4">@Localizer["Workgroups_Active"] <span class="badge bg-secondary">@Model.Active.Count</span></h2>
@if (Model.Active.Count == 0)
{
    <empty-state>@Localizer["Workgroups_NoActive"]</empty-state>
}
else
{
    <div class="d-grid gap-3 mb-4">
        @foreach (var w in Model.Active)
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <a asp-action="Details" asp-route-slug="@w.Slug" class="h5 text-decoration-none">@w.Name</a>
                            <div class="small text-muted">@Localizer["Workgroups_CoordinatedBy"] @await Html.PartialAsync("_WorkgroupCoordinators", w)</div>
                        </div>
                        <div class="text-end">
                            @if (w.IsSensitive)
                            {
                                <span class="badge bg-dark"><i class="fa-solid fa-lock me-1"></i>@Localizer["Workgroups_Sensitive"]</span>
                            }
                            @if (!w.IsSensitive || w.IsMember(Model.CurrentUserId))
                            {
                                @if (w.IsOpenForComment(Model.Now))
                                {
                                    <span class="badge bg-primary">@Localizer["Workgroups_OpenForComment"]</span>
                                }
                                @if (w.IsUpdateDue(Model.Now))
                                {
                                    <span class="badge bg-warning text-dark">@Localizer["Workgroups_UpdateDue"]</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="mt-2">@Localizer["Workgroups_DeliverableSentence", w.TargetDate?.ToDate() ?? Localizer["Workgroups_NoTargetDate"].Value, w.Deliverable, Localizer.EnumDisplay(w.Audience)]</div>
                </div>
            </div>
        }
    </div>
}

<h2 class="h4 mt-4">@Localizer["Workgroups_Pending"] <span class="badge bg-secondary">@Model.Pending.Count</span></h2>
@if (Model.Pending.Count == 0)
{
    <empty-state>@Localizer["Workgroups_NoPending"]</empty-state>
}
else
{
    <partial name="_Table" model="pendingTable" />
}

<h2 class="h4 mt-4">@Localizer["Workgroups_Archive"] <span class="badge bg-secondary">@Model.Archive.Count</span></h2>
@if (Model.Archive.Count == 0)
{
    <empty-state>@Localizer["Workgroups_NoArchive"]</empty-state>
}
else
{
    <partial name="_Table" model="archiveTable" />
}
