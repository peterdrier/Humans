@model DocumentFormViewModel
@{
    ViewData["Title"] = Localizer[Model.Id is null ? "Workgroups_DocumentNewTitle" : "Workgroups_DocumentEditTitle"];
}

@section Crumbs {
    <a asp-action="Index">@Localizer["Workgroups_Title"]</a>
    <a asp-action="Details" asp-route-slug="@Model.Slug">@Model.Slug</a>
    <span>@ViewData["Title"]</span>
}

<page-header title="@(ViewData["Title"]?.ToString())" />

<div class="card" style="max-width: 900px;">
    <div class="card-body">
        <form method="post" asp-action="SaveDocument" asp-route-slug="@Model.Slug">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Slug" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">@Localizer["Workgroups_Field_DocumentTitle"]</label>
                <input asp-for="Title" class="form-control" maxlength="200" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Kind" class="form-label">@Localizer["Workgroups_Field_DocumentKind"]</label>
                <select asp-for="Kind" class="form-select" asp-items="@Localizer.EnumSelectItems<WorkgroupDocumentKind>()"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label">@Localizer["Workgroups_Field_DocumentBody"]</label>
                <markdown-editor asp-for="Body" rows="12" />
                <div class="form-text">@Localizer["Workgroups_Field_DocumentBodyHelp"]</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@SharedLocalizer["Common_Save"]</button>
                <a asp-action="Details" asp-route-slug="@Model.Slug" class="btn btn-outline-secondary">@SharedLocalizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
