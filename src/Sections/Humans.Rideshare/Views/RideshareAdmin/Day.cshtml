@model DayViewModel
@{
    ViewData["Title"] = $"Rideshare day roster {Model.Date.ToInvariantDate()}";
}

<h1>Day roster <small class="text-muted">@Model.Date.ToWeekdayDayMonth()</small></h1>
<p class="text-muted">Every ride happening on this day — including full and cancelled ones — with its accepted riders.</p>

<form method="get" asp-action="Day" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="day-date" class="form-label">Date</label>
        <input id="day-date" type="date" name="date" class="form-control" value="@Model.Date.ToInvariantDate()" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Show</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Settings &amp; stats</a>
    </div>
</form>

@if (Model.Trips.Count == 0)
{
    <empty-state>No rides on this day.</empty-state>
}
else
{
        Func<DayRosterRow, IHtmlContent> tripCell0 = @<text>@item.Trip.Direction</text>;
        Func<DayRosterRow, IHtmlContent> tripCell1 = @<text>@item.Trip.MemberPlaceLabel</text>;
        Func<DayRosterRow, IHtmlContent> tripCell2 = @<text>@item.Trip.DepartureDate.ToInvariantDate() (@item.Trip.ExpectedDurationDays d)</text>;
        Func<DayRosterRow, IHtmlContent> tripCell4 = @<text><vc:human user-id="@item.Trip.UserId" layout="AvatarName" link="Admin" /></text>;
        Func<DayRosterRow, IHtmlContent> tripCell5 = @<text>@(item.Trip.SeatsOffered - item.Trip.SeatsRemaining) / @item.Trip.SeatsOffered</text>;
        Func<DayRosterRow, IHtmlContent> tripCell6 = @<text>
            @if (item.Riders.Count == 0)
            {
                <span class="text-muted">—</span>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var rider in item.Riders)
                    {
                        <li><vc:human user-id="@rider.UserId" link="Admin" /> <span class="text-muted">× @rider.Seats</span></li>
                    }
                </ul>
            }

        </text>;
        var tripsTable = TableModel.For(Model.Trips)
            .Template("Direction", tripCell0)
            .Template("From / to", tripCell1)
            .Template("Departs", tripCell2, sortBy: r => r.Trip.DepartureDate)
            .Column("Status", r => r.Trip.Status, o => o.EnumBadge())
            .Template("Driver", tripCell4)
            .Template("Seats", tripCell5, sortBy: r => r.Trip.SeatsOffered - r.Trip.SeatsRemaining)
            .Template("Accepted riders", tripCell6, sortBy: r => r.Riders.Count)
            .Css("align-middle")
            .Build();
    <partial name="_Table" model="tripsTable" />
}
