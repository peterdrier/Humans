@model OfferFormViewModel
@{
    ViewData["Title"] = Localizer[Model.IsEdit ? "Rideshare_OfferTitle_Edit" : "Rideshare_OfferTitle_New"];
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.20.1/dist/maplibre-gl.css" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Rideshare_Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<h1>@ViewData["Title"]</h1>
@if (!Model.IsEdit)
{
    <p class="text-muted">@Localizer["Rideshare_OfferIntro"]</p>
}

<div class="card" style="max-width: 760px;">
    <div class="card-body">
        <form method="post" asp-action="Offer">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Direction" class="form-label">@Localizer["Rideshare_Field_Direction"]</label>
                <select asp-for="Direction" class="form-select" asp-items="@Localizer.EnumSelectItems<RideshareDirection>()"></select>
            </div>

            <div class="mb-3">
                <label asp-for="MemberPlaceLabel" class="form-label">@Localizer["Rideshare_Field_Place"]</label>
                <input asp-for="MemberPlaceLabel" class="form-control" maxlength="200" />
                <div class="form-text">@Localizer["Rideshare_Field_PlaceHelp"]</div>
                <span asp-validation-for="MemberPlaceLabel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-text mb-1">@Localizer["Rideshare_PickOnMap"]</div>
                <div id="pick-map" class="rounded border" style="height: 280px;"
                     data-lat-input="Latitude" data-lng-input="Longitude" data-place-input="MemberPlaceLabel"></div>
                <div class="row g-2 mt-1">
                    <div class="col-6 col-md-4">
                        <label asp-for="Latitude" class="form-label small">@Localizer["Rideshare_Field_Latitude"]</label>
                        <input asp-for="Latitude" class="form-control form-control-sm" type="number" step="any" min="-90" max="90" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label asp-for="Longitude" class="form-label small">@Localizer["Rideshare_Field_Longitude"]</label>
                        <input asp-for="Longitude" class="form-control form-control-sm" type="number" step="any" min="-180" max="180" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="WaypointLabels" class="form-label">@Localizer["Rideshare_Field_Waypoints"]</label>
                <textarea asp-for="WaypointLabels" class="form-control" rows="3" maxlength="2000"></textarea>
                <div class="form-text">@Localizer["Rideshare_Field_WaypointsHelp"]</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="DepartureDate" class="form-label">@Localizer["Rideshare_Field_DepartureDate"]</label>
                    <input asp-for="DepartureDate" type="date" class="form-control" />
                    <span asp-validation-for="DepartureDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpectedDurationDays" class="form-label">@Localizer["Rideshare_Field_DurationDays"]</label>
                    <input asp-for="ExpectedDurationDays" type="number" min="1" max="30" class="form-control" />
                    <span asp-validation-for="ExpectedDurationDays" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SeatsOffered" class="form-label">@Localizer["Rideshare_Field_SeatsOffered"]</label>
                    <input asp-for="SeatsOffered" type="number" min="1" max="20" class="form-control" />
                    <span asp-validation-for="SeatsOffered" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="OvernightPlan" class="form-label">@Localizer["Rideshare_Field_OvernightPlan"]</label>
                <textarea asp-for="OvernightPlan" class="form-control" rows="2" maxlength="1000"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="VehicleType" class="form-label">@Localizer["Rideshare_Field_VehicleType"]</label>
                    <select asp-for="VehicleType" class="form-select" asp-items="@Localizer.EnumSelectItems<VehicleType>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="LuggageCapacity" class="form-label">@Localizer["Rideshare_Field_LuggageCapacity"]</label>
                    <select asp-for="LuggageCapacity" class="form-select" asp-items="@Localizer.EnumSelectItems<LuggageSize>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="CostSharing" class="form-label">@Localizer["Rideshare_Field_CostSharing"]</label>
                    <select asp-for="CostSharing" class="form-select" asp-items="@Localizer.EnumSelectItems<CostSharing>()"></select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CapacityNote" class="form-label">@Localizer["Rideshare_Field_CapacityNote"]</label>
                <input asp-for="CapacityNote" class="form-control" maxlength="500" />
            </div>

            <div class="mb-3">
                <label asp-for="CostNote" class="form-label">@Localizer["Rideshare_Field_CostNote"]</label>
                <input asp-for="CostNote" class="form-control" maxlength="500" />
            </div>

            <div class="mb-3">
                <label asp-for="Restrictions" class="form-label">@Localizer["Rideshare_Field_Restrictions"]</label>
                <input asp-for="Restrictions" class="form-control" maxlength="500" />
                <div class="form-text">@Localizer["Rideshare_Field_RestrictionsHelp"]</div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="WillingToDetour" class="form-check-input" />
                <label asp-for="WillingToDetour" class="form-check-label">@Localizer["Rideshare_Field_WillingToDetour"]</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Rideshare_Save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Rideshare_BackToBoard"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/maplibre-gl@5.20.1/dist/maplibre-gl.js"></script>
    <script type="module" src="~/_content/Humans.Rideshare/js/rideshare/pick-point.js" asp-append-version="true"></script>
}
