@model SurveyAdminIndexViewModel

@{
    ViewData["Title"] = Localizer["Survey_Admin_Index_Title"].Value;

    string StatusBadge(SurveyStatus s) => s switch
    {
        SurveyStatus.Open => "bg-success",
        SurveyStatus.Closed => "bg-secondary",
        SurveyStatus.PendingApproval => "bg-info text-dark",
        _ => "bg-warning text-dark",
    };
}

@if (Model.IsBoardOrAdmin)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Localizer["Survey_Admin_Index_Title"]</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Localizer["Survey_Admin_Index_Title"]</h1>
    <a asp-controller="SurveyAdmin" asp-action="Create" class="btn btn-primary btn-sm">@Localizer["Survey_Admin_Index_New"]</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@Localizer["Survey_Admin_Index_ColumnTitle"]</th>
                    @if (Model.IsBoardOrAdmin)
                    {
                        <th>@Localizer["Survey_Admin_Index_ColumnAuthor"]</th>
                    }
                    <th>@Localizer["Survey_Admin_Index_ColumnStatus"]</th>
                    <th class="text-end">@Localizer["Survey_Admin_Index_ColumnInvited"]</th>
                    <th class="text-end">@Localizer["Survey_Admin_Index_ColumnResponses"]</th>
                    <th class="text-end">@Localizer["Survey_Admin_Index_ColumnRate"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Surveys.Count == 0)
                {
                    <tr><td colspan="@(Model.IsBoardOrAdmin ? 7 : 6)" class="text-center text-muted py-4">@Localizer["Survey_Admin_Index_Empty"]</td></tr>
                }
                @foreach (var s in Model.Surveys)
                {
                    var rate = s.InvitedCount > 0 ? (int)Math.Round(100.0 * s.ResponseCount / s.InvitedCount) : 0;
                    var canViewResults = Model.IsBoardOrAdmin || s.Status == SurveyStatus.Closed;
                    <tr>
                        <td>
                            <a asp-controller="SurveyAdmin" asp-action="Edit" asp-route-id="@s.Id">
                                @(string.IsNullOrWhiteSpace(s.Title) ? Localizer["Survey_Admin_Index_Untitled"].Value : s.Title)
                            </a>
                            @if (s.Status == SurveyStatus.Draft && !string.IsNullOrWhiteSpace(s.RejectionNote))
                            {
                                <div class="small text-danger">@string.Format(Localizer["Survey_Admin_Index_RejectionNote"].Value, s.RejectionNote)</div>
                            }
                        </td>
                        @if (Model.IsBoardOrAdmin)
                        {
                            <td class="small text-muted">@s.CreatedByUserId</td>
                        }
                        <td>
                            @if (s.Status == SurveyStatus.Open && Model.IsBoardOrAdmin)
                            {
                                <a asp-controller="SurveyAdmin" asp-action="Official" asp-route-id="@s.Id"
                                   class="badge @StatusBadge(s.Status) text-decoration-none"
                                   title="Open the official survey link">@Localizer.EnumDisplay(s.Status)</a>
                            }
                            else
                            {
                                <span class="badge @StatusBadge(s.Status)">@Localizer.EnumDisplay(s.Status)</span>
                            }
                        </td>
                        <td class="text-end">@s.InvitedCount</td>
                        <td class="text-end">@s.ResponseCount</td>
                        <td class="text-end">@(s.InvitedCount > 0 ? $"{rate}%" : "—")</td>
                        <td class="text-end">
                            @if (Model.IsBoardOrAdmin)
                            {
                                <partial name="_SurveyPreviewMenu" model="@s.Id" />
                            }
                            <a asp-controller="SurveyAdmin" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm">@Localizer["Survey_Admin_Index_Edit"]</a>
                            @if (s.Status == SurveyStatus.Draft)
                            {
                                <form asp-controller="SurveyAdmin" asp-action="Submit" asp-route-id="@s.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success btn-sm">@Localizer["Survey_Admin_Index_SubmitForApproval"]</button>
                                </form>
                            }
                            @if (Model.IsBoardOrAdmin)
                            {
                                <a asp-controller="SurveyAdmin" asp-action="Send" asp-route-id="@s.Id" class="btn btn-outline-secondary btn-sm">@Localizer["Survey_Admin_Index_Send"]</a>
                            }
                            @if (canViewResults)
                            {
                                <a asp-controller="SurveyAdmin" asp-action="Results" asp-route-id="@s.Id" class="btn btn-outline-secondary btn-sm">@Localizer["Survey_Admin_Index_Results"]</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
