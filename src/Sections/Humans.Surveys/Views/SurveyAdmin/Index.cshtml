@model SurveyAdminIndexViewModel
@using Humans.Base.Models.Tables

@{
    ViewData["Title"] = Localizer["Surveys_Admin_Index_Title"].Value;
    Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var viewerId);

    bool CanEdit(SurveyAdminSummary s) =>
        Model.ManagesEverySurvey || (s.Status == SurveyStatus.Draft && s.CreatedByUserId == viewerId);
    int Rate(SurveyAdminSummary s) =>
        s.InvitedCount > 0 ? (int)Math.Round(100.0 * s.ResponseCount / s.InvitedCount) : 0;

    Func<SurveyAdminSummary, IHtmlContent> titleCell = @<text>
        @{ var title = string.IsNullOrWhiteSpace(item.Title) ? Localizer["Surveys_Admin_Index_Untitled"].Value : item.Title; }
        @if (CanEdit(item))
        {
            @* Same gate as the Edit button: past Draft this destination
               is a 403 for an author, and always for Board (SurveyAuthorizationHandler). *@
            <a asp-controller="SurveyAdmin" asp-action="Edit" asp-route-id="@item.Id">@title</a>
        }
        else
        {
            @title
        }
        @if (item.Status == SurveyStatus.Draft && !string.IsNullOrWhiteSpace(item.RejectionNote))
        {
            <div class="small text-danger">@string.Format(Localizer["Surveys_Admin_Index_RejectionNote"].Value, item.RejectionNote)</div>
        }
    </text>;
    Func<SurveyAdminSummary, IHtmlContent> statusCell = @<text>
        @if (item.Status == SurveyStatus.Open && Model.SeesEverySurvey)
        {
            <a asp-controller="SurveyAdmin" asp-action="Official" asp-route-id="@item.Id"
               class="badge @EnumBadgeMap.For(item.Status) text-decoration-none"
               title="Open the official survey link">@Localizer.EnumDisplay(item.Status)</a>
        }
        else
        {
            <status-badge value="@item.Status" localizer="@Localizer" />
        }
    </text>;
    Func<SurveyAdminSummary, IHtmlContent> actionsCell = @<text>
        @* No role gate: the service scopes this list to the viewer's own
           surveys unless they see every survey, so every row is one they may rehearse. *@
        <partial name="_SurveyPreviewMenu" model="@item.Id" />
        @if (CanEdit(item))
        {
            <a asp-controller="SurveyAdmin" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">@Localizer["Surveys_Admin_Index_Edit"]</a>
        }
        @if (item.Status == SurveyStatus.Draft && item.CreatedByUserId == viewerId)
        {
            <form asp-controller="SurveyAdmin" asp-action="Submit" asp-route-id="@item.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success btn-sm">@Localizer["Surveys_Admin_Index_SubmitForApproval"]</button>
            </form>
        }
        @if (Model.SeesEverySurvey)
        {
            <a asp-controller="SurveyAdmin" asp-action="Send" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">@Localizer["Surveys_Admin_Index_Send"]</a>
        }
        @if (Model.SeesEverySurvey || item.Status == SurveyStatus.Closed)
        {
            <a asp-controller="SurveyAdmin" asp-action="Results" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">@Localizer["Surveys_Admin_Index_Results"]</a>
        }
    </text>;
    var surveysBuilder = TableModel.For(Model.Surveys)
        .Template(Localizer["Surveys_Admin_Index_ColumnTitle"], titleCell, sortBy: s => s.Title);
    if (Model.SeesEverySurvey)
    {
        surveysBuilder.Column(Localizer["Surveys_Admin_Index_ColumnAuthor"], s => s.CreatedByUserId, o => o.Css("small text-muted"));
    }
    var surveysTable = surveysBuilder
        .Template(Localizer["Surveys_Admin_Index_ColumnStatus"], statusCell, sortBy: s => s.Status)
        .Column(Localizer["Surveys_Admin_Index_ColumnInvited"], s => s.InvitedCount, o => o.Number().End())
        .Column(Localizer["Surveys_Admin_Index_ColumnResponses"], s => s.ResponseCount, o => o.Number().End())
        .Column(Localizer["Surveys_Admin_Index_ColumnRate"], s => s.InvitedCount > 0 ? $"{Rate(s)}%" : null, o => o.End())
        .Template("", actionsCell, o => o.NoSort().Css("text-end"))
        .Css("align-middle")
        .Empty(Localizer["Surveys_Admin_Index_Empty"])
        .Build();
}

@section Crumbs {
    @if (Model.SeesEverySurvey)
    {
        <a asp-controller="Admin" asp-action="Index">Admin</a>
        <span>@Localizer["Surveys_Admin_Index_Title"]</span>
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Localizer["Surveys_Admin_Index_Title"]</h1>
    <a asp-controller="SurveyAdmin" asp-action="Create" class="btn btn-primary btn-sm">@Localizer["Surveys_Admin_Index_New"]</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <partial name="_Table" model="surveysTable" />
    </div>
</div>
