@model SurveyInformationImageRowModel
@{
    var prefix = $"Questions[{Model.QuestionKey}].InformationImages[{Model.ImageKey}]";
    var image = Model.Image;
}
<div class="information-image-row border rounded p-2 mb-2">
    <input type="hidden" name="Questions[@Model.QuestionKey].InformationImages.Index" value="@Model.ImageKey" />
    <input type="hidden" name="@(prefix).Id" value="@image.Id" />
    <input type="hidden" name="@(prefix).ExistingStoragePath" value="@image.ExistingStoragePath" />
    <input type="hidden" name="@(prefix).ExistingFileName" value="@image.ExistingFileName" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-start gap-2 mb-2">
        <div class="flex-grow-1" style="min-width:0">
            @if (!string.IsNullOrWhiteSpace(image.ExistingStoragePath))
            {
                <a href="/@image.ExistingStoragePath.TrimStart('/')" target="_blank" rel="noopener">
                    @(string.IsNullOrWhiteSpace(image.ExistingFileName) ? Localizer["Survey_Admin_Builder_ViewCurrentImage"].Value : image.ExistingFileName)
                </a>
                <div class="form-text">@Localizer["Survey_Admin_Builder_ReplaceImageHelp"]</div>
            }
            <input type="file" name="@(prefix).Upload" class="form-control form-control-sm mt-1"
                   accept="image/jpeg,image/png,image/webp" />
        </div>
        <div class="btn-group btn-group-sm align-self-start" role="group" aria-label="@Localizer["Survey_Admin_Builder_ImageOrderAriaLabel"]">
            <button type="button" class="btn btn-outline-secondary move-information-image-up" aria-label="@Localizer["Survey_Admin_Builder_MoveImageUp"]">
                <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary move-information-image-down" aria-label="@Localizer["Survey_Admin_Builder_MoveImageDown"]">
                <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-outline-danger remove-information-image">@Localizer["Survey_Admin_Builder_RemoveImage"]</button>
        </div>
    </div>

    <partial name="_SurveyLocalizedField"
             model="@(new SurveyLocalizedFieldModel($"{prefix}.Label", Localizer["Survey_Admin_Builder_Field_TabLabel"], image.Label))" />
    <partial name="_SurveyLocalizedField"
             model="@(new SurveyLocalizedFieldModel($"{prefix}.AltText", Localizer["Survey_Admin_Builder_Field_ImageAltText"], image.AltText))" />
</div>
