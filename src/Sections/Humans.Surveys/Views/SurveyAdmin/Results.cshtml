@model SurveyResultsViewModel

@{
    ViewData["Title"] = Localizer["Survey_Admin_Results_Title"].Value;

    static string StatusBadge(SurveyStatus s) => s switch
    {
        SurveyStatus.Open => "bg-success",
        SurveyStatus.Closed => "bg-secondary",
        _ => "bg-warning text-dark",
    };
    var untitled = Localizer["Survey_Admin_Results_Untitled"].Value;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">@Localizer["Survey_Admin_Common_AdminBreadcrumb"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="SurveyAdmin" asp-action="Index">@Localizer["Survey_Admin_Index_Title"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="SurveyAdmin" asp-action="Edit" asp-route-id="@Model.SurveyId">@(string.IsNullOrWhiteSpace(Model.Title) ? untitled : Model.Title)</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Survey_Admin_Results_Breadcrumb"]</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@(string.IsNullOrWhiteSpace(Model.Title) ? untitled : Model.Title)</h1>
    <div class="d-flex align-items-center gap-2">
        <span class="badge @StatusBadge(Model.Status)">@Model.Status</span>
        @if (!Model.IsEmbargoed)
        {
            <a asp-controller="SurveyAdmin" asp-action="ExportCsv" asp-route-id="@Model.SurveyId" class="btn btn-outline-secondary btn-sm">@Localizer["Survey_Admin_Results_DownloadCsv"]</a>
            <a asp-controller="SurveyAdmin" asp-action="ExportJson" asp-route-id="@Model.SurveyId" class="btn btn-outline-secondary btn-sm">@Localizer["Survey_Admin_Results_DownloadJson"]</a>
        }
    </div>
</div>

@if (Model.IsEmbargoed)
{
    <div class="alert alert-info">
        @Localizer["Survey_Admin_Results_EmbargoNotice"]
    </div>
}
else
{
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <strong>@Localizer["Survey_Admin_Results_QuestionResultsLabel"]</strong>
        <span class="text-muted">@string.Format(Localizer["Survey_Admin_Results_ResponseCount"].Value, Model.SelectedResponseCount)</span>
    </div>
    <div class="btn-group" role="group" aria-label="@Localizer["Survey_Admin_Results_FilterAriaLabel"]">
        <a asp-action="Results" asp-route-id="@Model.SurveyId" asp-route-scope="@SurveyResultsScope.Unique"
           class="btn btn-sm @(Model.Scope == SurveyResultsScope.Unique ? "btn-primary" : "btn-outline-primary")">
            @Localizer["Survey_Admin_Results_ScopeUnique"]
        </a>
        <a asp-action="Results" asp-route-id="@Model.SurveyId" asp-route-scope="@SurveyResultsScope.Anonymous"
           class="btn btn-sm @(Model.Scope == SurveyResultsScope.Anonymous ? "btn-primary" : "btn-outline-primary")">
            @Localizer["Survey_Admin_Results_ScopeAnonymous"]
        </a>
        <a asp-action="Results" asp-route-id="@Model.SurveyId" asp-route-scope="@SurveyResultsScope.Combined"
           class="btn btn-sm @(Model.Scope == SurveyResultsScope.Combined ? "btn-primary" : "btn-outline-primary")">
            @Localizer["Survey_Admin_Results_ScopeCombined"]
        </a>
    </div>
</div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card h-100"><div class="card-body text-center">
            <div class="display-6">@Model.ResponseCount</div>
            <div class="text-muted">@Localizer["Survey_Admin_Results_StatResponses"]</div>
        </div></div>
    </div>
    <div class="col-sm-4">
        <div class="card h-100"><div class="card-body text-center">
            <div class="display-6">@Model.InvitedCount</div>
            <div class="text-muted">@Localizer["Survey_Admin_Results_StatInvited"]</div>
        </div></div>
    </div>
    <div class="col-sm-4">
        <div class="card h-100"><div class="card-body text-center">
            <div class="display-6">@(Model.InvitedCount > 0 ? $"{Model.ResponseRatePercent}%" : "—")</div>
            <div class="text-muted">@Localizer["Survey_Admin_Results_StatResponseRate"]</div>
        </div></div>
    </div>
</div>

<h2 class="h5">@Localizer["Survey_Admin_Results_FunnelHeader"] <span class="text-muted fw-normal">@Localizer["Survey_Admin_Results_FunnelAllResponses"]</span></h2>
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h3 class="h6 text-muted">@Localizer["Survey_Admin_Results_InviteLink"]</h3>
                <p class="mb-1">@Localizer["Survey_Admin_Results_Started"] <strong>@Model.Funnel.LinkStarted</strong></p>
                <p class="mb-0">@Localizer["Survey_Admin_Results_Finished"] <strong>@Model.Funnel.LinkFinished</strong></p>
            </div>
            <div class="col-md-6">
                <h3 class="h6 text-muted">@Localizer["Survey_Admin_Results_PublicLink"]</h3>
                <p class="mb-1">@Localizer["Survey_Admin_Results_Started"] <strong>@Model.Funnel.SlugStarted</strong></p>
                <p class="mb-0">@Localizer["Survey_Admin_Results_Finished"] <strong>@Model.Funnel.SlugFinished</strong></p>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsEmbargoed)
{
<h2 class="h5">@Localizer["Survey_Admin_Results_QuestionsHeader"]</h2>
@if (Model.Questions.Count == 0)
{
    <p class="text-muted">@Localizer["Survey_Admin_Results_NoQuestions"]</p>
}
@foreach (var q in Model.Questions)
{
    <div class="card mb-3">
        <div class="card-header">@q.Prompt</div>
        <div class="card-body">
            @switch (q.Type)
            {
                case SurveyQuestionType.RankedChoice:
                    @if (!Model.RankedQuestions.TryGetValue(q.QuestionId, out var ranked))
                    {
                        <p class="text-muted mb-0">@Localizer["Survey_Admin_Results_NoRankedBallots"]</p>
                    }
                    else
                    {
                        var noWinner = Localizer["Survey_Admin_Results_NoWinner"].Value;
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="text-muted small">@Localizer["Survey_Admin_Results_OriginalOfficialResult"]</div>
                                        <div class="h5 mb-0">@(ranked.OriginalOfficialResult.WinnerLabel ?? noWinner)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="text-muted small">@Localizer["Survey_Admin_Results_CurrentOfficialResult"]</div>
                                        <div class="h5 mb-0">@(ranked.CurrentOfficialResult.WinnerLabel ?? noWinner)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        var originalCycleLabels = ranked.OriginalPreferenceCycle
                            .Select(value => ranked.Candidates
                                .FirstOrDefault(candidate => string.Equals(candidate.Value, value, StringComparison.Ordinal))
                                ?.Label ?? value)
                            .ToList();
                        var currentCycleLabels = ranked.CurrentPreferenceCycle
                            .Select(value => ranked.Candidates
                                .FirstOrDefault(candidate => string.Equals(candidate.Value, value, StringComparison.Ordinal))
                                ?.Label ?? value)
                            .ToList();
                        @if (currentCycleLabels.Count > 0 || originalCycleLabels.Count > 0)
                        {
                            var showingCurrentCycle = currentCycleLabels.Count > 0;
                            var cycleLabels = showingCurrentCycle ? currentCycleLabels : originalCycleLabels;
                            <div class="alert alert-info">
                                <strong>@(showingCurrentCycle ? Localizer["Survey_Admin_Results_CycleDetectedAvailable"].Value : Localizer["Survey_Admin_Results_CycleDetectedAll"].Value)</strong>
                                @string.Join(" → ", cycleLabels).
                                @if (showingCurrentCycle)
                                {
                                    <text>@Localizer["Survey_Admin_Results_CycleExplanationCurrent"]</text>
                                }
                                else
                                {
                                    <text>@Localizer["Survey_Admin_Results_CycleExplanationOriginal"]</text>
                                }
                                <a href="https://nobodies.team/event-dates-2027-voting-method.html#preference-cycles-and-availability"
                                   target="_blank" rel="noopener noreferrer">@Localizer["Survey_Admin_Results_CycleLinkText"]</a>.
                            </div>
                        }
                        @if (!string.Equals(
                            ranked.OriginalOfficialResult.WinnerValue,
                            ranked.CurrentOfficialResult.WinnerValue,
                            StringComparison.Ordinal))
                        {
                            <div class="alert alert-warning py-2">
                                @Localizer["Survey_Admin_Results_WinnerChanged"]
                            </div>
                        }

                        <h4 class="h6">@Localizer["Survey_Admin_Results_SensitivityHeader"]</h4>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle">
                                <thead><tr><th>@Localizer["Survey_Admin_Results_ColumnMethod"]</th><th>@Localizer["Survey_Admin_Results_ColumnWinner"]</th><th>@Localizer["Survey_Admin_Results_ColumnNotes"]</th></tr></thead>
                                <tbody>
                                @foreach (var method in ranked.Methods)
                                {
                                    <tr class="@(method.Method.StartsWith("Ranked Pairs", StringComparison.Ordinal) ? "table-primary" : "")">
                                        <th scope="row">@method.Method</th>
                                        <td>@(method.WinnerLabel ?? Localizer["Survey_Admin_Results_NoUniqueWinner"].Value)</td>
                                        <td>@(method.TieBreakUsed ? Localizer["Survey_Admin_Results_TieBreakApplied"].Value : "")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        <details class="mb-3">
                            <summary>@Localizer["Survey_Admin_Results_PairwiseSummary"]</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm">
                                    <thead><tr><th>@Localizer["Survey_Admin_Results_ColumnPair"]</th><th>@Localizer["Survey_Admin_Results_ColumnVotes"]</th></tr></thead>
                                    <tbody>
                                    @foreach (var contest in ranked.Pairwise)
                                    {
                                        var first = ranked.Candidates.First(candidate => candidate.Value == contest.First).Label;
                                        var second = ranked.Candidates.First(candidate => candidate.Value == contest.Second).Label;
                                        <tr><td>@first @Localizer["Survey_Admin_Results_VsSeparator"] @second</td><td>@contest.PreferFirst – @contest.PreferSecond</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </details>

                        <h4 class="h6">@Localizer["Survey_Admin_Results_RejectionsHeader"]</h4>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm">
                                <thead><tr><th>@Localizer["Survey_Admin_Results_ColumnOption"]</th><th>@Localizer["Survey_Admin_Results_ColumnRejected"]</th><th>@Localizer["Survey_Admin_Results_ColumnStatus"]</th></tr></thead>
                                <tbody>
                                @foreach (var candidate in ranked.Candidates)
                                {
                                    <tr>
                                        <td>@candidate.Label</td>
                                        <td>@candidate.RejectionCount (@Math.Round(candidate.RejectionPercent)%)</td>
                                        <td>
                                            @if (!candidate.IsAvailable)
                                            {
                                                <span class="badge text-bg-warning">@Localizer["Survey_Admin_Results_NoLongerAvailable"]</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.Status == SurveyStatus.Closed)
                        {
                            <form asp-action="RankedAvailability" asp-route-id="@Model.SurveyId" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="questionId" value="@q.QuestionId" />
                                <fieldset>
                                    <legend class="h6">@Localizer["Survey_Admin_Results_UnavailableOptionsLegend"]</legend>
                                    <p class="form-text">@Localizer["Survey_Admin_Results_UnavailableOptionsHelp"]</p>
                                    @foreach (var candidate in ranked.Candidates)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="unavailable-@q.QuestionId-@candidate.Value"
                                                   name="unavailableValues" value="@candidate.Value"
                                                   checked="@(!candidate.IsAvailable ? "checked" : null)" />
                                            <label class="form-check-label" for="unavailable-@q.QuestionId-@candidate.Value">@candidate.Label</label>
                                        </div>
                                    }
                                    <button type="submit" class="btn btn-outline-primary btn-sm mt-2">@Localizer["Survey_Admin_Results_Recalculate"]</button>
                                </fieldset>
                            </form>
                        }
                    }
                    break;

                case SurveyQuestionType.SingleChoice:
                case SurveyQuestionType.MultiChoice:
                    @if (q.OptionCounts.Count == 0)
                    {
                        <p class="text-muted mb-0">@Localizer["Survey_Admin_Results_NoOptions"]</p>
                    }
                    else
                    {
                        foreach (var o in q.OptionCounts)
                        {
                            var pct = (int)Math.Round(o.Percent);
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span>@o.Label</span>
                                    <span class="text-muted">@o.Count (@pct%)</span>
                                </div>
                                <div class="progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" style="height: .75rem;">
                                    <div class="progress-bar" style="width: @pct%;"></div>
                                </div>
                            </div>
                        }
                    }
                    break;

                case SurveyQuestionType.Rating:
                    <p class="mb-2">@Localizer["Survey_Admin_Results_AverageLabel"] <strong>@(q.RatingAverage ?? "—")</strong></p>
                    @foreach (var b in q.RatingDistribution)
                    {
                        var w = q.RatingMaxCount > 0 ? (int)Math.Round(100.0 * b.Count / q.RatingMaxCount) : 0;
                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span>@b.Value</span>
                                <span class="text-muted">@b.Count</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@w" aria-valuemin="0" aria-valuemax="100" style="height: .75rem;">
                                <div class="progress-bar bg-info" style="width: @w%;"></div>
                            </div>
                        </div>
                    }
                    break;

                case SurveyQuestionType.Grid:
                    @if (q.Grid is null || q.Grid.Rows.Count == 0 || q.Grid.Columns.Count == 0)
                    {
                        <p class="text-muted mb-0">@Localizer["Survey_Admin_Results_GridNoRowsColumns"]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@Localizer["Survey_Admin_Results_ColumnRow"]</th>
                                        @foreach (var column in q.Grid.Columns)
                                        {
                                            <th scope="col" class="text-center">@column.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in q.Grid.Rows)
                                    {
                                        <tr>
                                            <th scope="row">@row.Label</th>
                                            @foreach (var cell in row.Cells)
                                            {
                                                var pct = (int)Math.Round(cell.Percent);
                                                <td class="text-center">
                                                    <strong>@cell.Count</strong>
                                                    <span class="text-muted small">(@pct%)</span>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    break;

                default:
                    @if (q.FreeTextAnswers.Count == 0)
                    {
                        <p class="text-muted mb-0">@Localizer["Survey_Admin_Results_NoFreeTextAnswers"]</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var t in q.FreeTextAnswers)
                            {
                                <li class="list-group-item">@t</li>
                            }
                        </ul>
                    }
                    break;
            }
        </div>
    </div>
}

@if (Model.ShowIdentifiedRespondents)
{
    <h2 class="h5">@Localizer["Survey_Admin_Results_IdentifiedRespondentsHeader"]</h2>
    @if (Model.Respondents.Count == 0)
    {
        <p class="text-muted">@Localizer["Survey_Admin_Results_NoIdentifiedRespondents"]</p>
    }
    else
    {
        <div class="accordion mb-4" id="respondents">
            @for (var i = 0; i < Model.Respondents.Count; i++)
            {
                var r = Model.Respondents[i];
                var headingId = $"respondent-heading-{i}";
                var collapseId = $"respondent-collapse-{i}";
                <div class="accordion-item">
                    <h3 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            @r.Name <span class="text-muted ms-2 small">@r.SubmittedAt</span>
                        </button>
                    </h3>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#respondents">
                        <div class="accordion-body">
                            <partial name="_RespondentAnswers" model="r.Answers" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@if (Model.ShowUnattributedBallots)
{
    <h2 class="h5">@Localizer["Survey_Admin_Results_IndividualBallotsHeader"]</h2>
    <p class="text-muted">
        @Localizer["Survey_Admin_Results_BallotsPrivacyNote"]
    </p>
    @if (Model.UnattributedBallots.Count == 0)
    {
        <p class="text-muted">@Localizer["Survey_Admin_Results_NoBallotsInView"]</p>
    }
    else
    {
        <div class="accordion mb-4" id="unattributed-ballots">
            @for (var i = 0; i < Model.UnattributedBallots.Count; i++)
            {
                var ballot = Model.UnattributedBallots[i];
                var headingId = $"ballot-heading-{i}";
                var collapseId = $"ballot-collapse-{i}";
                <div class="accordion-item">
                    <h3 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            @string.Format(Localizer["Survey_Admin_Results_BallotLabel"].Value, i + 1)
                        </button>
                    </h3>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#unattributed-ballots">
                        <div class="accordion-body">
                            <partial name="_RespondentAnswers" model="ballot.Answers" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
}

<div class="mt-3">
    <a asp-controller="SurveyAdmin" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Survey_Admin_Results_BackToSurveys"]</a>
</div>
