@model SurveyOptionRowModel
@{
    var prefix = $"Questions[{Model.QuestionKey}].Options[{Model.OptionKey}]";
}
<div class="option-row border rounded p-2 mb-2">
    <input type="hidden" name="Questions[@Model.QuestionKey].Options.Index" value="@Model.OptionKey" />
    @if (Model.Option.Id is { } oid)
    {
        <input type="hidden" name="@(prefix).Id" value="@oid" />
    }
    <div class="d-flex gap-2 align-items-start">
        <div class="flex-grow-1">
            <div class="input-group input-group-sm mb-2">
                <span class="input-group-text">@Localizer["Survey_Admin_Builder_ValueLabel"]</span>
                <input type="text" name="@(prefix).Value" class="form-control" value="@Model.Option.Value"
                       placeholder="@Localizer["Survey_Admin_Builder_ValuePlaceholder_Option"]" />
            </div>
            <partial name="_SurveyLocalizedField" model="@(new SurveyLocalizedFieldModel($"{prefix}.Label", Localizer["Survey_Admin_Builder_Field_OptionLabel"], Model.Option.Label))" />
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["Survey_Admin_Builder_OptionActionsAriaLabel"]">
            <button type="button" class="btn btn-outline-secondary move-option-up" title="@Localizer["Survey_Admin_Builder_MoveOptionUp"]">
                <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                <span class="visually-hidden">@Localizer["Survey_Admin_Builder_MoveOptionUp"]</span>
            </button>
            <button type="button" class="btn btn-outline-secondary move-option-down" title="@Localizer["Survey_Admin_Builder_MoveOptionDown"]">
                <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                <span class="visually-hidden">@Localizer["Survey_Admin_Builder_MoveOptionDown"]</span>
            </button>
            <button type="button" class="btn btn-outline-danger remove-option" title="@Localizer["Survey_Admin_Builder_RemoveOption"]">&times;</button>
        </div>
    </div>
</div>
