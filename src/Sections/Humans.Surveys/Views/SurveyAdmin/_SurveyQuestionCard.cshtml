@model SurveyQuestionCardModel
@{
    var key = Model.Key;
    var q = Model.Question;
    var prefix = $"Questions[{key}]";
}
<div class="question-card card mb-3" data-qkey="@key">
    <input type="hidden" name="Questions.Index" value="@key" />
    @* Always rendered: new questions get a client-generated id (Builder JS) so show-if clauses can
       reference them before the first save — the service honours supplied ids. *@
    <input type="hidden" name="@(prefix).Id" value="@q.Id" class="question-id" />
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
        <strong class="small text-muted question-position-label">@Localizer["Survey_Admin_Builder_QuestionLabel"]</strong>
        <div class="d-flex flex-wrap gap-1">
            <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["Survey_Admin_Builder_QuestionOrderAriaLabel"]">
                <button type="button" class="btn btn-outline-secondary move-question-up"
                        title="@Localizer["Survey_Admin_Builder_MoveQuestionUp"]" aria-label="@Localizer["Survey_Admin_Builder_MoveQuestionUp"]">
                    <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary move-question-down"
                        title="@Localizer["Survey_Admin_Builder_MoveQuestionDown"]" aria-label="@Localizer["Survey_Admin_Builder_MoveQuestionDown"]">
                    <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm add-question-after">
                @Localizer["Survey_Admin_Builder_AddBelow"]
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm remove-question">@Localizer["Survey_Admin_Builder_RemoveQuestion"]</button>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-2">
            <div class="col-auto">
                <label class="form-label small mb-0">@Localizer["Survey_Admin_Builder_PageLabel"]</label>
                <input type="number" min="1" name="@(prefix).PageNumber"
                       class="form-control form-control-sm question-page-number"
                       style="width:5rem;" value="@(q.PageNumber <= 0 ? 1 : q.PageNumber)" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">@Localizer["Survey_Admin_Builder_TypeLabel"]</label>
                <select name="@(prefix).Type" class="form-select form-select-sm question-type">
                    @foreach (var t in Enum.GetValues<SurveyQuestionType>())
                    {
                        <option value="@t" selected="@(q.Type == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-auto align-self-end required-section">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="req-@key" name="@(prefix).IsRequired" value="true" @(q.IsRequired ? "checked" : null) />
                    <label class="form-check-label small" for="req-@key">@Localizer["Survey_Admin_Builder_RequiredLabel"]</label>
                </div>
            </div>
        </div>

        <partial name="_SurveyLocalizedField" model="@(new SurveyLocalizedFieldModel($"{prefix}.Prompt", Localizer["Survey_Admin_Builder_Field_Prompt"], q.Prompt))" />
        <partial name="_SurveyLocalizedField" model="@(new SurveyLocalizedFieldModel($"{prefix}.HelpText", Localizer["Survey_Admin_Builder_Field_HelpText"], q.HelpText, Multiline: true, Markdown: true))" />

        <div class="information-section border-top pt-2 mt-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label small fw-semibold mb-0">@Localizer["Survey_Admin_Builder_ImagesLabel"]</label>
                <span class="small text-muted">@Localizer["Survey_Admin_Builder_ImagesHelp"]</span>
            </div>
            <div class="alert alert-warning small py-2">
                @Localizer["Survey_Admin_Builder_ImagesPublicWarning"]
            </div>
            <div class="information-images-container">
                @foreach (var (image, i) in q.InformationImages.Select((image, i) => (image, i)))
                {
                    <partial name="_SurveyInformationImageRow"
                             model="@(new SurveyInformationImageRowModel(key, i.ToString(), image))" />
                }
            </div>
            <template class="information-image-template">
                <partial name="_SurveyInformationImageRow"
                         model="@(new SurveyInformationImageRowModel(key, "__IKEY__", new SurveyInformationImageBuilderViewModel()))" />
            </template>
            <button type="button" class="btn btn-outline-secondary btn-sm add-information-image">
                @Localizer["Survey_Admin_Builder_AddImage"]
            </button>
        </div>

        <div class="rating-section border-top pt-2 mt-2">
            <div class="row g-2">
                <div class="col-auto">
                    <label class="form-label small mb-0">@Localizer["Survey_Admin_Builder_RatingMinLabel"]</label>
                    <input type="number" name="@(prefix).RatingMin" class="form-control form-control-sm" style="width:6rem;" value="@(q.RatingMin)" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-0">@Localizer["Survey_Admin_Builder_RatingMaxLabel"]</label>
                    <input type="number" name="@(prefix).RatingMax" class="form-control form-control-sm" style="width:6rem;" value="@(q.RatingMax)" />
                </div>
            </div>
            <partial name="_SurveyLocalizedField" model="@(new SurveyLocalizedFieldModel($"{prefix}.RatingMinLabel", Localizer["Survey_Admin_Builder_Field_MinLabel"], q.RatingMinLabel))" />
            <partial name="_SurveyLocalizedField" model="@(new SurveyLocalizedFieldModel($"{prefix}.RatingMaxLabel", Localizer["Survey_Admin_Builder_Field_MaxLabel"], q.RatingMaxLabel))" />
        </div>

        <div class="options-section border-top pt-2 mt-2">
            <label class="form-label small fw-semibold options-label">@Localizer["Survey_Admin_Builder_OptionsLabel"]</label>
            <div class="options-container">
                @foreach (var (opt, i) in q.Options.Select((o, i) => (o, i)))
                {
                    <partial name="_SurveyOptionRow" model="@(new SurveyOptionRowModel(key, i.ToString(), opt))" />
                }
            </div>
            <template class="option-template">
                <partial name="_SurveyOptionRow" model="@(new SurveyOptionRowModel(key, "__OKEY__", new SurveyOptionBuilderViewModel()))" />
            </template>
            <button type="button" class="btn btn-outline-secondary btn-sm add-option">@Localizer["Survey_Admin_Builder_AddOption"]</button>
            <div class="form-text grid-column-help">@Localizer["Survey_Admin_Builder_GridColumnHelp"]</div>
        </div>

        <div class="ranked-section border-top pt-2 mt-2">
            <div class="alert alert-info small py-2">
                @Localizer["Survey_Admin_Builder_RankedMethodNote"]
            </div>
            @if (Model.RankedDefinitionLocked)
            {
                <input type="hidden" name="@(prefix).RankedAllowEqualRanks"
                       value="@(q.RankedAllowEqualRanks ? "true" : "false")" />
                <input type="hidden" name="@(prefix).RankedAllowReject"
                       value="@(q.RankedAllowReject ? "true" : "false")" />
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="ranked-equal-@key"
                           checked="@(q.RankedAllowEqualRanks ? "checked" : null)" disabled />
                    <label class="form-check-label small" for="ranked-equal-@key">@Localizer["Survey_Admin_Builder_AllowEqualRanks"]</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="ranked-reject-@key"
                           checked="@(q.RankedAllowReject ? "checked" : null)" disabled />
                    <label class="form-check-label small" for="ranked-reject-@key">@Localizer["Survey_Admin_Builder_IncludeReject"]</label>
                </div>
                <div class="form-text">
                    @Localizer["Survey_Admin_Builder_RankedLockedHelp"]
                </div>
            }
            else
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="ranked-equal-@key"
                           name="@(prefix).RankedAllowEqualRanks" value="true"
                           checked="@(q.RankedAllowEqualRanks ? "checked" : null)" />
                    <input type="hidden" name="@(prefix).RankedAllowEqualRanks" value="false" />
                    <label class="form-check-label small" for="ranked-equal-@key">@Localizer["Survey_Admin_Builder_AllowEqualRanks"]</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="ranked-reject-@key"
                           name="@(prefix).RankedAllowReject" value="true"
                           checked="@(q.RankedAllowReject ? "checked" : null)" />
                    <input type="hidden" name="@(prefix).RankedAllowReject" value="false" />
                    <label class="form-check-label small" for="ranked-reject-@key">@Localizer["Survey_Admin_Builder_IncludeReject"]</label>
                </div>
            }
        </div>

        <div class="grid-section border-top pt-2 mt-2">
            <div class="mb-2">
                <label class="form-label small fw-semibold" for="grid-mode-@key">@Localizer["Survey_Admin_Builder_SelectionsPerRow"]</label>
                <select id="grid-mode-@key" name="@(prefix).GridSelectionMode" class="form-select form-select-sm w-auto">
                    @if ((q.GridSelectionMode ?? GridSelectionMode.Single) == GridSelectionMode.Single)
                    {
                        <option value="@GridSelectionMode.Single" selected>@Localizer["Survey_Admin_Builder_OneChoice"]</option>
                    }
                    else
                    {
                        <option value="@GridSelectionMode.Single">@Localizer["Survey_Admin_Builder_OneChoice"]</option>
                    }
                    @if (q.GridSelectionMode == GridSelectionMode.Multiple)
                    {
                        <option value="@GridSelectionMode.Multiple" selected>@Localizer["Survey_Admin_Builder_MultipleChoices"]</option>
                    }
                    else
                    {
                        <option value="@GridSelectionMode.Multiple">@Localizer["Survey_Admin_Builder_MultipleChoices"]</option>
                    }
                </select>
            </div>
            <label class="form-label small fw-semibold">@Localizer["Survey_Admin_Builder_RowsLabel"]</label>
            <div class="grid-rows-container">
                @foreach (var (row, i) in q.GridRows.Select((row, i) => (row, i)))
                {
                    <partial name="_SurveyGridRow" model="@(new SurveyGridRowModel(key, i.ToString(), row))" />
                }
            </div>
            <template class="grid-row-template">
                <partial name="_SurveyGridRow" model="@(new SurveyGridRowModel(key, "__RKEY__", new SurveyGridRowBuilderViewModel()))" />
            </template>
            <button type="button" class="btn btn-outline-secondary btn-sm add-grid-row">@Localizer["Survey_Admin_Builder_AddRow"]</button>
        </div>

        <div class="border-top pt-2 mt-2 showif-section">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <label class="form-label small fw-semibold mb-0">@Localizer["Survey_Admin_Builder_VisibilityLabel"]</label>
                <select class="form-select form-select-sm w-auto showif-mode">
                    <option value="always" selected="@(q.ShowIfClauses.Count == 0 ? "selected" : null)">@Localizer["Survey_Admin_Builder_AlwaysShown"]</option>
                    <option value="conditional" selected="@(q.ShowIfClauses.Count > 0 ? "selected" : null)">@Localizer["Survey_Admin_Builder_ConditionalShown"]</option>
                </select>
                <select name="@(prefix).ShowIfCombine" class="form-select form-select-sm w-auto showif-combine"
                        style="@(q.ShowIfClauses.Count > 1 ? "" : "display:none")">
                    <option value="@BranchCombine.All" selected="@(q.ShowIfCombine == BranchCombine.All ? "selected" : null)">@Localizer["Survey_Admin_Builder_CombineAll"]</option>
                    <option value="@BranchCombine.Any" selected="@(q.ShowIfCombine == BranchCombine.Any ? "selected" : null)">@Localizer["Survey_Admin_Builder_CombineAny"]</option>
                </select>
            </div>
            <div class="showif-clauses" style="@(q.ShowIfClauses.Count == 0 ? "display:none" : "")">
                <div class="clauses-container">
                    @foreach (var (c, ci) in q.ShowIfClauses.Select((c, i) => (c, i.ToString())))
                    {
                        <partial name="_SurveyBranchClauseRow" model="@(new SurveyBranchClauseRowModel(key, ci, c))" />
                    }
                </div>
                <template class="clause-template">
                    <partial name="_SurveyBranchClauseRow" model="@(new SurveyBranchClauseRowModel(key, "__CKEY__", new SurveyBranchClauseBuilderViewModel()))" />
                </template>
                <button type="button" class="btn btn-outline-secondary btn-sm add-clause">@Localizer["Survey_Admin_Builder_AddCondition"]</button>
                <div class="form-text">@Localizer["Survey_Admin_Builder_ConditionsHelp"]</div>
            </div>
        </div>
    </div>
</div>
