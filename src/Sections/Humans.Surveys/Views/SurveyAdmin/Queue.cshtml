@model SurveyPendingApprovalViewModel

@{
    ViewData["Title"] = Localizer["Surveys_Admin_Queue_Title"].Value;
    var zone = DateTimeZoneProviders.Tzdb["Europe/Madrid"];
}

<h1 class="mb-3">@Localizer["Surveys_Admin_Queue_Title"]</h1>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (Model.Items.Count == 0)
{
    <empty-state>@Localizer["Surveys_Admin_Queue_Empty"]</empty-state>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            @{
                Func<SurveyPendingApprovalItem, IHtmlContent> queueCell0 = @<text>@(string.IsNullOrWhiteSpace(item.Title) ? Localizer["Surveys_Admin_Index_Untitled"].Value : item.Title)</text>;
                Func<SurveyPendingApprovalItem, IHtmlContent> queueCell1 = @<text>@item.CreatedByName</text>;
                Func<SurveyPendingApprovalItem, IHtmlContent> queueCell2 = @<text>@(item.SubmittedAt is { } at ? at.ToDateTime(zone) : "—")</text>;
                Func<SurveyPendingApprovalItem, IHtmlContent> queueCell3 = @<text>
                    <div class="d-inline" authorize-policy="@Humans.Surveys.Contracts.SurveysPolicies.Manage">
                        <form asp-controller="SurveyAdmin" asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm">@Localizer["Surveys_Admin_Queue_ApproveAndSend"]</button>
                        </form>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                            @Localizer["Surveys_Admin_Queue_Reject"]
                        </button>
                    </div>

                </text>;
                var queueTable = TableModel.For(Model.Items)
                    .Template(Localizer["Surveys_Admin_Index_ColumnTitle"], queueCell0)
                    .Template(Localizer["Surveys_Admin_Queue_Author"], queueCell1)
                    .Template(Localizer["Surveys_Admin_Queue_Submitted"], queueCell2, o => o.Css("small text-muted"), sortBy: i => i.SubmittedAt)
                    .Template("", queueCell3, o => o.Css("text-end").NoSort())
                    .Css("align-middle")
                    .Build();
            }
            <partial name="_Table" model="queueTable" />
        </div>
    </div>

    @* Outside the table: a <div> between two <tr>s is not valid table content, and the parser
       relocates it before the <table> anyway. *@
    @foreach (var item in Model.Items)
    {
        <div authorize-policy="@Humans.Surveys.Contracts.SurveysPolicies.Manage" class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-controller="SurveyAdmin" asp-action="Reject" asp-route-id="@item.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">@Localizer["Surveys_Admin_Queue_Reject"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="note-@item.Id">@Localizer["Surveys_Admin_Queue_RejectNoteLabel"]</label>
                            <textarea class="form-control" id="note-@item.Id" name="note" rows="3" required maxlength="4000">@(ViewData[$"RejectionNote:{item.Id}"])</textarea>
                            <div class="form-text text-danger">@Localizer["Surveys_Admin_Queue_RejectNoteRequired"]</div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-danger">@Localizer["Surveys_Admin_Queue_Reject"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
