@model SurveyPendingApprovalViewModel

@{
    ViewData["Title"] = Localizer["Survey_Admin_Queue_Title"].Value;
    var zone = DateTimeZoneProviders.Tzdb["Europe/Madrid"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
        <li class="breadcrumb-item"><a asp-controller="SurveyAdmin" asp-action="Index">@Localizer["Survey_Admin_Index_Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Survey_Admin_Queue_Title"]</li>
    </ol>
</nav>

<h1 class="mb-3">@Localizer["Survey_Admin_Queue_Title"]</h1>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">@Localizer["Survey_Admin_Queue_Empty"]</p>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>@Localizer["Survey_Admin_Index_ColumnTitle"]</th>
                        <th>@Localizer["Survey_Admin_Queue_Author"]</th>
                        <th>@Localizer["Survey_Admin_Queue_Submitted"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(item.Title) ? Localizer["Survey_Admin_Index_Untitled"].Value : item.Title)</td>
                            <td>@item.CreatedByName</td>
                            <td class="small text-muted">@(item.SubmittedAt is { } at ? at.ToDateTime(zone) : "—")</td>
                            <td class="text-end">
                                <form asp-controller="SurveyAdmin" asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">@Localizer["Survey_Admin_Queue_ApproveAndSend"]</button>
                                </form>
                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                    @Localizer["Survey_Admin_Queue_Reject"]
                                </button>
                            </td>
                        </tr>
                        <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-controller="SurveyAdmin" asp-action="Reject" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header">
                                            <h5 class="modal-title">@Localizer["Survey_Admin_Queue_Reject"]</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label class="form-label" for="note-@item.Id">@Localizer["Survey_Admin_Queue_RejectNoteLabel"]</label>
                                            <textarea class="form-control" id="note-@item.Id" name="note" rows="3" required></textarea>
                                            <div class="form-text text-danger">@Localizer["Survey_Admin_Queue_RejectNoteRequired"]</div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="submit" class="btn btn-danger">@Localizer["Survey_Admin_Queue_Reject"]</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
