@model IReadOnlyList<Humans.Surveys.Services.SurveyPendingApprovalItem>
@inject Humans.Base.Interfaces.IOrgTimeZone OrgTimeZone

@{
    ViewData["Title"] = Localizer["Surveys_Admin_Queue_Title"].Value;
    var orgZone = OrgTimeZone.Zone;
}

<page-header title="@(Localizer["Surveys_Admin_Queue_Title"].Value)" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (Model.Count == 0)
{
    <empty-state>@Localizer["Surveys_Admin_Queue_Empty"]</empty-state>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            @{
                Func<SurveyPendingApprovalItem, IHtmlContent> columntitleCell = @<text>@(string.IsNullOrWhiteSpace(item.Title) ? Localizer["Surveys_Admin_Index_Untitled"].Value : item.Title)</text>;
                Func<SurveyPendingApprovalItem, IHtmlContent> submittedCell = @<text>@(item.SubmittedAt is { } at ? at.ToDateTime(orgZone) : "—")</text>;
                Func<SurveyPendingApprovalItem, IHtmlContent> queueActionsCell = @<text><partial name="_SurveyReviewActions" model="@item.Id" /></text>;
                var queueTable = TableModel.For(Model)
                    .Template(Localizer["Surveys_Admin_Index_ColumnTitle"], columntitleCell)
                    .Human(Localizer["Surveys_Admin_Queue_Author"], r => r.CreatedByUserId)
                    .Template(Localizer["Surveys_Admin_Queue_Submitted"], submittedCell, o => o.Css("small text-muted"), sortBy: i => i.SubmittedAt)
                    .Template("", queueActionsCell, o => o.Css("text-end").NoSort())
                    .Css("align-middle")
                    .Build();
            }
            <partial name="_Table" model="queueTable" />
        </div>
    </div>
}
