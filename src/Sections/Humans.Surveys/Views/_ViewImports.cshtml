@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by the rendered-HTML diff in step 12. *@
@using Humans.Surveys
@using Humans.Surveys.Contracts
@using Humans.Surveys.Domain
@using Humans.Base.Enums
@using Humans.Surveys.Models
@using Humans.Surveys.Services
@using Humans.Base.Extensions
@using Humans.Base
@using Microsoft.Extensions.Localization
@using NodaTime
@using NodaTime.Text
@* Every string these views render is a Survey_* key carved into the section's own set;
   no Common_* key survives here, so there is deliberately no SharedLocalizer binding. *@
@inject IStringLocalizer<SurveysResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
