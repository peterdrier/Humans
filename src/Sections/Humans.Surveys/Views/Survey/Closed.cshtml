@model Humans.Surveys.Models.SurveyClosedViewModel

@{
    ViewData["Title"] = Localizer["Survey_Closed_Title"].Value;

    var (headingKey, bodyKey) = Model.Reason switch
    {
        "closed" => ("Survey_Closed_Heading", "Survey_Closed_Body"),
        "empty" => ("Survey_NothingToAnswer_Heading", "Survey_NothingToAnswer_Body"),
        _ => ("Survey_InvalidLink_Heading", "Survey_InvalidLink_Body"),
    };
    var heading = Localizer[headingKey];
    var body = Localizer[bodyKey];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card mt-4">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-circle-info fa-2x text-muted mb-3"></i>
                <h1 class="h4 mb-2">@heading</h1>
                <p class="text-muted mb-0">@body</p>
            </div>
        </div>
    </div>
</div>
