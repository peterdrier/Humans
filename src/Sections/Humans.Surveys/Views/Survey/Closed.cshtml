@model Humans.Surveys.Models.SurveyClosedViewModel

@{
    ViewData["Title"] = Localizer["Surveys_Closed_Title"].Value;

    var (headingKey, bodyKey) = Model.Reason switch
    {
        "closed" => ("Surveys_Closed_Heading", "Surveys_Closed_Body"),
        "empty" => ("Surveys_NothingToAnswer_Heading", "Surveys_NothingToAnswer_Body"),
        "ineligible" => ("Surveys_Ineligible_Heading", "Surveys_Ineligible_Body"),
        "ineligible-asociado" => ("Surveys_AsociadoIneligible_Heading", "Surveys_AsociadoIneligible_Body"),
        _ => ("Surveys_InvalidLink_Heading", "Surveys_InvalidLink_Body"),
    };
    var heading = Localizer[headingKey];
    var body = Localizer[bodyKey];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card mt-4">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-circle-info fa-2x text-muted mb-3"></i>
                <h1 class="h4 mb-2">@heading</h1>
                <p class="text-muted mb-0">@body</p>
            </div>
        </div>
    </div>
</div>
