@model Humans.Surveys.Models.SurveyThankYouViewModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? Localizer["Survey_ThankYou_Heading"].Value : Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        @if (Model.IsPreview)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3 mt-4 mb-0" role="note">
                <div>
                    <i class="fa-solid fa-eye me-1"></i>
                    <strong>Preview only.</strong> No response was submitted.
                </div>
                <form asp-controller="SurveyAdmin" asp-action="SendPreviewEmail"
                      asp-route-id="@Model.PreviewSurveyId" method="post" class="flex-shrink-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-dark">
                        <i class="fa-solid fa-envelope me-1"></i>Send preview email to me
                    </button>
                </form>
            </div>
        }
        <div class="card mt-4">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-circle-check fa-2x text-success mb-3"></i>
                <h1 class="h4 mb-3">@Localizer["Survey_ThankYou_Heading"]</h1>
                <div class="text-muted">
                    @(string.IsNullOrWhiteSpace(Model.ThankYou)
                        ? Localizer["Survey_ThankYouFallback"]
                        : Model.ThankYou)
                </div>
            </div>
        </div>
    </div>
</div>
