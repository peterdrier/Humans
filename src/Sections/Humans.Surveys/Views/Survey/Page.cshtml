@model Humans.Surveys.Models.SurveyPageViewModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? Localizer["Survey_TitleFallback"].Value : Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card mt-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="h4 mb-0">@(string.IsNullOrWhiteSpace(Model.Title) ? Localizer["Survey_TitleFallback"].Value : Model.Title)</h1>
                    @if (Model.TotalSteps > 0)
                    {
                        <span class="badge text-bg-secondary">@Localizer["Survey_PageOf", Model.StepNumber, Model.TotalSteps]</span>
                    }
                </div>

                @if (Model.IsPreview)
                {
                    <partial name="_PreviewNotice"
                             model="@(new SurveyPreviewNoticeModel(
                                 Model.PreviewSurveyId!.Value,
                                 "Answers and activity are not saved. Conditional questions are shown so they can be inspected."))" />
                }

                @if (Model.IsAsociadoVote)
                {
                    <div class="alert alert-warning small" role="note">
                        <i class="fa-solid fa-scale-balanced me-1"></i>
                        <strong>@Localizer["Survey_AsociadoVote_Heading"]</strong>
                        @Localizer["Survey_AsociadoVote_PageReminder"]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @Localizer["Survey_RequiredAlert"]
                    </div>
                }

                @{
                    // Public-slug path posts to PublicSubmitPage with the slug in the route; the invited
                    // path posts to SubmitPage with the token in a hidden field.
                    var submitController = Model.IsPreview ? "SurveyAdmin" : "Survey";
                    var submitAction = Model.IsPreview ? "PreviewPage" : Model.IsPublic ? "PublicSubmitPage" : "SubmitPage";
                }
                <form asp-controller="@submitController"
                      asp-action="@submitAction"
                      asp-route-id="@(Model.IsPreview ? Model.PreviewSurveyId : null)"
                      asp-route-slug="@(Model.IsPublic ? Model.Slug : null)"
                      method="@(Model.IsPreview ? "get" : "post")">
                    @if (!Model.IsPreview)
                    {
                        @Html.AntiForgeryToken()
                        @if (!Model.IsPublic)
                        {
                            <input type="hidden" name="Token" value="@Model.Token" />
                        }
                    }
                    <input type="hidden" name="Page" value="@Model.Page" />
                    @if (Model.IsPreview)
                    {
                        <input type="hidden" name="Culture" value="@Model.PreviewCulture" />
                    }

                    @if (Model.IsPreview)
                    {
                        <fieldset class="border-0 p-0 m-0" disabled="disabled">
                            <partial name="_SurveyQuestions" model="Model" />
                        </fieldset>
                    }
                    else
                    {
                        <partial name="_SurveyQuestions" model="Model" />
                    }

                    <div class="d-flex justify-content-between mt-4">
                        @if (Model.IsPreview && Model.PreviousPreviewPage is not null)
                        {
                            <a asp-controller="SurveyAdmin" asp-action="PreviewPage"
                               asp-route-id="@Model.PreviewSurveyId"
                               asp-route-culture="@Model.PreviewCulture"
                               asp-route-page="@Model.PreviousPreviewPage"
                               class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i>@Localizer["Survey_Back"]
                            </a>
                        }
                        else if (Model.CanGoBack)
                        {
                            <button type="submit" name="Back" value="true" class="btn btn-outline-secondary" formnovalidate>
                                <i class="fa-solid fa-arrow-left me-1"></i>@Localizer["Survey_Back"]
                            </button>
                        }
                        else
                        {
                            <span></span>
                        }

                        @if (Model.IsPreview && Model.NextPreviewPage is not null)
                        {
                            <a asp-controller="SurveyAdmin" asp-action="PreviewPage"
                               asp-route-id="@Model.PreviewSurveyId"
                               asp-route-culture="@Model.PreviewCulture"
                               asp-route-page="@Model.NextPreviewPage"
                               class="btn btn-primary">
                                @Localizer["Survey_Next"]<i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        }
                        else if (Model.IsPreview)
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="SurveyAdmin" asp-action="PreviewThankYou"
                                   asp-route-id="@Model.PreviewSurveyId"
                                   asp-route-culture="@Model.PreviewCulture"
                                   class="btn btn-outline-primary">
                                    Preview thank-you
                                </a>
                                <button type="button" class="btn btn-primary" disabled aria-disabled="true">
                                    @Localizer["Survey_Submit"]<i class="fa-solid fa-paper-plane ms-1"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary">
                                @if (Model.IsLastStep)
                                {
                                    <span>@Localizer["Survey_Submit"]<i class="fa-solid fa-paper-plane ms-1"></i></span>
                                }
                                else
                                {
                                    <span>@Localizer["Survey_Next"]<i class="fa-solid fa-arrow-right ms-1"></i></span>
                                }
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
