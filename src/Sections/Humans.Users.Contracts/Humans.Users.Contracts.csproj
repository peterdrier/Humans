<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Users' cross-section contracts that are not part of the core every section reads. The core
    (User, UserEmail, UserInfo, IUserService, IUserEmailService and the enums they name) lives in
    Humans.Base/Users/ under this same namespace, so most sections need no reference here.

    Stays a leaf rather than a Contracts/ folder: Humans.Users -> Humans.Auth -> this project
    would cycle if these types lived in Humans.Users.

    Onboarding.Contracts: IUserWrite, IHumanLifecycleService and IAccountDeletionService return
    OnboardingResult. That edge keeps Onboarding out of Base; it must never come the other way.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Onboarding.Contracts\Humans.Onboarding.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
