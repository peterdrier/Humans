@inject IWebHostEnvironment HostEnv
@inject IConfiguration Config
@inject Humans.Auth.Contracts.RoleCatalog Catalog
@*
    Lives here, not in Shell's /Account/Login, because PersonasFor is internal to this section; Shell renders it by
    name. Shell's devAuthEnabled guard keeps it out of Production. ReturnUrl comes from the calling view's ViewData.
*@
<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark py-2">
                <small><strong>Dev login — @HostEnv.EnvironmentName</strong></small>
            </div>
            <div class="card-body py-3 text-center">
                <p class="text-muted small mb-3">Skip Google OAuth and sign in directly.</p>
                <div class="d-flex gap-2 justify-content-center flex-wrap mb-3">
                    @* PersonasFor drops the Admin persona unless the host allows it — the
                       button and the route share one predicate. *@
                    @foreach (var persona in DevLoginController.PersonasFor(HostEnv, Config, Catalog))
                    {
                        <a asp-controller="DevLogin" asp-action="SignIn"
                           asp-route-persona="@persona.Slug"
                           asp-route-returnUrl="@ViewData["ReturnUrl"]"
                           class="btn btn-sm btn-outline-secondary">
                            @persona.DisplayName
                        </a>
                    }
                </div>
                <a asp-controller="DevLogin" asp-action="Users"
                   asp-route-returnUrl="@ViewData["ReturnUrl"]"
                   class="btn btn-sm btn-outline-warning">
                    Choose any user...
                </a>
            </div>
        </div>
    </div>
</div>
