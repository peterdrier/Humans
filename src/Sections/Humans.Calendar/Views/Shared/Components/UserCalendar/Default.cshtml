@model Humans.Calendar.Contracts.UserCalendarViewModel

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-calendar-days me-2"></i>@Localizer["Calendar_UserFeedTitle"]</span>
        @if (!Model.LoadFailed)
        {
            <small class="text-muted">
                @Model.Items.Count @(Model.Items.Count == 1 ? Localizer["Calendar_UserFeedItem"] : Localizer["Calendar_UserFeedItems"])
                &middot; @Localizer[Model.HasFeedToken ? "Calendar_UserFeedProvisioned" : "Calendar_UserFeedNotProvisioned"]
            </small>
        }
    </div>
    @if (Model.LoadFailed)
    {
        <div class="card-body text-danger">@Localizer["Calendar_UserFeedLoadFailed"]</div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="card-body text-muted">@Localizer["Calendar_UserFeedEmpty"]</div>
    }
    else
    {
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Calendar_UserFeedSource"]</th>
                        <th>@Localizer["Calendar_UserFeedSummary"]</th>
                        <th>@Localizer["Calendar_Start"]</th>
                        <th>@Localizer["Calendar_UserFeedEnd"]</th>
                        <th>@Localizer["Calendar_Location"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.Source</span></td>
                            <td>@item.Summary</td>
                            <td>@item.Start.ToDateTime()</td>
                            <td>@item.End.ToDateTime()</td>
                            <td class="text-muted">@item.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
