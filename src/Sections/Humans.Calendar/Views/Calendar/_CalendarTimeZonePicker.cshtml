@model string
@* Changing the zone saves it as the session's display zone (the same /api/timezone the browser reports to). *@
<div class="d-flex align-items-center gap-2 mb-3 small text-muted">
    <label for="calendar-timezone" class="mb-0">@Localizer["Calendar_TimeZoneLabel"]</label>
    <select id="calendar-timezone" class="form-select form-select-sm w-auto" data-error="@SharedLocalizer["Common_Error"]">
        @foreach (var id in DateTimeZoneProviders.Tzdb.Ids.Order(StringComparer.Ordinal))
        {
            <option value="@id" selected="@(id == Model ? "selected" : null)">@id</option>
        }
    </select>
</div>
<script nonce="@Context.Items["CspNonce"]">
    (function () {
        var picker = document.getElementById('calendar-timezone');
        var displayedZone = picker.value;
        picker.addEventListener('change', function () {
            if (picker.disabled) return;
            picker.disabled = true;
            fetch('/api/timezone', {
                method: 'POST',
                redirect: 'error',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ timeZone: picker.value })
            }).then(function (response) {
                if (!response.ok) throw new Error('Timezone save failed');
                location.reload();
            }).catch(function () {
                picker.value = displayedZone;
                showToast(picker.dataset.error, 'danger');
            }).finally(function () {
                picker.disabled = false;
            });
        });
    })();
</script>
