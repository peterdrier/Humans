@model Humans.Calendar.Models.CalendarEventFormViewModel
@{
    ViewData["Title"] = Localizer["Calendar_EditEvent"].Value;
}

<div class="container py-4">
    <page-header title="@(Localizer["Calendar_EditEvent"].Value)" />

    <div class="card mw-720">
        <div class="card-body">
            <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <partial name="_CalendarEventFormFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@SharedLocalizer["Common_Save"]</button>
                    <a class="btn btn-outline-secondary" asp-action="Event" asp-route-id="@Model.Id">@SharedLocalizer["Common_Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
