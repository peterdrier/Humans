@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error.
   CI doesn't guard it (CalendarPageRenderTests is integration-only); the preview deploy shows it. *@
@using Humans.Base.Extensions
@using Humans.Calendar
@using Humans.Calendar.Domain
@using Humans.Calendar.Models
@using Humans.Calendar.Services
@using Humans.Calendar.Services.Dtos
@using Humans.Base
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<CalendarResource> Localizer
@* SharedLocalizer covers Common_ keys and Profile_Location, which other sections render too. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@addTagHelper *, Humans.AuditLog
