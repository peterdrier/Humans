<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Scanner.Tests" />
    <!-- The one test assembly allowed to see many sections. -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not. -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- No Humans.Infrastructure reference: Scanner owns no tables, so no DbContext and no repository. -->
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Events.Contracts\Humans.Events.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Consent.Contracts\Humans.Consent.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Shifts.Contracts\Humans.Shifts.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <!--
      Tickets: the leaf for TicketStubInfo, and the section project for the <vc:ticket-stub>
      tag helper — it is generated from the component type, which lives in Humans.Tickets;
      a leaf-only reference renders the element as inert literal markup. Acyclic: Tickets
      names nothing in Scanner.
    -->
    <ProjectReference Include="..\Humans.Tickets\Humans.Tickets.csproj" />
    <ProjectReference Include="..\Humans.Tickets.Contracts\Humans.Tickets.Contracts.csproj" />
    <ProjectReference Include="..\Humans.EarlyEntry\Humans.EarlyEntry.csproj" />
    <!--
      Calendar: IICalFeedService for the member's shift commitments. Calendar's Contracts/
      is a folder, not a leaf, so the reference is to the section project (acyclic).
    -->
    <ProjectReference Include="..\Humans.Calendar\Humans.Calendar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No AspNetCore package: it would fail NU1010 under Central Package Management, and the
      framework reference Sdk.Razor adds covers the controller. No EF Core — no tables.
    -->
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the section's docs visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
