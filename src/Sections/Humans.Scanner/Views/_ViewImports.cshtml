@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by ScannerPageRenderTests (step 12). *@
@using Humans.Application.Extensions
@using Humans.Domain.Enums
@using Humans.Scanner
@using Humans.Scanner.Controllers
@using Humans.Scanner.Models
@using Humans.UI
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ScannerResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* <vc:ticket-stub> lives in Humans.UI, not Shell: a section can only addTagHelper against
   Humans.UI, and a Shell-resident component renders as inert literal markup (step 6). *@
@addTagHelper *, Humans.UI
