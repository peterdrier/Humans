@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by ScannerPageRenderTests (step 12). *@
@using Humans.Application.Extensions
@using Humans.Domain.Enums
@using Humans.Scanner
@using Humans.Tickets.Contracts
@using Humans.Scanner.Controllers
@using Humans.Scanner.Models
@using Humans.UI
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ScannerResource> Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.UI
@* <vc:ticket-stub> is the Tickets section's own component, public under
   Humans.Tickets/Contracts/ so MVC's default provider discovers it and the tag helper is
   generated. It was parked in Humans.UI until Tickets' own G5; a Shell-resident component
   would have rendered as inert literal markup (step 6). *@
@addTagHelper *, Humans.Tickets
