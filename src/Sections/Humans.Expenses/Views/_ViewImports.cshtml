@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error — see design §1/§2.
   Guarded by the rendered-HTML diff in step 12. *@
@using Humans.Expenses
@using Humans.Expenses.Contracts
@using Humans.Expenses.Domain
@using Humans.Expenses.Models
@using Humans.Expenses.Services
@using Humans.Expenses.Services.Dtos
@using Humans.Budget
@using Humans.Finance.Contracts
@using Humans.Base.Extensions
@using Humans.Base.Helpers
@using Humans.Base
@using Humans.Base.Models.Tables
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<ExpensesResource> Localizer
@* Genuinely shared strings (Common_*) stay in SharedResource — copying them into each
   section's .resx would duplicate them ~35 times. A section view that needs one uses
   SharedLocalizer explicitly, so which set a key comes from is visible at the call site. *@
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@* <vc:audit-log> (Expenses/Detail) is the AuditLog section's own component; without this the
   tag ships as inert literal markup with a green build and no runtime error. *@
@addTagHelper *, Humans.AuditLog
