@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error. *@
@using Humans.Expenses
@using Humans.Expenses.Contracts
@using Humans.Expenses.Domain
@using Humans.Expenses.Models
@using Humans.Expenses.Services
@using Humans.Expenses.Services.Dtos
@using Humans.Budget
@using Humans.Finance.Contracts
@using Humans.Preapprovals.Contracts
@using Humans.Base.Extensions
@using Humans.Base.Helpers
@using Humans.Base
@using Humans.Base.Models.Tables
@using Microsoft.Extensions.Localization
@using NodaTime
@inject IStringLocalizer<ExpensesResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
@* Without this, <vc:audit-log> ships as inert markup with a green build and no runtime error. *@
@addTagHelper *, Humans.AuditLog
