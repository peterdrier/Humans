@model Humans.Expenses.Models.ExpensesIndexViewModel
@using Humans.Expenses.Services.Dtos
@using Humans.UI.Extensions
@using Humans.UI.Models.Tables
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Localizer["Expenses_MyReportsTitle"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@Localizer["Expenses_MyReportsTitle"]</h1>
    <div class="d-flex gap-2">
        @if (Model.IsCoordinator)
        {
            <a asp-action="Coordinator" class="btn btn-outline-secondary">
                <i class="fa-solid fa-list-check me-1"></i>@Localizer["Expenses_CoordinatorQueue"]
                @if (Model.CoordinatorQueueCount > 0)
                {
                    <span class="badge text-bg-secondary ms-1">@Model.CoordinatorQueueCount</span>
                }
            </a>
        }
        @if (Model.HasActiveYear)
        {
            <a asp-action="New" class="btn btn-primary">
                <i class="fa-solid fa-plus me-1"></i>@Localizer["Expenses_NewReport"]
            </a>
        }
    </div>
</div>


@if (Model.AccountLedger is { } acct)
{
    <div class="card mb-4 border-info">
        <div class="card-header bg-info-subtle d-flex justify-content-between align-items-center">
            <strong><i class="fa-solid fa-building-columns me-1"></i>@Localizer["Expenses_IouHeader"] · @acct.SupplierAccountNum</strong>
            <span>
                <span class="text-muted small me-1">@Localizer["Expenses_IouOwed"]</span>
                <span class="fs-5 fw-semibold @(acct.OwedToMember > 0 ? "text-danger" : "")">@acct.OwedToMember.ToEuro()</span>
            </span>
        </div>
        @if (acct.Lines.Count > 0)
        {
            <table class="table table-sm table-hover mb-0 align-middle">
                <thead><tr>
                    <th>@SharedLocalizer["Common_Date"]</th>
                    <th>@Localizer["Expenses_LedgerColItem"]</th>
                    <th class="text-end">@SharedLocalizer["Common_Amount"]</th>
                </tr></thead>
                <tbody>
                @foreach (var l in acct.Lines)
                {
                    // Credit = owed to the member (in, +); debit = paid/settled (out, −).
                    var net = l.Credit - l.Debit;
                    <tr>
                        <td class="text-nowrap">@l.Date.ToDateTimeUtc().ToInvariantDate()</td>
                        <td>@l.Description</td>
                        <td class="text-end @(net < 0 ? "text-success" : "")">@net.ToEuro()</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}
else if (Model.AwaitingFirstLedgerActivity)
{
    @* Bound, but Holded has booked nothing to the account yet. Telling a correctly-bound member to
       go get bound again would send them to Finance for a non-problem. *@
    <div class="alert alert-secondary">
        <i class="fa-solid fa-circle-info me-1"></i>@Localizer["Expenses_CreditorAccountNoActivity", Model.BoundAccountNum!]
    </div>
}
else
{
    <div class="alert alert-secondary">
        <i class="fa-solid fa-circle-info me-1"></i>@Localizer["Expenses_NoCreditorAccount"]
    </div>
}

@if (!Model.HasActiveYear)
{
    <div class="alert alert-info">
        @Localizer["Expenses_NoActiveYear"]
    </div>
}
else if (!Model.HasIban)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation me-1"></i>
        @Localizer["Expenses_NoIban"]
    </div>
}

@if (Model.Reports.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="fa-solid fa-receipt fa-2x mb-3 d-block"></i>
            <p class="mb-0">@Localizer["Expenses_NoReports"]</p>
            @if (Model.HasActiveYear)
            {
                <a asp-action="New" class="btn btn-outline-primary mt-3">@Localizer["Expenses_FileFirst"]</a>
            }
        </div>
    </div>
}
else
{
    Func<ExpenseReportDto, IHtmlContent> reportActionCell =
        @<text><a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common_View"]</a></text>;
    var reportRows = Model.Reports.OrderByDescending(x => x.CreatedAt).ToList();
    var reportsTable = TableModel.For(reportRows)
        .Column(SharedLocalizer["Common_Created"].Value, r => r.CreatedAt, c => c.Date())
        .Column(BudgetLocalizer["Budget_ColCategory"].Value, r => Model.CategoryNames.TryGetValue(r.BudgetCategoryId, out var cat) ? cat : r.BudgetCategoryId.ToString())
        .Column(Localizer["Expenses_ColSubject"].Value, r => r.Note is { Length: > 60 } n ? n[..60] + "…" : r.Note)
        .Column(SharedLocalizer["Common_Status"].Value, r => r.Status, c => c.EnumBadge())
        .Column(SharedLocalizer["Common_Total"].Value, r => r.Total, c => c.Currency().End())
        .Template("", reportActionCell, c => c.NoSort().End())
        .Build();
    <partial name="_Table" model="reportsTable" />
}
