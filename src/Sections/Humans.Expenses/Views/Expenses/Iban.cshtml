@model Humans.Expenses.Models.ExpenseIbanViewModel
@using Humans.Base.ViewComponents
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<ExpensesResource> HtmlLocalizer
@{
    ViewData["Title"] = Localizer["Expenses_PaymentIban"].Value;
    Microsoft.AspNetCore.Html.IHtmlContent? memberHtml = null;
    if (Model.OnBehalfOfUserId is { } memberId)
    {
        var member = await Component.InvokeAsync(typeof(HumanViewComponent), new
        {
            userId = memberId,
            link = HumanLink.None,
        });
        using var memberWriter = new System.IO.StringWriter();
        member.WriteTo(memberWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
        // Keep template whitespace out of the localized sentence's punctuation.
        memberHtml = new Microsoft.AspNetCore.Html.HtmlString(memberWriter.ToString().Trim());
    }
}

<nav aria-label="@Localizer["Expenses_BreadcrumbNavigation"]" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Expenses_MyReportsTitle"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Detail" asp-route-id="@Model.ReportId">@Localizer["Expenses_ColReport"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Expenses_PaymentIban"]</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-6">
        <h1 class="mb-1">@Localizer["Expenses_PaymentIban"]</h1>
        @* An admin setting this for somebody else is editing that member's profile, not their own —
           say whose account it is before they type an account number into it. *@
        @if (memberHtml is not null)
        {
            <div class="alert alert-warning mb-4">
                @HtmlLocalizer["Expenses_IbanOnBehalf", memberHtml]
            </div>
        }
        else
        {
            <p class="text-muted mb-4">@Localizer["Expenses_IbanPrivacy"]</p>
        }


        <div class="card">
            <div class="card-body">
                @if (Model.HasIban)
                {
                    <p class="mb-3">
                        @Localizer["Expenses_CurrentIban"]: <span class="font-monospace fw-semibold">@Model.MaskedIban</span>
                    </p>
                }

                <form asp-action="Iban" asp-route-id="@Model.ReportId" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Iban" class="form-label">
                            @(Model.HasIban && Model.CanRemoveIban
                                ? Localizer["Expenses_NewIbanOrRemove"]
                                : Model.HasIban ? Localizer["Expenses_NewIban"] : Localizer["Expenses_Iban"])
                        </label>
                        <input asp-for="Iban" class="form-control font-monospace"
                               placeholder="@Localizer["Expenses_IbanPlaceholder"].Value"
                               maxlength="34"
                               autocomplete="off"
                               autofocus />
                        @* A report awaiting payment still needs its IBAN, so the service refuses to
                           clear one — don't offer the removal on those. *@
                        <div class="form-text">
                            @if (memberHtml is not null)
                            {
                                @HtmlLocalizer[Model.CanRemoveIban
                                    ? "Expenses_IbanEnterForMember"
                                    : "Expenses_IbanEnterForMemberNoRemove", memberHtml]
                            }
                            else if (Model.CanRemoveIban)
                            {
                                @Localizer["Expenses_IbanEnterOrRemove"]
                            }
                            else
                            {
                                @Localizer["Expenses_IbanEnter"]
                            }
                        </div>
                        <span asp-validation-for="Iban" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@Localizer["Expenses_Save"]</button>
                        <a asp-action="Detail" asp-route-id="@Model.ReportId" class="btn btn-outline-secondary">@Localizer["Expenses_Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-3 text-muted small">
            <i class="fa-solid fa-lock me-1"></i>
            @if (memberHtml is not null)
            {
                @HtmlLocalizer["Expenses_IbanStoredForMember", memberHtml]
            }
            else
            {
                @Localizer["Expenses_IbanStored"]
            }
        </div>
    </div>
</div>
