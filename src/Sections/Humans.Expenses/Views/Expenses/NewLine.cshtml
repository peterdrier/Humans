@model Humans.Expenses.Models.ExpenseLineNewViewModel
@{
    ViewData["Title"] = Localizer[Model.IsInvoice ? "Expenses_AddInvoice" : "Expenses_AddReceipt"].Value;
}

<nav aria-label="@Localizer["Expenses_BreadcrumbNavigation"]" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Expenses_MyReportsTitle"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Edit" asp-route-id="@Model.ReportId">@Localizer["Expenses_EditReport"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer[Model.IsInvoice ? "Expenses_AddInvoice" : "Expenses_AddReceipt"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <strong>@Localizer[Model.IsInvoice ? "Expenses_AddInvoice" : "Expenses_AddReceipt"]</strong>
            </div>
            <div class="card-body">
                @if (Model.IsInvoice)
                {
                    <p class="text-muted">
                        @Localizer["Expenses_InvoiceAddDescription"]
                    </p>
                }
                else
                {
                    <p class="text-muted">
                        @Localizer["Expenses_ReceiptAddDescription"]
                    </p>
                }

                <form asp-action="AddLine" asp-route-id="@Model.ReportId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LineType" value="@(Model.IsInvoice ? ExpenseLineType.Invoice : ExpenseLineType.Receipt)" />

                    <div class="mb-3">
                        <label class="form-label">@Localizer[Model.IsInvoice ? "Expenses_InvoicePurpose" : "Expenses_ReceiptPurpose"] <span class="text-danger">*</span></label>
                        <input type="text" name="Description" class="form-control" maxlength="500" required
                               placeholder="@Localizer[Model.IsInvoice ? "Expenses_InvoicePlaceholder" : "Expenses_ReceiptPlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Expenses_AmountEur"] <span class="text-danger">*</span></label>
                        <input type="number" name="Amount" class="form-control" step="0.01" min="0.01" placeholder="0.00" required style="max-width:200px;" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">@Localizer[Model.IsInvoice ? "Expenses_InvoiceFile" : "Expenses_ReceiptFile"] <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.heic" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            @Localizer[Model.IsInvoice ? "Expenses_SaveAndAddReceipts" : "Expenses_SaveReceipt"]
                        </button>
                        <a asp-action="Edit" asp-route-id="@Model.ReportId" class="btn btn-outline-secondary">@Localizer["Expenses_Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>

        <p class="mt-3 text-center">
            <a asp-action="NewLine" asp-route-id="@Model.ReportId" class="text-decoration-none">
                &larr; @Localizer[Model.IsInvoice ? "Expenses_NotAnInvoice" : "Expenses_NotAReceipt"] @Localizer["Expenses_ChangeType"]
            </a>
        </p>
    </div>
</div>
