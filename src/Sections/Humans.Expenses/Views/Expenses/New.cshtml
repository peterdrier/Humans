@model Humans.Expenses.Models.ExpenseNewViewModel
@{
    ViewData["Title"] = Localizer["Expenses_NewExpenseReport"].Value;
}

<nav aria-label="@Localizer["Expenses_BreadcrumbNavigation"]" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Expenses_MyReportsTitle"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Expenses_NewReport"]</li>
    </ol>
</nav>

<h1 class="mb-4">@Localizer["Expenses_NewExpenseReport"]</h1>


<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="New" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @* Finance admins file for members who cannot do it themselves. The report is the
                       member's from the moment it is created — the admin is only the actor. *@
                    <div class="mb-3" authorize-policy="FinanceAdminOrAdmin">
                        <label class="form-label" for="human-search-expense-submitter">@Localizer["Expenses_ForMember"]</label>
                        <vc:human-search field-name="SubmitterUserId"
                                         instance-key="expense-submitter"
                                         scope="Name"
                                         selected-user-id="@Model.SubmitterUserId" />
                        <div class="form-text">@Localizer["Expenses_ForMemberHelp"]</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BudgetCategoryId" class="form-label">@Localizer["Expenses_BudgetCategory"] <span class="text-danger">*</span></label>
                        <select asp-for="BudgetCategoryId" class="form-select" required>
                            <option value="">@Localizer["Expenses_SelectCategory"]</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@c.DisplayName</option>
                            }
                        </select>
                        <span asp-validation-for="BudgetCategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label">@Localizer["Expenses_ColSubject"] <small class="text-muted">@Localizer["Expenses_OptionalMaxChars"]</small></label>
                        <textarea asp-for="Note" class="form-control" rows="3" maxlength="500" placeholder="@Localizer["Expenses_SubjectPlaceholder"]"></textarea>
                        <span asp-validation-for="Note" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@Localizer["Expenses_CreateDraft"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Expenses_Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title">@Localizer["Expenses_HowItWorks"]</h6>
                <ol class="small text-muted mb-0">
                    <li>@Localizer["Expenses_HowItWorksStep1"]</li>
                    <li>@Localizer["Expenses_HowItWorksStep2"]</li>
                    <li>@Localizer["Expenses_HowItWorksStep3"]</li>
                    <li>@Localizer["Expenses_HowItWorksStep4"]</li>
                    <li>@Localizer["Expenses_HowItWorksStep5"]</li>
                </ol>
            </div>
        </div>
    </div>
</div>
