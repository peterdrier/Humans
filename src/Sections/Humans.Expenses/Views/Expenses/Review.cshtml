@model Humans.Expenses.Models.ExpenseReviewViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Localizer["Expenses_ReviewQueueTitle"].Value;
    @* Coordinators and members reach the same queue; an admin sidebar filtered down to nothing
       is worse than no admin sidebar, so only finance admins get the admin shell. *@
    Layout = Model.IsAdminView ? "_AdminLayout" : "_Layout";
}

@if (!Model.IsAdminView)
{
    @* The admin shell renders its own breadcrumb; the member shell does not. *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">@Localizer["Expenses_MyReportsTitle"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Localizer["Expenses_ReviewQueue"]</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Localizer["Expenses_ReviewQueue"]</h1>
</div>

@* Approved reports whose Holded push was written off look identical to healthy ones in every
   other view, so without this they are only discoverable by reconciling Holded by hand
   (nobodies-collective/Humans#1045). Finance admins are the only ones who can act on it. *@
@if (Model.FailedHoldedPushCount > 0)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        <strong>@Model.FailedHoldedPushCount</strong>
        approved @(Model.FailedHoldedPushCount == 1 ? "report" : "reports")
        failed to finish pushing to Holded. Open the report to see the error, whether a payable was
        created, and to re-queue the push.
    </div>
}

@if (!Model.Reports.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-inbox me-2"></i>@Localizer["Expenses_NoReportsAwaiting"]
    </div>
}
else
{
    Func<ExpenseReportDto, IHtmlContent> reportCell =
        @<text><a asp-action="Detail" asp-route-id="@item.Id">@item.Id.ToString()[..8]…</a></text>;
    @* One table per status rather than one status column: the queue is read as three separate
       piles of work, and grouping leaves each pile independently sortable and filterable. *@
    foreach (var group in Model.ByStatus)
    {
        var rows = group.ToList();
        var table = TableModel.For(rows)
            .Id($"review-{group.Key}")
            .Template(Localizer["Expenses_ColReport"].Value, reportCell)
            .Column(Localizer["Expenses_ColSubmittedBy"].Value, r => Model.SubmitterNames.TryGetValue(r.SubmitterUserId, out var name) ? name : SharedLocalizer["Common_Unknown"].Value)
            .Column(Localizer["Expenses_ColDepartment"].Value, r => Model.DepartmentNames.TryGetValue(r.BudgetCategoryId, out var dept) ? dept : SharedLocalizer["Common_Unknown"].Value, c => c.SelectFilter())
            .Column(Localizer["Expenses_ColSubject"].Value, r => r.Note is { Length: > 80 } n ? n[..80] + "…" : r.Note)
            @* Requested is the receipts total; a capped report pays the cap instead, so all three
               stay visible. Currency() rather than a template so they sort numerically — and a
               populated Max amount is already the signal that Payable was cut. *@
            .Column(Localizer["Expenses_ColRequested"].Value, r => r.Total, c => c.Currency().End())
            .Column(Localizer["Expenses_MaxAmount"].Value, r => r.MaxAmount, c => c.Currency().End())
            .Column(Localizer["Expenses_ColPayable"].Value, r => r.Payable, c => c.Currency().End())
            @* A template column sorts on its rendered text, so "Aug" would sort before "Jan".
               Date() hands the sorter the epoch value and formats the cell the same way. *@
            .Column(Localizer["Expenses_ColSubmitted"].Value, r => r.SubmittedAt, c => c.Date())
            .Build();

        <h2 class="h5 mt-4 mb-2">
            <span class="badge @group.Key.GetBadgeClass()">@Localizer.EnumDisplay(group.Key)</span>
            <span class="text-muted ms-1">@rows.Count</span>
        </h2>
        <partial name="_Table" model="table" />
    }
}
