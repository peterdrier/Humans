@using Humans.UI.Extensions
@model Humans.Expenses.Models.ExpenseReviewViewModel
@{
    ViewData["Title"] = "Expense Reports — Finance Review";
    Layout = "_AdminLayout";
    var badgeClass = (ExpenseReportStatus s) => s.GetBadgeClass();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">Finance Review</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Finance Review</h1>
</div>

@* Approved reports whose Holded push was written off look identical to healthy ones in every
   other view, so without this they are only discoverable by reconciling Holded by hand
   (nobodies-collective/Humans#1045). *@
@if (Model.FailedHoldedPushCount > 0)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        <strong>@Model.FailedHoldedPushCount</strong>
        approved @(Model.FailedHoldedPushCount == 1 ? "report" : "reports")
        failed to finish pushing to Holded. Open the report to see the error, whether a payable was
        created, and to re-queue the push.
    </div>
}


@if (!Model.Reports.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-inbox me-2"></i>No reports require review.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Report</th>
                    <th>Submitter</th>
                    <th>Subject</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td>
                            <a asp-action="Detail" asp-route-id="@r.Id">
                                @r.Id.ToString()[..8]…
                            </a>
                        </td>
                        <td>@(Model.SubmitterNames.TryGetValue(r.SubmitterUserId, out var name) ? name : "(unknown)")</td>
                        <td>@(r.Note is { Length: > 60 } n ? n[..60] + "…" : r.Note)</td>
                        @* Capped reports pay the cap, not the receipts total — show both so the difference is visible. *@
                        <td>
                            @r.Payable.ToEuro()
                            @if (r.Payable < r.Total)
                            {
                                <span class="text-muted small ms-1"><s>@r.Total.ToEuro()</s></span>
                            }
                        </td>
                        <td>
                            <span class="badge @badgeClass(r.Status)">@r.Status</span>
                        </td>
                        <td>
                            @if (r.SubmittedAt.HasValue)
                            {
                                @r.SubmittedAt.Value.ToDate()
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Detail" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-eye me-1"></i>View
                                </a>
                                @if (r.Status is ExpenseReportStatus.Submitted or ExpenseReportStatus.CoordinatorEndorsed)
                                {
                                    <button type="button" class="btn btn-sm btn-success"
                                            data-bs-toggle="modal"
                                            data-bs-target="#approveModal-@r.Id">
                                        <i class="fa-solid fa-check me-1"></i>Approve
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rejectModal-@r.Id">
                                        <i class="fa-solid fa-xmark me-1"></i>Reject
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @foreach (var r in Model.Reports.Where(x =>
        x.Status is ExpenseReportStatus.Submitted or ExpenseReportStatus.CoordinatorEndorsed))
    {
        <div class="modal fade" id="approveModal-@r.Id" tabindex="-1"
             aria-labelledby="approveModalLabel-@r.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="Approve" asp-route-id="@r.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="approveModalLabel-@r.Id">Approve Report</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-3">
                                Receipts total: <strong>@r.Total.ToEuro()</strong>
                            </p>
                            <div class="mb-3">
                                <label class="form-label">Max amount (optional)</label>
                                <input type="number" class="form-control" name="MaxAmount"
                                       step="0.01" min="0.01" value="@(r.MaxAmount?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                       placeholder="Leave blank for no cap">
                                <div class="form-text">Caps the payout below the receipts total. Overrides the coordinator's cap.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Category override (optional)</label>
                                <input type="text" class="form-control" name="OverrideCategoryId"
                                       placeholder="Category GUID to override, or leave blank">
                                <div class="form-text">Leave blank to keep the original category.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Approve</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @foreach (var r in Model.Reports.Where(x =>
        x.Status is ExpenseReportStatus.Submitted or ExpenseReportStatus.CoordinatorEndorsed))
    {
        <div class="modal fade" id="rejectModal-@r.Id" tabindex="-1"
             aria-labelledby="rejectModalLabel-@r.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="Reject" asp-route-id="@r.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="rejectModalLabel-@r.Id">Reject Report</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">
                                The submitter will see this reason. Explain clearly why the report is being rejected.
                            </p>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Rejection reason <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control" name="Reason"
                                          rows="3" maxlength="1000" required
                                          placeholder="e.g. Missing documentation for line 3"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
