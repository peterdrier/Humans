<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Expenses.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <!--
      The report grid's category column renders Budget's own Budget_ColCategory key
      (IStringLocalizer<BudgetResource>). Acyclic: nothing on Humans.Budget's graph names
      Expenses (memory/architecture/section-project-cycle-fix.md).
    -->
    <ProjectReference Include="..\Humans.Budget\Humans.Budget.csproj" />
    <!--
      <vc:audit-log> on the report detail page. Acyclic: nothing on Humans.AuditLog's graph
      names Expenses.
    -->
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <!--
      Creditor bindings and the payment round-trip come from Finance's contracts leaf, never
      from Humans.Finance itself (memory/architecture/section-project-cycle-fix.md).
    -->
    <ProjectReference Include="..\Humans.Finance.Contracts\Humans.Finance.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr\Humans.Gdpr.csproj" />
    <!--
      The Holded API client (IHoldedClient + its DTOs and typed exceptions) the outbox drain
      writes purchase documents through, from Humans.Holded's Contracts/ folder.
    -->
    <ProjectReference Include="..\Humans.Holded\Humans.Holded.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jobs/HoldedExpenseOutboxJob.cs — [DisableConcurrentExecution] and IRecurringJob.
         Package, not project, so no cycle is possible. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
