<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain Microsoft.NET.Sdk, not Sdk.Razor: the section has no controllers and no views.
    AccountController and its Views/Account/* stayed in Shell — see Section.cs.

    The framework reference is here for Microsoft.AspNetCore.Authorization only:
    RoleAssignmentAuthorizationHandler is a resource-based handler (template step 6) and
    CachingRoleAssignmentService is registered as an IHostedService. Central Package
    Management has no PackageVersion for the AspNetCore packages by design, so the
    framework reference is the only way to get them (template step 1).
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Auth.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
    <!--
      Temporary, both directions of Teams finding 36's trade. ServiceTestHarness and its
      copy TeamsTestHarness seed role_assignments rows for tests belonging to sections that
      have not moved (Shifts, GoogleIntegration, Users) and for Teams' own role tests.
      Both entries come out when those sections' own G5 lanes rewrite their fixtures.
    -->
    <InternalsVisibleTo Include="Humans.Application.Tests" />
    <InternalsVisibleTo Include="Humans.Teams.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Interfaces\Humans.Interfaces.csproj" />
    <ProjectReference Include="..\Humans.Auth.Contracts\Humans.Auth.Contracts.csproj" />
    <!--
      Three horizontal leaves:
      AuditLog  — RoleAssignmentService writes an audit row per assign/end.
      Gdpr      — role assignments are an Article 15 export slice.
      Notifications — best-effort in-app notice to the human whose role changed.

      Two *vertical* leaves are also here, both for the magic-link sign-in path that came home
      at nobodies-collective/Humans#866 G5 lane 4b-2i:

      Users.Contracts — already required before that lane (IUserServiceRead for assignee/creator
                        display stitching); MagicLinkService adds UserManager<User> and
                        IUserEmailService on top.
      Email.Contracts — IEmailService + IEmailMessageFactory, which MagicLinkService injects to
                        send the login/signup mail. This reference is exactly what the old
                        "a horizontal may not reference a vertical" reading forbade, and it is
                        why the orchestrator sat in Humans.Application until now. Peter's
                        Base-floor decision of 2026-08-14 supersedes that reading: leaves are
                        referenceable from anywhere, so hosting a section's own sign-in path in
                        the hub bought nothing. AuthArchitectureTests.SectionReferencesNoVerticalSection,
                        which pinned this list on the old premise, was retired in the same lane —
                        this comment is the record now, so keep a reason beside every name.

      Humans.Teams.Contracts arrived at G5 lane 5c: ISystemTeamSync moved onto that leaf when
      Humans.Application was emptied, and RoleAssignmentService injects it to reconcile the
      Board system team. A leaf, not the section — the horizontal/vertical rule still holds.
      There is still deliberately no Humans.Onboarding.Contracts reference.
    -->
    <ProjectReference Include="..\Humans.AuditLog.Contracts\Humans.AuditLog.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Notifications.Contracts\Humans.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
