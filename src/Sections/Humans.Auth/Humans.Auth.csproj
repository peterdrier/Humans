<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain Microsoft.NET.Sdk, not Sdk.Razor: the section has no controllers and no views.
    AccountController and its Views/Account/* stayed in Shell — see Section.cs.

    The framework reference is here for Microsoft.AspNetCore.Authorization only:
    RoleAssignmentAuthorizationHandler is a resource-based handler (template step 6) and
    CachingRoleAssignmentService is registered as an IHostedService. Central Package
    Management has no PackageVersion for the AspNetCore packages by design, so the
    framework reference is the only way to get them (template step 1).
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Auth.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
    <!-- Temporary: TeamsTestHarness seeds role_assignments rows for Teams' own role tests; comes out when that fixture is rewritten. -->
    <InternalsVisibleTo Include="Humans.Teams.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <!--
      One reason per reference:
      AuditLog      — RoleAssignmentService writes an audit row per assign/end.
      Gdpr          — role assignments are an Article 15 export slice.
      Notifications.Contracts — best-effort in-app notice to the human whose role changed.
      Users.Contracts — IUserService for assignee/creator display stitching;
                        MagicLinkService adds UserManager<User> and IUserEmailService.
      Email.Contracts — IEmailService, which MagicLinkService injects to send the
                        login/signup mail built by the section's own AuthEmails.
      Teams.Contracts — ISystemTeamSync, which RoleAssignmentService injects to reconcile
                        the Board system team.
      No Onboarding.Contracts reference.
    -->
    <ProjectReference Include="..\Humans.AuditLog\Humans.AuditLog.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr\Humans.Gdpr.csproj" />
    <ProjectReference Include="..\Humans.Notifications.Contracts\Humans.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
