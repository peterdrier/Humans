@model Humans.Auth.Models.CreateRoleAssignmentViewModel
@{
    ViewData["Title"] = Localizer["Auth_AddRole_Title"].Value;
}

@section Crumbs {
    <a asp-controller="UsersAdmin" asp-action="AdminDetail" asp-route-id="@Model.UserId">
        <vc:human user-id="@Model.UserId" link="None" popover="false" />
    </a>
    <span>@Localizer["Auth_AddRole_Title"]</span>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    @Localizer["Auth_Roles_AddRole"]:
                    <vc:human user-id="@Model.UserId" link="None" popover="false" />
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="AddRole" asp-route-id="@Model.UserId" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label">@SharedLocalizer["MyTeams_Role"]</label>
                        <select asp-for="RoleName" class="form-select">
                            <option value="">@Localizer["Auth_AddRole_SelectRole"]</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.Name">@role.Title</option>
                            }
                        </select>
                        <span asp-validation-for="RoleName" class="text-danger"></span>
                        <div class="form-text">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <strong>@role.Title:</strong> @role.Blurb<br />
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">@Localizer["Auth_AddRole_NotesLabel"]</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="@Localizer["Auth_AddRole_NotesPlaceholder"].Value"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@Localizer["Auth_Roles_AddRole"]</button>
                        <a asp-controller="UsersAdmin" asp-action="AdminDetail" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">@SharedLocalizer["Common_Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
