@using Humans.Auth.Contracts
@inject RoleCatalog Catalog
@model Humans.Auth.Models.AdminRoleAssignmentListViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Localizer["Auth_Roles_Title"]</h1>
    <span class="text-muted">@string.Format(SharedLocalizer["Admin_TotalCount"].Value, Model.TotalCount)</span>
</div>

<div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div class="btn-group" role="group">
            <a asp-action="Roles" asp-route-showInactive="@Model.ShowInactive"
               class="btn @(string.IsNullOrEmpty(Model.RoleFilter) ? "btn-primary" : "btn-outline-primary")">
                @Localizer["Auth_Roles_All"]
            </a>
            @foreach (var role in Catalog.Roles)
            {
                <a asp-action="Roles" asp-route-role="@role.Name" asp-route-showInactive="@Model.ShowInactive"
                   class="btn @(Model.RoleFilter == role.Name ? "btn-primary" : "btn-outline-primary")">
                    @role.Title
                </a>
            }
        </div>
        <div>
            @if (Model.ShowInactive)
            {
                <a asp-action="Roles" asp-route-role="@Model.RoleFilter" asp-route-showInactive="false" class="btn btn-outline-secondary btn-sm">
                    @Localizer["Auth_Roles_HideInactive"]
                </a>
            }
            else
            {
                <a asp-action="Roles" asp-route-role="@Model.RoleFilter" asp-route-showInactive="true" class="btn btn-outline-secondary btn-sm">
                    @Localizer["Auth_Roles_ShowInactive"]
                </a>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @{
            Func<AdminRoleAssignmentViewModel, IHtmlContent> userCell =
                @<text>
                    <vc:human user-id="@item.UserId" link="Admin" />
                    <br />
                    <small class="text-muted">@item.UserEmail</small>
                </text>;
            Func<AdminRoleAssignmentViewModel, IHtmlContent> roleCell =
                @<text><strong>@item.RoleName</strong></text>;
            Func<AdminRoleAssignmentViewModel, IHtmlContent> validToCell =
                @<text>
                    @if (item.ValidTo.HasValue)
                    {
                        @item.ValidTo.Value.ToDate()
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </text>;
            Func<AdminRoleAssignmentViewModel, IHtmlContent> statusCell =
                @<text>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">@SharedLocalizer["AdminHuman_Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Auth_Roles_Ended"]</span>
                    }
                </text>;
            Func<AdminRoleAssignmentViewModel, IHtmlContent> actionCell =
                @<text>
                    @if (item.IsActive)
                    {
                        <form asp-controller="RoleAssignments" asp-action="EndRole" asp-route-id="@item.UserId" asp-route-roleId="@item.Id" method="post" class="d-inline" authorize-policy="HumanAdminOrAdmin"
                              data-confirm="@Localizer["Auth_Roles_EndConfirm"].Value">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Auth_Roles_End"]</button>
                        </form>
                    }
                </text>;
            var rolesTable = TableModel.For(Model.RoleAssignments)
                .Template(Localizer["Auth_Roles_User"].Value, userCell)
                .Template(SharedLocalizer["MyTeams_Role"].Value, roleCell)
                .Column(Localizer["Auth_Roles_ValidFrom"].Value, ra => ra.ValidFrom.ToDate())
                .Template(Localizer["Auth_Roles_ValidTo"].Value, validToCell)
                .Template(SharedLocalizer["Common_Status"].Value, statusCell, c => c.NoSort())
                .Template("", actionCell, c => c.NoSort().End())
                .RowCss(ra => ra.IsActive ? null : "table-secondary")
                .Empty(Localizer["Auth_Roles_NoAssignments"].Value)
                .ServerMode(null, false, new PagerViewModel(Model.TotalPages, Model.PageNumber, "Roles") { NavCssClass = "mt-4" })
                .Build();
        }
        <partial name="_Table" model="rolesTable" />
    </div>
</div>
