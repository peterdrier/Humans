@model Humans.Debug.Controllers.WidgetGalleryViewModel
@using Humans.Base.Authorization
@using Humans.Base.Enums
@* This page catalogs Base and Shell widgets only. Every section-owned widget renders through the
   ChromeSlots.WidgetGallery chrome slot: the section contributes its own gallery view component
   from its SectionChrome (ISectionChrome), so Debug references no section for this page. *@
@{
    ViewData["Title"] = "Widget Gallery";
}

<style nonce="@Context.Items["CspNonce"]">
    .wg-toc {
        position: sticky;
        top: 1rem;
        background: var(--h-bg-card);
        border: 1px solid var(--h-border);
        border-radius: var(--h-radius);
        padding: 1rem;
        font-size: 0.85rem;
    }
    .wg-toc h6 {
        font-family: var(--h-font-display);
        margin-bottom: 0.5rem;
    }
    .wg-toc a {
        display: block;
        padding: 0.15rem 0;
        color: var(--h-aged-ink);
        text-decoration: none;
    }
    .wg-toc a:hover { color: var(--h-gold); }
    .wg-section { margin-bottom: 3rem; }
    .wg-section > h2 {
        font-family: var(--h-font-display);
        border-bottom: 2px solid var(--h-gold);
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }
    .wg-card {
        border: 1px solid var(--h-border);
        border-radius: var(--h-radius);
        padding: 1rem;
        background: var(--h-bg-card);
        margin-bottom: 1.5rem;
    }
    .wg-card-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px dashed var(--h-border-light);
    }
    .wg-card-name {
        font-family: 'Source Sans 3', monospace;
        font-weight: 600;
        font-size: 1rem;
        color: var(--h-aged-ink);
    }
    .wg-card-kind {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.15rem 0.5rem;
        border-radius: var(--h-radius);
        background: var(--h-bg-subtle, #eee);
        color: var(--h-sepia);
    }
    .wg-card-kind.kind-th { background: #d6e9ff; color: #0a3d6b; }
    .wg-card-kind.kind-vc { background: #ffe1cc; color: #6b3a0a; }
    .wg-card-kind.kind-pa { background: #d8f0d8; color: #1f5b1f; }
    .wg-card-path {
        font-family: 'Source Sans 3', monospace;
        font-size: 0.7rem;
        color: var(--h-sepia-light);
        word-break: break-all;
    }
    .wg-card-note {
        font-size: 0.85rem;
        color: var(--h-sepia);
        margin-bottom: 0.75rem;
    }

    /* Parameters table */
    .wg-params {
        display: grid;
        grid-template-columns: max-content 1fr;
        column-gap: 0.75rem;
        row-gap: 0.25rem;
        margin: 0 0 0.75rem 0;
        padding: 0.6rem 0.75rem;
        background: var(--h-bg-page, #fafafa);
        border-left: 3px solid var(--h-gold);
        border-radius: 0 var(--h-radius) var(--h-radius) 0;
        font-size: 0.8rem;
    }
    .wg-params dt {
        font-family: 'Source Sans 3', monospace;
        font-weight: 600;
        color: var(--h-aged-ink);
        margin: 0;
    }
    .wg-params dd {
        margin: 0;
        color: var(--h-sepia);
    }
    .wg-params dd code,
    .wg-params dt code {
        font-family: 'Source Sans 3', monospace;
        font-size: 0.78rem;
        background: rgba(0,0,0,0.04);
        padding: 0 0.25rem;
        border-radius: 3px;
    }
    .wg-params .wg-params-none {
        grid-column: 1 / -1;
        font-style: italic;
        color: var(--h-sepia-light);
    }
    .wg-auth-line {
        font-size: 0.78rem;
        color: var(--h-sepia);
        margin: 0 0 0.6rem 0;
        padding: 0.35rem 0.6rem;
        background: rgba(255, 215, 0, 0.08);
        border-left: 3px solid #ffaa00;
        border-radius: 0 4px 4px 0;
    }
    .wg-auth-line::before {
        content: "🔒 ";
    }

    /* Single example block (no variants) */
    .wg-card-example {
        padding: 0.75rem;
        background: var(--h-bg-page, #fafafa);
        border-radius: var(--h-radius);
        border: 1px dashed var(--h-border-light);
    }
    .wg-card-example.is-empty {
        font-style: italic;
        color: var(--h-sepia-light);
    }

    /* Two-column variant grid */
    .wg-variants {
        display: grid;
        grid-template-columns: minmax(160px, 240px) 1fr;
        gap: 0;
        background: var(--h-bg-page, #fafafa);
        border-radius: var(--h-radius);
        border: 1px dashed var(--h-border-light);
        overflow: hidden;
    }
    .wg-variants > .wg-variant-label,
    .wg-variants > .wg-variant-render {
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid var(--h-border-light);
    }
    .wg-variants > .wg-variant-label {
        background: rgba(0,0,0,0.025);
        border-right: 1px solid var(--h-border-light);
        font-size: 0.78rem;
        font-family: 'Source Sans 3', monospace;
        color: var(--h-aged-ink);
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }
    .wg-variants > .wg-variant-label .wg-variant-sub {
        font-size: 0.7rem;
        color: var(--h-sepia-light);
        font-family: 'Source Sans 3', sans-serif;
    }
    .wg-variants > .wg-variant-render {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .wg-variants > .wg-variant-label:last-of-type,
    .wg-variants > .wg-variant-render:last-of-type {
        border-bottom: none;
    }
</style>

@functions {
    private static IHtmlContent ParamsBlock(params (string Name, string Description)[] entries)
    {
        var html = new System.Text.StringBuilder();
        html.Append("<dl class=\"wg-params\">");
        if (entries.Length == 0)
        {
            html.Append("<dd class=\"wg-params-none\">(no parameters — uses ambient request context)</dd>");
        }
        else
        {
            foreach (var (name, desc) in entries)
            {
                html.Append($"<dt>{System.Net.WebUtility.HtmlEncode(name)}</dt><dd>{desc}</dd>");
            }
        }
        html.Append("</dl>");
        return new HtmlString(html.ToString());
    }

    private static IHtmlContent AuthLine(string text)
    {
        return new HtmlString(
            $"<div class=\"wg-auth-line\">{text}</div>");
    }
}

<div class="container my-4">
    <h1>Widget Gallery</h1>
    <p class="text-muted mb-4">
        A live catalog of every reusable UI widget — TagHelpers, ViewComponents, and shared partials —
        rendered against real data. Companion to <a href="/ColorPalette">/ColorPalette</a>.
        Admin-only. Base and Shell widgets are cataloged here; each section's own widgets arrive
        through the <code>ChromeSlots.WidgetGallery</code> slot under <a href="#sections">Section widgets</a>.
        Resolved sample data: current human <strong>@Model.CurrentUserDisplayName</strong>.
    </p>

    <div class="row">
        <div class="col-md-3 mb-3">
            <nav class="wg-toc">
                <h6>Sections</h6>
                <a href="#profile">Profile &amp; Identity</a>
                <a href="#sections">Section widgets</a>
                <a href="#dashboard">Personal Dashboard</a>
                <a href="#alerts">Notifications &amp; Alerts</a>
                <a href="#admin">Admin Chrome</a>
                <a href="#forms">Forms &amp; Inputs</a>
                <a href="#layout">Layout Bits</a>
                <a href="#skipped">Skipped (with reason)</a>
                <a href="#choosing">Choosing between them</a>
                <a href="#wg-tables">Tables</a>
            </nav>
        </div>

        <div class="col-md-9">

            <section id="profile" class="wg-section">
                <h2>Profile &amp; Identity</h2>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;vc:human&gt;</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/HumanViewComponent.cs</span>
                    </div>
                    <div class="wg-card-note">
                        One-stop human reference — text link, avatar, avatar+name, or card. Display name and avatar are resolved internally from the Profile section by human id.
                    </div>
                    @ParamsBlock(
                        ("user-id", "<code>Guid</code> — required"),
                        ("layout", "<code>HumanLayout</code> — Text (default) · Avatar · AvatarName · Card"),
                        ("link", "<code>HumanLink</code> — Public (default) · Admin · None"),
                        ("popover", "<code>bool</code> — hover-popover with profile summary (default true)"),
                        ("size", "<code>int</code> — avatar pixel size (default 40); applies to non-Text layouts"),
                        ("css-class", "<code>string?</code> — extra classes on the avatar element"),
                        ("bg-color", "<code>string</code> — background class for the initial fallback (default <code>bg-secondary</code>)")
                    )
                    <div class="wg-variants">
                        <div class="wg-variant-label">layout="Text"<span class="wg-variant-sub">default</span></div>
                        <div class="wg-variant-render"><vc:human user-id="@Model.CurrentUserId" /></div>

                        <div class="wg-variant-label">layout="Avatar"<span class="wg-variant-sub">size=48</span></div>
                        <div class="wg-variant-render"><vc:human user-id="@Model.CurrentUserId" layout="Avatar" size="48" /></div>

                        <div class="wg-variant-label">layout="AvatarName"<span class="wg-variant-sub">size=48</span></div>
                        <div class="wg-variant-render"><vc:human user-id="@Model.CurrentUserId" layout="AvatarName" size="48" /></div>

                        <div class="wg-variant-label">layout="Card"<span class="wg-variant-sub">size=64</span></div>
                        <div class="wg-variant-render"><div style="max-width: 160px;"><vc:human user-id="@Model.CurrentUserId" layout="Card" size="64" /></div></div>

                        <div class="wg-variant-label">link="Admin"<span class="wg-variant-sub">links to AdminDetail</span></div>
                        <div class="wg-variant-render"><vc:human user-id="@Model.CurrentUserId" link="Admin" /></div>

                        <div class="wg-variant-label">link="None"<span class="wg-variant-sub">no link, no popover</span></div>
                        <div class="wg-variant-render"><vc:human user-id="@Model.CurrentUserId" layout="Avatar" size="48" link="None" /></div>
                    </div>
                </div>

            </section>

            <section id="sections" class="wg-section">
                <h2>Section widgets</h2>
                <div class="wg-card-note" style="margin-bottom: 1.5rem;">
                    Every card below arrives through one chrome slot, <code>ChromeSlots.WidgetGallery</code>
                    (see <code>&lt;vc:chrome-slot&gt;</code> under <a href="#layout">Layout Bits</a>). Each section
                    owns its own gallery view component and contributes it from its <code>SectionChrome</code>
                    (<code>ISectionChrome</code>), so this page names no section and a section that is switched off
                    takes its cards with it. Cards are grouped by contributing section, in contribution order.
                </div>
                <vc:chrome-slot name="@ChromeSlots.WidgetGallery" />

            </section>

            <section id="dashboard" class="wg-section">
                <h2>Personal Dashboard</h2>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">_DashboardActionCard.cshtml</span>
                            <span class="wg-card-kind kind-pa">Partial</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/Views/Shared/_DashboardActionCard.cshtml</span>
                    </div>
                    <div class="wg-card-note">Reusable dashboard/guest action card. Caller supplies the route, text, icon, visual variant, and compact/full layout mode.</div>
                    @ParamsBlock(
                        ("@@model", "<code>DashboardActionCardViewModel</code> -- Controller, Action, Title, Description, IconCssClass, IconVariant, ColumnClass, Compact, IsPost, ConfirmMessage")
                    )
                    <div class="wg-card-example">
                        @await Html.PartialAsync("_DashboardActionCard", new DashboardActionCardViewModel
                        {
                            Controller = "Profile",
                            Action = "Index",
                            Title = "Edit profile",
                            Description = "Open the profile settings surface.",
                            IconCssClass = "fa-solid fa-user-pen",
                            IconVariant = "primary",
                            ColumnClass = string.Empty,
                            Compact = true,
                        })
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;vc:things-to-do&gt;</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/ThingsToDoViewComponent.cs + each section&#39;s ThingsToDo.cs</span>
                    </div>
                    <div class="wg-card-note">
                        Onboarding checklist on the human dashboard, merged from every section's
                        <code>ISectionThingsToDo</code> contribution for the signed-in member. Auto-hides when all
                        items are done — if you see nothing here, your account is fully onboarded.
                    </div>
                    <div class="wg-card-example">
                        <vc:things-to-do />
                    </div>
                </div>

            </section>

            <section id="alerts" class="wg-section">
                <h2>Notifications &amp; Alerts</h2>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;vc:temp-data-alerts&gt;</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/TempDataAlertsViewComponent.cs</span>
                    </div>
                    <div class="wg-card-note">
                        Renders flash messages from <code>TempData</code> (success / error / info). Empty here because no flash
                        was set on this request — see <code>HumansControllerBase.SetSuccess/SetError/SetInfo</code>.
                    </div>
                    @ParamsBlock()
                    <div class="wg-card-example">
                        <div class="text-muted small">↑ empty when no TempData keys are present.</div>
                    </div>
                </div>

            </section>

            <section id="admin" class="wg-section">
                <h2>Admin Chrome</h2>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;vc:admin-breadcrumb&gt;</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/AdminBreadcrumbViewComponent.cs</span>
                    </div>
                    <div class="wg-card-note">Resolves <em>Group / Page / Subpage</em> from the sections' <code>ISectionAdminNav</code> contributions and the current route; a subpage's own trail comes from the page's <code>Crumbs</code> section. Falls back to the page title when no nav match.</div>
                    @ParamsBlock()
                    <div class="wg-card-example">
                        <vc:admin-breadcrumb />
                        <div class="text-muted small">↑ resolves to whatever admin nav entry matches this route, or the page title.</div>
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;vc:user-parts&gt;</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/UserPartsViewComponent.cs + each contributing section&#39;s Section.cs</span>
                    </div>
                    <div class="wg-card-note">
                        The section-contributed parts of a profile page, merged from every active section's
                        <code>IUserPart</code> descriptors for the target user and rendered in weight order (Events' card is
                        the reference contributor). Users names no contributor; a contributor that throws is logged and skipped.
                        Renders nothing when no section contributes.
                    </div>
                    @ParamsBlock(
                        ("slot", "<code>string</code> — a <code>UserPartSlots</code> constant"),
                        ("user-id", "<code>Guid</code>, required: the profile being viewed, never the viewer"),
                        ("view-mode", "<code>ProfileCardViewMode</code> — Self · Public · Admin")
                    )
                    <div class="wg-card-example">
                        <vc:user-parts slot="@UserPartSlots.Profile" user-id="@Model.CurrentUserId" view-mode="@ProfileCardViewMode.Admin" />
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;vc:access-matrix&gt;</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/AccessMatrixViewComponent.cs</span>
                    </div>
                    <div class="wg-card-note">Section-help bundle: guide markdown + glossary + access matrix. Renders nothing for sections with no help content registered.</div>
                    @ParamsBlock(
                        ("section", "<code>string</code> — access-matrix key a section contributes through <code>ISectionAccessMatrix</code> (e.g. Teams, Shifts, Profile)")
                    )
                    <div class="wg-card-example">
                        <vc:access-matrix section="Teams" />
                    </div>
                </div>

            </section>

            <section id="forms" class="wg-section">
                <h2>Forms &amp; Inputs</h2>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">HumanSearchViewComponent.cs</span>
                            <span class="wg-card-kind kind-vc">ViewComponent</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/ViewComponents/HumanSearchViewComponent.cs</span>
                    </div>
                    <div class="wg-card-note">Type-ahead human picker (<code>&lt;vc:human-search&gt;</code>). Hits <code>/api/profiles/search</code>; the picked human's id ends up on a hidden input so it submits with the surrounding form. Pass <code>selected-user-id</code> to prefill for edit forms.</div>
                    @ParamsBlock(
                        ("field-name", "<code>string</code> — name of the hidden input (default <code>userId</code>)"),
                        ("instance-key", "<code>string?</code> — required when multiple instances render on the same page"),
                        ("placeholder", "<code>string?</code> — input placeholder (default \"Search by name…\")"),
                        ("exclude-user-ids", "<code>IEnumerable&lt;Guid&gt;?</code> — hide these users from results"),
                        ("scope", "<code>HumanSearchScope</code> — <code>Name</code> narrows to burner-name match; <code>All</code> (default) = full-text"),
                        ("selected-user-id", "<code>Guid?</code> — prefill the picker with this user (default null = empty)"),
                        ("allow-email", "<code>bool</code> — when true (default false), an <code>@@</code>-containing query resolves by exact, case-insensitive verified email (0-or-1 result, no enumeration leak); safe on non-admin surfaces"),
                        ("ticket-lookup-url", "<code>string?</code> — when set, the picker also queries this URL (<code>?q=…</code>) in parallel and merges any rows after the profile results; used by the Early Entry card for ticket-barcode lookup (default null = disabled)")
                    )
                    <div class="wg-card-example" style="max-width: 400px;">
                        <vc:human-search field-name="exampleUserId"
                                         instance-key="widget-gallery-demo"
                                         placeholder="Type a name to search…" />
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">_LanguageChooser.cshtml</span>
                            <span class="wg-card-kind kind-pa">Partial</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Web/Views/Shared/_LanguageChooser.cshtml</span>
                    </div>
                    <div class="wg-card-note">Dropdown to switch UI culture; posts <code>culture</code> + <code>returnUrl</code> to <code>/Language/SetLanguage</code>.</div>
                    @ParamsBlock()
                    <div class="wg-card-example">
                        @await Html.PartialAsync("_LanguageChooser")
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">&lt;markdown-editor&gt;</span>
                            <span class="wg-card-kind kind-th">TagHelper</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/TagHelpers/MarkdownEditorTagHelper.cs</span>
                    </div>
                    <div class="wg-card-note">
                        Textarea upgraded with the EasyMDE WYSIWYG-ish Markdown editor (toolbar, preview, syntax help).
                        Server-side rendering is unchanged — the textarea posts raw Markdown and <code>HtmlHelperExtensions.SanitizedMarkdown</code> still owns rendering. Loads EasyMDE from jsDelivr with SRI; degrades to a plain textarea if JS fails.
                        The toolbar "?" button modal (<code>_MarkdownHelp</code>) is auto-emitted once per request — no manual <code>&lt;partial&gt;</code> needed.
                    </div>
                    @ParamsBlock(
                        ("asp-for", "<code>ModelExpression?</code> — standard model binding (preferred); validation/ModelState work as with a plain textarea"),
                        ("name", "<code>string?</code> — explicit name when <code>asp-for</code> is not used"),
                        ("value", "<code>string?</code> — explicit initial value when <code>asp-for</code> is not used"),
                        ("id", "<code>string?</code> — optional explicit id; defaults to the asp-for/name expression"),
                        ("rows", "<code>int</code> — textarea height before the EasyMDE upgrade (default 6)"),
                        ("class", "<code>string?</code> — additional CSS classes for the textarea (<code>form-control</code> is always applied)"),
                        ("required", "<code>bool</code> — emits HTML <code>required</code>"),
                        ("maxlength", "<code>int</code> — emits HTML <code>maxlength</code> when &gt; 0"),
                        ("placeholder", "<code>string?</code> — HTML <code>placeholder</code>")
                    )
                    <div class="wg-card-example">
                        <markdown-editor name="widget-gallery-markdown" value="**Hello** _editor_." rows="4" />
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">_MarkdownHelp.cshtml</span>
                            <span class="wg-card-kind kind-pa">Partial</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/Views/Shared/_MarkdownHelp.cshtml</span>
                    </div>
                    <div class="wg-card-note">
                        Hidden Bootstrap modal — include once per page, then trigger with
                        <code>data-bs-toggle="modal" data-bs-target="#markdownHelpModal"</code>.
                    </div>
                    @ParamsBlock()
                    <div class="wg-card-example">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#markdownHelpModal">
                            <i class="fa-solid fa-circle-info me-1"></i> Open Markdown help
                        </button>
                        @await Html.PartialAsync("_MarkdownHelp")
                    </div>
                </div>

                <div class="wg-card">
                    <div class="wg-card-header">
                        <div>
                            <span class="wg-card-name">_EmailComposer.cshtml</span>
                            <span class="wg-card-kind kind-pa">Partial</span>
                        </div>
                        <span class="wg-card-path">src/Humans.Base/Views/Shared/_EmailComposer.cshtml</span>
                    </div>
                    <div class="wg-card-note">
                        Shared human-composed-email component: optional subject field, an EasyMDE Markdown body
                        (<code>&lt;markdown-editor&gt;</code>), a read-only "To:" line (warning + confirm-on-submit at or
                        above <code>WarnRecipientCount</code>, default 25), a "Preview" button showing the exact branded,
                        sanitized send via <code>/Email/PreviewMarkdown</code> (no outbox row is created), and a "Send to me"
                        button that queues that send to the signed-in human via <code>/Email/SendMarkdownToSelf</code>. Every
                        compose form — profile message, camp contact, rota messages, survey invitation, feedback
                        reply, issue comment, campaign — renders through this one component.
                    </div>
                    @ParamsBlock(
                        ("@@model", "<code>EmailComposerViewModel</code> — RecipientCount/RecipientSummary/RecipientUserId/WarnRecipientCount for the To: line, BodyName/BodyValue/BodyLabel/BodyRows/BodyRequired/BodyMaxLength/BodyHelpText/BodyPlaceholder/BodyLabelVisuallyHidden, optional SubjectName/SubjectValue/SubjectLabel/SubjectRequired/SubjectMaxLength, Category (a <code>MessageCategory</code> name — drives the placeholder unsubscribe footer in the preview), and PreviewSubjectName/PreviewModalId/IncludePreviewModal for hosts with more than one instance on a page or that inject this partial via AJAX (Feedback/Issues)")
                    )
                    <div class="wg-card-example">
