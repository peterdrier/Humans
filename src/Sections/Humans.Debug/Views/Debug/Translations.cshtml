@model TranslationsPageViewModel
@{
    ViewData["Title"] = "Translations gallery";
}

<page-header title="Translations gallery">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Admin
    </a>
</page-header>

<div class="d-flex flex-wrap gap-3 align-items-center mb-3">
    <strong>@Model.TotalKeys keys in @Model.Sets.Count resource sets</strong>
    @foreach (var lang in Model.Languages)
    {
        var missing = Model.Sets.Sum(s => s.Gallery.MissingByLanguage[lang]);
        <span>
            <code>@lang</code>
            @if (missing == 0)
            {
                <span class="badge bg-success">complete</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">@missing missing</span>
            }
        </span>
    }
</div>

<form method="get" class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <input type="search" name="q" value="@Model.Query" class="form-control form-control-sm" style="max-width: 320px"
           placeholder="Search every set by key or text…" autocomplete="off" />
    <select name="set" class="form-select form-select-sm" style="max-width: 260px" aria-label="Resource set"
            onchange="this.form.q.value = ''; this.form.submit()">
        @foreach (var set in Model.Sets)
        {
            var setMissing = set.Gallery.MissingByLanguage.Values.Sum();
            <option value="@set.Name" selected="@string.Equals(set.Name, Model.SelectedSet, StringComparison.Ordinal)">
                @set.Name (@set.Gallery.TotalKeys)@(setMissing > 0 ? $" · {setMissing} missing" : "")
            </option>
        }
    </select>
    <div class="form-check form-check-inline mb-0">
        <input class="form-check-input" type="checkbox" name="missing" value="true" id="loc-missing-only"
               checked="@Model.MissingOnly" onchange="this.form.submit()" />
        <label class="form-check-label" for="loc-missing-only">Only missing</label>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Search</button>
    @if (Model.IsSearch)
    {
        <a asp-action="Translations" asp-route-set="@Model.SelectedSet" class="btn btn-link btn-sm">Clear search</a>
    }
</form>

<h2 class="h5 mb-2">
    @(Model.IsSearch ? $"Results for “{Model.Query}”" : Model.SelectedSet)
    <small class="text-muted">— @Model.Rows.Count @(Model.Rows.Count == 1 ? "key" : "keys")</small>
</h2>

@if (!Model.IsSearch && Model.Selected.Gallery.OrphanKeysByLanguage.Any(kv => kv.Value.Count > 0))
{
    <div class="alert alert-warning">
        <strong>Orphan keys</strong> — present in a language file but no longer in the English resx; safe to delete:
        <ul class="mb-0">
            @foreach (var (lang, keys) in Model.Selected.Gallery.OrphanKeysByLanguage.Where(kv => kv.Value.Count > 0))
            {
                <li><code>@lang</code>: @string.Join(", ", keys)</li>
            }
        </ul>
    </div>
}

@if (Model.Rows.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle small">
            <thead>
                <tr>
                    @if (Model.IsSearch)
                    {
                        <th>Set</th>
                    }
                    <th style="min-width: 16rem">Key</th>
                    <th>en</th>
                    @foreach (var lang in Model.Languages)
                    {
                        <th>@lang</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hit in Model.Rows)
                {
                    <tr>
                        @if (Model.IsSearch)
                        {
                            <td><a asp-action="Translations" asp-route-set="@hit.Set">@hit.Set</a></td>
                        }
                        <td><code>@hit.Row.Key</code></td>
                        <td>@hit.Row.English</td>
                        @foreach (var lang in Model.Languages)
                        {
                            var value = hit.Row.Values[lang];
                            @if (value is null)
                            {
                                <td class="table-warning text-center" title="Missing: falls back to English">—</td>
                            }
                            else
                            {
                                <td>@value</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
