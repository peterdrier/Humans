@* A section RCL does not inherit the host's _ViewImports. A missing line here ships broken
   markup with a green build and no runtime error; DebugPageRenderTests guards it. *@
@using Humans.Base.Extensions
@using Humans.Debug
@using Humans.Debug.Controllers
@using Humans.Debug.Models
@using Humans.Debug.Services
@using Humans.Base.Logging
@using Humans.Base
@using Humans.Base.Interfaces
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@* Debug has no resource set — every string here is English developer copy. /Debug/Translations
   reads SharedResource as data, not as its own UI strings; DebugArchitectureTests pins it as
   the only localizer bound. *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* A section can only addTagHelper against assemblies it references — a Shell-resident
   component renders as inert literal markup. <vc:human> is in Humans.Base. *@
@addTagHelper *, Humans.Base
