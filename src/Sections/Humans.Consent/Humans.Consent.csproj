<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/controllers, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Consent.Tests" />
    <!-- The one assembly allowed to see many sections (design §5). -->
    <InternalsVisibleTo Include="Humans.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
    <ProjectReference Include="..\Humans.Consent.Contracts\Humans.Consent.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Teams.Contracts\Humans.Teams.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Users.Contracts\Humans.Users.Contracts.csproj" />
    <!--
      Both go through the other section's leaf, never its project, so the graph stays
      acyclic: ConsentService resolves required teams and completion through
      IMembershipCalculatorRead, and auto-resolves an AccessSuspended notification through
      INotificationAutoResolve. Humans.Governance references Humans.Consent back (for
      ConsentResource, step 3b), which is fine — Humans.Governance.Contracts names no
      Consent type.
    -->
    <ProjectReference Include="..\Humans.Governance.Contracts\Humans.Governance.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Notifications.Contracts\Humans.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Email.Contracts\Humans.Email.Contracts.csproj" />
    <ProjectReference Include="..\Humans.Gdpr.Contracts\Humans.Gdpr.Contracts.csproj" />
    <!--
      Onboarding's leaf, for the consent-check threshold ConsentController peer-calls after
      a submit. It is a leaf *project* precisely so this reference is not a cycle:
      Humans.Onboarding references Humans.Consent back, for ConsentResource and the
      _ConsentReviewBody partial the widget's Consents step renders.
    -->
    <ProjectReference Include="..\Humans.Onboarding.Contracts\Humans.Onboarding.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Octokit: the GitHub content API behind IGitHubLegalDocumentConnector. The connector
         is shaped by this section's {name}.md / {name}-{lang}.md convention and has no
         consumer outside it, so it moved in whole (design §15.5b, Agent's rule). -->
    <PackageReference Include="Octokit" />
    <!-- Contracts/SyncLegalDocumentsJob.cs — [DisableConcurrentExecution] and IRecurringJob,
         since G5 lane 5b-4. Package, not project, so no cycle is possible; it was already
         arriving transitively. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The section owns its documentation (design §7a); keep it visible in Solution Explorer. -->
    <None Include="**\*.md" />
  </ItemGroup>

</Project>
