@* A section RCL does NOT inherit the host's Views/_ViewImports.cshtml. Omitting a line
   here ships broken markup with a green build and no runtime error.
   Two localizers: the section's Consent_* keys, and Nav_Consents in SharedResource because Humans.UI's login
   partial renders it too. *@
@using Humans.Base.Extensions
@using Humans.Consent
@using Humans.Consent.Contracts
@using Humans.Consent.Controllers
@using Humans.Consent.Models
@using Humans.Base.Enums
@using Humans.Base
@using Humans.Base.Models
@using Humans.Base.Models.Tables
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ConsentResource> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Humans.Base
