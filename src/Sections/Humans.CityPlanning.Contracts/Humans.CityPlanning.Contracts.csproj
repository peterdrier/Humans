<Project Sdk="Microsoft.NET.Sdk">

  <!--
    City Planning's cross-section surface, a leaf project rather than a Contracts/ folder
    because two consumers would otherwise cycle:

      - Humans.Camps' CampService clears a deleted camp's polygons through
        ICityPlanningService.DeleteCampPolygonsForSeasonsAsync;
      - Humans.Containers needs ICityPlanningServiceRead, while Humans.CityPlanning
        references Humans.Containers for IContainerService and its view models.

    See memory/architecture/section-project-cycle-fix.md. References Humans.Base only —
    the bottom of the graph.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Humans.Base\Humans.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

</Project>
