<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- MVC views/partials/view components, not Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.NET.Sdk.Web adds these to ImplicitUsings; Microsoft.NET.Sdk.Razor does not.
      Declaring them keeps the files moved out of Humans.Web byte-identical to their originals.
    -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humans.Application\Humans.Application.csproj" />
  </ItemGroup>

  <!--
    HtmlSanitizer and Markdig left with Extensions/HtmlHelperExtensions.cs in G5 lane
    4b-iii A (nobodies-collective/Humans#866) and are now declared on Humans.Interfaces.
    Nothing left in this project names either package: SanitizedMarkdown's signature is
    string -> IHtmlContent, so the views here that render it need no package of their own.
  -->

</Project>
