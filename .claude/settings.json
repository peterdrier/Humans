{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/db-migration-checklist-hook.sh",
            "timeout": 10,
            "statusMessage": "Checking for database changes..."
          },
          {
            "type": "command",
            "command": "bash .claude/check-ef-output-dir.sh",
            "timeout": 5,
            "statusMessage": "Checking EF migration command..."
          },
          {
            "type": "command",
            "command": "bash .claude/razor-lint-hook.sh || true",
            "timeout": 15,
            "statusMessage": "Linting Razor views..."
          },
          {
            "type": "command",
            "command": "bash .claude/block-data-migration-hook.sh",
            "timeout": 10,
            "statusMessage": "Checking for data migration commit..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/block-data-migration-hook.sh",
            "timeout": 10,
            "statusMessage": "Checking for data migration..."
          }
        ]
      }
    ]
  }
}
