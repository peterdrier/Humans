  <ItemGroup>
    <!--
      The section's controllers are ASP.NET types, and a plain Microsoft.NET.Sdk test
      project does not get the shared framework — a PackageReference cannot supply it
      either (NU1010 under Central Package Management, design §15 step 8).
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="NodaTime.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The six Profile-side entities are internal to Humans.Users
      (nobodies-collective/Humans#1051); this project holds InternalsVisibleTo and
      names them in a dozen files. Global, as in the section's own csproj.
    -->
    <Using Include="Humans.Users.Domain" />
  </ItemGroup>

